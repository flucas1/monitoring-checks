async def findswitchesininterface(interface, model):
    result = []

    for index in range(2):
        infomsg("interface " + interface + " - iteration " + str(index))
        cmdline = ["/etc/nagios/scripts/prosafe/psl-cli.py", "--interface", interface, "discover"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        if exitcode == 0:
            infos = {}
            for line in output.splitlines():
                line = line.strip()
                if line == "":
                    infos = {}
                else:
                    parts = line.split(":", 1)
                    marker = parts[0].strip()
                    if marker in ["model", "name", "MAC", "dhcp", "ip"]:
                        infos[marker] = parts[1].strip()
                if ("model" in infos.keys()) and ("MAC" in infos.keys()):
                    if infos["model"] == model:
                        mac = infos["MAC"]
                        if mac not in result:
                            result.append(mac)
        await asyncio.sleep(1)

    infomsg("interfaces " + str(result))
    return result


async def findallswitches(model):
    switches = {}
    if_list = netifaces.interfaces()
    for interface in if_list:
        if (interface.startswith("veth") == False) and (interface.startswith("flannel") == False) and (interface.startswith("calico") == False) and (interface.startswith("cni") == False) and (interface.startswith("tun") == False) and (interface.startswith("tap") == False) and (interface not in ["pimreg", "lo"]):
            foundmacs = await findswitchesininterface(interface, model)
            if len(foundmacs) > 0:
                switches[interface] = foundmacs
    return switches


async def queryversion(interface, mac, strict):
    result = None

    if strict:
        maxversions = 5
    else:
        maxversions = 2
    for index in range(maxversions):
        cmdline = ["/etc/nagios/scripts/prosafe/psl-cli.py", "--interface", interface, "query", "--mac", mac, "firmwarever"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        if exitcode == 0:
            for line in output.splitlines():
                line = line.strip()
                parts = line.split()
                if len(parts) > 0 and parts[0] == "Firmwarever":
                    result = parts[1]
                    break
        infomsg("queryversion")
        if result is not None:
            break
        else:
            await asyncio.sleep(1)

    return result


async def getversions(switches, version, strict):
    results = {}
    for interface, macs in switches.items():
        for mac in macs:
            version = await queryversion(interface, mac, strict)
            results[mac] = {}
            results[mac]["interface"] = interface
            results[mac]["version"] = version
    return results


async def doprosafecall(model, expected, strict):
    switches = await findallswitches(model)
    infomsg(str(switches))
    versions = await getversions(switches, expected, strict)
    infomsg(str(versions))

    valid = {}
    failures = {}
    for key, value in versions.items():
        foundversion = value["version"]
        if (foundversion == None and strict == False) or (foundversion == expected) or (expected == ""):
            valid[key] = value
        else:
            failures[key] = value

    if len(failures) == 0:
        await exitnagios("OK", "all switches found are OK - valid " + str(valid) + " | found=" + str(len(versions)) + " failures=" + str(len(failures)) + " valid=" + str(len(valid)) + " version=" + expected)
    else:
        await exitnagios("WARNING", "some switches are not as expected - failures " + str(failures) + " - valid " + str(valid) + " | found=" + str(len(versions)) + " failures=" + str(len(failures)) + " valid=" + str(len(valid)) + " version=" + expected)


async def getexpected(proxy, model):
    expected = ""
    try:
        driver = await generatedriver(proxy)

        wait = selenium.webdriver.support.ui.WebDriverWait(driver, 20)
        action = selenium.webdriver.common.action_chains.ActionChains(driver)

        infomsg("browser initialized")

        url = "https://www.netgear.com/support/product/" + model.lower() + "#download"
        driver.get(url)
        await asyncio.sleep(1)
        await wait_page_loaded(driver)

        wait.until(selenium.webdriver.support.expected_conditions.visibility_of_element_located((selenium.webdriver.common.by.By.ID, "topicsdownload")))
        titles = driver.find_elements(by=selenium.webdriver.common.by.By.CLASS_NAME, value="accordion-title")
        candidates = []
        for title in titles:
            text = title.get_attribute("text")
            if "Firmware Version" in text:
                parts = text.split()
                version = parts[2]
                if version not in candidates:
                    candidates.append(version)
        if len(candidates) > 0:
            expected = candidates[0]

        infomsg("the autodetected expected value is " + expected)

    except Exception as e:
        infomsg("unexpected error during the check " + str(e))

    return expected


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-m", "--model", dest="model", default="", help="netgear prosafe model to check")
    parser.add_argument("-e", "--expected", dest="expected", default="auto", help="expected firmware version")
    parser.add_argument("-s", "--strict", action="store_true", dest="strict", default=False, help="if version not found, raise problem")
    parser.add_argument("-l", "--tolerant", action="store_false", dest="strict", help="if version not found, do not raise problem")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    model = args.model
    strict = args.strict
    if args.expected in ["auto", "", None]:
        proxy = ""
        expected = await getexpected(proxy, model)
        infomsg(expected)
    else:
        expected = args.expected

    await doprosafecall(model, expected, strict)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

