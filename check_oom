#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import os
import json
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def oom_kernel_check(criticallevel, warninglevel, short=False):
    infomsg("KERNEL")

    cmdline = ["/usr/bin/journalctl", "--utc", "--no-pager", "-kq", "-o", "json", "-b", "-0", "--output-fields=MESSAGE"]
    infomsg(cmdline)

    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()

    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode

    logs = []
    if exitcode == 0:
        counter = 0
        for line in output.splitlines():
            try:
                parsed = json.loads(line)
                message = parsed.get("MESSAGE", "")
                if "killed process" in message:
                    infomsg(parsed)
                    logs.append(message)
                    counter += 1
            except json.JSONDecodeError:
                continue

        return counter, logs
    else:
        return None, logs


async def oom_systemd_check(criticallevel, warninglevel, short=False):
    infomsg("SYSTEMD")

    cmdline = ["/usr/bin/journalctl", "-u", "systemd-oomd.service", "--utc", "--no-pager", "-o", "json", "-b", "-0", "--output-fields=MESSAGE"]
    infomsg(cmdline)

    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()

    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode

    logs = []
    if exitcode == 0:
        counter = 0
        for line in output.splitlines():
            try:
                parsed = json.loads(line)
                message = parsed.get("MESSAGE", "")
                if "Killed " in message:
                    infomsg(parsed)
                    logs.append(message)
                    counter += 1
            except json.JSONDecodeError:
                continue

        return counter, logs
    else:
        return None, logs


async def oom_check(criticallevel, warninglevel, short=False):
    kernelcounter, kernellogs = await oom_kernel_check(criticallevel, warninglevel, short)
    systemdcounter, systemdlogs = await oom_systemd_check(criticallevel, warninglevel, short)

    if kernelcounter is None:
        exitnagios("CRITICAL", "error retrieving the information from kernel oom journalctl | counter=-1")
    elif systemdcounter is None:
        exitnagios("CRITICAL", "error retrieving the information from systemd oomd journalctl | counter=-1")
    else:
        counter = kernelcounter + systemdcounter
        logs = kernellogs + systemdlogs
        if criticallevel != "" and counter > int(criticallevel):
            exitnagios("CRITICAL", str(counter) + " processes was killed by OOM - " + str(logs) + " | counter=" + str(counter))
        elif warninglevel != "" and counter > int(warninglevel):
            exitnagios("WARNING", str(counter) + " processes was killed by OOM - " + str(logs) + " | counter=" + str(counter))
        else:
            exitnagios("OK", "No OOM killer activity found | counter=-1")

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-w", "--warning", default="", help="Number of occurences to trigger a warning")
    parser.add_argument("-c", "--critical", default="1", help="Number of occurences to trigger a warning")
    parser.add_argument("-s", "--short", action="store_true", help="If this option is specified, check ignores dmesg OOM problems older then 24 hours")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)

    setcandebug(args.debug)

    await oom_check(args.critical, args.warning, args.short)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
