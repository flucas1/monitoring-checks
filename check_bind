#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import aiohttp
import argparse
import socket
import xml.etree.ElementTree

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def get_connector(protocol):
    if protocol == "-4":
        return aiohttp.TCPConnector(family=socket.AF_INET)
    elif protocol == "-6":
        return aiohttp.TCPConnector(family=socket.AF_INET6)
    else:
        return aiohttp.TCPConnector()


async def fetch_data(url, timeout, protocol):
    connector = get_connector(protocol)
    timeout_obj = aiohttp.ClientTimeout(total=timeout)
    try:
        async with aiohttp.ClientSession(connector=connector, timeout=timeout_obj) as session:
            async with session.get(url) as response:
                return await response.read()
    except Exception as e:
        exitnagios("UNKNOWN", "Stats collection failed - " + str(e))


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check Bind9 Statistics (new format XML v3)")
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-H", "--hostaddress", required=True, help="Host address of the Bind9 server")
    parser.add_argument("-p", "--port", required=True, help="Port of the Bind9 statistics channel")
    parser.add_argument("-w", "--warning", type=float, default=5.0, help="Warning threshold for slow RTT percentage (default: 5.0 percent)")
    parser.add_argument("-c", "--critical", type=float, default=10.0, help="Critical threshold for slow RTT percentage (default: 10.0 percent)")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    url = "http://" + str(args.hostaddress) + ":" + str(args.port) + "/xml/v3/server"

    TIMEOUT = 20
    xml_data = await fetch_data(url, TIMEOUT, protocol)

    if not xml_data:
        exitnagios("UNKNOWN", "Stats collection failed")

    try:
        root = xml.etree.ElementTree.fromstring(xml_data)
    except Exception:
        exitnagios("UNKNOWN", "Stats collection failed")

    total_queries = ""
    for elem in root.findall(".//*[@name='QUERY']"):
        total_queries = elem.text
        break

    queries = []
    for elem in root.findall(".//*[@type='qtype']"):
        if "name" in elem.attrib and elem.text is not None:
            queries.append("query_" + str(elem.attrib["name"]) + "=" + str(elem.text) + "c")

    out_queries = []
    for elem in root.findall(".//*[@type='resqtype']"):
        if "name" in elem.attrib and elem.text is not None:
            out_queries.append("query-out_" + str(elem.attrib["name"]) + "=" + str(elem.text) + "c")

    rtt = {"10": "", "100": "", "500": "", "800": "", "1600": "", "1600+": ""}
    for elem in root.findall(".//*[@name]"):
        name = elem.attrib["name"]
        if name.startswith("QryRTT") and name[6:] in rtt:
            rtt[name[6:]] = elem.text if elem.text is not None else ""

    rtt_out = []
    mapping = [("10", "10"), ("100", "100"), ("500", "500"), ("800", "800"), ("1600", "1600"), ("1600+", "Over1600")]

    total_rtt_count = 0
    slow_rtt_count = 0

    for key, label in mapping:
        if rtt[key]:
            val = rtt[key]
            rtt_out.append("QryRTT_" + str(label) + "=" + str(val) + "c")
            try:
                count = int(val)
                total_rtt_count += count
                # Define "slow" RTT as anything taking 500ms or longer
                if key in ["500", "800", "1600", "1600+"]:
                    slow_rtt_count += count
            except ValueError:
                pass

    status = "OK"
    slow_rate = 0.0

    if total_rtt_count > 0:
        slow_rate = (float(slow_rtt_count) / float(total_rtt_count)) * 100.0

        if args.critical is not None and slow_rate >= args.critical:
            status = "CRITICAL"
        elif args.warning is not None and slow_rate >= args.warning:
            status = "WARNING"

    output = ["Bind 9 Stats - Slow RTT Rate: " + str(round(slow_rate, 2)) + "% |"]
    if total_queries:
        output.append("total_queries=" + str(total_queries) + "c")
    output.extend(queries)
    output.extend(out_queries)
    output.extend(rtt_out)

    exitnagios(status, " ".join(output))


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
