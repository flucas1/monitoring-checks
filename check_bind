#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import urllib.request
import xml.etree.ElementTree
import asyncio
import argparse

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3
TIMEOUT = 20


async def main(forcedargs=None)

    args = sys.argv[1:]
    hostaddress = None
    hostport = None

    while args:
        arg = args.pop(0)
        elif arg in ('-H', '--hostaddress'):
            if args:
                hostaddress = args.pop(0)
        elif arg in ('-p', '--port'):
            if args:
                hostport = args.pop(0)
        else:
            print(f"Unknown argument: {arg}")
            sys.exit(STATE_UNKNOWN)

    if not hostaddress or not hostport:
        print(f"missing argument")
        sys.exit(STATE_UNKNOWN)

    url = f"http://{hostaddress}:{hostport}/xml/v3/server"

    try:
        req = urllib.request.urlopen(url, timeout=TIMEOUT)
        xml_data = req.read()
    except Exception:
        print("Stats collection failed")
        sys.exit(STATE_UNKNOWN)

    if not xml_data:
        print("Stats collection failed")
        sys.exit(STATE_UNKNOWN)

    try:
        root = xml.etree.ElementTree.fromstring(xml_data)
    except Exception:
        print("Stats collection failed")
        sys.exit(STATE_UNKNOWN)

    total_queries = ""
    for elem in root.findall(".//*[@name='QUERY']"):
        total_queries = elem.text
        break

    queries = []
    for elem in root.findall(".//*[@type='qtype']"):
        if 'name' in elem.attrib and elem.text is not None:
            queries.append(f"query_{elem.attrib['name']}={elem.text}c")

    out_queries = []
    for elem in root.findall(".//*[@type='resqtype']"):
        if 'name' in elem.attrib and elem.text is not None:
            out_queries.append(f"query-out_{elem.attrib['name']}={elem.text}c")

    rtt = {"10": "", "100": "", "500": "", "800": "", "1600": "", "1600+": ""}
    for elem in root.findall(".//*[@name]"):
        name = elem.attrib['name']
        if name.startswith("QryRTT") and name[6:] in rtt:
            rtt[name[6:]] = elem.text if elem.text is not None else ""

    rtt_out = []
    mapping = [("10", "10"), ("100", "100"), ("500", "500"), ("800", "800"), ("1600", "1600"), ("1600+", "Over1600")]
    for key, label in mapping:
        rtt_out.append(f"QryRTT_{label}={rtt[key]}c")

    output = ["OK: Bind 9 Stats Collected |"]
    if total_queries:
        output.append(f"total_queries={total_queries}c")

    output.extend(queries)
    output.extend(out_queries)
    output.extend(rtt_out)

    print(" ".join(output))
    sys.exit(STATE_OK)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
