#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import aiohttp
import argparse
import xml.etree.ElementTree

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------

async def fetch_data(url, timeout):
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=timeout) as response:
                return await response.read()
    except Exception:
        exitnagios("UNKNOWN", "Stats collection failed")

# -------------------------------------------------------------------------------\


async def main(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check Bind9 Statistics (new format XML v3)")
    parser.add_argument("-H", "--hostaddress", required=True, help="Host address of the Bind9 server")
    parser.add_argument("-p", "--port", required=True, help="Port of the Bind9 statistics channel")
    parser.add_argument("-w", "--warning", type=int, default=100000, help="Warning threshold for total queries (default: 100000)")
    parser.add_argument("-c", "--critical", type=int, default=250000, help="Critical threshold for total queries (default: 250000)")
    args = parser.parse_args()

    url = f"http://{args.hostaddress}:{args.port}/xml/v3/server"

    TIMEOUT = 20
    xml_data = await fetch_data(url, TIMEOUT)

    if not xml_data:
        exitnagios("UNKNOWN", "Stats collection failed")

    try:
        root = xml.etree.ElementTree.fromstring(xml_data)
    except Exception:
        exitnagios("UNKNOWN", "Stats collection failed")

    total_queries = ""
    for elem in root.findall(".//*[@name='QUERY']"):
        total_queries = elem.text
        break

    status = "OK"
    if total_queries:
        try:
            tq_int = int(total_queries)
            if args.critical is not None and tq_int >= args.critical:
                status = "CRITICAL"
            elif args.warning is not None and tq_int >= args.warning:
                status = "WARNING"
        except ValueError:
            pass

    queries = []
    for elem in root.findall(".//*[@type='qtype']"):
        if 'name' in elem.attrib and elem.text is not None:
            queries.append(f"query_{elem.attrib['name']}={elem.text}c")

    out_queries = []
    for elem in root.findall(".//*[@type='resqtype']"):
        if 'name' in elem.attrib and elem.text is not None:
            out_queries.append(f"query-out_{elem.attrib['name']}={elem.text}c")

    rtt = {"10": "", "100": "", "500": "", "800": "", "1600": "", "1600+": ""}
    for elem in root.findall(".//*[@name]"):
        name = elem.attrib['name']
        if name.startswith("QryRTT") and name[6:] in rtt:
            rtt[name[6:]] = elem.text if elem.text is not None else ""

    rtt_out = []
    mapping = [("10", "10"), ("100", "100"), ("500", "500"), ("800", "800"), ("1600", "1600"), ("1600+", "Over1600")]
    for key, label in mapping:
        if rtt[key]:
            rtt_out.append(f"QryRTT_{label}={rtt[key]}c")

    output = ["Bind 9 Stats Collected |"]
    if total_queries:
        output.append(f"total_queries={total_queries}c")
    output.extend(queries)
    output.extend(out_queries)
    output.extend(rtt_out)

    exitnagios(status, " ".join(output))


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
