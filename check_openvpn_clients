_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def read_until(reader, expected, timeout=10):
    buffer = ""
    try:
        while expected not in buffer:
            chunk = await asyncio.wait_for(reader.read(1), timeout=timeout)
            if not chunk:
                break
            buffer += chunk
    except asyncio.TimeoutError:
        infomsg("Timeout while waiting for: " + expected)
    return buffer


async def interact(hostname, port, password, request):
    timeout = 5
    try:
        tnreader, tnwriter = await telnetlib3.open_connection(hostname, port)
        await read_until(tnreader, "ENTER PASSWORD:")
        tnwriter.write(password + "\r\n")
        await read_until(tnreader, "SUCCESS:")
        await read_until(tnreader, "-- type 'help' for more info" + "\r\n")
        tnwriter.write(request + "\r\n")
        response = await read_until(tnreader, "\r\n" + "END" + "\r\n")
        return response
    except Exception as e:
        exitnagios("CRITICAL", str(e))


