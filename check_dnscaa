#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import aiohttp
import asyncio
import bs4
import socket

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def get_connector(protocol):
    if protocol == "-4":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET)
    elif protocol == "-6":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET6)
    else:
        return aiohttp.TCPConnector()


async def dodnscaacall(domain, protocol):
    try:
        url = "https://caatest.co.uk/" + domain
        connector = get_connector(protocol)
        async with aiohttp.ClientSession(connector=connector) as session:
            headers = {
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/113.0"
            }
            async with session.get(url, headers=headers, ssl=False) as response:
                if response.status != 200:
                    exitnagios("CRITICAL", "unexpected HTTP status: " + str(response.status))
                content = await response.read()
                if len(content) == 0:
                    exitnagios("CRITICAL", "no result from page")

                soup = bs4.BeautifulSoup(content, "html.parser")

                element = soup.find("span", class_="success green")
                if element is not None:
                    exitnagios("OK", "the domain has valid CAA records")
                else:
                    exitnagios("CRITICAL", "the domain has issues with the CAA records")

    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check " + str(e))


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-H", "--host", dest="host", help="Hostname")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    if args.host is None or args.host == "":
        exitnagios("CRITICAL", "specify a host/domain to check")

    await dodnscaacall(args.host, protocol)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
