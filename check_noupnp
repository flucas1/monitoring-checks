#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import subprocess
import sys


def check_upnp_gateway():
    try:
        # Run the command and redirect stderr to stdout (equivalent to 2>&1)
        result = subprocess.run(
            ["/usr/bin/external-ip"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )
        # The $() construct in shell strips trailing newlines, so we use .strip() here
        exitmsg = result.stdout.strip()

    except FileNotFoundError:
        # Fallback if the executable is not found on the system
        exitmsg = "/usr/bin/external-ip: not found"

    # Evaluate the output and exit with corresponding messages and codes
    if exitmsg == "No IGD UPnP Device found on the network !":
        print("OK: no UPnP gateway found")
        sys.exit(0)
    else:
        print(f"CRITICAL: an UPnP gateway was found!!!! {exitmsg}")
        sys.exit(2)


if __name__ == "__main__":
    check_upnp_gateway()
