#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import asyncio
import sys


async def check_upnp_gateway():
    try:
        # Run the command asynchronously
        cmdline = ["/usr/bin/external-ip"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        # print("OK")
        output = stdout.decode("utf-8").strip()
        errors = stderr.decode("utf-8").strip()
    except FileNotFoundError as e:
        # Fallback if the executable is not found on the system
        print(str(e))
        output = None
        errors = None

    # print(output)
    # print(errors)

    # Evaluate the output and exit with corresponding messages and codes
    if errors == "No IGD UPnP Device found on the network !":
        print("OK: no UPnP gateway found")
        sys.exit(0)
    else:
        print(f"CRITICAL: an UPnP gateway was found!!!! {errors}")
        sys.exit(2)


if __name__ == "__main__":
    asyncio.run(check_upnp_gateway())
