#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import asyncio
import argparse
import sys


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def check_upnp_gateway():
    try:
        cmdline = ["/usr/bin/external-ip"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip()
        errors = stderr.decode("utf-8").strip()
    except FileNotFoundError as e:
        print(str(e))
        output = None
        errors = None

    if errors == "No IGD UPnP Device found on the network !":
        print("OK: no UPnP gateway found")
        sys.exit(0)
    else:
        print("CRITICAL: an UPnP gateway was found - " + errors)
        sys.exit(2)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug mode")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    await check_upnp_gateway()


# -------------------------------------------------------------------------------


if __name__ == "__main__":
    asyncio.run(main())


# -------------------------------------------------------------------------------
