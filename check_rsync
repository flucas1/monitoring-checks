#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import argparse

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def check_rsync(remote, rsync_port, timeoutvalue, timeoutstatus):
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(remote, rsync_port),
            timeout=timeoutvalue
        )
        try:
            writer.write(b"\r\n")
            await writer.drain()
            rsync_out = await asyncio.wait_for(
                reader.read(1024),
                timeout=timeoutvalue
            )
            rsync_out = rsync_out.decode("utf-8", errors="ignore").strip()

            if rsync_out.startswith("@RSYNCD:"):
                print("OK - " + rsync_out)
                return 0
            else:
                print("WARNING - rsync out: " + rsync_out)
                return 1
        finally:
            writer.close()
            await writer.wait_closed()
    except (asyncio.TimeoutError, OSError):
        print(timeoutstatus + " - Could not connect to " + remote + ":" + str(rsync_port))
        if timeoutstatus == "CRITICAL":
            return 2
        if timeoutstatus == "WARNING":
            return 1
        if timeoutstatus == "OK":
            return 0
        return 3


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="remote", type=str, default="")
    parser.add_argument("-t", "--timeout", dest="timeoutmerged", type=str, default="30:CRITICAL")
    parser.add_argument("-p", "--port", dest="rsync_port", type=int, default=873)
    parser.add_argument("-d", "--debug", dest="debug", action="store_true", default=False)
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    timeout_parts = args.timeoutmerged.split(":")
    timeoutvalue = float(timeout_parts[0])
    timeoutstatus = timeout_parts[1] if len(timeout_parts) > 1 else "CRITICAL"

    exit_code = await check_rsync(args.remote, args.rsync_port, timeoutvalue, timeoutstatus)

    if exit_code is None:
        print("UNKNOW - Plugin internal error")
        exit_code = 3

    sys.exit(exit_code)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
