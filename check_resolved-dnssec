#!/usr/bin/env python3
#-------------------------------------------------------------------------------

import argparse
import sys
import os
import asyncio

#-------------------------------------------------------------------------------

_candebug = False
def candebug():
    global _candebug
    return _candebug

def setcandebug(value):
    global _candebug
    _candebug = value

def infomsg(msg):
    if candebug() == True:
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

async def doresolveddnsseccall():
    cmdline = ["/usr/bin/resolvectl", "dnssec"]
    process = await asyncio.create_subprocess_exec(*cmdline, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip()
    errors = stderr.decode("utf-8").strip()
    exitcode = process.returncode

    if exitcode == 0:
        allenabled = True
        failed = []
        for line in output.splitlines():
            parts = line.split()
            if len(parts) < 2:
                continue
            if parts[-1].lower() != "yes":
                allenabled = False
                if parts[0].lower() == "global":
                    failed.append("Global")
                else:
                    if len(parts) >= 3:
                        failed.append(parts[2].replace("(", "").replace(")", ""))
                    else:
                        failed.append("Unknown")
        if allenabled:
            exitnagios("OK", "all interfaces have dnssec activated")
        else:
            exitnagios("CRITICAL", "some interfaces do not have dnssec activated: " + ", ".join(failed))
    else:
        exitnagios("CRITICAL", "issue retrieving dnssec status")

#-------------------------------------------------------------------------------

def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-®", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args

async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await doresolveddnsseccall()

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

#-------------------------------------------------------------------------------
