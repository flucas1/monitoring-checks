async def dodnssecverisigncall(mailfrom, tolerate, proxy):
    try:
        driver = await generatedriver(proxy)

        wait = selenium.webdriver.support.ui.WebDriverWait(driver, 20)

        # OTHER ALTERNATIVES, BUT DO NOT CHECK DMARC
        # https://dkimvalidator.com/
        # https://dmarcchecker.app/
        # https://www.mailreach.co/dkim-checker
        # https://wander.science/projects/email/dkimtest/

        infomsg("browser OK")
        url = "https://dmarcchecker.app"
        driver.get(url)
        infomsg("asking for navigating " + url)

        await asyncio.sleep(2)
        await wait_page_loaded(driver)
        infomsg("page loaded")

        infomsg("waiting for element")
        wait.until(selenium.webdriver.support.expected_conditions.presence_of_element_located((selenium.webdriver.common.by.By.ID, "email-address")))

        infomsg("finding base element")
        elements = await tryfindbyxpath(driver, ".//*[@id='email-address']//a")
        if len(elements) == 0:
            exitnagios("CRITICAL", "no result from page")

        infomsg("extracting email")
        targetemail = elements[0].text
        me = mailfrom
        dummystring = "TEST email to " + url + " at " + datetime.datetime.now(datetime.timezone.utc).isoformat()

        email_body = dummystring
        email_message = email.mime.text.MIMEText(email_body)
        email_message["Subject"] = dummystring
        email_message["From"] = me
        email_message["To"] = targetemail
        email_message["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; WOW64; rv:102.0) Gecko/20100101 Thunderbird/102.0"

        infomsg("sending email to " + targetemail)
        s = smtplib.SMTP("localhost")
        s.sendmail(me, [targetemail], email_message.as_string())
        s.quit()

        await asyncio.sleep(5)
        infomsg("waiting for element")
        start_time = datetime.datetime.now(datetime.timezone.utc).timestamp()
        max_duration = 180
        retry_interval = 5
        gotanswer = False
        while datetime.datetime.now(datetime.timezone.utc).timestamp() - start_time < max_duration:
            founddetails = await tryfindbyclassname(driver, "report-details-table")
            if len(founddetails) > 0:
                infomsg("found details!")
                gotanswer = True
                break
            else:
                foundcheck = await tryfindbyid(driver, "check-status")
                if len(foundcheck) > 0:
                    infomsg("the check status is " + foundcheck[0].text)
                infomsg("extra wait for mail arrival")
                await asyncio.sleep(retry_interval)

        if gotanswer == False:
            exitnagios("CRITICAL", "could not find answer from remote website")
        else:
            infomsg("extracting errors")
            errors = await tryfindbyclassname(driver, "error")
            infomsg(str(len(errors)))
            countError = 0
            for item in errors:
                words = item.text.split()
                infomsg(str(words))
                if len(words) == 2:
                    partial = None
                    try:
                        partial = int(words[0])
                    except:
                        pass
                    if partial is not None:
                        countError = countError + partial
            infomsg("extracting warns")
            warns = await tryfindbyclassname(driver, "warn")
            infomsg(str(len(warns)))
            countWarning = 0
            for item in warns:
                words = item.text.split()
                infomsg(str(words))
                if len(words) == 2:
                    partial = None
                    try:
                        partial = int(words[0])
                    except:
                        pass
                    if partial is not None:
                        countWarning = countWarning + partial

        if countError > 0:
            exitnagios("CRITICAL", "There are errors for " + mailfrom + " | warnings=" + str(countWarning) + " errors=" + str(countError))
        elif countWarning > tolerate:
            exitnagios("WARNING", "There are warnings for " + mailfrom + " | warnings=" + str(countWarning) + " errors=" + str(countError))
        else:
            exitnagios("OK", "No issues found for " + mailfrom + " | warnings=" + str(countWarning) + " errors=" + str(countError))

    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check - " + str(e))

# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-f", "--mailfrom", dest="mailfrom", default="root@localhost", help="email to test")
    parser.add_argument("-l", "--tolerate", dest="tolerate", default="0", help="number of warnings to tolerate")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    proxy = ""
    tolerate = int(args.tolerate)
    await dodnssecverisigncall(args.mailfrom, tolerate, proxy)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

