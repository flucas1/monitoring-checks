#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys
import os
import shutil


def parse_thresholds(thresh_str, default_val=99999):
    """Parses comma-separated thresholds and pads them to 5 values."""
    if not thresh_str:
        return [default_val] * 5

    parts = thresh_str.split(',')
    # Pad the list to ensure it has 5 elements for the comparisons
    while len(parts) < 5:
        parts.append(default_val)

    return [float(p) for p in parts[:5]]


async def run_iostat(disk, extended, samples):
    """Executes iostat asynchronously and returns the last line matching the disk."""
    cmdline = ["/usr/bin/iostat", disk, "-k", "-d", "10", str(samples)]
    if extended:
        cmdline.insert(2, "-x")

    try:
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            print("ERROR: Failed to run iostat command")
            sys.exit(-1)

        output = stdout.decode('utf-8')
        # grep $disk | tail -1
        matching_lines = [line.strip() for line in output.splitlines() if disk in line]
        if not matching_lines:
            return []

        last_line = matching_lines[-1]
        # Replace commas with dots for float parsing, then split by whitespace
        return last_line.replace(',', '.').split()
    except Exception as e:
        print("ERROR: Failed to run iostat command: " + str(e))
        sys.exit(-1)


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", dest="disk", default="sda", help="Device to be checked")
    parser.add_argument("-w", dest="warning", default="", help="Warning levels")
    parser.add_argument("-c", dest="critical", default="", help="Critical levels")
    parser.add_argument("-i", dest="io", action="store_true", help="IO Check Mode")
    parser.add_argument("-q", dest="queue", action="store_true", help="Queue Mode")
    parser.add_argument("-W", dest="waittime", action="store_true", help="Wait Time Mode")
    parser.add_argument("-p", dest="printperfdata", action="store_true", help="Provide performance data")
    parser.add_argument("-g", dest="samples", action="store_const", const="1", default="2", help="Since last reboot")
    args = parser.parse_args()

    # Checks that only one query type is run
    if sum([args.io, args.queue, args.waittime]) != 1:
        print("ERROR: select one and only one run mode")
        sys.exit(-1)

    # Checks for sane Disk name
    if not os.path.exists("/dev/" + args.disk):
        print("ERROR: Device incorrectly specified")
        sys.exit(-1)

    warn = parse_thresholds(args.warning, 99999)
    crit = parse_thresholds(args.critical, 99999)

    # Checks for sane warning/critical levels
    if args.warning or args.critical:
        if warn[0] > crit[0] or warn[1] > crit[1]:
            print("ERROR: critical levels must be higher than warning levels")
            sys.exit(-1)
        if args.io or args.waittime:
            if warn[2] > crit[2] or warn[3] > crit[3] or warn[4] > crit[4]:
                print("ERROR: critical levels must be higher than warning levels")
                sys.exit(-1)

    tmpx = await run_iostat(args.disk, extended=True, samples=args.samples)
    if not tmpx:
        print("ERROR: No data returned for disk " + args.disk)
        sys.exit(-1)

    state = "OK"
    status = 0
    msg = ""
    perfdata = ""

    # ------------IO Test-------------
    if args.io:
        tmpd = await run_iostat(args.disk, extended=False, samples=args.samples)
        tps = float(tmpd[1])  # awk '{print $2}'
        read_sec = float(tmpx[3])  # awk '{print $4}'
        written_sec = float(tmpx[4])  # awk '{print $5}'
        kbytes_read_sec = float(tmpx[5])  # awk '{print $6}'
        kbytes_written_sec = float(tmpx[6])  # awk '{print $7}'

        if args.warning:
            if tps >= warn[0] or read_sec >= warn[1] or written_sec >= warn[2] or kbytes_read_sec >= warn[3] or kbytes_written_sec >= warn[4]:
                state = "WARNING"
                status = 1
        if args.critical:
            if tps >= crit[0] or read_sec >= crit[1] or written_sec >= crit[2] or kbytes_read_sec >= crit[3] or kbytes_written_sec >= crit[4]:
                state = "CRITICAL"
                status = 2

        msg = state + " - I/O stats: Transfers/Sec=" + str(tps) + " Read Requests/Sec=" + str(read_sec) + " Write Requests/Sec=" + str(written_sec) + " KBytes Read/Sec=" + str(kbytes_read_sec) + " KBytes_Written/Sec=" + str(kbytes_written_sec)
        perfdata = " | total_io_sec=" + str(tps) + ";" + str(warn[0]) + ";" + str(crit[0]) + ";" + " read_io_sec=" + str(read_sec) + ";" + str(warn[1]) + ";" + str(crit[1]) + ";" + " write_io_sec=" + str(written_sec) + ";" + str(warn[2]) + ";" + str(crit[2]) + ";" + " kbytes_read_sec=" + str(kbytes_read_sec) + ";" + str(warn[3]) + ";" + str(crit[3]) + ";" + " kbytes_written_sec=" + str(kbytes_written_sec) + ";" + str(warn[4]) + ";" + str(crit[4]) + ";"

    # ------------Queue Test-------------
    elif args.queue:
        qsize = float(tmpx[7])  # awk '{print $8}'
        qlength = float(tmpx[8])  # awk '{print $9}'

        if args.warning:
            if qsize >= warn[0] or qlength >= warn[1]:
                state = "WARNING"
                status = 1
        if args.critical:
            if qsize >= crit[0] or qlength >= crit[1]:
                state = "CRITICAL"
                status = 2

        msg = state + " - Disk Queue Stats: Average Request Size=" + str(qsize) + " Average Queue Length=" + str(qlength)
        perfdata = " | qsize=" + str(qsize) + ";" + str(warn[0]) + ";" + str(crit[0]) + ";" + " queue_length=" + str(qlength) + ";" + str(warn[1]) + ";" + str(crit[1]) + ";"

    # ------------Wait Time Test-------------
    elif args.waittime:
        avgwait = float(tmpx[9])  # awk '{print $10}'
        avgrwait = float(tmpx[10])  # awk '{print $11}'
        avgwwait = float(tmpx[11])  # awk '{print $12}'
        avgsvctime = float(tmpx[12])  # awk '{print $13}'
        avgcpuutil = float(tmpx[13])  # awk '{print $14}'

        if args.warning:
            if avgwait >= warn[0] or avgrwait >= warn[1] or avgwwait >= warn[2] or avgsvctime >= warn[3] or avgcpuutil >= warn[4]:
                state = "WARNING"
                status = 1
        if args.critical:
            if avgwait >= crit[0] or avgrwait >= crit[1] or avgwwait >= crit[2] or avgsvctime >= crit[3] or avgcpuutil >= crit[4]:
                state = "CRITICAL"
                status = 2

        msg = state + " - Wait Time Stats: Avg I/O Wait Time (ms)=" + str(avgwait) + " Avg Read Wait Time (ms)=" + str(avgrwait) + " Avg Write Wait Time (ms)=" + str(avgwwait) + " Avg Service Wait Time (ms)=" + str(avgsvctime) + " Avg CPU Utilization=" + str(avgcpuutil)
        perfdata = " | avg_io_waittime_ms=" + str(avgwait) + ";" + str(warn[0]) + ";" + str(crit[0]) + ";" + " avg_r_waittime_ms=" + str(avgrwait) + ";" + str(warn[1]) + ";" + str(crit[1]) + ";" + " avg_w_waittime_ms=" + str(avgwwait) + ";" + str(warn[2]) + ";" + str(crit[2]) + ";" + " avg_service_waittime_ms=" + str(avgsvctime) + ";" + str(warn[3]) + ";" + str(crit[3]) + ";" + " avg_cpu_utilization=" + str(avgcpuutil) + ";" + str(warn[4]) + ";" + str(crit[4]) + ";"

    # now output the official result
    final_output = msg
    if args.printperfdata:
        final_output += perfdata

    print(final_output)
    sys.exit(status)


if __name__ == "__main__":
    asyncio.run(main())
