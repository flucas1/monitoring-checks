import sys
import argparse
import asyncio
import socket
import aiohttp

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug() is True:
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def get_connector(protocol):
    if protocol == "-4":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET)
    elif protocol == "-6":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET6)
    else:
        return aiohttp.TCPConnector()


async def dodefacementcheck(url, ignore, excludelist, keywordlist, protocol, session):
    try:
        async with session.get(url) as resp:
            text = await resp.text()
    except Exception:
        exitnagios("UNKNOWN", "Error accessing url: " + url)

    if ignore:
        keywords = []
    else:
        keywords = [
            "Anonymous", "Hacked", "Hacker", "hack", "h4ck3d",
            "attack", "Hacktivist", "virus", "defaced",
            "Gary McKinnon", "LulzSec", "Lulz Security", "lulz",
            "Adrian Lamo", "Astra", "MafiaBoy", "YTCracker", "414s",
            "FinnSec Security", "Chaos Computer Club", "Cicada 3301",
            "Croatian Revolution Hackers", "Cult of the Dead Cow",
            "cDc", "Decocidio", "#Ө", "Digital DawgPound", "Global kOS ",
            "globalHell", "Goatse Security", "GoatSec", "Hacking Team",
            "Hacking", "Hackweiser", "Honker Union", "L0pht", "Mazafaka",
            "milw0rm", "NCPH", "OurMine", "Syrian Electronic Army",
            "TeaMp0isoN", "UGNazi", "bl@ck dr@gon", "Lizard Squad",
            "Tarh Andishan", "ArabAttack", "k4zuk3", "kdms team",
            "Dragonfly", "LockBit", "Cl0p", "Akira", "Play", "Black Basta",
            "Medusa", "RansomHub", "APT28", "Fancy Bear", "APT29", "Cozy Bear",
            "Lazarus Group", "REvil", "Sandworm", "Equation Group", "Scattered Spider",
            "DarkSide", "Conti", "Wizard Spider", "APT41", "Wicked Panda", "FIN7",
            "Emotet", "Legion of Doom", "Masters of Deception", "Anonymous Sudan",
            "Hive", "Homebrew Computer Club", "BlackCat", "ALPHV", "BianLian",
            "INC Ransom", "Hunters International", "Rhysida"
        ]

    if len(keywordlist) > 0:
        keywords = list(set(keywords) + set(keywordlist))

    if len(excludelist) > 0:
        keywords = list(set(keywords) - set(excludelist))

    word_match = []
    for word in keywords:
        if word in text:
            word_match.append(word)

    if len(word_match) > 0:
        exitnagios("CRITICAL", "Suspicious content detected, verify that the following " + str(len(word_match)) + " words '" + (", ".join(word_match)) + "', are legitimate in the following web page: " + url)
    else:
        exitnagios("OK", "No issues found")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-U", "--url", dest="url", help="Specify the full url you want to check, i.e. -U https://www.google.com")
    parser.add_argument("-K", "--keyword", dest="keyword", help="Put the words you want to search, i.e. -K hacker,hacked,anonymous")
    parser.add_argument("-i", "--ignore", action="store_true", dest="ignore", default=False, help="Use this option to ignore all pre-installed suspect words")
    parser.add_argument("-x", "--exclude", dest="exclude", help="Use this option to ignore one or multiple pre-installed suspect words")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    if args.ignore:
        if not args.keyword:
            exitnagios("UNKNOWN", "When using -i option, you need to specify at least one suspect word.")
    if not args.url:
        exitnagios("UNKNOWN", "Please, this program requires url arguments.")

    exclude_list = []
    if args.exclude:
        exclude_list = args.exclude.split(",")

    keyword_list = []
    if args.keyword:
        keyword_list = args.keyword.split(",")

    client_timeout = aiohttp.ClientTimeout(total=2)
    connector = get_connector(protocol)
    async with aiohttp.ClientSession(timeout=client_timeout, connector=connector) as session:
        await dodefacementcheck(args.url, args.ignore, exclude_list, keyword_list, args.protocol, session)


# -------------------------------------------------------------------------------


if __name__ == "__main__":
    asyncio.run(main())

