#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import os
import argparse
import traceback
import datetime
import ipaddress
import dns.asyncresolver
import dns.exception
import aiofiles
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def extractsearchlist():
    result = []
    try:
        async with aiofiles.open("/etc/resolv.conf", "r") as handle:
            content = await handle.read()
            lines = content.decode("utf-8").strip().splitlines()
            for line in lines:
                line = line.strip().split("#", 1)[0]
                if len(line) > 0:
                    parts = line.split()
                    if parts[0] == "search":
                        result = parts[1].split()
                        break
    except Exception:
        pass
    return result


async def extracthostslist():
    result = {}
    try:
        async with aiofiles.open("/etc/hosts", "r") as handle:
            content = await handle.read()
            lines = content.decode("utf-8").strip().splitlines()
            for line in lines:
                line = line.strip().split("#", 1)[0]
                if len(line) > 0:
                    parts = line.split()
                    key = parts[0]
                    result[key] = parts[1:]
    except Exception:
        pass
    return result


async def testvalue(ipo, dnsquery, recordtype, customresolver):
    result = False
    try:
        queryrr = await customresolver.resolve(dnsquery, recordtype, search=False)
        infomsg(queryrr.rrset)
        if len(queryrr.rrset) > 0:
            for rr in queryrr.rrset:
                foundip = ipaddress.ip_address(rr)
                # infomsg("--> " + str(foundip))
                # infomsg("--> " + str(ipo))
                if str(foundip) == str(ipo):
                    result = True
                    break
    except Exception:
        infomsg("Error resolving " + dnsquery + " " + recordtype)
    return result


async def testentry(ipo, canonical, aliases, searchlist, customresolver):
    result = True
    reason = None

    recordtype = None
    if ipo.version == 4:
        recordtype = "A"
    elif ipo.version == 6:
        recordtype = "AAAA"

    if await testvalue(ipo, canonical, recordtype, customresolver):
        infomsg("Test value is True for " + str(ipo))
        for alias in aliases:
            if await testvalue(ipo, alias, recordtype, customresolver) == False:
                foundusingsearch = False
                for search in searchlist:
                    if await testvalue(ipo, alias + "." + search, recordtype, customresolver):
                        foundusingsearch = True
                        break
                infomsg(alias + " " + str(foundusingsearch))
                if foundusingsearch == False:
                    result = False
                    reason = "Entry not found"
                    break
    else:
        infomsg("Test value is False for " + str(ipo))
        result = False
        reason = "Error in DNS resolving of " + canonical

    return result, reason


async def dohostsfilecall():
    searchlist = await extractsearchlist()
    hosts = await extracthostslist()
    infomsg(searchlist)
    infomsg(hosts)

    allvalid = True
    failing = {}
    customresolver = dns.asyncresolver.Resolver("/etc/resolv.conf")

    for key, value in hosts.items():
        ipo = ipaddress.ip_address(key)
        if (ipo.is_loopback == False) and (ipo.is_private or ipo.is_global) and (ipo.is_reserved == False) and (ipo.is_link_local == False) and (ipo.is_multicast == False):
            infomsg("Evaluating for " + str(ipo))
            canonical = value[0]
            aliases = value[1:]
            valid, reason = await testentry(ipo, canonical, aliases, searchlist, customresolver)
            allvalid = allvalid and valid
            if not valid:
                failing[key] = [value, reason]

    if allvalid:
        exitnagios("OK", "the hosts file seems valid")
    else:
        exitnagios("WARNING", "some lines do not fully conform to specification or do not resolve properly " + str(failing))

# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await dohostsfilecall()

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

