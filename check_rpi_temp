#!/usr/bin/env python
# -------------------------------------------------------------------------------

import os
import sys
import argparse
import asyncio
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug() is True:
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def read_temperature():
    try:
        async with aiofiles.open("/sys/class/thermal/thermal_zone0/temp", "r", encoding="utf-8") as f:
            temp_str = await f.read()
        return float(temp_str.strip()) / 1000.0
    except Exception:
        return None


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Monitor temperature of Raspberry Pi")
    parser.add_argument("-w", "--warning", dest="warn", type=float, default=None, help="Set warning threshold")
    parser.add_argument("-c", "--critical", dest="crit", type=float, default=None, help="Set critical threshold")
    parser.add_argument("-d", "--debug", dest="debug", action="store_true", help="Enable debug output")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    temp = 0.0
    warn = 0.0
    crit = 0.0
    max_temp = 85.0
    min_temp = 0.0

    if args.warn is not None:
        warn = args.warn

    if args.crit is not None:
        crit = args.crit

    temp = await read_temperature()
    if temp is None:
        exitnagios("UNKNOWN", "Unable to read the thermal zone")

    perfdata = " | rpi_temp=" + "{:.2f}".format(temp) + ";" + "{:.2f}".format(warn) + ";" + "{:.2f}".format(crit) + ";" + "{:.2f}".format(min_temp) + ";" + "{:.2f}".format(max_temp)

    if crit > 0 and temp >= crit:
        exitnagios("CRITICAL", "Temperature " + "{:.2f}".format(temp) + " is higher than critical threshold (" + "{:.2f}".format(crit) + ")" + perfdata)
    elif warn > 0 and temp >= warn:
        exitnagios("WARNING", "Temperature " + "{:.2f}".format(temp) + " is higher than warning threshold (" + "{:.2f}".format(warn) + ")" + perfdata)
    else:
        exitnagios("OK", "Temperature " + "{:.2f}".format(temp) + perfdata)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
