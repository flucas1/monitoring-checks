#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check systemd timers and their associated services")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    parser.parse_args(forcedargs)
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Reload the systemd manager configuration
    try:
        proc = await asyncio.create_subprocess_exec(
            "systemctl", "daemon-reload",
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL
        )
        await proc.wait()
    except Exception as e:
        print("Error reloading daemon: " + str(e))
        sys.exit(1)

    # Get the list of enabled unit files, omitting pagers and legends
    list_cmd = [
        "systemctl", "list-unit-files",
        "--state=enabled", "--no-pager",
        "--property=unit_file", "--legend=false"
    ]

    try:
        proc = await asyncio.create_subprocess_exec(
            *list_cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        if proc.returncode != 0:
            print("Error listing unit files: " + stderr.decode().strip())
            sys.exit(1)
        list_result = stdout.decode()
    except Exception as e:
        print("Error listing unit files: " + str(e))
        sys.exit(1)

    # Filter for the first column and items ending in ".timer"
    units = []
    for line in list_result.splitlines():
        if not line.strip():
            continue
        parts = line.split()
        if parts:
            unit = parts[0]
            if unit.endswith(".timer"):
                units.append(unit)

    problematic_services = []

    # Iterate through the timer units to check their corresponding services
    for unit in units:
        # Determine the service name by replacing .timer with .service
        service = unit[:-6] + ".service"

        # Check if the service is enabled
        is_enabled_cmd = ["systemctl", "is-enabled", service]

        try:
            proc = await asyncio.create_subprocess_exec(
                *is_enabled_cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, stderr = await proc.communicate()
            if proc.returncode == 0:
                output = stdout.decode().strip()
                if output == "enabled":
                    problematic_services.append(service)
        except Exception:
            # Ignore errors for individual service checks
            continue

    # Output the final results based on whether any problematic services were found
    if problematic_services:
        result_str = " ".join(problematic_services)
        print("WARNING: There are issues with " + result_str)
        sys.exit(1)
    else:
        print("OK")
        sys.exit(0)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------