#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import subprocess
import sys


def main():
    # Reload the systemd manager configuration
    try:
        subprocess.run(["systemctl", "daemon-reload"], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error reloading daemon: {e}")
        sys.exit(1)

    # Get the list of enabled unit files, omitting pagers and legends
    list_cmd = [
        "systemctl", "list-unit-files",
        "--state=enabled", "--no-pager",
        "--property=unit_file", "--legend=false"
    ]

    try:
        list_result = subprocess.run(list_cmd, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error listing unit files: {e}")
        sys.exit(1)

    # Filter for the first column and items ending in ".timer"
    units = []
    for line in list_result.stdout.splitlines():
        if not line.strip():
            continue
        unit = line.split()[0]
        if unit.endswith(".timer"):
            units.append(unit)

    problematic_services = []

    # Iterate through the timer units to check their corresponding services
    for unit in units:
        # Determine the service name by replacing .timer with .service
        service = unit[:-6] + ".service"

        # Check if the service is enabled
        is_enabled_cmd = ["systemctl", "is-enabled", service]
        # systemctl is-enabled returns a non-zero exit code if the unit is not enabled,
        # so we do not use check=True here.
        is_enabled_result = subprocess.run(is_enabled_cmd, capture_output=True, text=True)

        # If the output specifically equals "enabled", add it to the result list
        if is_enabled_result.stdout.strip() == "enabled":
            problematic_services.append(service)

    # Output the final results based on whether any problematic services were found
    if problematic_services:
        result_str = " ".join(problematic_services)
        print(f"WARNING: There are issues with {result_str}")
        sys.exit(1)
    else:
        print("OK")
        sys.exit(0)


if __name__ == "__main__":
    main()
