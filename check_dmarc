# -------------------------------------------------------------------------------


async def dodnssecverisigncall(domain, proxy):
    try:
        driver = await generatedriver(proxy)

        wait = selenium.webdriver.support.ui.WebDriverWait(driver, 20)
        action = selenium.webdriver.common.action_chains.ActionChains(driver)

        infomsg("browser OK")
        url = "https://app.dmarcanalyzer.com/dns/dmarc_validator?domain=" + domain
        driver.get(url)
        infomsg("asking for navigating " + url)

        await asyncio.sleep(5)
        await wait_page_loaded(driver)
        infomsg("page loaded")

        infomsg("waiting for element")
        wait.until(selenium.webdriver.support.expected_conditions.presence_of_element_located((selenium.webdriver.common.by.By.ID, "dns-results")))

        infomsg("finding base element")
        element = await tryfindbyclassname(driver, "panel-body")
        if len(element) == 0:
            exitnagios("CRITICAL", "no result from page")

        infomsg("finding error message")
        wellsmlist = await tryfindbytagname(driver, "td")
        messages = []
        isValid = False
        isWarning = False
        isError = False
        for wellsmelem in wellsmlist:
            classes = wellsmelem.get_attribute("class").split()
            status = wellsmelem.text.strip()
            if "success" in classes:
                isValid = True
            if "warning" in classes:
                messages.append(status)
                isWarning = True
            if "danger" in classes:
                messages.append(status)
                isError = True
        if isError:
            exitnagios("CRITICAL", " -- ".join(messages))
        elif isWarning:
            exitnagios("WARNING", " -- ".join(messages))
        elif isValid:
            exitnagios("OK", "no issues found")
        else:
            exitnagios("CRITICAL", "unexpected scenario")

    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check " + str(e))

# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--host", dest="host", help="Hostname")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    proxy = ""
    await dodnssecverisigncall(args.host, proxy)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

