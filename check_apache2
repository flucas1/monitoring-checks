#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import re
import sys
import aiohttp
import socket

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def get_connector(protocol):
    if protocol == "-4":
        return aiohttp.TCPConnector(family=socket.AF_INET)
    elif protocol == "-6":
        return aiohttp.TCPConnector(family=socket.AF_INET6)
    else:
        return aiohttp.TCPConnector()


def check_threshold(value, warn, crit):
    status = 0
    try:
        val = float(value)
        if crit:
            if val >= float(crit):
                return 2
        if warn:
            if val >= float(warn):
                status = 1
    except ValueError:
        pass
    return status


async def fetch_status(protocol, url, username, password, verify, timeout):
    headers = { "Authorization": aiohttp.encode_basic_auth(username, password) }
    timeout_obj = aiohttp.ClientTimeout(total=timeout)
    connector = get_connector(protocol)
    async with aiohttp.ClientSession(headers=headers, timeout=timeout_obj, connector=connector) as session:
        async with session.get(url, ssl=verify) as response:
            await response.read() 
            return response


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-H", "--hostname", required=True)
    parser.add_argument("-p", "--port", type=int)
    parser.add_argument("-u", "--uri", default="/server-status?auto")
    parser.add_argument("-U", "--username", default="")
    parser.add_argument("-P", "--password", default="")
    parser.add_argument("-s", "--ssl", action="store_true")
    parser.add_argument("-N", "--no_validate", action="store_true")
    parser.add_argument("-w", "--warning", default="")
    parser.add_argument("-c", "--critical", default="")
    parser.add_argument("-R", "--unreachable", action="store_true")
    parser.add_argument("-t", "--timeout", type=int, default=15)
    parser.add_argument("-d", "--debug", action="store_true")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    warnings_list = args.warning.split(",") if args.warning else []
    criticals = args.critical.split(",") if args.critical else []

    warnings_list += [""] * (6 - len(warnings_list))
    criticals += [""] * (6 - len(criticals))

    if bool(args.username) != bool(args.password):
        exitnagios("UNKNOWN", "If you specify an username, you have to set a password too!")

    proto = "https://" if args.ssl else "http://"
    port_str = ":" + str(args.port) if args.port else ""

    url = proto + args.hostname + port_str + args.uri
    if "?" not in url or not url.endswith("auto"):
        url += "?auto"

    verify = not args.no_validate

    try:
        response = await fetch_status(protocol, url, args.username, args.password, verify, args.timeout)
        if response.status_code >= 500:
            status_prefix = "CRITICAL" if args.unreachable else "UNKNOWN"
            exitnagios(status_prefix, str(response.reason_phrase))
        elif response.status_code != 200:
            exitnagios("CRITICAL", str(response.reason_phrase))
    except asyncio.TimeoutError:
        status_prefix = "CRITICAL" if args.unreachable else "UNKNOWN"
        exitnagios(status_prefix, "plugin timed out")
    except Exception as e:
        exitnagios("CRITICAL", str(e))

    content = response.text

    match = re.search(r"ReqPerSec:\s([0-9\.]+).*?BytesPerSec:\s([0-9\.]+).*?BusyWorkers:\s([0-9]+).*?IdleWorkers:\s([0-9]+).*?Scoreboard:\s(\S*)", content, re.DOTALL)
    if not match:
        exitnagios("UNKNOWN", "No status information found at " + url)

    req_per_sec = match.group(1)
    bytes_per_sec = match.group(2)
    busy_workers = match.group(3)
    idle_workers = match.group(4)
    scoreboard = match.group(5)

    open_slots = scoreboard.count(".") + scoreboard.count("_")

    match_bpr = re.search(r"BytesPerReq:\s([0-9\.]+)", content, re.DOTALL)
    bytes_per_req = match_bpr.group(1) if match_bpr else "0"

    metrics = [
        ("OpenSlots", str(open_slots), warnings_list[0], criticals[0], ""),
        ("BusyWorkers", busy_workers, warnings_list[1], criticals[1], ""),
        ("IdleWorkers", idle_workers, warnings_list[2], criticals[2], ""),
        ("ReqPerSec", req_per_sec, warnings_list[3], criticals[3], ""),
        ("BytesPerSec", bytes_per_sec, warnings_list[4], criticals[4], "B"),
        ("BytesPerReq", bytes_per_req, warnings_list[5], criticals[5], "B")
    ]

    overall_status = 0
    perfdata = []

    for name, val, w, c, uom in metrics:
        st = check_threshold(val, w, c)
        overall_status = max(overall_status, st)
        w_str = w if w else ""
        c_str = c if c else ""
        perfdata.append(name + "=" + str(val) + uom + ";" + str(w_str) + ";" + str(c_str) + ";;")

    output = "OpenSlots:" + str(open_slots) + " BusyWorkers:" + str(busy_workers) + " IdleWorkers:" + str(idle_workers) + " ReqPerSec:" + str(req_per_sec) + " BytesPerSec:" + str(bytes_per_sec) + " BytesPerReq:" + str(bytes_per_req)
    perf_string = " ".join(perfdata)

    if overall_status == 0:
        status_str = "OK"
    elif overall_status == 1:
        status_str = "WARNING"
    elif overall_status == 2:
        status_str = "CRITICAL"
    else:
        status_str = "UNKNOWN"

    exitnagios(status_str, output + " | " + perf_string)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
