SNORT_DB = "snort"
SNORT_DB_HOST = "localhost"
SNORT_DB_PORT = "3306"
SNORT_DB_USER = "snortuser"
SNORT_DB_PASS = "snortpass"

SPOOL_DATA_DIR = "/var/log/nagios"
DEBUG = False
NOW_DATE = datetime.datetime.now().strftime("%Y-%m-%d-%H:%M")
LOG_FILE = SPOOL_DATA_DIR + "/check_snort." + datetime.datetime.now().strftime("%a") + ".log"
HOSTNAME = socket.getfqdn()

INTERVAL = "2"
WARNING_THRESH = 500
CRITICAL_THRESH = 1000
PRIORITY_LEVEL = 3

SNORT_SYSLOG = "/var/log/syslog"
DROPPED_WARNING = 5
DROPPED_CRITICAL = 10
MODUS = ""


def stamp2date(ts):
    return datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")


async def run_mysql_query(query):
    cmd = [
        "mysql", "--skip-column-names",
        "-h", SNORT_DB_HOST,
        "-P", str(SNORT_DB_PORT),
        "-u", SNORT_DB_USER,
        "--password=" + SNORT_DB_PASS,
        "-e", query, SNORT_DB
    ]
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        if proc.returncode != 0:
            infomsg("MySQL Error: " + stderr.decode().strip())
            return 1
        result = stdout.decode().strip()
        return int(result) if result and result != "0" else 1
    except Exception as e:
        infomsg("MySQL Exception: " + str(e))
        return 1


async def get_alert_count(time_diff_seconds, priority_level):
    now = int(time.time())
    time_diff = stamp2date(now - time_diff_seconds)
    query = "select count(*) from event,signature where event.signature=signature.sig_id and signature.sig_priority > '" + str(priority_level - 1) + "' and timestamp(event.timestamp) > '" + time_diff + "';"
    infomsg("get_alert_count -> " + query)

    count = await run_mysql_query(query)
    infomsg("time_diff -> " + time_diff + " / count: -> " + str(count))
    return count


async def get_latest_values(values_log_file):
    if not os.path.isfile(values_log_file):
        try:
            async with aiofiles.open(values_log_file, "a") as f:
                pass
        except IOError:
            pass
        msg = "check_file not found -> " + values_log_file + " (trying to create)"
        infomsg(msg)
        return "WARNING", msg

    try:
        async with aiofiles.open(values_log_file, "r") as f:
            line = (await f.readline()).strip()
            if line:
                parts = [p.strip() for p in line.split(":")]
                last_status = parts[0] if len(parts) > 0 else ""
                if last_status == "SUPERCRITICAL":
                    msg = "critical status found > " + values_log_file + " -> " + line
                    infomsg(msg)
                    return "CRITICAL", msg
    except Exception as e:
        msg = "file read exception -> " + str(e)
        infomsg(msg)
        return "UNKNOWN", msg

    return "OK", ""


async def write_latest_values(values_log_file, status, count_last, avg_avg):
    try:
        async with aiofiles.open(values_log_file, "w") as f:
            await f.write(status + " : " + str(count_last) + " : " + str(avg_avg) + " : " + NOW_DATE + "\n")
    except IOError:
        pass
    infomsg(status + " : " + str(count_last) + " : " + str(avg_avg) + " values_log_file -> " + values_log_file)


async def check_host():
    try:
        proc = await asyncio.create_subprocess_exec(
            "pidof", "snort",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        if proc.returncode != 0:
            return "UNKNOWN", "no pid for snort found _pidof snort_ (sorry)", "", None

        pid_out = stdout.decode().strip()
        snort_pid = int(pid_out.split()[0])
    except Exception as e:
        return "UNKNOWN", "failed to find snort pid: " + str(e), "", None

    try:
        os.kill(snort_pid, signal.SIGUSR1)
        await asyncio.sleep(1)
        proc = await asyncio.create_subprocess_exec(
            "sudo", "tail", "-n", "200", SNORT_SYSLOG,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        if proc.returncode != 0:
            return "UNKNOWN", "failed to read syslog: " + stderr.decode().strip(), "", None

        syslog_lines = stdout.decode().splitlines()
    except Exception as e:
        return "UNKNOWN", "failed to signal snort or read syslog: " + str(e), "", None

    start_stats = False
    received_pckt = 0
    dropped_pckt = 0

    for line in syslog_lines:
        if "snort" not in line:
            continue

        if "Packet Wire Totals" in line:
            start_stats = True

        if start_stats:
            if "Received" in line:
                received_pckt = int(line.split(":")[-1].strip().split()[0])
            elif "Dropped" in line:
                dropped_pckt = int(line.split(":")[-1].strip().split()[0])
            elif "Outstanding" in line:
                break

    if received_pckt == 0:
        return "UNKNOWN", "division by zero in packet stats", "", None

    dropped_perc = int(100 / received_pckt * dropped_pckt)
    perf_data = "dropped_perc=" + str(dropped_perc) + ";" + str(DROPPED_WARNING) + ";" + str(DROPPED_CRITICAL) + "; dropped_total=" + str(dropped_pckt)

    if dropped_perc > DROPPED_CRITICAL:
        status = "CRITICAL"
    elif dropped_perc > DROPPED_WARNING:
        status = "WARNING"
    else:
        status = "OK"

    exit_text = "snort-stats total received: " + str(received_pckt) + ", dropped: " + str(dropped_pckt) + " / " + str(dropped_perc) + " % :: warning: " + str(DROPPED_WARNING) + ", :: critical: " + str(DROPPED_CRITICAL)

    state_to_save = {
        "file": SPOOL_DATA_DIR + "/host_stats.check",
        "last": 1,
        "avg": 1
    }

    return status, exit_text, perf_data, state_to_save


async def check_alerts():
    intervals = {
        "1": (3600, 300, 12, "5min-1hr"),
        "2": (86400, 3600, 24, "1hr-24hr"),
        "3": (604800, 86400, 7, "24hr-7d"),
        "4": (2592000, 604800, 4, "7d-30d"),
        "5": (7776000, 604800, 13, "7d-90d")
    }

    average_alerts, actual_alerts, divider, count_interval = intervals.get(INTERVAL, (86400, 3600, 24, "1hr-24hr"))

    infomsg("\n----[ " + NOW_DATE + " ]-----------------------------------------------\n")

    last_tag, avg_tag = count_interval.split("-")
    values_log_file = SPOOL_DATA_DIR + "/" + str(PRIORITY_LEVEL) + "-" + count_interval + ".check"

    read_status, read_msg = await get_latest_values(values_log_file)
    if read_status != "OK":
        return read_status, read_msg, "", None

    count_last, count_avg = await asyncio.gather(
        get_alert_count(actual_alerts, PRIORITY_LEVEL),
        get_alert_count(average_alerts, PRIORITY_LEVEL)
    )

    avg_avg = count_avg // divider
    if avg_avg == 0:
        avg_avg = 1

    w_limit = avg_avg + int(avg_avg * WARNING_THRESH / 100)
    c_limit = avg_avg + int(avg_avg * CRITICAL_THRESH / 100)

    infomsg("check_options: AVG -> " + str(average_alerts) + " / ACT -> " + str(actual_alerts) + " / INT -> " + count_interval + " / DIV -> " + str(divider))
    infomsg("\nPRIORITY  -> " + str(PRIORITY_LEVEL) + "\nINTERVAL  -> " + count_interval + "\nLAST      -> " + str(count_last) + "\nAVG       -> " + str(count_avg) + "\nAVG_AVG   -> " + str(avg_avg) + "\nw_limit   -> " + str(w_limit) + "\nc_limit   -> " + str(c_limit) + "\n")

    perf_data = last_tag + "=" + str(count_last) + ";" + str(w_limit) + ";" + str(c_limit) + "; " + avg_tag + "=" + str(count_avg) + "; " + avg_tag + "-avg=" + str(avg_avg)

    if count_last > c_limit:
        status = "CRITICAL"
    elif count_last > w_limit:
        status = "WARNING"
    else:
        status = "OK"

    exit_text = "p-" + str(PRIORITY_LEVEL) + " :: " + count_interval + " :: last: " + str(count_last) + " - avg: " + str(avg_avg) + " / thresh: " + str(w_limit) + "/" + str(c_limit) + " [" + str(WARNING_THRESH) + "%/" + str(CRITICAL_THRESH) + "%]"

    state_to_save = {
        "file": values_log_file,
        "last": count_last,
        "avg": avg_avg
    }

    return status, exit_text, perf_data, state_to_save

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-m", dest="modus")
    parser.add_argument("-i", dest="interval", default="2")
    parser.add_argument("-c", dest="critical_thresh", type=int, default=1000)
    parser.add_argument("-w", dest="warning_thresh", type=int, default=500)
    parser.add_argument("-p", dest="priority_level", type=int, default=3)
    parser.add_argument("-s", dest="sid")
    parser.add_argument("-d", dest="debug", action="store_true")
    parser.add_argument("-l", dest="log_file")
    parser.add_argument("-o", dest="spool_data_dir")
    args = parser.parse_args()

    global MODUS, INTERVAL, CRITICAL_THRESH, DROPPED_CRITICAL, WARNING_THRESH, DROPPED_WARNING, PRIORITY_LEVEL, DEBUG, LOG_FILE, SPOOL_DATA_DIR

    MODUS = args.modus
    INTERVAL = args.interval
    CRITICAL_THRESH = args.critical_thresh
    DROPPED_CRITICAL = args.critical_thresh
    WARNING_THRESH = args.warning_thresh
    DROPPED_WARNING = args.warning_thresh
    PRIORITY_LEVEL = args.priority_level
    DEBUG = args.debug

    if args.log_file:
        LOG_FILE = args.log_file
    if args.spool_data_dir:
        SPOOL_DATA_DIR = args.spool_data_dir
        LOG_FILE = SPOOL_DATA_DIR + "/check_snort." + datetime.datetime.now().strftime("%a") + ".log"

    if not os.path.isdir(SPOOL_DATA_DIR):
        infomsg("\n> error no output_dir given/created; run\n> $ mkdir -p " + SPOOL_DATA_DIR + " && chown nagios:nagios " + SPOOL_DATA_DIR + "\n> to create that dir\n")
        exitnagios("UNKNOWN", "[" + str(MODUS) + "] SPOOL_DATA_DIR not found -> " + SPOOL_DATA_DIR)

    if MODUS == "host":
        status, exit_text, perf_data, state_to_save = await check_host()
    elif MODUS == "alerts":
        status, exit_text, perf_data, state_to_save = await check_alerts()
    else:
        exitnagios("UNKNOWN", "no modus selected (use -m switch)")

    if state_to_save:
        await write_latest_values(state_to_save["file"], status, state_to_save["last"], state_to_save["avg"])

    infomsg(NOW_DATE + " :: " + status + "  :: " + exit_text + "  :perfdata: " + perf_data)

    perf_str = " | " + perf_data if perf_data else ""
    final_message = "[" + str(MODUS) + "] " + exit_text + perf_str
    exitnagios(status, final_message)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

