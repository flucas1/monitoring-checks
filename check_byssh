#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import socket
import sys
import argparse
import asyncio
import asyncssh

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def execute_ssh_command(conn_kwargs, remotecmdline):
    async with asyncssh.connect(**conn_kwargs) as conn:
        return await conn.run(remotecmdline, check=False)


async def dobysshcheck(family, hostname, timeoutvalue, timeoutstatus, remotecmdline, key, login, autoaccept):
    retries = 3
    counter = 0

    conn_kwargs = {
        "host": hostname,
        "username": login,
        "family": family
    }

    if key != "" and key is not None:
        conn_kwargs["client_keys"] = [key]
        conn_kwargs["password"] = None

    if autoaccept:
        conn_kwargs["known_hosts"] = None

    status_map = {0: "OK", 1: "WARNING", 2: "CRITICAL", 3: "UNKNOWN"}
    while True:
        infomsg("executing retry " + str(counter))
        counter = counter + 1

        try:
            result = await asyncio.wait_for(execute_ssh_command(conn_kwargs, remotecmdline), timeout=timeoutvalue)
            output = result.stdout.strip() if result.stdout else ""
            errors = result.stderr.strip() if result.stderr else ""
            exitcode = result.exit_status

            if exitcode in [0, 1, 2, 3]:
                if output != "":
                    parts = output.split(": ", 1)
                    if len(parts) > 1:
                        candidate = parts[0]
                        if candidate in ["OK", "WARNING", "CRITICAL", "UNKNOWN"]:
                            status = candidate
                            message = parts[1]
                        else:
                            status = status_map[exitcode]
                            message = parts[0].lower() + " - " + parts[1]
                    else:
                        status = status_map[exitcode]
                        message = output
                    if errors != "":
                        message = message + " - " + errors
                    exitnagios(status, message)
                else:
                    exitnagios("UNKNOWN", output + " - " + errors)
            else:
                exitnagios("UNKNOWN", output + " - " + errors)

        except asyncio.TimeoutError:
            exitnagios(timeoutstatus, "Plugin timed out")
        except (OSError, asyncssh.Error) as exc:
            errors = str(exc)
            output = "SSH connection failed"
            if counter > retries:
                exitnagios(timeoutstatus, output + " - " + errors)
            else:
                infomsg("sleeping for retry " + str(counter))
                await asyncio.sleep(10)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="server to check")
    parser.add_argument("-t", "--timeout", dest="timeout", default="30:CRITICAL", help="timeout value:STATUS")
    parser.add_argument("-i", "--key", dest="key", default="", help="ssh key to use")
    parser.add_argument("-l", "--login", dest="login", default="", help="username for login")
    parser.add_argument("-C", "--remotecmdline", dest="remotecmdline", default="", help="remote commandline to execute")
    parser.add_argument("-a", "--autoaccept", action="store_true", dest="autoaccept", default=False, help="accept all remote keys")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    family = socket.AF_UNSPEC
    exclist = 0
    if args.ipv0 == True:
        family = socket.AF_UNSPEC
        exclist = exclist + 1
    if args.ipv4 == True:
        family = socket.AF_INET
        exclist = exclist + 1
    if args.ipv6 == True:
        family = socket.AF_INET6
        exclist = exclist + 1

    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    if (args.hostname == ""):
        exitnagios("CRITICAL", "hostname not defined")

    if (args.remotecmdline == ""):
        exitnagios("CRITICAL", "remote cmdline not defined")

    if (args.login == ""):
        exitnagios("CRITICAL", "login not defined")

    parts = args.timeout.split(":")
    timeoutvalue = int(parts[0])
    if len(parts) > 1:
        timeoutstatus = parts[1]
    else:
        timeoutstatus = "CRITICAL"

    if timeoutstatus in ["OK", "WARNING", "CRITICAL", "UNKNOWN"]:
        await dobysshcheck(family, args.hostname, timeoutvalue, timeoutstatus, args.remotecmdline, args.key, args.login, args.autoaccept)
    else:
        exitnagios("CRITICAL", "timeout status is not valid")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
