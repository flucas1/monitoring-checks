#!/usr/bin/env python3
#-------------------------------------------------------------------------------

import sys
import asyncio
import argparse
import samba.param
import samba.credentials
import samba.netcmd.drs
import samba.netcmd.common
import samba.dcerpc.drsuapi

#-------------------------------------------------------------------------------

_candebug = False
def candebug():
    global _candebug
    return _candebug

def setcandebug(value):
    global _candebug
    _candebug = value

def infomsg(msg):
    if candebug():
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(f"{status}: {message}", flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

async def dosmbreplicationcall():
    failures = False
    msg = ""
    try:
        lp = samba.param.LoadParm()
        lp.load_default()
        creds = samba.credentials.Credentials()
        creds.guess(lp)
        creds.set_machine_account(lp)
        server = samba.netcmd.common.netcmd_dnsname(lp)

        consecutive_sync_failures = dict()
        drsuapi_handle = await asyncio.to_thread(samba.netcmd.drs.drsuapi_connect, server, lp, creds)
        req1 = samba.dcerpc.drsuapi.DsReplicaGetInfoRequest1()
        req1.info_type = samba.dcerpc.drsuapi.DRSUAPI_DS_REPLICA_INFO_REPSTO
        (info_type, info) = await asyncio.to_thread(drsuapi_handle.DsReplicaGetInfo, 1, req1)
        for n in info.array:
            if n.consecutive_sync_failures > 0:
                failures = True
                (site, server) = samba.netcmd.drs.drs_parse_ntds_dn(n.source_dsa_obj_dn)
                if server not in consecutive_sync_failures:
                    consecutive_sync_failures[server] = 0
                consecutive_sync_failures[server] += n.consecutive_sync_failures
        for server in consecutive_sync_failures:
            text = f"{consecutive_sync_failures[server]} failures on {server}"
            msg = f"{msg}, {text}" if msg else text
    except RuntimeError as error:
        exitnagios("CRITICAL", str(error))
    except Exception as ex:
        exitnagios("CRITICAL", str(ex))

    if failures:
        exitnagios("CRITICAL", msg)
    else:
        exitnagios("OK", "no drs failures")

#-------------------------------------------------------------------------------

def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args

async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await dosmbreplicationcall()

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

#-------------------------------------------------------------------------------
