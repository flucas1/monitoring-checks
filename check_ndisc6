#!/usr/bin/env python3
#-------------------------------------------------------------------------------

import argparse
import sys
import os
import asyncio

#-------------------------------------------------------------------------------

_candebug = False
def setcandebug(value):
    global _candebug
    _candebug = value
def candebug():
    global _candebug
    return _candebug

def infomsg(msg):
    if candebug() == True:
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status=="OK":
        exitcode = 0
    elif status=="WARNING":
        exitcode = 1
    elif status=="CRITICAL":
        exitcode = 2
    elif status=="UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status,message):
    exitcode = mapstatustoexitcode(status)
    print(status+": "+message, flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

async def dondisc6call(hostname):
    cmdline = ["/usr/bin/ip","route","get",hostname]
    process = await asyncio.create_subprocess_exec(*cmdline, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8")
    errors = stderr.decode("utf-8")
    response = process.returncode
    infomsg(output)
    interface = None
    if response == 0:
        routeparts = output.split()
        if len(routeparts)>4:
            interface = routeparts[4]
    if interface == None:
        exitnagios("CRITICAL","Cannot identify interface for discovery")
    infomsg("interface -> "+interface)

    cmdline = ["/usr/bin/ndisc6",hostname,interface]
    process = await asyncio.create_subprocess_exec(*cmdline, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8")
    errors = stderr.decode("utf-8")
    response = process.returncode
    infomsg(output)
    macfound = None
    if response == 0:
        alllines = output.splitlines()
        if len(alllines)>1:
            line = alllines[1]
            infomsg(line)
            parts = line.split()
            if len(parts)>3:
                macfound = parts[3]
                infomsg(macfound)

    if macfound!=None:
        exitnagios("OK",hostname+" is responding to NDD with mac "+macfound)
    else:
        exitnagios("CRITICAL",hostname+" is not responding to NDD")

#-------------------------------------------------------------------------------

#collect arguments
def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname",          action="store",                                                                              help="target IP or hostname")
    parser.add_argument("-®", "--debug",             action="store_true",  dest="debug",            default=False,                                help="be more verbose")
    args = parser.parse_args(forcedargs)

    return args

async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if not args.hostname:
        exitnagios("CRITICAL","Must give a hostname.")

    await dondisc6call(args.hostname)

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

