#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import os
import argparse
import sys
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def parse_args():
    parser = argparse.ArgumentParser(description="Detect files with Windows line endings.")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="Enable debug output")
    return parser.parse_args()

# -------------------------------------------------------------------------------


async def is_text_file_with_windows_endings(file_path):
    """Return True if the file is text and contains Windows line endings (CRLF)."""
    try:
        cmdline = ["file", "--brief", file_path]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        return "CRLF" in output
    except Exception:
        return False

# -------------------------------------------------------------------------------


async def scan_directory(path, debug):
    """Scan a directory recursively for text files with Windows line endings."""
    found_files = []

    for root, dirs, files in os.walk(path, followlinks=False):
        # Skip symbolic link directories
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        for file in files:
            full_path = os.path.join(root, file)
            # Skip symbolic link files
            if os.path.islink(full_path):
                continue
            if await is_text_file_with_windows_endings(full_path):
                found_files.append(full_path)
                infomsg(full_path)

    return found_files

# -------------------------------------------------------------------------------


async def main():
    args = parse_args()
    all_found_files = []

    paths_to_check = ["/etc"]
    for path in paths_to_check:
        found_files = await scan_directory(path, args.debug)
        all_found_files.extend(found_files)

    if len(all_found_files) > 0:
        exitnagios("CRITICAL", "Files with Windows line endings: " + str(all_found_files))
    else:
        exitnagios("OK", "No files with Windows line endings found")

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
