#!/usr/bin/env python3
#-------------------------------------------------------------------------------

import os
import subprocess
import argparse
import sys

#-------------------------------------------------------------------------------

_candebug = False
def candebug():
    global _candebug
    return _candebug
def setcandebug(value):
    global _candebug
    _candebug = value

def infomsg(msg):
    if candebug() == True:
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status=="OK":
        exitcode = 0
    elif status=="WARNING":
        exitcode = 1
    elif status=="CRITICAL":
        exitcode = 2
    elif status=="UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status,message):
    exitcode = mapstatustoexitcode(status)
    print(status+": "+message, flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

def parse_args():
    parser = argparse.ArgumentParser(description="Detect files with Windows line endings.")
    parser.add_argument("--debug", action="store_true", help="Enable debug output")
    return parser.parse_args()

#-------------------------------------------------------------------------------

def is_text_file_with_windows_endings(file_path):
    """Return True if the file is text and contains Windows line endings (CRLF)."""
    try:
        result = subprocess.run(
            ["file", "--brief", file_path],
            capture_output=True,
            text=True
        )
        output = result.stdout.strip()
        return "CRLF" in output
    except Exception:
        return False

#-------------------------------------------------------------------------------

def scan_directory(path,debug):
    """Scan a directory recursively for text files with Windows line endings."""
    found_files = []

    for root, dirs, files in os.walk(path, followlinks=False):
        # Skip symbolic link directories
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        for file in files:
            full_path = os.path.join(root, file)
            # Skip symbolic link files
            if os.path.islink(full_path):
                continue
            if is_text_file_with_windows_endings(full_path):
                found_files.append(full_path)
                infomsg(full_path)

    return found_files

#-------------------------------------------------------------------------------

def main():
    args = parse_args()
    all_found_files = []

    paths_to_check = ["/etc"]
    for path in paths_to_check:
        found_files = scan_directory(path,args.debug)
        all_found_files.extend(found_files)

    if len(all_found_files)>0:
        exitnagios("ERROR", "Files with Windows line endings: "+str(all_found_files))
    else:
        exitnagios("OK", "No files with Windows line endings found")

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    main()

#-------------------------------------------------------------------------------

