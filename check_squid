#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import subprocess
import sys
import re

STATUS_OK = 0
STATUS_WARNING = 1
STATUS_CRITICAL = 2
STATUS_UNKNOWN = 3

def parse_threshold(thresh_str):
    if not thresh_str:
        return None, None, False
    thresh_str = str(thresh_str).strip()
    if thresh_str.startswith('@'):
        inclusive = True
        thresh_str = thresh_str[1:]
    else:
        inclusive = False
    
    if ':' in thresh_str:
        start_str, end_str = thresh_str.split(':', 1)
        start = float(start_str) if start_str else 0.0
        end = float(end_str) if end_str else float('inf')
    else:
        start = 0.0
        end = float(thresh_str) if thresh_str else float('inf')
        
    return start, end, inclusive

def check_threshold(value, warning, critical):
    value = float(value)
    
    if critical:
        c_start, c_end, c_inc = parse_threshold(critical)
        if c_inc:
            if c_start <= value <= c_end:
                return STATUS_CRITICAL
        else:
            if value < c_start or value > c_end:
                return STATUS_CRITICAL

    if warning:
        w_start, w_end, w_inc = parse_threshold(warning)
        if w_inc:
            if w_start <= value <= w_end:
                return STATUS_WARNING
        else:
            if value < w_start or value > w_end:
                return STATUS_WARNING

    return STATUS_OK

def exit_plugin(status, message, perfdata=""):
    status_text = {0: "OK", 1: "WARNING", 2: "CRITICAL", 3: "UNKNOWN"}.get(status, "UNKNOWN")
    if perfdata:
        print(f"{status_text} - {message} | {perfdata}")
    else:
        print(f"{status_text} - {message}")
    sys.exit(status)

def main():
    parser = argparse.ArgumentParser(usage="%(prog)s [ -H <host> ] [ -f <filename> ] [ -d <data> ] [ -p <port> ] [ -t <timeout>] [ -c <threshold> ] [ -w <threshold> ]")
    parser.add_argument('-H', '--host', default='localhost')
    parser.add_argument('-f', '--filecreds')
    parser.add_argument('-d', '--data', default='Connections')
    parser.add_argument('-p', '--port', type=int, default=3128)
    parser.add_argument('-U', '--user', default='root')
    parser.add_argument('-W', '--password', default='')
    parser.add_argument('-w', '--warning')
    parser.add_argument('-c', '--critical')
    parser.add_argument('-s', '--squidclient', default='/usr/bin/squidclient')
    
    args = parser.parse_args()[cite: 1]
    
    host = args.host
    port = args.port
    data_type = args.data
    user = args.user
    password = args.password
    warning = args.warning
    critical = args.critical
    squidclient = args.squidclient
    
    if args.filecreds:
        try:
            with open(args.filecreds, 'r') as f:
                lines = f.read().split('\n')
                if len(lines) > 0: user = lines[0]
                if len(lines) > 1: password = lines[1]
        except Exception as e:
            exit_plugin(STATUS_CRITICAL, f"Could not open {args.filecreds} for reading: {e}")

    cmd = [squidclient, '-h', host, '-p', str(port), '-U', user, '-W', password, 'mgr:info'][cite: 1]
    
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)[cite: 1]
        output = result.stdout
    except subprocess.CalledProcessError:
        exit_plugin(STATUS_CRITICAL, f"error executing {squidclient}")
    except FileNotFoundError:
        exit_plugin(STATUS_CRITICAL, f"error executing {squidclient}")

    parsed_data = {}
    
    for line in output.splitlines():
        m = re.search(r'\s+Number of clients accessing cache:\s+([0-9]+)', line)[cite: 1]
        if m: parsed_data['connection_nbclient'] = m.group(1)
        
        m = re.search(r'\s+Number of HTTP requests received:\s+([0-9]+)', line)
        if m: parsed_data['connection_nbhttpreceived'] = m.group(1)
        
        m = re.search(r'\s+Number of ICP messages received:\s+([0-9]+)', line)
        if m: parsed_data['connection_nbicpreceived'] = m.group(1)
        
        m = re.search(r'\s+Number of ICP messages sent:\s+([0-9]+)', line)
        if m: parsed_data['connection_nbicpsent'] = m.group(1)
        
        m = re.search(r'\s+Number of queued ICP replies:\s+([0-9]+)', line)
        if m: parsed_data['connection_nbicpqueued'] = m.group(1)
        
        m = re.search(r'\s+Request Hit Ratios:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%', line)
        if m: 
            parsed_data['cache_requesthitratio5'] = m.group(1)
            parsed_data['cache_requesthitratio60'] = m.group(2)
            
        m = re.search(r'\s+Byte Hit Ratios:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%', line)
        if m:
            parsed_data['cache_bytehitratio5'] = m.group(1)
            parsed_data['cache_bytehitratio60'] = m.group(2)

        m = re.search(r'\s+Hits as % of all requests:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%', line)
        if m:
            parsed_data['cache_requesthitratio5'] = m.group(1)
            parsed_data['cache_requesthitratio60'] = m.group(2)

        m = re.search(r'\s+Hits as % of bytes sent:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%', line)
        if m:
            parsed_data['cache_bytehitratio5'] = m.group(1)
            parsed_data['cache_bytehitratio60'] = m.group(2)
            
        m = re.search(r'\s+CPU Usage:\s+([0-9\.]+)%', line)[cite: 1]
        if m: parsed_data['resource_cpu5s'] = m.group(1)
        
        m = re.search(r'\s+CPU Usage, 5 minute avg:\s+([0-9\.]+)%', line)
        if m: parsed_data['resource_cpu5m'] = m.group(1)
        
        m = re.search(r'\s+CPU Usage, 60 minute avg:\s+([0-9\.]+)%', line)
        if m: parsed_data['resource_cpu60m'] = m.group(1)
        
        m = re.search(r'\s+Total in use:\s+([0-9]+)', line)
        if m: parsed_data['memory_used'] = m.group(1)
        
        m = re.search(r'\s+Total size:\s+([0-9]+)', line)
        if m: parsed_data['memory_available'] = m.group(1)
        
        m = re.search(r'\s+Maximum number of file descriptors:\s+([0-9]+)', line)
        if m: parsed_data['fd_available'] = m.group(1)
        
        m = re.search(r'\s+Number of file desc currently in use:\s+([0-9]+)', line)
        if m: parsed_data['fd_used'] = m.group(1)

    if re.search(r'Connections', data_type, re.IGNORECASE):[cite: 1]
        if 'connection_nbclient' not in parsed_data:
            exit_plugin(STATUS_CRITICAL, 'cannot parse connections data')
        else:
            msg = f"Squid have {parsed_data['connection_nbclient']} clients and {parsed_data.get('connection_nbicpqueued', 0)} ICP requests queued"
            perf = f"'HTTP requests'={parsed_data.get('connection_nbhttpreceived', 0)}c 'sent ICP requests'={parsed_data.get('connection_nbicpsent', 0)}c 'received ICP requests'={parsed_data.get('connection_nbicpreceived', 0)}c"
            exit_plugin(STATUS_OK, msg, perf)

    elif re.search(r'Cache', data_type, re.IGNORECASE):
        if 'cache_requesthitratio5' not in parsed_data:
            exit_plugin(STATUS_CRITICAL, 'cannot parse cache data')
        else:
            msg = f"Requests Hit Ratio 5min: {parsed_data['cache_requesthitratio5']}, Requests Hit Ratio 60min: {parsed_data['cache_requesthitratio60']}, Byte Hit Ratio 5min: {parsed_data['cache_bytehitratio5']}, Byte Hit Ratio 60min: {parsed_data['cache_bytehitratio60']}"
            perf = f"'Requests Hit Ratio 5min'={parsed_data['cache_requesthitratio5']}% 'Requests Hit Ratio 60min'={parsed_data['cache_requesthitratio60']}% 'Byte Hit Ratio 5min'={parsed_data['cache_bytehitratio5']}% 'Byte Hit Ratio 60min'={parsed_data['cache_bytehitratio60']}%"
            exit_plugin(STATUS_OK, msg, perf)

    elif re.search(r'Resources', data_type, re.IGNORECASE):
        if 'resource_cpu5s' not in parsed_data:
            exit_plugin(STATUS_CRITICAL, 'cannot parse resources data')
        else:
            msg = f"CPU used 5s: {parsed_data['resource_cpu5s']}, CPU used 5m: {parsed_data.get('resource_cpu5m', 0)}, CPU used 60m: {parsed_data.get('resource_cpu60m', 0)}"
            perf = f"'CPU used 5s'={parsed_data['resource_cpu5s']}% 'CPU used 5m'={parsed_data.get('resource_cpu5m', 0)}% 'CPU used 60m'={parsed_data.get('resource_cpu60m', 0)}%"
            exit_plugin(STATUS_OK, msg, perf)

    elif re.search(r'Memory', data_type, re.IGNORECASE):
        if 'memory_used' not in parsed_data:
            exit_plugin(STATUS_CRITICAL, 'cannot parse memory data')
        else:
            val = parsed_data['memory_used']
            status = check_threshold(val, warning, critical)
            msg = f"Squid use {val} KB of memory"
            perf = f"'Memory used'={val}KB;{warning or ''};{critical or ''} 'Memory available'={parsed_data.get('memory_available', 0)}KB"
            exit_plugin(status, msg, perf)

    elif re.search(r'FileDescriptors', data_type, re.IGNORECASE):
        if 'fd_used' not in parsed_data:
            exit_plugin(STATUS_CRITICAL, 'cannot parse filedescriptors data')
        else:
            val = parsed_data['fd_used']
            status = check_threshold(val, warning, critical)
            msg = "Squid work fine."
            perf = f"'Max FD'={parsed_data.get('fd_available', 0)} 'Cur FD'={val};{warning or ''};{critical or ''}"
            exit_plugin(status, msg, perf)

if __name__ == '__main__':
    main()