#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys
import re
import aiofiles


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_threshold(thresh_str):
    if not thresh_str:
        return None, None, False
    thresh_str = str(thresh_str).strip()
    if thresh_str.startswith("@"):
        inclusive = True
        thresh_str = thresh_str[1:]
    else:
        inclusive = False

    if ":" in thresh_str:
        start_str, end_str = thresh_str.split(":", 1)
        start = float(start_str) if start_str else 0.0
        end = float(end_str) if end_str else float("inf")
    else:
        start = 0.0
        end = float(thresh_str) if thresh_str else float("inf")

    return start, end, inclusive


def check_threshold(value, warning, critical):
    value = float(value)

    if critical:
        c_start, c_end, c_inc = parse_threshold(critical)
        if c_inc:
            if c_start <= value <= c_end:
                return "CRITICAL"
        else:
            if value < c_start or value > c_end:
                return "CRITICAL"

    if warning:
        w_start, w_end, w_inc = parse_threshold(warning)
        if w_inc:
            if w_start <= value <= w_end:
                return "WARNING"
        else:
            if value < w_start or value > w_end:
                return "WARNING"

    return "OK"


async def run_squidclient(squidclient, host, port, user, password):
    cmdline = [squidclient, "-h", host, "-p", str(port), "-U", user, "-W", password, "mgr:info"]
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()

    if process.returncode != 0:
        raise RuntimeError("Command failed with return code " + str(process.returncode))

    return stdout.decode("utf-8")


async def read_credentials(file_path):
    try:
        async with aiofiles.open(file_path, "rb") as f:
            content = await f.read()
            lines = content.decode("utf-8").strip().splitlines()
            user = lines[0] if len(lines) > 0 else ""
            password = lines[1] if len(lines) > 1 else ""
            return user, password
    except Exception as e:
        exitnagios("CRITICAL", "Could not open " + str(file_path) + " for reading: " + str(e))


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--host", default="localhost")
    parser.add_argument("-f", "--filecreds")
    parser.add_argument("-t", "--data", default="Connections")
    parser.add_argument("-p", "--port", type=int, default=3128)
    parser.add_argument("-U", "--user", default="root")
    parser.add_argument("-W", "--password", default="")
    parser.add_argument("-w", "--warning")
    parser.add_argument("-c", "--critical")
    parser.add_argument("-d", "--debug", action="store_true")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    host = args.host
    port = args.port
    data_type = args.data
    user = args.user
    password = args.password
    warning = args.warning
    critical = args.critical
    squidclient = "/usr/bin/squidclient"

    if args.filecreds:
        user, password = await read_credentials(args.filecreds)

    try:
        output = await run_squidclient(squidclient, host, port, user, password)
    except Exception as e:
        exitnagios("CRITICAL", "error executing " + str(squidclient) + ": " + str(e))

    parsed_data = {}

    for line in output.splitlines():
        m = re.search(r"\s+Number of clients accessing cache:\s+([0-9]+)", line)
        if m:
            parsed_data["connection_nbclient"] = m.group(1)

        m = re.search(r"\s+Number of HTTP requests received:\s+([0-9]+)", line)
        if m:
            parsed_data["connection_nbhttpreceived"] = m.group(1)

        m = re.search(r"\s+Number of ICP messages received:\s+([0-9]+)", line)
        if m:
            parsed_data["connection_nbicpreceived"] = m.group(1)

        m = re.search(r"\s+Number of ICP messages sent:\s+([0-9]+)", line)
        if m:
            parsed_data["connection_nbicpsent"] = m.group(1)

        m = re.search(r"\s+Number of queued ICP replies:\s+([0-9]+)", line)
        if m:
            parsed_data["connection_nbicpqueued"] = m.group(1)

        m = re.search(r"\s+Request Hit Ratios:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["cache_requesthitratio5"] = m.group(1)
            parsed_data["cache_requesthitratio60"] = m.group(2)

        m = re.search(r"\s+Byte Hit Ratios:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["cache_bytehitratio5"] = m.group(1)
            parsed_data["cache_bytehitratio60"] = m.group(2)

        m = re.search(r"\s+Hits as % of all requests:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["cache_requesthitratio5"] = m.group(1)
            parsed_data["cache_requesthitratio60"] = m.group(2)

        m = re.search(r"\s+Hits as % of bytes sent:\s+5min:\s+([0-9\.]+)%,\s+60min:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["cache_bytehitratio5"] = m.group(1)
            parsed_data["cache_bytehitratio60"] = m.group(2)

        m = re.search(r"\s+CPU Usage:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["resource_cpu5s"] = m.group(1)

        m = re.search(r"\s+CPU Usage, 5 minute avg:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["resource_cpu5m"] = m.group(1)

        m = re.search(r"\s+CPU Usage, 60 minute avg:\s+([0-9\.]+)%", line)
        if m:
            parsed_data["resource_cpu60m"] = m.group(1)

        m = re.search(r"\s+Total in use:\s+([0-9]+)", line)
        if m:
            parsed_data["memory_used"] = m.group(1)

        m = re.search(r"\s+Total size:\s+([0-9]+)", line)
        if m:
            parsed_data["memory_available"] = m.group(1)

        m = re.search(r"\s+Maximum number of file descriptors:\s+([0-9]+)", line)
        if m:
            parsed_data["fd_available"] = m.group(1)

        m = re.search(r"\s+Number of file desc currently in use:\s+([0-9]+)", line)
        if m:
            parsed_data["fd_used"] = m.group(1)

    if re.search(r"Connections", data_type, re.IGNORECASE):
        if "connection_nbclient" not in parsed_data:
            exitnagios("CRITICAL", "cannot parse connections data")
        else:
            msg = "Squid have " + str(parsed_data["connection_nbclient"]) + " clients and " + str(parsed_data.get("connection_nbicpqueued", 0)) + " ICP requests queued"
            perf = "\"HTTP requests\"=" + str(parsed_data.get("connection_nbhttpreceived", 0)) + "c \"sent ICP requests\"=" + str(parsed_data.get("connection_nbicpsent", 0)) + "c \"received ICP requests\"=" + str(parsed_data.get("connection_nbicpreceived", 0)) + "c"
            exitnagios("OK", msg + " | " + perf)

    elif re.search(r"Cache", data_type, re.IGNORECASE):
        if "cache_requesthitratio5" not in parsed_data:
            exitnagios("CRITICAL", "cannot parse cache data")
        else:
            msg = "Requests Hit Ratio 5min: " + str(parsed_data["cache_requesthitratio5"]) + ", Requests Hit Ratio 60min: " + str(parsed_data["cache_requesthitratio60"]) + ", Byte Hit Ratio 5min: " + str(parsed_data["cache_bytehitratio5"]) + ", Byte Hit Ratio 60min: " + str(parsed_data["cache_bytehitratio60"])
            perf = "\"Requests Hit Ratio 5min\"=" + str(parsed_data["cache_requesthitratio5"]) + "% \"Requests Hit Ratio 60min\"=" + str(parsed_data["cache_requesthitratio60"]) + "% \"Byte Hit Ratio 5min\"=" + str(parsed_data["cache_bytehitratio5"]) + "% \"Byte Hit Ratio 60min\"=" + str(parsed_data["cache_bytehitratio60"]) + "%"
            exitnagios("OK", msg + " | " + perf)

    elif re.search(r"Resources", data_type, re.IGNORECASE):
        if "resource_cpu5s" not in parsed_data:
            exitnagios("CRITICAL", "cannot parse resources data")
        else:
            msg = "CPU used 5s: " + str(parsed_data["resource_cpu5s"]) + ", CPU used 5m: " + str(parsed_data.get("resource_cpu5m", 0)) + ", CPU used 60m: " + str(parsed_data.get("resource_cpu60m", 0))
            perf = "\"CPU used 5s\"=" + str(parsed_data["resource_cpu5s"]) + "% \"CPU used 5m\"=" + str(parsed_data.get("resource_cpu5m", 0)) + "% \"CPU used 60m\"=" + str(parsed_data.get("resource_cpu60m", 0)) + "%"
            exitnagios("OK", msg + " | " + perf)

    elif re.search(r"Memory", data_type, re.IGNORECASE):
        if "memory_used" not in parsed_data:
            exitnagios("CRITICAL", "cannot parse memory data")
        else:
            val = parsed_data["memory_used"]
            status = check_threshold(val, warning, critical)
            msg = "Squid use " + str(val) + " KB of memory"
            warn_str = str(warning) if warning else ""
            crit_str = str(critical) if critical else ""
            perf = "\"Memory used\"=" + str(val) + "KB;" + warn_str + ";" + crit_str + " \"Memory available\"=" + str(parsed_data.get("memory_available", 0)) + "KB"
            exitnagios(status, msg + " | " + perf)

    elif re.search(r"FileDescriptors", data_type, re.IGNORECASE):
        if "fd_used" not in parsed_data:
            exitnagios("CRITICAL", "cannot parse filedescriptors data")
        else:
            val = parsed_data["fd_used"]
            status = check_threshold(val, warning, critical)
            msg = "Squid work fine."
            warn_str = str(warning) if warning else ""
            crit_str = str(critical) if critical else ""
            perf = "\"Max FD\"=" + str(parsed_data.get("fd_available", 0)) + " \"Cur FD\"=" + str(val) + ";" + warn_str + ";" + crit_str
            exitnagios(status, msg + " | " + perf)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
