async def douptimecall(host, username, password, warn_low, warn_high, crit_low, crit_high, timeoutvalue, timeoutstatus, protocol):
    url, headers = await doasusroutercall(host, username, password, timeoutvalue, protocol)
    uptime = await get_uptime_secs(url, headers, timeoutvalue, protocol)
    if uptime is not None:
        infomsg(uptime)
        check_status(uptime, warn_low, warn_high, crit_low, crit_high)
    else:
        exitnagios(timeoutstatus, "unable to retrieve the value | value=-1")


async def domemorycall(host, username, password, warn_low, warn_high, crit_low, crit_high, timeoutvalue, timeoutstatus, protocol):
    url, headers = await doasusroutercall(host, username, password, timeoutvalue, protocol)
    memory = await get_memory_usage(url, headers, timeoutvalue, protocol)
    if memory is not None:
        value = (int(memory["mem_used"]) / int(memory["mem_total"])) * 100
        infomsg(value)
        check_status(round(value, 2), warn_low, warn_high, crit_low, crit_high)
    else:
        exitnagios(timeoutstatus, "unable to retrieve the value | value=-1")


async def docpucall(host, username, password, warn_low, warn_high, crit_low, crit_high, timeoutvalue, timeoutstatus, protocol):
    url, headers = await doasusroutercall(host, username, password, timeoutvalue, protocol)
    cpu = await get_cpu_usage(url, headers, timeoutvalue, protocol)
    if cpu is not None:
        cores = int(len(cpu) / 2)
        infomsg(cores)
        counter = 1
        values = []
        while counter <= cores:
            temp = (int(cpu["cpu" + str(counter) + "_usage"]) / int(cpu["cpu" + str(counter) + "_total"])) * 100
            values.append(temp)
            counter = counter + 1
        infomsg(values)
        added = 0
        for value in values:
            added = added + value
        average = added / len(values)
        infomsg(average)
        check_status(round(average, 2), warn_low, warn_high, crit_low, crit_high)
    else:
        exitnagios(timeoutstatus, "unable to retrieve the value | value=-1")

