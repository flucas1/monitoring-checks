async def get_online_clients(url, headers):
    clnts = await get_clients_fullinfo(url, headers)
    if clnts is None:
        return None
    else:
        infomsg(clnts)
        lst = []
        for c in clnts['get_clientlist']:
            if (len(c) == 17) and ("isOnline" in clnts['get_clientlist'][c]) and (clnts['get_clientlist'][c]['isOnline'] == '1'):
                lst.append({"mac": c})
