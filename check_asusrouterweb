async def doasusroutercall(hostname, username, password, timeoutvalue, protocol):
    try:
        url, headers = await authenticate(hostname, username, password, timeoutvalue, protocol)
        if headers is None:
            raise Exception("Authentication Failed")

        infomsg("Router URL: " + url)
        infomsg("Uptime    : " + str(await get_uptime_secs(url, headers, timeoutvalue, protocol)))
        infomsg("Memory    : " + str(await get_memory_usage(url, headers, timeoutvalue, protocol)))
        infomsg("CPU       : " + str(await get_cpu_usage(url, headers, timeoutvalue, protocol)))
        infomsg("Data      : " + str(await get_traffic_total(url, headers, timeoutvalue, protocol)))
        infomsg("Settings  : " + str(await get_settings(url, headers, timeoutvalue, protocol)))
        infomsg("Uptime    : " + str(await get_uptime(url, headers, timeoutvalue, protocol)))
        infomsg("Online    : " + str(await is_wan_online(url, headers, timeoutvalue, protocol)))
        infomsg("Clients   : " + str(await get_clients_fullinfo(url, headers, timeoutvalue, protocol)))
        infomsg("Clients   : " + str(await get_clients_info(url, headers, timeoutvalue, protocol)))
        infomsg("Online    : " + str(await get_online_clients(url, headers, timeoutvalue, protocol)))
        infomsg("IP addr   : " + str(await get_lan_ip_address(url, headers, timeoutvalue, protocol)))
        infomsg("Netmask   : " + str(await get_lan_netmask(url, headers, timeoutvalue, protocol)))
        infomsg("Gateway   : " + str(await get_lan_gateway(url, headers, timeoutvalue, protocol)))
        infomsg("DHCP      : " + str(await get_dhcp_list(url, headers, timeoutvalue, protocol)))
        infomsg("Bandwidth : " + str(await get_traffic(url, headers, timeoutvalue, protocol)))
        infomsg("WAN       : " + str(await get_status_wan(url, headers, timeoutvalue, protocol)))
        infomsg("Client    : " + str(await get_client_info(url, headers, "B8:2C:A0:5F:37:52", timeoutvalue, protocol)))

    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check " + str(e) + " | value=-1")

    return url, headers

