async def authenticate(ipaddress, username, password):
    """
    Authenticate with the router and return the URL and headers
    Parameters:
        ipaddress : IP Address of the router
        username : Root user name
        password : Password required to login
    :returns: Tuple of (url, headers) or (url, None) if authentication fails
    """
    url = "http://" + ipaddress + "/appGet.cgi"
    auth = username + ":" + password
    auth_bytes = auth.encode("ascii")
    logintoken = base64.b64encode(auth_bytes).decode("ascii")
    payload = "login_authorization=" + logintoken
    headers = {
        "user-agent": "asusrouter-Android-DUTUtil-1.0.0.245"
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url="http://" + ipaddress + "/login.cgi", data=payload, headers=headers) as resp:
                r = await resp.json()
    except Exception:
        return url, None
    if "asus_token" in r:
        token = r["asus_token"]
        auth_headers = {
            "user-agent": "asusrouter-Android-DUTUtil-1.0.0.245",
            "cookie": "asus_token=" + token
        }
        return url, auth_headers
    else:
        return url, None


async def router_get(url, headers, command):
    """
    Execute a hook on the router and return the result
    Parameters:
        url : URL to post the command
        headers : Authentication headers
        command : Command to send
    :returns: string result from the router
    """
    if headers:
        payload = "hook=" + command
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post(url=url, data=payload, headers=headers) as resp:
                    return await resp.text()
        except Exception:
            return None
    else:
        return None


async def get_uptime(url, headers):
    """
    Return uptime of the router
    Format: {"since": "Thu, 22 Jul 2021 14:32:38 +0200", "uptime": "375001"}
    :returns: JSON with last boot time and uptime in seconds
    """
    r = await router_get(url, headers, "uptime()")
    if r is None:
        return None
    else:
        temp = json.loads(r)["uptime"]
        parts = temp.replace("(", "¶").replace(")", "¶").split("¶")
        since = parts[0]
        up = parts[1].split()[0]
        return json.loads('{"since":"' + since + '", "uptime":"' + up + '"}')


async def get_uptime_secs(url, headers):
    """
    Return uptime of the router in seconds
    :returns: integer - uptime in seconds
    """
    r = await get_uptime(url, headers)
    if r is None:
        return None
    else:
        return int(r["uptime"])


