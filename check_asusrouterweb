async def authenticate(ipaddress, username, password):
    auth = "{}:{}".format(username, password).encode('ascii')
    logintoken = base64.b64encode(auth).decode('ascii')
    payload = "login_authorization={}".format(logintoken)
    headers = {
        'user-agent': "asusrouter-Android-DUTUtil-1.0.0.245"
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url='http://{}/login.cgi'.format(ipaddress), data=payload, headers=headers) as resp:
                r = await resp.json()
    except Exception:
        return None
    if "asus_token" in r:
        token = r['asus_token']
        return {
            'user-agent': "asusrouter-Android-DUTUtil-1.0.0.245",
            'cookie': 'asus_token={}'.format(token)
        }
    else:
        return None

async def fetch_data(url, headers, command):
    if headers:
        payload = "hook={}".format(command)
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post(url=url, data=payload, headers=headers) as resp:
                    return await resp.text()
        except Exception:
            return None
    else:
        return None

async def get_uptime(url, headers):
    r = await fetch_data(url, headers, 'uptime()')
    if r is None:
        return None
    else:
        temp = json.loads(r)["uptime"]
        parts = temp.replace("(", "¶").replace(")", "¶").split("¶")
        since = parts[0]
        up = parts[1].split()[0]
        return json.loads('{' + '"since":"{}", "uptime":"{}"'.format(since, up) + '}')

async def get_uptime_secs(url, headers):
    r = await get_uptime(url, headers)
    if r is None:
        return None
    else:
        return int(r['uptime'])

