def get_connector(protocol):
    if protocol == "-4":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET)
    elif protocol == "-6":
        return aiohttp.TCPConnector(family=aiohttp.SocketFamily.AF_INET6)
    else:
        return aiohttp.TCPConnector()


async def authenticate(hostname, username, password, timeout, protocol):
    url = "http://" + hostnamedress + "/appGet.cgi"
    auth = username + ":" + password
    auth_bytes = auth.encode("ascii")
    logintoken = base64.b64encode(auth_bytes).decode("ascii")
    payload = "login_authorization=" + logintoken
    headers = {
        "user-agent": "asusrouter-Android-DUTUtil-1.0.0.245"
    }
    client_timeout = aiohttp.ClientTimeout(total=timeout)
    connector = get_connector(protocol)
    try:
        async with aiohttp.ClientSession(timeout=client_timeout, connector=connector) as session:
            async with session.post(url="http://" + hostname + "/login.cgi", data=payload, headers=headers) as resp:
                r = await resp.json()
    except Exception:
        return url, None
    if "asus_token" in r:
        token = r["asus_token"]
        auth_headers = {
            "user-agent": "asusrouter-Android-DUTUtil-1.0.0.245",
            "cookie": "asus_token=" + token
        }
        return url, auth_headers
    else:
        return url, None


async def router_get(url, headers, command, timeout, protocol):
    if headers:
        payload = "hook=" + command
        client_timeout = aiohttp.ClientTimeout(total=timeout)
        connector = get_connector(protocol)
        try:
            async with aiohttp.ClientSession(timeout=client_timeout, connector=connector) as session:
                async with session.post(url=url, data=payload, headers=headers) as resp:
                    return await resp.text()
        except Exception:
            return None
    else:
        return None


async def get_uptime(url, headers, timeout, protocol):
    r = await router_get(url, headers, "uptime()", timeout, protocol)
    if r is None:
        return None
    else:
        temp = json.loads(r)["uptime"]
        parts = temp.replace("(", "~").replace(")", "~").split("~")
        since = parts[0]
        up = parts[1].split()[0]
        return json.loads("{\"since\":\"" + since + "\", \"uptime\":\"" + up + "\"}")


async def get_uptime_secs(url, headers, timeout, protocol):
    r = await get_uptime(url, headers, timeout, protocol)
    if r is None:
        return None
    else:
        return int(r["uptime"])


