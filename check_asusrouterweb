async def doasusroutercall(host, username, password, timeoutvalue):
    try:
        url, headers = await authenticate(host, username, password)
        if headers is None:
            raise Exception("Authentication Failed")

        infomsg("Router URL: " + url)
        infomsg("Uptime    : " + str(await get_uptime_secs(url, headers)))
        infomsg("Memory    : " + str(await get_memory_usage(url, headers)))
        infomsg("CPU       : " + str(await get_cpu_usage(url, headers)))
        infomsg("Data      : " + str(await get_traffic_total(url, headers)))
        infomsg("Settings  : " + str(await get_settings(url, headers)))
        infomsg("Uptime    : " + str(await get_uptime(url, headers)))
        infomsg("Online    : " + str(await is_wan_online(url, headers)))
        infomsg("Clients   : " + str(await get_clients_fullinfo(url, headers)))
        infomsg("Clients   : " + str(await get_clients_info(url, headers)))
        infomsg("Online    : " + str(await get_online_clients(url, headers)))
        infomsg("IP addr   : " + str(await get_lan_ip_address(url, headers)))
        infomsg("Netmask   : " + str(await get_lan_netmask(url, headers)))
        infomsg("Gateway   : " + str(await get_lan_gateway(url, headers)))
        infomsg("DHCP      : " + str(await get_dhcp_list(url, headers)))
        infomsg("Bandwidth : " + str(await get_traffic(url, headers)))
        infomsg("WAN       : " + str(await get_status_wan(url, headers)))
        infomsg("Client    : " + str(await get_client_info(url, headers, "B8:2C:A0:5F:37:52")))

    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check " + str(e) + " | value=-1")

    return url, headers

