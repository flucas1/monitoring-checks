# Total traffic in Mb/s
async def get_traffic_total(url, headers, timeout, protocol):
    r = await router_get(url, headers, "netdev(appobj)", timeout, protocol)
    if r is None:
        return None
    else:
        meas = json.loads(r)
        tx = int(meas["netdev"]["INTERNET_tx"], base=16) * 8 / 1024 / 1024 / 2
        rx = int(meas["netdev"]["INTERNET_rx"], base=16) * 8 / 1024 / 1024 / 2
        return json.loads("{\"sent\":\"" + str(tx) + "\", \"recv\":\"" + str(rx) + "\"}")


async def get_traffic(url, headers, timeout, protocol):
    meas_1 = await router_get(url, headers, "netdev(appobj)", timeout, protocol)
    if meas_1 is None:
        return None
    await asyncio.sleep(2)
    meas_2 = await router_get(url, headers, "netdev(appobj)", timeout, protocol)
    if meas_2 is None:
        return None
    meas_1 = json.loads(meas_1)
    meas_2 = json.loads(meas_2)
    persec = {}
    totaldata = {}
    tx = int(meas_2["netdev"]["INTERNET_tx"], base=16) * 8 / 1024 / 1024 / 2
    totaldata["sent"] = tx
    tx -= int(meas_1["netdev"]["INTERNET_tx"], base=16) * 8 / 1024 / 1024 / 2
    persec["tx"] = tx
    rx = int(meas_2["netdev"]["INTERNET_rx"], base=16) * 8 / 1024 / 1024 / 2
    totaldata["recv"] = rx
    rx -= int(meas_1["netdev"]["INTERNET_rx"], base=16) * 8 / 1024 / 1024 / 2
    persec["rx"] = rx
    return json.dumps({"speed": persec, "total": totaldata})


async def get_status_wan(url, headers, timeout, protocol):
    r = await router_get(url, headers, "wanlink()", timeout, protocol)
    if r is None:
        return None
    else:
        status = {}
        for f in r.split("\n"):
            if "return" in f:
                if "wanlink_" in f:
                    key = f.partition("(")[0].partition("_")[2]
                    value = f.rpartition(" ")[-1][:-2]
                    status[key] = value
        return json.loads(json.dumps(status))


async def is_wan_online(url, headers, timeout, protocol):
    r = await get_status_wan(url, headers, timeout, protocol)
    if r is None:
        return None
    else:
        return r["status"] == "1"


