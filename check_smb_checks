#!/usr/bin/env python3
# -------------------------------------------------------------------------------
# aptitude install python-nagiosplugin

import argparse
import asyncio
import sys

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def check_kcc():
    command = ["/usr/bin/samba-tool", "drs", "kcc"]
    try:
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
    except Exception:
        output = "Error during 'samba-tool drs kcc'"
        return False, output
    if exitcode != 0:
        return False, output + "\n" + errors
    return True, output


async def check_sysvol():
    command = ["/usr/bin/samba-tool", "ntacl", "sysvolcheck"]
    try:
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
    except Exception:
        output = "Error during 'samba-tool ntacl sysvolcheck'"
        return False, output
    if exitcode != 0:
        return False, output + "\n" + errors
    return True, output


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    errors = 0
    output = ""

    kcc_result, kcc_output = await check_kcc()
    if kcc_result == False:
        errors = errors + 1
        output += kcc_output + "\n"

    sysvol_result, sysvol_output = await check_sysvol()
    if sysvol_result == False:
        errors = errors + 1
        output += sysvol_output + "\n"

    if errors == 0:
        exitnagios("OK", "no issues detected in kcc nor sysvol")
    else:
        exitnagios("CRITICAL", output)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
