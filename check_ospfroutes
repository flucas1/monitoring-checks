#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def doospfroutescall():
    cmdline = ["/usr/bin/vtysh", "-c", "show ip route"]
    infomsg(cmdline)
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode

    total = 0
    if exitcode == 0:
        for line in output.splitlines():
            if line.startswith("O") and ("is directly connected" not in line):
                total = total + 1
                break
        if total > 0:
            exitnagios("OK", "there are remote OSPF routes | total=" + str(total))
        else:
            exitnagios("CRITICAL", "there are no remote OSPF routes | total=" + str(total))
    else:
        exitnagios("CRITICAL", "issue retrieving ospf routes | total=" + str(total))

# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")

    args = parser.parse_args(forcedargs)

    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await doospfroutescall()

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
