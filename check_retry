#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import os
import asyncio
import argparse

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def doretrycall(cmdline):
    counter = 0
    retries = 3
    while True:
        counter = counter + 1
        infomsg(str(cmdline))
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        if exitcode == 0:
            if output != "":
                print(output, file=sys.stdout, flush=True, end="")
            if errors != "":
                print(errors, file=sys.stderr, flush=True, end="")
            return 0
        elif counter >= retries:
            if output != "":
                print(output, file=sys.stdout, flush=True, end="")
            if errors != "":
                print(errors, file=sys.stderr, flush=True, end="")
            return exitcode
        else:
            await asyncio.sleep(10)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Retry a command multiple times")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    parser.add_argument("cmdline", nargs="+", help="Command and arguments to execute")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    result = await doretrycall(args.cmdline)
    sys.exit(result)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
