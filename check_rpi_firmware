#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import asyncio
import argparse
import sys


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check Raspberry Pi firmware version")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug mode")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    try:
        cmdline = ["/opt/vc/bin/vcgencmd", "version"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            exitnagios("UNKNOWN", "Command failed with exit status " + str(process.returncode))

        words = stdout.decode().split()

        date_version = " ".join(words[0:4]) if len(words) >= 4 else "Unknown Date"

        git_version = words[9] if len(words) >= 10 else "Unknown Version"

        exitnagios("OK", date_version + " - (" + git_version + ")")

    except Exception as e:
        exitnagios("UNKNOWN", "Command failed with exception: " + str(e))


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
