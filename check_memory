#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import os
import re
import sys
import aiofiles


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def get_memory_info(opt_C, opt_v):
    used_memory_kb = 0
    free_memory_kb = 0
    total_memory_kb = 0
    caches_kb = 0
    hugepages_nr = 0
    hugepages_size = 0
    hugepages_kb = 0

    try:
        async with aiofiles.open("/proc/meminfo", "r") as f:
            async for line in f:
                line = line.strip()
                m1 = re.match(r"^Mem(Total|Free):\s+(\d+) kB", line)
                if m1:
                    if m1.group(1) == "Free":
                        free_memory_kb = int(m1.group(2))
                    elif m1.group(1) == "Total":
                        total_memory_kb = int(m1.group(2))
                    continue
                m2 = re.match(r"^(Buffers|Cached|SReclaimable):\s+(\d+) kB", line)
                if m2:
                    caches_kb += int(m2.group(2))
                    continue
                m3 = re.match(r"^Shmem:\s+(\d+) kB", line)
                if m3:
                    caches_kb -= int(m3.group(1))
                    continue
                m4 = re.match(r"^HugePages_Total:\s+(\d+)", line)
                if m4:
                    hugepages_nr = int(m4.group(1))
                    continue
                m5 = re.match(r"^Hugepagesize:\s+(\d+) kB", line)
                if m5:
                    hugepages_size = int(m5.group(1))
                    continue
    except IOError:
        pass

    hugepages_kb = hugepages_nr * hugepages_size
    used_memory_kb = total_memory_kb - free_memory_kb

    sysfs_dir = "/sys/kernel/mm/hugepages"
    if os.path.isdir(sysfs_dir):
        hugepages_kb = 0
        for entry in os.listdir(sysfs_dir):
            m = re.match(r"^hugepages-(\d+)kB", entry)
            if m:
                h_size = int(m.group(1))
                try:
                    async with aiofiles.open(os.path.join(sysfs_dir, entry, "nr_hugepages"), "r") as f:
                        content = await f.read()
                        h_nr = int(content.strip())
                    hugepages_kb += h_nr * h_size
                except IOError:
                    pass

    return free_memory_kb, used_memory_kb, caches_kb, hugepages_kb


# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-f", action="store_true")
    parser.add_argument("-u", action="store_true")
    parser.add_argument("-C", action="store_true")
    parser.add_argument("-h", action="store_true", dest="opt_h")
    parser.add_argument("-v", action="store_true")
    parser.add_argument("-w", type=float)
    parser.add_argument("-c", type=float)

    args, _ = parser.parse_known_args()

    if args.w is None or args.w == 0 or args.c is None or args.c == 0:
        exitnagios("UNKNOWN", "You must define WARN and CRITICAL levels!")
    elif not args.f and not args.u:
        exitnagios("UNKNOWN", "You must select to monitor either USED or FREE memory!")

    if args.w <= args.c and args.f:
        exitnagios("UNKNOWN", "WARNING level must not be less than CRITICAL when checking FREE memory!")
    elif args.w >= args.c and args.u:
        exitnagios("UNKNOWN", "WARNING level must not be greater than CRITICAL when checking USED memory!")

    free_kb, used_kb, caches_kb, hugepages_kb = await get_memory_info(args.C, args.v)

    if args.v:
        infomsg(f"{free_kb} Free\n{used_kb} Used\n{caches_kb} Cache")
        if args.opt_h:
            infomsg(f"{hugepages_kb} Hugepages")

    if args.C:
        used_kb -= caches_kb
        free_kb += caches_kb

    if args.opt_h:
        used_kb -= hugepages_kb

    if args.v:
        infomsg(f"{used_kb} Used (after Hugepages)")

    free_kb = int(free_kb)
    used_kb = int(used_kb)
    caches_kb = int(caches_kb)

    total = free_kb + used_kb
    if args.v:
        infomsg(f"{total} Total")

    if args.u:
        perf_warn = int(total * args.w / 100)
        perf_crit = int(total * args.c / 100)
    else:
        perf_warn = int(total * (100 - args.w) / 100)
        perf_crit = int(total * (100 - args.c) / 100)

    perfdata = f"|TOTAL={total}KB;;;; USED={used_kb}KB;{perf_warn};{perf_crit};; FREE={free_kb}KB;;;; CACHES={caches_kb}KB;;;;"
    if args.opt_h:
        perfdata += f" HUGEPAGES={hugepages_kb}KB;;;;"

    if args.f:
        percent = float(free_kb) / total * 100 if total else 0
        if percent <= args.c:
            exitnagios("CRITICAL", f"{percent:.1f}% ({free_kb} kB) free!{perfdata}")
        elif percent <= args.w:
            exitnagios("WARNING", f"{percent:.1f}% ({free_kb} kB) free!{perfdata}")
        else:
            exitnagios("OK", f"{percent:.1f}% ({free_kb} kB) free.{perfdata}")
    elif args.u:
        percent = float(used_kb) / total * 100 if total else 0
        if percent >= args.c:
            exitnagios("CRITICAL", f"{percent:.1f}% ({used_kb} kB) used!{perfdata}")
        elif percent >= args.w:
            exitnagios("WARNING", f"{percent:.1f}% ({used_kb} kB) used!{perfdata}")
        else:
            exitnagios("OK", f"{percent:.1f}% ({used_kb} kB) used.{perfdata}")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
