#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import os
import re
import sys
import aiofiles


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def get_memory_info():
    used_memory_kb = 0
    free_memory_kb = 0
    total_memory_kb = 0
    caches_kb = 0
    hugepages_nr = 0
    hugepages_size = 0
    hugepages_kb = 0

    try:
        async with aiofiles.open("/proc/meminfo", "rb") as f:
            lines = await f.read()
            lines = lines.decode("utf-8").strip().splitlines()
            for line in lines:
                line = line.strip()
                m1 = re.match(r"^Mem(Total|Free):\s+(\d+) kB", line)
                if m1:
                    if m1.group(1) == "Free":
                        free_memory_kb = int(m1.group(2))
                    elif m1.group(1) == "Total":
                        total_memory_kb = int(m1.group(2))
                    continue
                m2 = re.match(r"^(Buffers|Cached|SReclaimable):\s+(\d+) kB", line)
                if m2:
                    caches_kb += int(m2.group(2))
                    continue
                m3 = re.match(r"^Shmem:\s+(\d+) kB", line)
                if m3:
                    caches_kb -= int(m3.group(1))
                    continue
                m4 = re.match(r"^HugePages_Total:\s+(\d+)", line)
                if m4:
                    hugepages_nr = int(m4.group(1))
                    continue
                m5 = re.match(r"^Hugepagesize:\s+(\d+) kB", line)
                if m5:
                    hugepages_size = int(m5.group(1))
                    continue
    except IOError:
        pass

    hugepages_kb = hugepages_nr * hugepages_size
    used_memory_kb = total_memory_kb - free_memory_kb

    sysfs_dir = "/sys/kernel/mm/hugepages"
    if os.path.isdir(sysfs_dir):
        hugepages_kb = 0
        entries = os.listdir(sysfs_dir)
        for entry in entries:
            m = re.match(r"^hugepages-(\d+)kB", entry)
            if m:
                h_size = int(m.group(1))
                try:
                    async with aiofiles.open(os.path.join(sysfs_dir, entry, "nr_hugepages"), "rb") as f:
                        content = await f.read()
                        h_nr = int(content.decode("utf-8").strip())
                    hugepages_kb += h_nr * h_size
                except IOError:
                    pass

    return free_memory_kb, used_memory_kb, caches_kb, hugepages_kb


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-f", "--free", action="store_true", dest="free")
    parser.add_argument("-u", "--used", action="store_true", dest="used")
    parser.add_argument("-C", "--caches", action="store_true", dest="caches")
    parser.add_argument("-g", "--huge", action="store_true", dest="huge")
    parser.add_argument("-w", "--warning", type=float, dest="warning")
    parser.add_argument("-c", "--critical", type=float, dest="critical")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.warning is None or args.warning == 0 or args.critical is None or args.critical == 0:
        exitnagios("UNKNOWN", "You must define WARN and CRITICAL levels!")
    elif not args.free and not args.used:
        exitnagios("UNKNOWN", "You must select to monitor either USED or FREE memory!")

    if args.warning <= args.critical and args.free:
        exitnagios("UNKNOWN", "WARNING level must not be less than CRITICAL when checking FREE memory!")
    elif args.warning >= args.critical and args.used:
        exitnagios("UNKNOWN", "WARNING level must not be greater than CRITICAL when checking USED memory!")

    free_kb, used_kb, caches_kb, hugepages_kb = await get_memory_info()

    if args.debug:
        infomsg(str(free_kb) + " Free\n" + str(used_kb) + " Used\n" + str(caches_kb) + " Cache")
        if args.huge:
            infomsg(str(hugepages_kb) + " Hugepages")

    if args.caches:
        used_kb -= caches_kb
        free_kb += caches_kb

    if args.huge:
        used_kb -= hugepages_kb

    if args.debug:
        infomsg(str(used_kb) + " Used (after Hugepages)")

    free_kb = int(free_kb)
    used_kb = int(used_kb)
    caches_kb = int(caches_kb)

    total = free_kb + used_kb
    if args.debug:
        infomsg(str(total) + " Total")

    if args.used:
        perf_warn = int(total * args.warning / 100)
        perf_crit = int(total * args.critical / 100)
    else:
        perf_warn = int(total * (100 - args.warning) / 100)
        perf_crit = int(total * (100 - args.critical) / 100)

    perfdata = " | TOTAL=" + str(total) + "KB;;;; USED=" + str(used_kb) + "KB;" + str(perf_warn) + ";" + str(perf_crit) + ";; FREE=" + str(free_kb) + "KB;;;; CACHES=" + str(caches_kb) + "KB;;;;"
    if args.huge:
        perfdata += " HUGEPAGES=" + str(hugepages_kb) + "KB;;;;"

    if args.free:
        percent = float(free_kb) / total * 100 if total else 0
        if percent <= args.critical:
            exitnagios("CRITICAL", str(round(percent, 1)) + "% (" + str(free_kb) + " kB) free!" + perfdata)
        elif percent <= args.warning:
            exitnagios("WARNING", str(round(percent, 1)) + "% (" + str(free_kb) + " kB) free!" + perfdata)
        else:
            exitnagios("OK", str(round(percent, 1)) + "% (" + str(free_kb) + " kB) free." + perfdata)
    elif args.used:
        percent = float(used_kb) / total * 100 if total else 0
        if percent >= args.critical:
            exitnagios("CRITICAL", str(round(percent, 1)) + "% (" + str(used_kb) + " kB) used!" + perfdata)
        elif percent >= args.warning:
            exitnagios("WARNING", str(round(percent, 1)) + "% (" + str(used_kb) + " kB) used!" + perfdata)
        else:
            exitnagios("OK", str(round(percent, 1)) + "% (" + str(used_kb) + " kB) used." + perfdata)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
