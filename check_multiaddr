#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import os
import asyncio
import argparse

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def dotest(host, multiargs, multitimeoutvalue, multitimeoutstatus, childtimeoutvalue, childtimeoutstatus):
    try:
        infomsg(childtimeoutvalue)
        infomsg(childtimeoutstatus)
        cmdline = multiargs + ["-H", host]
        if childtimeoutvalue is not None and childtimeoutstatus is not None:
            cmdline = cmdline + ["-t", str(childtimeoutvalue) + ":" + childtimeoutstatus]
        infomsg("cmdline -> "+str(cmdline))

        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        try:
            stdout, stderr = await asyncio.wait_for(process.communicate(), timeout=multitimeoutvalue)
            output = stdout.decode("utf-8").strip() if stdout else ""
            errors = stderr.decode("utf-8").strip() if stderr else ""
            exitcode = process.returncode
        except asyncio.TimeoutError:
            try:
                process.kill()
            except ProcessLookupError:
                pass
            output = "timeout"
            errors = ""
            exitcode = mapstatustoexitcode(multitimeoutstatus)
        except Exception as e:
            output = "unknown error"
            errors = str(e)
            exitcode = 2

        infomsg(exitcode)
        return (exitcode, output, errors)

    except Exception as e:
        infomsg("Exception in dotest: " + str(e))
        return (2, "unknown error", str(e))


def build_final_message(host, output, errors):
    parts = output.split("|", 1)
    status_text = parts[0].strip()
    perfdata = parts[1].strip() if len(parts) > 1 else ""

    finalmsg = host + " -> " + status_text
    if errors != "":
        finalmsg = finalmsg + "\n\n" + errors.replace("|", "#")
    if perfdata != "":
        finalmsg = finalmsg + " | " + perfdata
    return finalmsg


async def domultiaddrcall(multitimeoutvalue, multitimeoutstatus, childtimeoutvalue, childtimeoutstatus, allhosts, multiargs):
    tasks = []
    mappings = {}
    for host in allhosts:
        infomsg(host + " " + str(multiargs))
        task = asyncio.create_task(dotest(host, multiargs, multitimeoutvalue, multitimeoutstatus, childtimeoutvalue, childtimeoutstatus))
        tasks.append(task)
        mappings[task] = host

    # Wait for all tasks to complete
    results = await asyncio.gather(*tasks, return_exceptions=True)

    # Check for any OK results first
    for i, task in enumerate(tasks):
        (exitcode, output, errors) = results[i]
        infomsg(str(exitcode) + "\n" + output + "\n" + errors)
        if exitcode == 0:
            finalmsg = build_final_message(mappings[task], output, errors)
            exitnagios("OK", finalmsg)

    # If no OK, check for CRITICAL
    for i, task in enumerate(tasks):
        (exitcode, output, errors) = results[i]
        if exitcode == 2:
            finalmsg = build_final_message(mappings[task], output, errors)
            exitnagios("CRITICAL", finalmsg)

    # Then WARNING
    for i, task in enumerate(tasks):
        (exitcode, output, errors) = results[i]
        if exitcode == 1:
            finalmsg = build_final_message(mappings[task], output, errors)
            exitnagios("WARNING", finalmsg)

    # Check for UNKNOWN
    for i, task in enumerate(tasks):
        (exitcode, output, errors) = results[i]
        if exitcode == 3:
            finalmsg = build_final_message(mappings[task], output, errors)
            exitnagios(childtimeoutstatus, finalmsg)

    exitnagios(multitimeoutstatus, "no results obtained for any alternative")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="hostname", help="Comma-separated hostnames", default=None)
    parser.add_argument("-t", "--timeout", dest="timeout", help="Multi timeout in seconds[:status]", default=None)

    if forcedargs is None:
        forcedargs = sys.argv[3:]
    #print(forcedargs)
    args, unknown = parser.parse_known_args(forcedargs)
    #print(args)
    #print(unknown)

    hostnames = args.hostname
    maintimeout = sys.argv[1]
    childtimeout = args.timeout

    return hostnames,maintimeout,childtimeout,sys.argv[2],unknown


async def main(forcedargs=None):
    hostnames,maintimeout,childtimeout,script,childargs = parse_args(forcedargs)
    setcandebug(False)

    infomsg(maintimeout)
    if maintimeout in ["", None]:
        maintimeout = "CRITICAL:30"
    multitimeoutparts = maintimeout.split(":")
    infomsg(multitimeoutparts)
    multitimeoutvalue = int(multitimeoutparts[0])
    infomsg(multitimeoutvalue)
    if len(multitimeoutparts) > 1:
        multitimeoutstatus = multitimeoutparts[1]
    else:
        multitimeoutstatus = "CRITICAL"
    infomsg(multitimeoutstatus)

    multihostnames = hostnames
    infomsg("multihostname: "+str(multihostnames))

    multiargs = [script] + childargs
    infomsg("multiarg: "+str(multiargs))

    allhosts = multihostnames.split(",") if multihostnames else []

    childtimeoutvalue = None
    childtimeoutstatus = None
    if childtimeout != "":
        childtimeoutparts = childtimeout.split(":")
        infomsg(childtimeoutparts)
        childtimeoutvalue = int(childtimeoutparts[0])
        if len(childtimeoutparts) > 1:
            childtimeoutstatus = childtimeoutparts[1]
    if childtimeoutstatus is None:
        childtimeoutstatus = "CRITICAL"
    infomsg(childtimeoutvalue)
    infomsg(childtimeoutstatus)

    infomsg("multitimeoutvalue: " + str(multitimeoutvalue))
    infomsg("multitimeoutstatus: " + str(multitimeoutstatus))
    infomsg("childtimeoutvalue: " + str(childtimeoutvalue))
    infomsg("childtimeoutstatus: " + str(childtimeoutstatus))
    infomsg("allhosts: " + str(allhosts))
    infomsg("multiargs: " + str(multiargs))

    await domultiaddrcall(multitimeoutvalue, multitimeoutstatus, childtimeoutvalue, childtimeoutstatus, allhosts, multiargs)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

