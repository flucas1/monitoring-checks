#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import os
import sys
import time
import filecmp
import signal
import re
import asyncio


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def is_path_qualified(path):
    return path.startswith("./") or path.startswith("/")


def is_filename(filename):
    if not filename or not filename.strip() or filename.endswith("/"):
        return None
    dirname_regex = r"[\/\w\s\\.,:*()=%?+-]+"
    filename_regex = dirname_regex + r"[^\/]"
    match = re.match(f"^({filename_regex})$", filename)
    if match:
        return match.group(1)
    return None


def validate_filename(filename, name="filename", noquit=False):
    if not filename or not filename.strip():
        print(f"{name} not defined")
        return None
    filename2 = is_filename(filename)
    if not filename2:
        if not noquit:
            print(f"invalid {name} (does not match regex critera): '{filename}'")
        return None
    return filename2


# -------------------------------------------------------------------------------


async def check_timezone_logic(args):
    LOCALTIME_FILE = "/etc/localtime"
    ZONEINFO_DIR = "/usr/share/zoneinfo"

    if not args.timezone:
        exitnagios("UNKNOWN", "timezone not specified")

    if not re.match(r"^[\w\/\+-]+$", args.timezone):
        exitnagios("UNKNOWN", "invalid timezone specified")

    zoneinfo_file = args.zoneinfo_file if args.zoneinfo_file else args.timezone
    alternate_timezone = args.alternate if args.alternate else args.timezone

    if not is_path_qualified(zoneinfo_file):
        zoneinfo_file = f"{ZONEINFO_DIR}/{zoneinfo_file}"

    zoneinfo_file = validate_filename(zoneinfo_file)

    server_timezone = time.tzname[0]

    if not is_path_qualified(zoneinfo_file):
        exitnagios("CRITICAL", "failed to get timezone")

    msg = f"timezone is '{server_timezone}'"

    if server_timezone != args.timezone and server_timezone != alternate_timezone:
        if args.timezone != alternate_timezone:
            msg += f" (expected: '{args.timezone}' or '{alternate_timezone}')"
        else:
            msg += f" (expected: '{args.timezone}')"
        exitnagios("CRITICAL", msg)

    try:
        if filecmp.cmp(LOCALTIME_FILE, zoneinfo_file, shallow=False):
            exitnagios("OK", msg)
        else:
            exitnagios("CRITICAL", f"{msg}, localtime file '{LOCALTIME_FILE}' does not match timezone file '{zoneinfo_file}'!")
    except FileNotFoundError:
        exitnagios("CRITICAL", f"{msg}, localtime file '{LOCALTIME_FILE}' does not match timezone file '{zoneinfo_file}'!")

    exitnagios("UNKNOWN", msg)


# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    LOCALTIME_FILE = "/etc/localtime"
    ZONEINFO_DIR = "/usr/share/zoneinfo"

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-T", "--timezone", type=str)
    parser.add_argument("-A", "--alternate", type=str)
    parser.add_argument("-Z", "--zoneinfo-file", type=str)
    parser.add_argument("-h", "--help", action="store_true")

    args = parser.parse_args()

    check_timezone_logic(args)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

