#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import os
import sys
import time
import filecmp
import signal
import re
import asyncio


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


LOCALTIME_FILE = "/etc/localtime"
ZONEINFO_DIR = "/usr/share/zoneinfo"


def is_path_qualified(path):
    return path.startswith("./") or path.startswith("/")


def is_filename(filename):
    if not filename or not filename.strip() or filename.endswith("/"):
        return None
    dirname_regex = r"[\/\w\s\\.,:*()=%?+-]+"
    filename_regex = dirname_regex + r"[^\/]"
    match = re.match(f"^({filename_regex})$", filename)
    if match:
        return match.group(1)
    return None


def validate_filename(filename, name="filename", noquit=False):
    if not filename or not filename.strip():
        print(f"{name} not defined")
        return None
    filename2 = is_filename(filename)
    if not filename2:
        if not noquit:
            print(f"invalid {name} (does not match regex critera): '{filename}'")
        return None
    return filename2


def timeout_handler(signum, frame):
    print("UNKNOWN self timed out after 10 seconds")
    sys.exit(3)


# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-T", "--timezone", type=str)
    parser.add_argument("-A", "--alternate", type=str)
    parser.add_argument("-Z", "--zoneinfo-file", type=str)
    parser.add_argument("-h", "--help", action="store_true")

    args = parser.parse_args()

    if args.help:
        print("T|timezone=s Timezone to expect the server in as shown by the 'date' command (eg. GMT)")
        print("A|alternate=s Alternative timezone to expect the server in. Optional (defaults to same as --timezone). Useful to allow daylight saving time shifts by specifying a second timezone to allow (eg. BST)")
        print(f"Z|zoneinfo-file=s Timezone file to compare {LOCALTIME_FILE} to. Optional (defaults to --timezone suffixed to {ZONEINFO_DIR}). Useful when your localtime is set to say Europe/London which shows up as GMT/BST but you still want to validate that {LOCALTIME_FILE} is set to Europe/London for following daylight saving time changes back and forth. Can be any valid timezone file under {ZONEINFO_DIR}/ (eg. UTC or GMT) or a fully qualified path to a timezone file")
        sys.exit(0)

    if not args.timezone:
        print("ERROR: timezone not specified")
        sys.exit(3)

    if not re.match(r"^[\w\/\+-]+$", args.timezone):
        print("ERROR: invalid timezone specified")
        sys.exit(3)

    zoneinfo_file = args.zoneinfo_file if args.zoneinfo_file else args.timezone
    alternate_timezone = args.alternate if args.alternate else args.timezone

    if not is_path_qualified(zoneinfo_file):
        zoneinfo_file = f"{ZONEINFO_DIR}/{zoneinfo_file}"

    zoneinfo_file = validate_filename(zoneinfo_file)

    signal.signal(signal.SIGALRM, timeout_handler)
    signal.alarm(10)

    server_timezone = time.tzname[0]

    if not is_path_qualified(zoneinfo_file):
        print("CRITICAL: failed to get timezone")
        sys.exit(2)

    msg = f"timezone is "{server_timezone}""

    if server_timezone != args.timezone and server_timezone != alternate_timezone:
        if args.timezone != alternate_timezone:
            msg += f" (expected: '{args.timezone}' or '{alternate_timezone}')"
        else:
            msg += f" (expected: '{args.timezone}')"
        print(f"CRITICAL: {msg}")
        sys.exit(2)

    try:
        if filecmp.cmp(LOCALTIME_FILE, zoneinfo_file, shallow=False):
            print(f"OK: {msg}")
            sys.exit(0)
        else:
            print(f"CRITICAL: {msg}, localtime file '{LOCALTIME_FILE}' does not match timezone file '{zoneinfo_file}'!")
            sys.exit(2)
    except FileNotFoundError:
        print(f"CRITICAL: {msg}, localtime file '{LOCALTIME_FILE}' does not match timezone file '{zoneinfo_file}'!")
        sys.exit(2)

    print(f"UNKNOWN {msg}")
    sys.exit(3)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
