#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


SELINUX_MODES = ["enforcing", "permissive", "disabled"]


async def check_selinux_mode(expected_mode, warning_flag):
    try:
        cmdline = ["/usr/sbin/getenforce"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            exitnagios("UNKNOWN", "unable to retrieve SELinux mode")

        current_mode = stdout.decode().strip().lower()
    except (FileNotFoundError, OSError):
        exitnagios("UNKNOWN", "unable to retrieve SELinux mode")

    if current_mode != expected_mode:
        error_state_label = "WARNING" if warning_flag else "CRITICAL"
        exitnagios(error_state_label, "SELinux is not " + expected_mode + " (currently " + current_mode + ")")

    exitnagios("OK", "SELinux is " + expected_mode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check expected SELinux mode.")
    parser.add_argument("-w", "--warning", action="store_true", help="Exit warning, instead of critical by default, if current SELinux status doesn't match expected one")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug mode")
    parser.add_argument("selinux_mode", type=str.lower, choices=SELINUX_MODES, metavar="SELINUX_MODE", help="Expected SELinux mode (allowed values: " + " ".join(SELINUX_MODES) + ")")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await check_selinux_mode(args.selinux_mode, args.warning)


# -------------------------------------------------------------------------------


if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
