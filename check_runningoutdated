#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys


# -------------------------------------------------------------------------------


# Define default values for warning and critical thresholds
WARNING_DEFAULT = 1
CRITICAL_DEFAULT = 4

# Path to checkrestart binary
CHECKRESTART_BIN = "/usr/sbin/checkrestart"


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="check_checkrestart - Check obsolete libraries still in use\n\nNeeds debian-goodies!")
    parser.add_argument("-w", "--warning", type=int, default=WARNING_DEFAULT, help="Warning number of processes using old libraries. Default: " + str(WARNING_DEFAULT))
    parser.add_argument("-c", "--critical", type=int, default=CRITICAL_DEFAULT, help="Critical number of processes using old libraries. Default: " + str(CRITICAL_DEFAULT))
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    cmd = [CHECKRESTART_BIN]

    # Check if -p is supported by looking for 'vhpa' in the help output
    try:
        proc = await asyncio.create_subprocess_exec(
            CHECKRESTART_BIN, "-h",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        help_output = stdout.decode("utf-8") + stderr.decode("utf-8")
        if "vhpa" in help_output:
            cmd.append("-p")
    except FileNotFoundError:
        print("CRITICAL - No data, maybe " + CHECKRESTART_BIN + " missing?")
        sys.exit(2)
    except Exception:
        # If help command fails, assume -p is not supported
        pass

    # Execute checkrestart
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        output = stdout.decode("utf-8")
        if proc.returncode != 0:
            # Even on non-zero exit, checkrestart may output useful data
            output = output + stderr.decode("utf-8")
    except FileNotFoundError:
        print("CRITICAL - No data, maybe " + CHECKRESTART_BIN + " missing?")
        sys.exit(2)

    # Parse result: equivalent to grep Found | awk '{print $2}'
    result = None
    for line in output.splitlines():
        if "Found" in line:
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                result = int(parts[1])
                break

    # Make sure we have a result. Fail if connection or execution failed
    if result is None:
        print("CRITICAL - No data, maybe " + CHECKRESTART_BIN + " missing?")
        sys.exit(2)

    # Threshold comparison and Nagios standard exit codes
    if result >= args.critical:
        print("CRITICAL: " + str(result) + " services or processes to restart | to_restart=" + str(result))
        sys.exit(2)
    elif result >= args.warning:
        print("WARNING: " + str(result) + " services or processes to restart | to_restart=" + str(result))
        sys.exit(1)
    else:
        print("OK: no service or process to restart | to_restart=" + str(result))
        sys.exit(0)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------