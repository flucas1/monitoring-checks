#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    WARNING_DEFAULT = 1
    CRITICAL_DEFAULT = 4
    parser = argparse.ArgumentParser(description="check_checkrestart - Check obsolete libraries still in use\n\nNeeds debian-goodies!")
    parser.add_argument("-w", "--warning", type=int, default=WARNING_DEFAULT, help="Warning number of processes using old libraries. Default: " + str(WARNING_DEFAULT))
    parser.add_argument("-c", "--critical", type=int, default=CRITICAL_DEFAULT, help="Critical number of processes using old libraries. Default: " + str(CRITICAL_DEFAULT))
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug mode")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    CHECKRESTART_BIN = "/usr/sbin/checkrestart"
    cmd = [CHECKRESTART_BIN]

    # Check if -p is supported by looking for 'vhpa' in the help output
    try:
        proc = await asyncio.create_subprocess_exec(
            CHECKRESTART_BIN, "-h",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        help_output = stdout.decode("utf-8") + stderr.decode("utf-8")
        if "vhpa" in help_output:
            cmd.append("-p")
    except FileNotFoundError:
        exitnagios("CRITICAL", "No data, maybe " + CHECKRESTART_BIN + " missing?")
    except Exception:
        # If help command fails, assume -p is not supported
        pass

    # Execute checkrestart
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        output = stdout.decode("utf-8")
        if proc.returncode != 0:
            # Even on non-zero exit, checkrestart may output useful data
            output = output + stderr.decode("utf-8")
    except FileNotFoundError:
        exitnagios("CRITICAL", "No data, maybe " + CHECKRESTART_BIN + " missing?")

    # Parse result: equivalent to grep Found | awk '{print $2}'
    result = None
    for line in output.splitlines():
        if "Found" in line:
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                result = int(parts[1])
                break

    # Make sure we have a result. Fail if connection or execution failed
    if result is None:
        exitnagios("CRITICAL", "No data, maybe " + CHECKRESTART_BIN + " missing?")

    # Threshold comparison and Nagios standard exit codes
    if result >= args.critical:
        exitnagios("CRITICAL", str(result) + " services or processes to restart | to_restart=" + str(result))
    elif result >= args.warning:
        exitnagios("WARNING", str(result) + " services or processes to restart | to_restart=" + str(result))
    else:
        exitnagios("OK", "no service or process to restart | to_restart=" + str(result))


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
