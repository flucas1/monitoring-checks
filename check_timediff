#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import time
from datetime import datetime

# Nagios Return Codes
RC_OK = 0
RC_WARNING = 1
RC_CRITICAL = 2
RC_UNKNOWN = 3


def msg(status_class, message_text):
    """Generalised messaging interface for Nagios output."""
    prefix = f"TIME_DIFF {status_class}"
    print(f"{prefix} - {message_text}")

    if status_class == 'OK':
        sys.exit(RC_OK)
    elif status_class == 'WARNING':
        sys.exit(RC_WARNING)
    elif status_class == 'CRITICAL':
        sys.exit(RC_CRITICAL)
    else:
        sys.exit(RC_UNKNOWN)


def main():

    parser = argparse.ArgumentParser(
        add_help=False,
        usage="usage: check_timediff [-c seconds] -f format [-h]\n   -t time [-w seconds] [-v]"
    )

    parser.add_argument('-c', type=int, default=3, dest='critical_seconds')
    parser.add_argument('-w', type=int, default=2, dest='warning_seconds')
    parser.add_argument('-f', dest='server_time_format', choices=['euro', 'iso8601', 'strict-iso8601', 'us'])
    parser.add_argument('-t', dest='server_time', type=str)
    parser.add_argument('-h', action='store_true', dest='help')

    args, unknown = parser.parse_known_args()

    # Handle Help
    if args.help:
        script_name = "check_timediff"
        help_text = (
            f"usage: {script_name} [-c seconds] -f format [-h]\n"
            f"   -t time [-w seconds] [-v]\n"
            f"  where:\n"
            f"    -c critical time difference limit in seconds (default 3)\n"
            f"    -f format of -t value; the Nagios server's date_format value\n"
            f"       Possible values: euro, iso8601, strict-iso8601 or us\n"
            f"    -h Prints this help and exits\n"
            f"    -t time passed by the Nagios server by for example:\n"
            f"           check_nrpe!check_time_diff!-f iso8601 -t $SHORTDATETIME$\n"
            f"    -w warning time difference limit in seconds (default 2)\n"
        )
        print(help_text)
        sys.exit(0)

    # Validate extra arguments
    if unknown:
        parser.error(f"Invalid extra argument(s) ' {' '.join(unknown)}'")

    # Validate required arguments
    if not args.server_time_format:
        parser.error("Option -f is required")
    if not args.server_time:
        parser.error("Option -t is required")

    # Validate logical thresholds
    if args.warning_seconds >= args.critical_seconds:
        parser.error(f"warning seconds ({args.warning_seconds}) cannot be >= critical seconds ({args.critical_seconds})")

    # Time format mapping
    format_map = {
        'us': '%m/%d/%Y %H:%M:%S',
        'euro': '%d/%m/%Y %H:%M:%S',
        'iso8601': '%Y-%m-%d %H:%M:%S',
        'strict-iso8601': '%Y-%m-%dT%H:%M:%S'
    }

    # Convert Server Time to Epoch
    try:
        dt_format = format_map[args.server_time_format]
        parsed_time = datetime.strptime(args.server_time, dt_format)
        server_epoch_time = int(time.mktime(parsed_time.timetuple()))
    except ValueError:
        parser.error(f"Invalid -t value {args.server_time} (does not match {args.server_time_format} format)")

    # Calculate difference
    local_epoch_time = int(time.time())
    diff = abs(local_epoch_time - server_epoch_time)
    diff_msg = f"{diff} seconds"

    # Evaluate against thresholds
    if diff >= args.critical_seconds:
        msg('CRITICAL', diff_msg)
    elif diff >= args.warning_seconds:
        msg('WARNING', diff_msg)
    else:
        msg('OK', diff_msg)


if __name__ == '__main__':
    main()
