#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys
import time
import datetime

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-c", "--critical", type=int, default=3, dest="critical_seconds")
    parser.add_argument("-w", "--warning", type=int, default=2, dest="warning_seconds")
    parser.add_argument("-f", "--format", dest="server_time_format", choices=["euro", "iso8601", "strict-iso8601", "us"])
    parser.add_argument("-t", "--time", dest="server_time", type=str)
    parser.add_argument("-d", "--debug", action="store_true", dest="debug")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Validate required arguments
    if not args.server_time_format:
        exitnagios("UNKNOWN", "Option -f/--format is required")
    if not args.server_time:
        exitnagios("UNKNOWN", "Option -t/--time is required")

    # Validate logical thresholds
    if args.warning_seconds >= args.critical_seconds:
        exitnagios("UNKNOWN", "warning seconds (" + str(args.warning_seconds) + ") cannot be >= critical seconds (" + str(args.critical_seconds) + ")")

    # Time format mapping
    format_map = {
        "us": "%m/%d/%Y %H:%M:%S",
        "euro": "%d/%m/%Y %H:%M:%S",
        "iso8601": "%Y-%m-%d %H:%M:%S",
        "strict-iso8601": "%Y-%m-%dT%H:%M:%S"
    }

    # Convert Server Time to Epoch
    try:
        dt_format = format_map[args.server_time_format]
        parsed_time = datetime.datetime.strptime(args.server_time, dt_format)
        server_epoch_time = int(time.mktime(parsed_time.timetuple()))
    except ValueError as e:
        exitnagios("UNKNOWN", str(e))

    # Calculate difference
    local_epoch_time = int(time.time())
    diff = abs(local_epoch_time - server_epoch_time)
    diff_msg = str(diff) + " seconds"

    # Evaluate against thresholds
    if diff >= args.critical_seconds:
        exitnagios("CRITICAL", diff_msg)
    elif diff >= args.warning_seconds:
        exitnagios("WARNING", diff_msg)
    else:
        exitnagios("OK", diff_msg)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
