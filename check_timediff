#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import sys
import time
import datetime

# Nagios Return Codes
RC_OK = 0
RC_WARNING = 1
RC_CRITICAL = 2
RC_UNKNOWN = 3


def msg(status_class, message_text):
    prefix = "TIME_DIFF " + status_class
    print(prefix + " - " + message_text)

    if status_class == "OK":
        sys.exit(RC_OK)
    elif status_class == "WARNING":
        sys.exit(RC_WARNING)
    elif status_class == "CRITICAL":
        sys.exit(RC_CRITICAL)
    else:
        sys.exit(RC_UNKNOWN)


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-c", type=int, default=3, dest="critical_seconds")
    parser.add_argument("-w", type=int, default=2, dest="warning_seconds")
    parser.add_argument("-f", dest="server_time_format", choices=["euro", "iso8601", "strict-iso8601", "us"])
    parser.add_argument("-t", dest="server_time", type=str)
    args = parser.parse_args()

    # Validate required arguments
    if not args.server_time_format:
        parser.error("Option -f is required")
    if not args.server_time:
        parser.error("Option -t is required")

    # Validate logical thresholds
    if args.warning_seconds >= args.critical_seconds:
        parser.error("warning seconds (" + str(args.warning_seconds) + ") cannot be >= critical seconds (" + str(args.critical_seconds) + ")")

    # Time format mapping
    format_map = {
        "us": "%m/%d/%Y %H:%M:%S",
        "euro": "%d/%m/%Y %H:%M:%S",
        "iso8601": "%Y-%m-%d %H:%M:%S",
        "strict-iso8601": "%Y-%m-%dT%H:%M:%S"
    }

    # Convert Server Time to Epoch
    try:
        dt_format = format_map[args.server_time_format]
        parsed_time = datetime.datetime.strptime(args.server_time, dt_format)
        server_epoch_time = int(time.mktime(parsed_time.timetuple()))
    except ValueError:
        parser.error("Invalid -t value " + args.server_time + " (does not match " + args.server_time_format + " format)")

    # Calculate difference
    local_epoch_time = int(time.time())
    diff = abs(local_epoch_time - server_epoch_time)
    diff_msg = str(diff) + " seconds"

    # Evaluate against thresholds
    if diff >= args.critical_seconds:
        msg("CRITICAL", diff_msg)
    elif diff >= args.warning_seconds:
        msg("WARNING", diff_msg)
    else:
        msg("OK", diff_msg)


if __name__ == "__main__":
    asyncio.run(main())
