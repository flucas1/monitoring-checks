#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import os
import pathlib
import asyncio
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def isvalidjob(jobspath, entry):
    permalinks = os.path.join(jobspath, entry, "builds", "permalinks")
    if not os.path.isdir(permalinks):
        return False
    else:
        isOK = False
        lastCompletedBuild = -1
        lastStableBuild = -1
        lastSuccessfulBuild = -1
        content = pathlib.Path(permalinks).read_text()
        lines = content.splitlines()
        for line in lines:
            infomsg(line)
            parts = line.split()
            if len(parts) > 0:
                if parts[0] == "lastCompletedBuild":
                    lastCompletedBuild = int(parts[1])
                elif parts[0] == "lastStableBuild":
                    lastStableBuild = int(parts[1])
                elif parts[0] == "lastSuccessfulBuild":
                    lastSuccessfulBuild = int(parts[1])
        isOK = (lastSuccessfulBuild == lastStableBuild) and (lastSuccessfulBuild == lastCompletedBuild) and (lastSuccessfulBuild > 0)
        infomsg(entry + " " + str(lastCompletedBuild) + " " + str(lastStableBuild) + " " + str(lastSuccessfulBuild) + " " + str(isOK))
        return isOK


async def docheckjenkinsjobs(directory, critical):
    jobspath = os.path.join(directory, "jobs")
    if not os.path.isdir(jobspath):
        exitnagios("CRITICAL", "the jobs path " + directory + " does not exists")

    listjobs = []
    for entry in os.listdir(jobspath):
        pathentry = os.path.join(jobspath, entry)
        if os.path.isdir(pathentry):
            listjobs.append(entry)

    issuesjobs = []
    alertsjobs = []
    for entry in listjobs:
        if not await isvalidjob(jobspath, entry):
            if entry in critical:
                alertsjobs.append(entry)
            else:
                issuesjobs.append(entry)

    if len(alertsjobs) > 0:
        if len(issuesjobs) == 0:
            exitnagios("CRITICAL", "some jenkins jobs have alerts: " + " ".join(alertsjobs) + " | alerts=" + str(len(alertsjobs)) + " issues=0")
        else:
            exitnagios("CRITICAL", "some jenkins jobs have alerts: " + " ".join(alertsjobs) + " and some jenkins jobs have issues: " + " ".join(issuesjobs) + " | alerts=" + str(len(alertsjobs)) + " issues=" + str(len(issuesjobs)))
    elif len(issuesjobs) > 0:
        exitnagios("WARNING", "some jenkins jobs have issues: " + " ".join(issuesjobs) + " | alerts=0 issues=" + str(len(issuesjobs)))
    else:
        exitnagios("OK", "all jenkins jobs are in valid state | alerts=0 issues=0")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-r", "--directory", action="store", default="/var/lib/jenkins", help="path for the jenkins working folder")
    parser.add_argument("-c", "--critical", action="store", default="", help="jobs that will raise a critical")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    critical = args.critical.split(",")
    critical = [job for job in critical if job != ""]
    await docheckjenkinsjobs(args.directory, critical)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
