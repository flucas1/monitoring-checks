#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import asyncio

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="check_eximailqueue - Nagios Exim mail queue check script")
    parser.add_argument("-w", '--warning', dest="warning", type=int, required=True, help="Queue size at which a warning is triggered")
    parser.add_argument("-c", '--critical', dest="critical", type=int, required=True, help="Queue size at which a critical is triggered")
    parser.add_argument("-d", '--debug', dest="debug", action="store_true", help="Enable debug mode")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    try:
        process = await asyncio.create_subprocess_exec(
            "/usr/sbin/exim", "-bpc",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode().strip() if stdout else ""
    except (FileNotFoundError, Exception):
        output = ""

    # Check if the output is empty or invalid
    if not output or not output.isdigit():
        print("Mailqueue WARNING - query returned no output!")
        sys.exit(STATE_WARNING)

    queue_size = int(output)

    # Evaluate thresholds and return information and exit status
    if queue_size >= args.critical:
        print("CRITICAL:- " + str(queue_size) + " messages on queue | queue=" + str(queue_size))
        sys.exit(STATE_CRITICAL)
    elif queue_size >= args.warning:
        print("WARNING: " + str(queue_size) + " messages on queue | queue=" + str(queue_size))
        sys.exit(STATE_WARNING)
    else:
        print("OK: " + str(queue_size) + " messages on queue | queue=" + str(queue_size))
        sys.exit(STATE_OK)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
