#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import ntplib
import asyncio


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-h", action="store_true")
    parser.add_argument("-H", dest="ntpserver", default="172.16.4.253")
    parser.add_argument("-w", dest="warnlevel", type=float, default=150.0)
    parser.add_argument("-c", dest="critlevel", type=float, default=300.0)

    args = parser.parse_args()

    if args.warnlevel == 0:
        args.warnlevel = 150.0
    if args.critlevel == 0:
        args.critlevel = 300.0

    if args.warnlevel >= args.critlevel:
        print("*** WARN level must be less than CRITICAL!\n")
        usage()

    warningpos = args.warnlevel
    warningneg = args.warnlevel * -1.0
    criticalpos = args.critlevel
    criticalneg = args.critlevel * -1.0

    ntpserver = args.ntpserver

    client = ntplib.NTPClient()
    try:
        response = client.request(ntpserver, version=3)
        offset = response.offset
    except Exception:
        print(f"CRITICAL: NTP Server {ntpserver} is unreachable")
        sys.exit(2)

    if offset >= 0:
        if offset >= criticalpos:
            print(f"CRITICAL: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningpos:.6f};{criticalpos:.6f};")
            sys.exit(2)
        elif offset >= warningpos:
            print(f"WARNING: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningpos:.6f};{criticalpos:.6f};")
            sys.exit(1)
        else:
            print(f"OK: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningpos:.6f};{criticalpos:.6f};")
            sys.exit(0)

    if offset <= criticalneg:
        print(f"CRITICAL: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningneg:.6f};{criticalneg:.6f};")
        sys.exit(2)
    elif offset <= warningneg:
        print(f"WARNING: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningneg:.6f};{criticalneg:.6f};")
        sys.exit(1)
    else:
        print(f"OK: Offset {offset:.6f} secs|offset={offset:.6f}s;{warningneg:.6f};{criticalneg:.6f};")
        sys.exit(0)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
