#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import ntplib
import asyncio


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", dest="ntpserver", default="172.16.4.253")
    parser.add_argument("-w", dest="warnlevel", type=float, default=150.0)
    parser.add_argument("-c", dest="critlevel", type=float, default=300.0)
    args = parser.parse_args()

    if args.warnlevel == 0:
        args.warnlevel = 150.0
    if args.critlevel == 0:
        args.critlevel = 300.0

    if args.warnlevel >= args.critlevel:
        exitnagios("UNKNOWN", "WARNING level must be less than CRITICAL!")

    warningpos = args.warnlevel
    warningneg = args.warnlevel * -1.0
    criticalpos = args.critlevel
    criticalneg = args.critlevel * -1.0

    ntpserver = args.ntpserver

    client = ntplib.NTPClient()
    try:
        # Run the synchronous network call in a separate thread to avoid blocking the event loop
        response = await asyncio.to_thread(client.request, ntpserver, version=3)
        offset = response.offset
    except Exception:
        exitnagios("CRITICAL", "NTP Server " + str(ntpserver) + " is unreachable")

    if offset >= 0:
        msg = "Offset " + format(offset, ".6f") + " secs|offset=" + format(offset, ".6f") + "s;" + format(warningpos, ".6f") + ";" + format(criticalpos, ".6f") + ";"
        if offset >= criticalpos:
            exitnagios("CRITICAL", msg)
        elif offset >= warningpos:
            exitnagios("WARNING", msg)
        else:
            exitnagios("OK", msg)
    else:
        msg = "Offset " + format(offset, ".6f") + " secs|offset=" + format(offset, ".6f") + "s;" + format(warningneg, ".6f") + ";" + format(criticalneg, ".6f") + ";"
        if offset <= criticalneg:
            exitnagios("CRITICAL", msg)
        elif offset <= warningneg:
            exitnagios("WARNING", msg)
        else:
            exitnagios("OK", msg)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
