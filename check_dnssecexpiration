#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import re
import sys
import datetime

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def run_cmd(cmd):
    """Executes a shell command asynchronously and returns the stripped stdout."""
    try:
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        if process.returncode != 0:
            raise Exception("Command failed with code " + str(process.returncode) + ": " + stderr.decode().strip())
        return stdout.decode().strip()
    except Exception as e:
        print("UNKNOWN: Command execution failed - " + str(e))
        sys.exit(3)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check DNSSEC validity and remaining expiration time.")
    parser.add_argument("-H", dest="zone", required=True, help="specify zone to check")
    parser.add_argument("-w", dest="warning", type=int, default=5, help="warning time left days")
    parser.add_argument("-c", dest="critical", type=int, default=2, help="critical time left days")
    parser.add_argument("-r", dest="resolver", default="8.8.8.8", help="specify which resolver to use")
    parser.add_argument("-f", dest="always_failing_domain", default="dnssec-failed.org", help="specify a domain that will always fail DNSSEC")
    parser.add_argument("-t", dest="record_type", default="SOA", help="specify a DNS record type to check")
    parser.add_argument("-d", "--debug", action="store_true", help="enable debug mode")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Check the resolver to properly validate DNSSEC at all
    resolver_cmd = ["dig", "+nocmd", "+nostats", "+noquestion", args.always_failing_domain, "@" + args.resolver]
    resolver_out = await run_cmd(resolver_cmd)
    if "opcode: QUERY" not in resolver_out or "status: SERVFAIL" not in resolver_out:
        print("WARNING: Resolver seems to not validate DNSSEC signatures - going further seems hopeless right now.")
        sys.exit(1)

    # Check if the resolver delivers an answer for the domain to test
    check_resolvable_out = await run_cmd(["dig", "+short", "@" + args.resolver, "SOA", args.zone])
    if not check_resolvable_out:
        # Check explicit disabled validation
        check_cd_out = await run_cmd(["dig", "+short", "@" + args.resolver, "SOA", args.zone, "+cd"])
        if check_cd_out:
            print("CRITICAL: The domain " + args.zone + " can be validated without DNSSEC validation - but will fail on resolvers that do validate DNSSEC.")
            sys.exit(2)
        else:
            print("CRITICAL: The domain " + args.zone + " cannot be resolved via " + args.resolver + " as resolver while DNSSEC validation is active.")
            sys.exit(2)

    # Check if the domain is DNSSEC signed at all
    check_signed_out = await run_cmd(["dig", args.zone, "@" + args.resolver, "DS", "+short"])
    if not check_signed_out:
        print("WARNING: Zone " + args.zone + " seems to be unsigned itself (= resolvable, but no DNSSEC involved at all)")
        sys.exit(1)

    # Check if there are multiple RRSIG responses and check them one after the other
    now = datetime.datetime.now(datetime.timezone.utc).timestamp()
    rrsig_out = await run_cmd(["dig", "@" + args.resolver, args.record_type, args.zone, "+dnssec"])
    rrsig_lines = [line for line in rrsig_out.split('\n') if 'RRSIG' in line and not line.startswith(';')]

    if not rrsig_lines:
        print("CRITICAL: There is no RRSIG for the " + args.record_type + " of your zone.")
        sys.exit(2)

    max_remaining_lifetime = None
    max_remaining_days = None

    for rrsig in rrsig_lines:
        parts = rrsig.split()
        if len(parts) < 10:
            continue

        # Get the RRSIG entry and extract the date out of it (assuming standard dig formatting)
        expiry_str = parts[8]
        inception_str = parts[9]

        if not re.match(r'^[0-9]{14}$', expiry_str):
            print("UNKNOWN: Something went wrong while checking the expiration of the RRSIG entry - investigate please.")
            sys.exit(3)

        if not re.match(r'^[0-9]{14}$', inception_str):
            print("UNKNOWN: Something went wrong while checking the inception date of the RRSIG entry - investigate please.")
            sys.exit(3)

        # Parse the YYYYMMDDHHMMSS strings into UTC datetimes
        expiry_dt = datetime.datetime.strptime(expiry_str, "%Y%m%d%H%M%S").replace(tzinfo=datetime.timezone.utc)
        inception_dt = datetime.datetime.strptime(inception_str, "%Y%m%d%H%M%S").replace(tzinfo=datetime.timezone.utc)

        expiry_ts = expiry_dt.timestamp()
        inception_ts = inception_dt.timestamp()

        # Calculate the remaining lifetime of the signature
        remaining_lifetime = int(expiry_ts - now)
        remaining_days = remaining_lifetime // 86400

        # Store the result of this single RRSIG's check
        if max_remaining_lifetime is None or remaining_lifetime > max_remaining_lifetime:
            max_remaining_lifetime = remaining_lifetime
            max_remaining_days = remaining_days

    if max_remaining_lifetime is None:
        print("UNKNOWN: Could not parse any valid RRSIG dates.")
        sys.exit(3)

    # Determine if we need to alert, depending on warning/critical thresholds provided
    perf_data = "| sig_lifetime=" + str(max_remaining_lifetime) + "  sig_lifetime_days=" + str(max_remaining_days) + "%;" + str(args.warning) + ";" + str(args.critical)

    if max_remaining_days < args.critical:
        print("CRITICAL: DNSSEC signature for " + args.zone + " is very short before expiration! (" + str(max_remaining_days) + " days remaining) " + perf_data)
        sys.exit(2)
    elif max_remaining_days < args.warning:
        print("WARNING: DNSSEC signature for " + args.zone + " is short before expiration! (" + str(max_remaining_days) + " days remaining) " + perf_data)
        sys.exit(1)
    else:
        print("OK: DNSSEC signatures for " + args.zone + " seem to be valid and not expired (" + str(max_remaining_days) + " days remaining) " + perf_data)
        sys.exit(0)


# -------------------------------------------------------------------------------


if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
