#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import shutil
import subprocess
import sys
import re
from datetime import datetime, timezone


def run_cmd(cmd):
    """Executes a shell command and returns the stripped stdout."""
    try:
        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        return result.stdout.strip()
    except Exception as e:
        print(f"UNKNOWN: Command execution failed - {e}")
        sys.exit(3)


def main():
    # Parse the input options
    parser = argparse.ArgumentParser(
        description="Check DNSSEC validity and remaining expiration time.",
        add_help=False
    )
    parser.add_argument("-H", dest="zone", required=True, help="specify zone to check")
    parser.add_argument("-w", dest="warning", type=int, default=5, help="warning time left days")
    parser.add_argument("-c", dest="critical", type=int, default=2, help="critical time left days")
    parser.add_argument("-r", dest="resolver", default="8.8.8.8", help="specify which resolver to use")
    parser.add_argument("-f", dest="always_failing_domain", default="dnssec-failed.org", help="specify a domain that will always fail DNSSEC")
    parser.add_argument("-t", dest="record_type", default="SOA", help="specify a DNS record type to check")
    parser.add_argument("-h", "--help", action="help", help="show this help message and exit")

    try:
        args = parser.parse_args()
    except SystemExit:
        sys.exit(255)  # Replicating the bash exit code 255 on usage error

    # Check if dig is available at all - fail hard if not
    if not shutil.which("dig"):
        print("No executable of dig found, cannot proceed without dig. Sorry!")
        sys.exit(1)

    # Check the resolver to properly validate DNSSEC at all
    resolver_cmd = ["dig", "+nocmd", "+nostats", "+noquestion", args.always_failing_domain, f"@{args.resolver}"]
    resolver_out = run_cmd(resolver_cmd)
    if "opcode: QUERY" not in resolver_out or "status: SERVFAIL" not in resolver_out:
        print("WARNING: Resolver seems to not validate DNSSEC signatures - going further seems hopeless right now.")
        sys.exit(1)

    # Check if the resolver delivers an answer for the domain to test
    check_resolvable_out = run_cmd(["dig", "+short", f"@{args.resolver}", "SOA", args.zone])
    if not check_resolvable_out:
        # Check explicit disabled validation
        check_cd_out = run_cmd(["dig", "+short", f"@{args.resolver}", "SOA", args.zone, "+cd"])
        if check_cd_out:
            print(f"CRITICAL: The domain {args.zone} can be validated without DNSSEC validation - but will fail on resolvers that do validate DNSSEC.")
            sys.exit(2)
        else:
            print(f"CRITICAL: The domain {args.zone} cannot be resolved via {args.resolver} as resolver while DNSSEC validation is active.")
            sys.exit(2)

    # Check if the domain is DNSSEC signed at all
    check_signed_out = run_cmd(["dig", args.zone, f"@{args.resolver}", "DS", "+short"])
    if not check_signed_out:
        print(f"WARNING: Zone {args.zone} seems to be unsigned itself (= resolvable, but no DNSSEC involved at all)")
        sys.exit(1)

    # Check if there are multiple RRSIG responses and check them one after the other
    now = datetime.now(timezone.utc).timestamp()
    rrsig_out = run_cmd(["dig", f"@{args.resolver}", args.record_type, args.zone, "+dnssec"])
    rrsig_lines = [line for line in rrsig_out.split('\n') if 'RRSIG' in line and not line.startswith(';')]

    if not rrsig_lines:
        print(f"CRITICAL: There is no RRSIG for the {args.record_type} of your zone.")
        sys.exit(2)

    max_remaining_lifetime = None
    max_remaining_days = None

    for rrsig in rrsig_lines:
        parts = rrsig.split()
        if len(parts) < 10:
            continue

        # Get the RRSIG entry and extract the date out of it (assuming standard dig formatting)
        expiry_str = parts[8]
        inception_str = parts[9]

        if not re.match(r'^[0-9]{14}$', expiry_str):
            print("UNKNOWN: Something went wrong while checking the expiration of the RRSIG entry - investigate please.")
            sys.exit(3)

        if not re.match(r'^[0-9]{14}$', inception_str):
            print("UNKNOWN: Something went wrong while checking the inception date of the RRSIG entry - investigate please.")
            sys.exit(3)

        # Parse the YYYYMMDDHHMMSS strings into UTC datetimes
        expiry_dt = datetime.strptime(expiry_str, "%Y%m%d%H%M%S").replace(tzinfo=timezone.utc)
        inception_dt = datetime.strptime(inception_str, "%Y%m%d%H%M%S").replace(tzinfo=timezone.utc)

        expiry_ts = expiry_dt.timestamp()
        inception_ts = inception_dt.timestamp()

        # Calculate the remaining lifetime of the signature
        remaining_lifetime = int(expiry_ts - now)
        remaining_days = remaining_lifetime // 86400

        # Store the result of this single RRSIG's check
        if max_remaining_lifetime is None or remaining_lifetime > max_remaining_lifetime:
            max_remaining_lifetime = remaining_lifetime
            max_remaining_days = remaining_days

    if max_remaining_days is None:
        print("UNKNOWN: Could not parse any valid RRSIG dates.")
        sys.exit(3)

    # Determine if we need to alert, depending on warning/critical thresholds provided
    perf_data = f"| sig_lifetime={max_remaining_lifetime}  sig_lifetime_days={max_remaining_days}%;{args.warning};{args.critical}"

    if max_remaining_days < args.critical:
        print(f"CRITICAL: DNSSEC signature for {args.zone} is very short before expiration! ({max_remaining_days} days remaining) {perf_data}")
        sys.exit(2)
    elif max_remaining_days < args.warning:
        print(f"WARNING: DNSSEC signature for {args.zone} is short before expiration! ({max_remaining_days} days remaining) {perf_data}")
        sys.exit(1)
    else:
        print(f"OK: DNSSEC signatures for {args.zone} seem to be valid and not expired ({max_remaining_days} days remaining) {perf_data}")
        sys.exit(0)


if __name__ == "__main__":
    main()
