#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import asyncio
import hashlib
import json
import logging
import pathlib
import pickle
import re
import sys
import time
import aiofiles

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


STATE_FILE_PATH = "/tmp"


def prettify_size(size, multiplier):
    binary_str = "i" if multiplier == 1024 else ""
    for unit in ("", f"K{binary_str}", f"M{binary_str}", f"G{binary_str}"):
        if abs(size) < multiplier:
            return str(size) + unit
        size /= multiplier
    return str(size) + "T" + binary_str


def human_size(string):
    match = re.search(r"\A(\d+)([KMGT]?)\Z", string, flags=re.I)
    if not match:
        raise argparse.ArgumentTypeError("invalid argument: " + string + ", must be an integer, optionally followed by K, M, G or T (case-insensitive)")
    value, unit = match.groups()
    units = ("", "K", "M", "G", "T")
    power = units.index(unit.upper())
    return int(value), power


async def run_command(command):
    try:
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )
        stdout, stderr = await process.communicate()
        if process.returncode != 0:
            exitnagios("UNKNOWN", "command " + str(command) + " exited with status " + str(process.returncode) + ": " + repr(stderr.decode()))
        infomsg("Output from " + " ".join(command) + ": " + stdout.decode())
        return stdout.decode()
    except Exception as exc:
        exitnagios("UNKNOWN", "command " + str(command) + " failed: " + str(exc))


async def get_interfaces(args):
    netns_info = []
    if args.include_netns:
        command_output = await run_command(["ip", "-json", "netns", "list"])
        if command_output:
            netns_info = json.loads(command_output)
    interfaces = []
    for netns in [None] + netns_info:
        if netns is None:
            command = ["ip"]
            netns_name = None
        else:
            command = ["sudo", "-n", "ip"]
            netns_name = netns["name"]
            command += ["-netns", netns_name]
        command += ["-details", "-statistics", "-json", "link", "show"]
        interfaces_by_netns = json.loads(await run_command(command))
        for interface in interfaces_by_netns:
            interface["netns_name"] = netns_name
            if netns_name is None:
                interface["pretty_ifname"] = interface["ifname"]
            else:
                interface["pretty_ifname"] = netns_name + "/" + interface["ifname"]
        interfaces.extend(interfaces_by_netns)
    execution_time = time.time()
    return execution_time, interfaces


def include_interface(interface, args):
    interface_name = interface["ifname"]
    interface_pretty_name = interface["pretty_ifname"]
    interface_type = interface["link_type"]
    if "linkinfo" in interface and "info_kind" in interface["linkinfo"]:
        interface_type = interface["linkinfo"]["info_kind"]
    interface["computed_type"] = interface_type

    if not args.down and interface["operstate"] == "DOWN":
        infomsg("[-] Skipping interface " + interface_pretty_name + " (operstate DOWN)")
        return False

    if interface_type in args.exclude_type:
        infomsg("[-] Skipping interface " + interface_pretty_name + " (type " + interface_type + " matches " + str(args.exclude_type) + ")")
        return False
    if args.exclude_name and re.search(args.exclude_name, interface_name):
        infomsg("[-] Skipping interface " + interface_pretty_name + " (name matches " + args.exclude_name + ")")
        return False

    inclusion_tests = []
    if args.type:
        inclusion_tests.append(("type", args.type, interface_type in args.type))
    if args.name:
        inclusion_tests.append(("name", args.name, re.search(args.name, interface_name)))
    if inclusion_tests:
        messages = []
        tests_match = True
        for test_type, test_str, test_result in inclusion_tests:
            verb = "matches" if test_result else "does not match"
            additional_info = " " + interface_type if test_type == "type" else ""
            messages.append(test_type + additional_info + " " + verb + " " + str(test_str))
            tests_match = tests_match and test_result
        infomsg(("[+] Including" if tests_match else "[-] Skipping") + " interface " + interface_pretty_name + " (" + ", ".join(messages) + ")")
        return tests_match

    infomsg("[+] Including interface " + interface_pretty_name + " of type " + interface_type + " (no inclusion filter specified)")
    return True


async def load_state(state_file):
    try:
        async with aiofiles.open(state_file, "rb") as f:
            content = await f.read()
            state = json.loads(content.decode("utf-8"))
            infomsg("Loaded old metrics from " + str(state_file))
            return state
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


async def save_state(state_file, state):
    async with aiofiles.open(state_file, "wb") as f:
        content = json.dumps(state).encode("utf-8")
        await f.write(content)


def check_thresholds(value, warn, crit):
    if crit is not None and value >= crit:
        return "CRITICAL"
    if warn is not None and value >= warn:
        return "WARNING"
    return "OK"


def evaluate_traffic(filtered_interfaces, old_state, current_state, args, state_file):
    overall_status = "OK"
    messages = []
    perf_data = []

    if not old_state:
        overall_status = "WARNING"
        messages.append("no data in state file " + str(state_file) + ", first run?")
        return overall_status, messages, perf_data

    time_delta = current_state["execution_time"] - old_state["execution_time"]
    multiplier = 1 if args.bytes else 8
    unit = "B" if args.bytes else "b"

    for interface in filtered_interfaces:
        interface_name = interface["pretty_ifname"]

        if interface_name not in old_state["statistics"]:
            overall_status = max(overall_status, "WARNING")
            messages.append("no data in state file for " + interface_name + ", new interface?")
            continue

        for direction in ("rx", "tx"):
            current_bytes = current_state["statistics"][interface_name][direction]
            old_bytes = old_state["statistics"][interface_name][direction]
            bandwidth = multiplier * (current_bytes - old_bytes) / time_delta

            if bandwidth < 0:
                overall_status = max(overall_status, "WARNING")
                messages.append("Counter for " + interface_name + "/" + direction + " is decreasing, this could be caused by a reboot")
                continue

            warn_limit = getattr(args, "warning_" + direction)
            crit_limit = getattr(args, "critical_" + direction)

            metric_status = check_thresholds(bandwidth, warn_limit, crit_limit)
            overall_status = max(overall_status, metric_status)

            human_readable = prettify_size(bandwidth, 1024 if args.bytes else 1000)
            perf_str = "'" + interface_name + "_" + direction + "'=" + str(bandwidth) + unit + ";" + (str(warn_limit) if warn_limit else "") + ";" + (str(crit_limit) if crit_limit else "") + ";;"
            perf_data.append(perf_str)

            messages.append(interface_name + "_" + direction + " = " + human_readable + unit + "/s")

    return overall_status, messages, perf_data


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    filter_group = parser.add_argument_group("filtering options, exclusions are applied before inclusions, increase verbosity for details")
    filter_group.add_argument("-t", "--type", help="only select interfaces of this type, can be specified multiple times", action="append", default=[])
    filter_group.add_argument("-T", "--exclude-type", help="exclude interfaces of this type, can be specified multiple times", action="append", default=[])
    filter_group.add_argument("-n", "--name", help="only select interfaces whose names match this regular expression")
    filter_group.add_argument("-N", "--exclude-name", help="exclude interfaces whose names match this regular expression")
    filter_group.add_argument("-D", "--down", help="include interfaces whose operstate is down", action="store_true", default=False)
    filter_group.add_argument("--include-netns", help='include interfaces from non-default network namespaces, the netns will be prepended to the interface name with a slash, e.g. "container/wg0"', action="store_true", default=False)
    parser.add_argument("-b", "--bytes", help="use bytes as output unit instead of bits, does not affect thresholds", action="store_true", default=False)
    threshold_group = parser.add_argument_group("threshold options, suffixes K, M, G and T (case-insensitive) are accepted, multiples of 1000 are used for bits and 1024 for bytes")
    threshold_group.add_argument("-w", "--warning", metavar=("RX", "TX"), nargs=2, help="warning threshold", type=human_size)
    threshold_group.add_argument("-c", "--critical", metavar=("RX", "TX"), nargs=2, help="critical threshold", type=human_size)
    parser.add_argument("-d", "--debug", help="enable debug output", default=False, action="store_true")
    args = parser.parse_args(forcedargs)
    multiplier = 1024 if args.bytes else 1000
    for threshold in ("warning", "critical"):
        arg = getattr(args, threshold)
        for i, direction in enumerate(("rx", "tx")):
            setattr(args, threshold + "_" + direction, None)
            if arg:
                setattr(args, threshold + "_" + direction, arg[i][0] * multiplier ** arg[i][1])
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    relevant_args = []
    for arg, arg_val in sorted(vars(args).items()):
        if arg not in ("debug"):
            relevant_args.append((arg, arg_val))
    args_hash = hashlib.sha1(pickle.dumps(relevant_args)).hexdigest()
    state_file = pathlib.Path(STATE_FILE_PATH) / ("." + "check_traffic" + "_" + args_hash + ".json")

    old_state = await load_state(state_file)
    execution_time, interfaces = await get_interfaces(args)

    if not interfaces:
        exitnagios("UNKNOWN", "No interfaces found")

    filtered_interfaces = [e for e in interfaces if include_interface(e, args)]
    infomsg("Included interfaces: " + ", ".join(e["pretty_ifname"] for e in filtered_interfaces))

    if not filtered_interfaces:
        exitnagios("UNKNOWN", "No matching interfaces found after applying filters")

    current_state = {"execution_time": execution_time, "statistics": {}}
    for interface in filtered_interfaces:
        interface_name = interface["pretty_ifname"]
        current_state["statistics"][interface_name] = {"rx": interface["stats64"]["rx"]["bytes"], "tx": interface["stats64"]["tx"]["bytes"]}

    status, messages, perf_data = evaluate_traffic(filtered_interfaces, old_state, current_state, args, state_file)

    await save_state(state_file, current_state)
    exitnagios(status, ", ".join(messages) if messages else "")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

