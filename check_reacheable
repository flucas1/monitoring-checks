#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import socket
import netifaces
import random
import asyncio
import icmplib

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def resolve_hostname_to_ip(hostname, protocol):
    try:
        targetip = socket.gethostbyname(hostname).strip()
        return targetip
    except Exception:
        return ""


def interface_to_address(interface, protocol):
    primary_ip = None
    if interface != "":
        try:
            infomsg("protocol is " + protocol)
            addresses = netifaces.ifaddresses(interface)
            ip_info = []
            if protocol in ["-4", "4"]:
                ip_info4 = addresses.get(netifaces.AF_INET)
                if ip_info4 is not None:
                    ip_info.append(ip_info4[0]["addr"])
            elif protocol in ["-6", "6"]:
                ip_info6 = addresses.get(netifaces.AF_INET6)
                if ip_info6 is not None:
                    ip_info.append(ip_info6[0]["addr"])
            else:
                ip_info4 = addresses.get(netifaces.AF_INET)
                if ip_info4 is not None:
                    ip_info.append(ip_info4[0]["addr"])
                ip_info6 = addresses.get(netifaces.AF_INET6)
                if ip_info6 is not None:
                    ip_info.append(ip_info6[0]["addr"])
                random.shuffle(ip_info)
            infomsg("------> " + str(ip_info))
            if ip_info is not None and len(ip_info) > 0:
                primary_ip = ip_info[0]
            else:
                infomsg("could not get interface ip for " + interface)
        except Exception as e:
            infomsg("exception - " + str(e))
    infomsg("The ip for interface " + interface + " is " + str(primary_ip))
    return primary_ip


async def dopingtestsingle(protocol, interface, packets, timeout, hostname, warningms, warningpercent, criticalms, criticalpercent):
    family = socket.AF_UNSPEC
    if protocol == "-4":
        family = socket.AF_INET
    elif protocol == "-6":
        family = socket.AF_INET6

    source = interface_to_address(interface, protocol)

    try:
        resolvedip = await resolve_hostname_to_ip(hostname, protocol)
        infomsg("The hostname " + hostname + " resolves into " + str(resolvedip))
        host = await asyncio.wait_for(icmplib.async_ping(resolvedip, count=int(packets), timeout=2, interval=0.2, family=family, source=source, privileged=False), timeout=timeout)
    except asyncio.TimeoutError:
        return [2, -1, 100.0, "error"]
    except Exception as e:
        infomsg(str(e))
        return [2, -1, 100.0, "error"]

    if not host.is_alive or host.packets_received == 0:
        avgms = -1.0
        percent = 100.0
    else:
        avgms = host.avg_rtt if host.avg_rtt is not None else -1.0
        percent = round(host.packet_loss * 100.0, 1)

    if avgms >= criticalms or avgms == -1.0:
        reason = "critical latency"
        infomsg(reason)
        return [2, avgms, percent, reason]
    elif percent >= criticalpercent:
        reason = "critical ping loss"
        infomsg(reason)
        return [2, avgms, percent, reason]
    elif avgms >= warningms:
        reason = "warning latency"
        infomsg(reason)
        return [1, avgms, percent, reason]
    elif percent >= warningpercent:
        reason = "warning ping loss"
        infomsg(reason)
        return [1, avgms, percent, reason]
    else:
        reason = "no issues"
        infomsg(reason)
        return [0, avgms, percent, reason]


async def dopingtestmulti(protocol, interface, packets, timeoutvalue, timeoutstatus, hostname, minimum, warningms, warningpercent, criticalms, criticalpercent):
    hosts = hostname.replace(",", " ").split()
    total_valid = 0
    warning = 0
    total_latency = 0
    total_percent_loss = 0
    okreasons = []
    warnreasons = []
    critreasons = []

    if protocol == "":
        protocolslist = ["-4", "-6"]
    elif protocol == "-4":
        protocolslist = ["-4"]
    elif protocol == "-6":
        protocolslist = ["-6"]
    else:
        protocolslist = []

    tasks = []
    for hostsingle in hosts:
        for protocol in protocolslist:
            task = dopingtestsingle(protocol, interface, packets, timeoutvalue, hostsingle, warningms, warningpercent, criticalms, criticalpercent)
            tasks.append(task)

    results = await asyncio.gather(*tasks, return_exceptions=True)
    for result in results:
        if isinstance(result, list):
            total_latency += result[1]
            total_percent_loss += result[2]
            reason = result[3]
            if result[0] == 0:
                total_valid += 1
                if reason not in okreasons:
                    okreasons.append(reason)
            elif result[0] == 1:
                warning += 1
                if reason not in warnreasons:
                    warnreasons.append(reason)
            else:
                if reason not in critreasons:
                    critreasons.append(reason)
        infomsg(str(result))

    total_tests = len(hosts) * len(protocolslist)
    if total_tests == 0:
        average_latency = 0.0
        average_percent_loss = 0.0
        valid_ratio = 0.0
    else:
        average_latency = total_latency / total_tests
        average_percent_loss = total_percent_loss / total_tests
        valid_ratio = total_valid / total_tests
    success_percent = 100.0 - average_percent_loss

    if valid_ratio >= minimum:
        return ("OK", hostname + " - " + str(valid_ratio) + " of at least " + str(minimum) + " entries are reachable - " + str(okreasons) + " | valid=" + str(valid_ratio) + " warning=" + str(warning) + " average=" + str(average_latency) + " percent=" + str(success_percent))
    elif valid_ratio + warning >= minimum:
        return ("WARNING", hostname + " - " + str(valid_ratio) + " of at least " + str(minimum) + " entries are reachable - " + str(warnreasons) + " | valid=" + str(valid_ratio) + " warning=" + str(warning) + " average=" + str(average_latency) + " percent=" + str(success_percent))
    else:
        return (timeoutstatus, hostname + " - only " + str(valid_ratio) + " of at least " + str(minimum) + " entries are reachable - " + str(critreasons) + " | valid=" + str(valid_ratio) + " warning=" + str(warning) + " average=-1 percent=0")


async def dopingtestretry(retries, protocol, interface, packets, timeoutvalue, timeoutstatus, hostname, minimum, warningms, warningpercent, criticalms, criticalpercent):
    counter = 0
    while True:
        exitlevel, message = await dopingtestmulti(protocol, interface, packets, timeoutvalue, timeoutstatus, hostname, minimum, warningms, warningpercent, criticalms, criticalpercent)
        if (exitlevel == "OK") or (counter >= retries):
            exitnagios(exitlevel, message)
        else:
            counter += 1
            await asyncio.sleep(5)
    exitnagios("CRITICAL", "unexpected state")

