#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import argparse
import re


# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------

def compare(val, op, limit):
    try:
        fval = float(val)
        flimit = float(limit)
        is_num = True
    except ValueError:
        is_num = False

    if op == ">=":
        return is_num and fval >= flimit
    if op == ">":
        return is_num and fval > flimit
    if op == "<=":
        return is_num and fval <= flimit
    if op == "<":
        return is_num and fval < flimit
    if op == "==":
        return str(val) == str(limit)
    if op == "=":
        return is_num and fval == flimit
    if op == "<>":
        return is_num and fval != flimit
    if op == "!=":
        return str(val) != str(limit)
    if op == "~":
        return bool(re.search(str(limit), str(val)))
    if op == "!~":
        return not bool(re.search(str(limit), str(val)))
    return False

async def run_command(cmd):
    proc = await asyncio.create_subprocess_exec(
        *cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await proc.communicate()
    error_details = stderr.decode().strip()
    if proc.returncode != 0:
        raise RuntimeError("Command " + " ".join(cmd) + " failed with code " + str(proc.returncode) + ". " + error_details)
    return stdout.decode().strip()


# -------------------------------------------------------------------------------

# CHECK_DESC := UPSCKEY "=" SEVERITY OPERATOR VALUE [ ":" SEVERITY OPERATOR VALUE ]
# UPSCKEY : key string as listed by upsc, see "man upsc"
# SEVERITY := { "w" | "c" } ( "w" for warning, "c" for critical errors )
#     "w" : warning
#     "c" : critical
# OPERATOR := { ">=" | ">" | "<=" | | "<" "==" | "=" | "<>" | "!=" | "~" | "!~" }
#     ">=" : numerical comparison, reported value is greater or equal than VALUE
#     ">"  : numerical comparison, reported value is greater than VALUE
#     "<=" : numerical comparison, reported value is less or equal than VALUE
#     "<"  : numerical comparison, reported value is less than VALUE
#     "="  : numerical comparison, reported value is equal to VALUE
#     "<>" : numerical comparison, reported value is not equal to VALUE
#     "==" : string comparison, reported value is identical to VALUE
#     "!=" : string comparison, reported value is not identical to VALUE
#     "~"  : regex match, reported value matches the perl regular expression
#            given by VALUE
#     "!~" : regex match, reported value does not match the perl regular
#            expression given by VALUE
#     (for perl regular expressions see "man perlre")
# VALUE : the value representing the preset, might be a string, integer
#         or float, depending on OPERATOR

# NUT status is a combination of the following tags:
#     OL - On line (mains is present)
#     OB - On battery (mains is not present)
#     LB - Low battery
#     HB - High battery
#     RB - The battery needs to be replaced
#     CHRG - The battery is charging
#     DISCHRG - The battery is discharging (inverter is providing load power)
#     BYPASS - UPS bypass circuit is active -- no battery protection is available
#     CAL - UPS is currently performing runtime calibration (on battery)
#     OFF - UPS is offline and is not supplying power to the load
#     OVER - UPS is overloaded
#     TRIM - UPS is trimming incoming voltage (called "buck" in some hardware)
#     BOOST - UPS is boosting incoming voltage
#     FSD and SD - Forced Shutdown

async def main(forcedargs=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-d", "--device", type=str)
    parser.add_argument("-D", "--debug", action="store_true")
    parser.add_argument("-v", "--value", action="append", default=[])

    args = parser.parse_args()

    if not args.device:
        exitnagios("UNKNOWN", "Device not specified")

    limits = {}
    for v in args.value:
        if "=" in v:
            key, val = v.split("=", 1)
            limits[key] = val

    if not limits:
        exitnagios("UNKNOWN", "you have to specify some value to check")

    upsc_path = "/usr/bin/upsc"
    try:
        res = await run_command([upsc_path, args.device])
    except RuntimeError as e:
        exitnagios("UNKNOWN", "can't run '" + str(upsc_path) + " " + str(args.device) + "': " + str(e))

    ups_data = {}
    for line in res.splitlines():
        if ": " in line:
            key, val = line.split(": ", 1)
            ups_data[key] = val

    alarmlevel = 0
    critmesg = []
    warnmesg = []
    okmesg = []

    for key, limstring in limits.items():
        if key not in ups_data:
            exitnagios("UNKNOWN", "key '" + str(key) + "' is not defined in output from " + str(upsc_path))

        kvtriples = limstring.split(":")
        cmp_dict = {"c": [], "w": []}

        for kvtriple in kvtriples:
            match = re.match(r"^(c|w)(>=|>|==|=|<>|<=|<|!=|!~|~)(.*?)$", kvtriple)
            if match:
                severity, op, value = match.groups()
                cmp_dict[severity].append({"op": op, "value": value})
                if args.debug:
                    print("KV3: (" + str(severity) + "," + str(op) + "," + str(value) + ")")
            else:
                exitnagios("UNKNOWN", "ERROR: '" + str(kvtriple) + "' is invalid")

        if cmp_dict["c"]:
            cnthits = 0
            for comparison in cmp_dict["c"]:
                if args.debug:
                    print(str(key) + " " + str(ups_data[key]) + " " + str(comparison["op"]) + " " + str(comparison["value"]))
                if compare(ups_data[key], comparison["op"], comparison["value"]):
                    msg = "CRITICAL: " + str(ups_data[key]) + " " + str(comparison["op"]) + " " + str(comparison["value"]) + " | " + str(key) + "=" + str(ups_data[key])
                    if args.debug:
                        print(msg)
                    critmesg.append(msg)
                    if alarmlevel < 2:
                        alarmlevel = 2
                    cnthits += 1
            if cnthits:
                continue

        if cmp_dict["w"]:
            cnthits = 0
            for comparison in cmp_dict["w"]:
                if compare(ups_data[key], comparison["op"], comparison["value"]):
                    msg = "WARNING: " + str(ups_data[key]) + " " + str(comparison["op"]) + " " + str(comparison["value"]) + " | " + str(key) + "=" + str(ups_data[key])
                    if args.debug:
                        print(msg)
                    warnmesg.append(msg)
                    if alarmlevel < 1:
                        alarmlevel = 1
                    cnthits += 1
            if cnthits:
                continue

        if args.debug:
            print("OK: " + str(key) + "=" + str(ups_data[key]) + " | " + str(key) + "=" + str(ups_data[key]))
        okmesg.append("OK: " + str(key) + "=" + str(ups_data[key]) + " | " + str(key) + "=" + str(ups_data[key]))

    # Mapping alarmlevel back to status string directly based on exit code correlation
    statuses = ["OK", "WARNING", "CRITICAL", "UNKNOWN"]
    final_status = statuses[alarmlevel] if alarmlevel < len(statuses) else "UNKNOWN"

    combined_messages = " - ".join(critmesg + warnmesg + okmesg)
    exitnagios(final_status, combined_messages)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

