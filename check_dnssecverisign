def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--host", dest="host", help="Hostname")
    parser.add_argument("-e", "--expected", dest="expected", default="false", help="expected true/false")
    parser.add_argument("-t", "--tolerant", action="store_true", dest="tolerant", default=False, help="allow servers not responding")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    proxy = ""
    ignoremessages = []
    # ignoremessages.append("DS=44251/SHA-1 uses a deprecated digest algorithm")
    await dodnssecverisigncall(args.host, proxy, args.tolerant, ignoremessages)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

