#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import jsonpath_rw
import json
import ssl
import sys
import os
import argparse
import asyncio
import time
import zmqtt

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug() is True:
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    # Setup default values and parse command line arguments for the MQTT check
    DEFAULTS = {
        "mqtt_host": "localhost",
        "mqtt_port": 1883,
        "mqtt_username": None,
        "mqtt_password": None,
        "max_wait": 4,
        "keepalive": 60,
        "sleep": 0.1,
        "mqtt_cafile": None,
        "mqtt_certfile": None,
        "mqtt_keyfile": None,
        "mqtt_insecure": False,
        "check_topic": "nagios/test",
        "check_subscription": None,
        "mqtt_readonly": False,
        "mqtt_payload": "PiNG",
        "mqtt_jsonpath": None,
        "mqtt_value": "PiNG",
        "mqtt_operator": "equal",
        "warning": None,
        "critical": None,
        "short_output": False,
    }

    operators = ["eq", "equal", "lt", "lessthan", "gt", "greaterthan", "ct", "contains", "any"]

    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--host", metavar="<hostname>", help="mqtt host to connect to (default: " + DEFAULTS["mqtt_host"] + ")", dest="mqtt_host", default=DEFAULTS["mqtt_host"])
    parser.add_argument("-P", "--port", metavar="<port>", help="network port to connect to (default: " + str(DEFAULTS["mqtt_port"]) + ")", dest="mqtt_port", default=DEFAULTS["mqtt_port"], type=int)
    parser.add_argument("-u", "--username", metavar="<username>", help="MQTT username (default: " + str(DEFAULTS["mqtt_username"]) + ")", dest="mqtt_username", default=DEFAULTS["mqtt_username"])
    parser.add_argument("-p", "--password", metavar="<password>", help="MQTT password (default: " + str(DEFAULTS["mqtt_password"]) + ")", dest="mqtt_password", default=DEFAULTS["mqtt_password"])
    parser.add_argument("-m", "--max-wait", metavar="<seconds>", help="maximum time to wait for the check (default: " + str(DEFAULTS["max_wait"]) + " seconds)", dest="max_wait", default=DEFAULTS["max_wait"], type=int)
    parser.add_argument("-e", "--keepalive", metavar="<seconds>", help="maximum period in seconds allowed between communications with the broker (default: " + str(DEFAULTS["keepalive"]) + " seconds)", dest="keepalive", default=DEFAULTS["keepalive"], type=int)
    parser.add_argument("-L", "--sleep", metavar="<seconds>", help="main loop sleep period in seconds (default: " + str(DEFAULTS["sleep"]) + ")", dest="sleep", default=DEFAULTS["sleep"], type=float)
    parser.add_argument("-a", "--cafile", metavar="<cafile>", help="cafile (default: " + str(DEFAULTS["mqtt_cafile"]) + ")", dest="mqtt_cafile", default=DEFAULTS["mqtt_cafile"])
    parser.add_argument("-C", "--certfile", metavar="<certfile>", help="certfile (default: " + str(DEFAULTS["mqtt_certfile"]) + ")", dest="mqtt_certfile", default=DEFAULTS["mqtt_certfile"])
    parser.add_argument("-k", "--keyfile", metavar="<keyfile>", help="keyfile (default: " + str(DEFAULTS["mqtt_keyfile"]) + ")", dest="mqtt_keyfile", default=DEFAULTS["mqtt_keyfile"])
    parser.add_argument("-n", "--insecure", help="suppress TLS verification of server hostname" + (" (default)" if DEFAULTS["mqtt_insecure"] else ""), dest="mqtt_insecure", default=DEFAULTS["mqtt_insecure"], action="store_true")
    parser.add_argument("-i", "--topic", metavar="<topic>", help="topic to use for the active check (default: " + DEFAULTS["check_topic"] + ")", dest="check_topic", default=DEFAULTS["check_topic"])
    parser.add_argument("-s", "--subscription", metavar="<subscription>", help="topic to use for the passive check (default: " + str(DEFAULTS["check_subscription"]) + ")", dest="check_subscription", default=DEFAULTS["check_subscription"])
    parser.add_argument("-r", "--readonly", help="just read the value of the topic" + (" (default)" if DEFAULTS["mqtt_readonly"] else ""), dest="mqtt_readonly", default=DEFAULTS["mqtt_readonly"], action="store_true")
    parser.add_argument("-l", "--payload", metavar="<payload>", help="payload which will be PUBLISHed (default: " + DEFAULTS["mqtt_payload"] + "). If it starts with an exclamation mark (!) the output of the command will be used", dest="mqtt_payload", default=DEFAULTS["mqtt_payload"])
    parser.add_argument("-j", "--jsonpath", metavar="<jsonpath>", help="if given, payload is interpreted as JSON string and value is extracted using <jsonpath> (default: " + str(DEFAULTS["mqtt_jsonpath"]) + ")", dest="mqtt_jsonpath", default=DEFAULTS["mqtt_jsonpath"])
    parser.add_argument("-v", "--value", metavar="<value>", help="value to compare against received payload (default: " + DEFAULTS["mqtt_value"] + "). If it starts with an exclamation mark (!) the output of the command will be used", dest="mqtt_value", default=DEFAULTS["mqtt_value"])
    parser.add_argument("-o", "--operator", metavar="<operator>", help="operator to compare received value with value. Choose from " + str(operators) + " (default: " + DEFAULTS["mqtt_operator"] + "). 'eq' compares Strings, the other convert the arguments to float before compare", dest="mqtt_operator", default=DEFAULTS["mqtt_operator"], choices=operators)
    parser.add_argument("-w", "--warning", metavar="<expr>", help="Exit with WARNING status if <expr> is true (default: " + str(DEFAULTS["warning"]) + "). <expr> can be any Python expression, use <payload> within expression for current payload value.", dest="warning", default=DEFAULTS["warning"])
    parser.add_argument("-c", "--critical", metavar="<expr>", help="Exit with CRITICAL status if <expr> is true (default: " + str(DEFAULTS["critical"]) + "). <expr> can be any Python expression, use <payload> within expression for current payload value.", dest="critical", default=DEFAULTS["critical"])
    parser.add_argument("-S", "--short", help="use a shorter string on output" + (" (default)" if DEFAULTS["short_output"] else ""), dest="short_output", default=DEFAULTS["short_output"], action="store_true")
    parser.add_argument("-t", "--timeout", action="store", default="10:CRITICAL", help="timeout value:STATUS")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    timeoutparts = args.timeout.split(":")
    timeoutvalue = int(timeoutparts[0])
    timeoutstatus = "CRITICAL"
    if len(timeoutparts) > 1:
        timeoutstatus = timeoutparts[1]

    if args.check_subscription is None:
        args.check_subscription = args.check_topic

    start_time = time.monotonic()

    # TLS Configuration
    tls_context = None
    if args.mqtt_cafile is not None:
        tls_context = ssl.create_default_context(cafile=args.mqtt_cafile)
        if args.mqtt_certfile is not None:
            tls_context.load_cert_chain(certfile=args.mqtt_certfile, keyfile=args.mqtt_keyfile)
        if args.mqtt_insecure:
            tls_context.check_hostname = False
            tls_context.verify_mode = ssl.CERT_NONE

    client_kwargs = {
        "host": args.mqtt_host,
        "port": args.mqtt_port,
        "keepalive": args.keepalive,
        "client_id": "nagios-" + str(os.getpid())
    }

    if args.mqtt_username is not None:
        client_kwargs["username"] = args.mqtt_username
        client_kwargs["password"] = args.mqtt_password

    if tls_context is not None:
        client_kwargs["tls"] = tls_context

    infomsg("Starting loop")

    status = "OK"
    message = "no issues"
    try:
        async with zmqtt.create_client(**client_kwargs) as client:

            # Use zmqtt's context manager subscription to read messages
            async with client.subscribe(args.check_subscription) as messages:

                # Publish active check message if not explicitly in readonly mode
                if not args.mqtt_readonly:
                    await client.publish(args.check_topic, args.mqtt_payload, qos=zmqtt.QoS.EXACTLY_ONCE, retain=False)

                try:
                    time_left = args.max_wait - (time.monotonic() - start_time)
                    if time_left <= 0:
                        raise asyncio.TimeoutError

                    # Fetch the next message directly from the async subscription queue
                    msg = await asyncio.wait_for(messages.get_message(), timeout=time_left)

                    rawpayload = msg.payload.decode("utf-8")
                    infomsg("The rawpayload is " + str(rawpayload))

                    # Check jsonpath mapping to correctly extract payload values
                    if args.mqtt_jsonpath:
                        try:
                            jspayload = json.loads(rawpayload)
                            jspath = jsonpath_rw.parse(args.mqtt_jsonpath)
                            extractpayload = [match.value for match in jspath.find(jspayload)]
                            payload = extractpayload[0]
                        except Exception:
                            payload = None
                    else:
                        payload = rawpayload

                    infomsg("The payload is " + str(payload))

                    elapsed = time.monotonic() - start_time

                    if args.short_output:
                        message = "value=" + str(payload) + " | response_time=" + str("%.2f" % elapsed) + " value=" + str(payload)
                    else:
                        message = "message from " + args.check_subscription + " at " + args.mqtt_host + " in " + str("%.2f" % elapsed) + "s | response_time=" + str("%.2f" % elapsed) + " value=" + str(payload)

                    # Execute dynamic evaluation of warning/critical expression variables
                    if args.critical is not None or args.warning is not None:
                        infomsg("non-value checks")
                        status = "OK"
                        if args.critical is not None:
                            try:
                                if eval(args.critical):
                                    status = "CRITICAL"
                            except Exception:
                                status = "CRITICAL"
                                message = "critical expression error '" + args.critical + "'"
                        if status == "OK" and args.warning is not None:
                            try:
                                if eval(args.warning):
                                    status = "WARNING"
                            except Exception:
                                status = "CRITICAL"
                                message = "warning expression error '" + args.warning + "'"
                    else:
                        infomsg("value checks")
                        status = "CRITICAL"
                        try:
                            # Conditional operators verify payload dynamically to apply the exit statuses
                            if (args.mqtt_operator == "lt" or args.mqtt_operator == "lessthan") and float(payload) < float(args.mqtt_value):
                                status = "OK"
                            if (args.mqtt_operator == "gt" or args.mqtt_operator == "greaterthan") and float(payload) > float(args.mqtt_value):
                                status = "OK"
                            if (args.mqtt_operator == "eq" or args.mqtt_operator == "equal") and str(payload) == args.mqtt_value:
                                status = "OK"
                            if (args.mqtt_operator == "ct" or args.mqtt_operator == "contains") and str(payload).find(args.mqtt_value) != -1:
                                status = "OK"
                            if (args.mqtt_operator == "any") and payload:
                                status = "OK"
                        except Exception:
                            status = "CRITICAL"

                except asyncio.TimeoutError:
                    message = "timeout waiting for message"
                    status = timeoutstatus

    except Exception as e:
        status = "CRITICAL"
        message = "Connection to " + args.mqtt_host + ":" + str(args.mqtt_port) + " failed: " + str(type(e)) + " " + str(e)
        exitnagios(status, message)

    infomsg("Ending loop")
    infomsg("status: " + str(status))
    exitnagios(status, message)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
