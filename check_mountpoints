#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import os
import sys
import datetime
import argparse
import socket
import tempfile
import re
import asyncio
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def create_zfs_fstab(original_fstab):
    tmp_fstab = tempfile.NamedTemporaryFile(mode="wb+", delete=False)

    if os.path.exists(original_fstab):
        async with aiofiles.open(original_fstab, "rb") as f:
            content = await f.read()
            tmp_fstab.write(content)

    try:
        cmdline = ["zfs", "list", "-H", "-o", "name"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, _ = await process.communicate()
        zfs_list = stdout.decode().strip().splitlines()

        for ds in zfs_list:
            cmdline = ["zfs", "get", "-H", "mountpoint", ds]
            process = await asyncio.create_subprocess_exec(
                *cmdline,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await process.communicate()
            parts = stdout.decode().strip().split()
            if len(parts) < 3:
                continue
            mp = parts[2]
            if not os.path.isdir(mp):
                continue

            cmdline = ["zfs", "get", "-H", "canmount", ds]
            process = await asyncio.create_subprocess_exec(
                *cmdline,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await process.communicate()
            parts = stdout.decode().strip().split()
            if len(parts) < 3:
                continue
            canmount = parts[2]
            if canmount == "off":
                continue

            cmdline = ["zfs", "get", "-H", "readonly", ds]
            process = await asyncio.create_subprocess_exec(
                *cmdline,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await process.communicate()
            parts = stdout.decode().strip().split()
            ro = "ro" if len(parts) >= 3 and parts[2] == "on" else "rw"

            tmp_fstab.write(ds + "\t" + mp + "\tzfs\t" + ro + "\t0\t0\n")
    except Exception:
        pass

    tmp_fstab.close()
    return tmp_fstab.name


async def make_mtab():
    tmp_mtab = tempfile.NamedTemporaryFile(mode="w+", delete=False)
    try:
        process = await asyncio.create_subprocess_exec(
            "mount",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, _ = await process.communicate()
        mount_output = stdout.decode().strip().splitlines()
        for line in mount_output:
            parts = line.replace(" on ", " ").replace(" (", " ").replace(",", " ").split()
            if len(parts) >= 3:
                tmp_mtab.write(parts[0] + " " + parts[1] + " " + parts[2] + "\n")
    except Exception:
        pass
    tmp_mtab.close()
    return tmp_mtab.name


async def run_df(mp, timeout):
    try:
        cmdline = ["df", "-k", mp]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        await asyncio.wait_for(process.communicate(), timeout=timeout)
    except asyncio.TimeoutError:
        raise Exception("df timeout")


async def check_mountpoint(mp, args, fstab_lines, mtab_lines):
    err_mesg = []

    is_openvz = os.path.exists("/proc/vz/veinfo")
    if not is_openvz and not args.auto and not args.ignorefstab:
        found_in_fstab = False
        for line in fstab_lines:
            parts = line.split()
            if len(parts) > args.mf - 1 and parts[args.mf - 1] == mp:
                found_in_fstab = True
                break
        if not found_in_fstab:
            infomsg("CRIT: " + mp + " doesn't exist in /etc/fstab")
            err_mesg.append(mp + " doesn't exist in fstab " + args.fstab)

    found_in_mtab = False
    for line in mtab_lines:
        parts = line.split()
        if len(parts) > args.mf - 1 and parts[args.mf - 1] == mp:
            found_in_mtab = True
            break
    if not found_in_mtab:
        if not (args.linkok and os.path.islink(mp)):
            infomsg("CRIT: " + mp + " is not mounted")
            err_mesg.append(mp + " is not mounted")

    try:
        await run_df(mp, args.timeout)
    except Exception:
        err_mesg.append(mp + " did not respond in " + str(args.timeout) + " sec. Seems to be stale.")
        return err_mesg

    is_rw = 0
    if not os.path.isdir(mp):
        infomsg("CRIT: " + mp + " doesn't exist on filesystem")
        err_mesg.append(mp + " doesn't exist on filesystem")
    elif args.writetest:
        is_rw = 1
        if args.auto:
            for line in fstab_lines:
                fields = line.split()
                if len(fields) > max(args.mf - 1, args.of - 1) and fields[args.mf - 1] == mp:
                    if "ro" in fields[args.of - 1].split(","):
                        is_rw = 0
                        infomsg("CRIT: " + mp + " is not mounted as writable.")
                        err_mesg.append("Could not write in " + mp + " filesystem was mounted RO.")

    if is_rw == 1:
        timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d--%H-%M-%S")
        touchfile = os.path.join(mp, ".mount_test_from_" + socket.gethostname() + "_" + timestamp + "_" + str(os.getpid()))

        try:
            cmdline = ["touch", touchfile]
            process = await asyncio.create_subprocess_exec(
                *cmdline,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            await asyncio.wait_for(process.communicate(), timeout=args.timeout)
            if not os.path.isfile(touchfile):
                infomsg("CRIT: " + touchfile + " is not writable.")
                err_mesg.append("Could not write in " + mp + ".")
            else:
                os.remove(touchfile)
        except asyncio.TimeoutError:
            infomsg("CRIT: " + touchfile + " is not writable.")
            err_mesg.append("Could not write in " + mp + " in " + str(args.timeout) + " sec. Seems to be stale.")
        except Exception:
            infomsg("CRIT: " + touchfile + " is not writable.")
            err_mesg.append("Could not write in " + mp + ".")

    return err_mesg


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check if nfs/cifs/davfs mountpoints are correctly implemented and mounted.")
    parser.add_argument("-m", "--mtab", dest="mtab", default="/proc/mounts", help="Use this mtab instead")
    parser.add_argument("-f", "--fstab", dest="fstab", default="/etc/fstab", help="Use this fstab instead")
    parser.add_argument("-N", "--fsfield", dest="fsf", type=int, default=3, help="FS Field number in fstab")
    parser.add_argument("-M", "--mountfield", dest="mf", type=int, default=2, help="Mount Field number in fstab")
    parser.add_argument("-O", "--optionfield", dest="of", type=int, default=4, help="Option Field number in fstab")
    parser.add_argument("-T", "--timeout", dest="timeout", type=int, default=3, help="Responsetime for stale NFS")
    parser.add_argument("-L", "--linkok", dest="linkok", action="store_true", help="Allow softlinks instead of mount points")
    parser.add_argument("-i", "--ignorefstab", dest="ignorefstab", action="store_true", help="Ignore fstab")
    parser.add_argument("-a", "--auto", dest="auto", action="store_true", help="Autoselect mounts from fstab")
    parser.add_argument("-A", "--autoignore", dest="autoignore", action="store_true", help="Autoselect from fstab, OK if none found")
    parser.add_argument("-E", "--exclude", dest="exclude", default="none", help="Exclude paths in auto mode")
    parser.add_argument("-o", "--noautoignore", dest="noautoignore", action="store_true", help="Ignore mounts with noauto flag")
    parser.add_argument("-w", "--writetest", dest="writetest", action="store_true", help="Perform writetest on mountpoint")
    parser.add_argument("-e", "--dfargs", dest="dfargs", default="", help="Extra arguments for df")
    parser.add_argument("-d", "--debug", dest="debug", action="store_true", help="Enable debug output")
    parser.add_argument("mountpoints", nargs="*", help="List of mountpoints to check")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.autoignore:
        args.auto = True

    err_mesg = []

    fsf_idx = args.fsf - 1
    mf_idx = args.mf - 1
    of_idx = args.of - 1

    fstab_file = args.fstab
    mtab_file = args.mtab

    if os.path.exists("/sbin/zfs") and os.access("/sbin/zfs", os.X_OK):
        fstab_file = await create_zfs_fstab(fstab_file)

    mps = args.mountpoints

    if args.auto:
        mps = []
        valid_fs = {"ext2", "ext3", "xfs", "auto", "ext4", "nfs", "nfs4", "davfs", "cifs", "fuse", "glusterfs", "ocfs2", "lustre", "ufs", "zfs", "ceph", "btrfs", "yas3fs"}
        try:
            async with aiofiles.open(fstab_file, "rb") as f:
                lines = await f.read()
                lines = lines.decode("utf-8").strip().splitlines()
                for line in lines:
                    if line.strip().startswith("#"):
                        continue
                    if args.exclude != "none" and re.search(args.exclude, line):
                        continue
                    fields = line.split()
                    if len(fields) > max(fsf_idx, mf_idx, of_idx):
                        if args.noautoignore and "noauto" in fields[of_idx]:
                            continue
                        if fields[fsf_idx] in valid_fs:
                            mp = fields[mf_idx].rstrip("/")
                            if mp:
                                mps.append(mp)
        except IOError:
            pass

    if not mps and args.autoignore:
        exitnagios("OK", "no external mounts were found in " + args.fstab)
    elif not mps:
        msg = "ERROR: no mountpoints given!"
        exitnagios("UNKNOWN", msg)

    if mtab_file == "none":
        mtab_file = await make_mtab()

    if not os.path.exists(mtab_file):
        msg = mtab_file + " doesn't exist!"
        exitnagios("CRITICAL", msg)

    fstab_lines = []
    if os.path.exists(fstab_file):
        async with aiofiles.open(fstab_file, "rb") as f:
            lines = await f.read()
            lines = lines.decode("utf-8").strip().splitlines()
            for line in lines:
                stripped = line.strip()
                if not stripped.startswith("#"):
                    fstab_lines.append(stripped)

    mtab_lines = []
    async with aiofiles.open(mtab_file, "rb") as f:
        mtab_lines = await f.read()
        mtab_lines = mtab_lines.decode("utf-8").strip().splitlines()

    tasks = []
    for mp in mps:
        tasks.append(check_mountpoint(mp, args, fstab_lines, mtab_lines))

    results = await asyncio.gather(*tasks, return_exceptions=True)
    for res in results:
        err_mesg.extend(res)

    if "/tmp" in mtab_file and os.path.exists(mtab_file):
        os.remove(mtab_file)
    if "/tmp" in fstab_file and os.path.exists(fstab_file):
        os.remove(fstab_file)

    if err_mesg:
        exitnagios("CRITICAL", " ; ".join(err_mesg))

    exitnagios("OK", "all mounts were found (" + " ".join(mps) + ")")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

