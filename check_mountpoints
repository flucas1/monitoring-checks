#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import os
import sys
import time
import argparse
import subprocess
import socket
import tempfile
import re
import syslog

# Nagios Exit Codes
STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def log(message):
    """Log to syslog similar to the logger command in the bash script."""
    syslog.openlog(os.path.basename(sys.argv[0]), syslog.LOG_PID, syslog.LOG_KERN)
    syslog.syslog(syslog.LOG_WARNING, message)
    syslog.closelog()


def create_zfs_fstab(original_fstab):
    """Generate a temporary fstab for ZFS datasets."""
    tmp_fstab = tempfile.NamedTemporaryFile(mode='w+', delete=False)

    # Copy original
    if os.path.exists(original_fstab):
        with open(original_fstab, 'r') as f:
            tmp_fstab.write(f.read())

    try:
        zfs_list = subprocess.check_output(['zfs', 'list', '-H', '-o', 'name'], universal_newlines=True).splitlines()
        for ds in zfs_list:
            mp = subprocess.check_output(['zfs', 'get', '-H', 'mountpoint', ds], universal_newlines=True).split()[2]
            if not os.path.isdir(mp):
                continue

            canmount = subprocess.check_output(['zfs', 'get', '-H', 'canmount', ds], universal_newlines=True).split()[2]
            if canmount == 'off':
                continue

            # Handling SunOS and FreeBSD specific checks
            system = os.uname().sysname
            if system == 'SunOS':
                zoned = subprocess.check_output(['zfs', 'get', '-H', 'zoned', ds], universal_newlines=True).split()[2]
                if zoned == 'on':
                    continue
            elif system == 'FreeBSD':
                jailed = subprocess.check_output(['zfs', 'get', '-H', 'jailed', ds], universal_newlines=True).split()[2]
                if jailed == 'on':
                    continue

            ro_output = subprocess.check_output(['zfs', 'get', '-H', 'readonly', ds], universal_newlines=True).split()
            ro = "ro" if ro_output[2] == "on" else "rw"

            tmp_fstab.write(f"{ds}\t{mp}\tzfs\t{ro}\t0\t0\n")
    except Exception as e:
        pass  # Fallback to ignore if zfs fails

    tmp_fstab.close()
    return tmp_fstab.name


def make_mtab():
    """Create a temporary mtab for systems that lack one."""
    tmp_mtab = tempfile.NamedTemporaryFile(mode='w+', delete=False)
    try:
        mount_output = subprocess.check_output(['mount'], universal_newlines=True).splitlines()
        for line in mount_output:
            # Simple conversion to 'dev mountpoint filesystem' format
            parts = line.replace(' on ', ' ').replace(' (', ' ').replace(',', ' ').split()
            if len(parts) >= 3:
                tmp_mtab.write(f"{parts[0]} {parts[1]} {parts[2]}\n")
    except Exception:
        pass
    tmp_mtab.close()
    return tmp_mtab.name


def main():
    parser = argparse.ArgumentParser(description="Check if nfs/cifs/davfs mountpoints are correctly implemented and mounted.")
    parser.add_argument('-m', dest='mtab', default='/proc/mounts', help="Use this mtab instead")
    parser.add_argument('-f', dest='fstab', default='/etc/fstab', help="Use this fstab instead")
    parser.add_argument('-N', dest='fsf', type=int, default=3, help="FS Field number in fstab")
    parser.add_argument('-M', dest='mf', type=int, default=2, help="Mount Field number in fstab")
    parser.add_argument('-O', dest='of', type=int, default=4, help="Option Field number in fstab")
    parser.add_argument('-T', dest='timeout', type=int, default=3, help="Responsetime for stale NFS")
    parser.add_argument('-L', dest='linkok', action='store_true', help="Allow softlinks instead of mount points")
    parser.add_argument('-i', dest='ignorefstab', action='store_true', help="Ignore fstab")
    parser.add_argument('-a', dest='auto', action='store_true', help="Autoselect mounts from fstab")
    parser.add_argument('-A', dest='autoignore', action='store_true', help="Autoselect from fstab, OK if none found")
    parser.add_argument('-E', dest='exclude', default='none', help="Exclude paths in auto mode")
    parser.add_argument('-o', dest='noautoignore', action='store_true', help="Ignore mounts with noauto flag")
    parser.add_argument('-w', dest='writetest', action='store_true', help="Perform writetest on mountpoint")
    parser.add_argument('-e', dest='dfargs', default='', help="Extra arguments for df")
    parser.add_argument('mountpoints', nargs='*', help="List of mountpoints to check")

    args = parser.parse_args()

    if args.autoignore:
        args.auto = True

    err_mesg = []

    fsf_idx = args.fsf - 1
    mf_idx = args.mf - 1
    of_idx = args.of - 1

    fstab_file = args.fstab
    mtab_file = args.mtab

    # ZFS Check
    if os.path.exists('/sbin/zfs') and os.access('/sbin/zfs', os.X_OK):
        fstab_file = create_zfs_fstab(fstab_file)

    mps = args.mountpoints

    # Auto select mounts
    if args.auto:
        mps = []
        valid_fs = {'ext2', 'ext3', 'xfs', 'auto', 'ext4', 'nfs', 'nfs4', 'davfs', 'cifs',
                    'fuse', 'glusterfs', 'ocfs2', 'lustre', 'ufs', 'zfs', 'ceph', 'btrfs', 'yas3fs'}
        try:
            with open(fstab_file, 'r') as f:
                for line in f:
                    if line.strip().startswith('#'):
                        continue
                    if args.exclude != 'none' and re.search(args.exclude, line):
                        continue
                    fields = line.split()
                    if len(fields) > max(fsf_idx, mf_idx, of_idx):
                        if args.noautoignore and 'noauto' in fields[of_idx]:
                            continue
                        if fields[fsf_idx] in valid_fs:
                            mp = fields[mf_idx].rstrip('/')
                            if mp:
                                mps.append(mp)
        except IOError:
            pass

    if not mps and args.autoignore:
        print(f"OK: no external mounts were found in {args.fstab}")
        sys.exit(STATE_OK)
    elif not mps:
        msg = "ERROR: no mountpoints given!"
        log(msg)
        print(msg)
        parser.print_help()
        sys.exit(STATE_UNKNOWN)

    if not os.path.exists('/proc/mounts') and mtab_file == '/proc/mounts':
        log("CRIT: /proc wasn't mounted!")
        ret = subprocess.call(['mount', '-t', 'proc', 'proc', '/proc'])
        err_mesg.append(f"CRIT: mounted /proc {ret}")

    if mtab_file == 'none':
        mtab_file = make_mtab()

    if not os.path.exists(mtab_file):
        msg = f"CRIT: {mtab_file} doesn't exist!"
        log(msg)
        print(msg)
        sys.exit(STATE_CRITICAL)

    # Read fstab and mtab into memory for checks
    fstab_lines = []
    if os.path.exists(fstab_file):
        with open(fstab_file, 'r') as f:
            fstab_lines = [l.strip() for l in f if not l.strip().startswith('#')]

    mtab_lines = []
    with open(mtab_file, 'r') as f:
        mtab_lines = f.readlines()

    # Main check loop
    for mp in mps:
        # Fstab check
        is_openvz = os.path.exists('/proc/vz/veinfo')
        if not is_openvz and not args.auto and not args.ignorefstab:
            found_in_fstab = any(len(l.split()) > mf_idx and l.split()[mf_idx] == mp for l in fstab_lines)
            if not found_in_fstab:
                log(f"CRIT: {mp} doesn't exist in /etc/fstab")
                err_mesg.append(f"{mp} doesn't exist in fstab {fstab_file}")

        # Kernel mount check
        found_in_mtab = any(len(l.split()) > mf_idx and l.split()[mf_idx] == mp for l in mtab_lines)
        if not found_in_mtab:
            if not (args.linkok and os.path.islink(mp)):
                log(f"CRIT: {mp} is not mounted")
                err_mesg.append(f"{mp} is not mounted")

        # Stale check via df
        df_cmd = ['df', '-k']
        if args.dfargs:
            df_cmd.extend(args.dfargs.split())
        df_cmd.append(mp)

        try:
            subprocess.run(df_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=args.timeout)
        except subprocess.TimeoutExpired:
            err_mesg.append(f"{mp} did not respond in {args.timeout} sec. Seems to be stale.")
            continue

        # Filesystem existence & Writable check
        is_rw = 0
        if not os.path.isdir(mp):
            log(f"CRIT: {mp} doesn't exist on filesystem")
            err_mesg.append(f"{mp} doesn't exist on filesystem")
        elif args.writetest:
            is_rw = 1
            if args.auto:
                for line in fstab_lines:
                    fields = line.split()
                    if len(fields) > max(mf_idx, of_idx) and fields[mf_idx] == mp:
                        if 'ro' in fields[of_idx].split(','):
                            is_rw = 0
                            log(f"CRIT: {mp} is not mounted as writable.")
                            err_mesg.append(f"Could not write in {mp} filesystem was mounted RO.")

        if is_rw == 1:
            timestamp = time.strftime("%Y-%m-%d--%H-%M-%S")
            touchfile = os.path.join(mp, f".mount_test_from_{socket.gethostname()}_{timestamp}.{os.getpid()}")

            try:
                subprocess.run(['touch', touchfile], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=args.timeout)
                if not os.path.isfile(touchfile):
                    log(f"CRIT: {touchfile} is not writable.")
                    err_mesg.append(f"Could not write in {mp}.")
                else:
                    os.remove(touchfile)
            except subprocess.TimeoutExpired:
                log(f"CRIT: {touchfile} is not writable.")
                err_mesg.append(f"Could not write in {mp} in {args.timeout} sec. Seems to be stale.")
            except Exception:
                log(f"CRIT: {touchfile} is not writable.")
                err_mesg.append(f"Could not write in {mp}.")

    # Cleanup temporary files
    if '/tmp' in mtab_file and os.path.exists(mtab_file):
        os.remove(mtab_file)
    if '/tmp' in fstab_file and os.path.exists(fstab_file):
        os.remove(fstab_file)

    # Output Nagios Status
    if err_mesg:
        print("CRITICAL: " + " ; ".join(err_mesg))
        sys.exit(STATE_CRITICAL)

    print(f"OK: all mounts were found ({' '.join(mps)})")
    sys.exit(STATE_OK)


if __name__ == '__main__':
    main()
