# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def generatedriver(proxy):
    chrome_options = selenium.webdriver.chrome.options.Options()
    # chrome_options.add_argument("--incognito")
    # chrome_options.add_argument("--enable-features=EphemeralGuestProfilesOnStartup")
    chrome_options.add_argument("--disk-cache-size=0")
    chrome_options.add_argument("--media-cache-size=0")
    chrome_options.add_argument("--headless")
    chrome_options.add_argument("--disable-gpu")
    chrome_options.add_argument("--no-zygote")
    chrome_options.add_argument("--renderer-process-limit=1")
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    chrome_options.add_argument("--in-process-gpu")
    chrome_options.add_argument("--use-gl=angle")
    chrome_options.add_argument("--use-angle=swiftshader-webgl")
    chrome_options.add_argument("--disable-popup-blocking")
    if proxy not in ["", None]:
        chrome_options.add_argument("--proxy-server=" + proxy)

    chrome_service = selenium.webdriver.ChromeService(executable_path="/usr/bin/chromedriver")

    driver = selenium.webdriver.Chrome(options=chrome_options, service=chrome_service)
    # driver.implicitly_Wait(10, TimeUnit.SECONDS)

    return driver


def check_page_loaded(driver):
    # self.log.info("Checking if {} page is loaded.".format(self.driver.current_url))
    page_state = driver.execute_script("return document.readyState;")
    return page_state == "complete"


async def wait_page_loaded(driver):
    timestamp = time.monotonic()
    while True:
        if check_page_loaded(driver):
            break
        if time.monotonic() - timestamp > 20:
            break
        await asyncio.sleep(1)


# -------------------------------------------------------------------------------


async def resolve_hostname_to_ip(hostname, protocol):
    try:
        targetip = socket.gethostbyname(hostname).strip()
        return targetip
    except Exception:
        return ""


async def dogocoaxspeedcall(protocol, proxy, username, password, warning, critical, hostname, timeoutvalue, timeoutstatus):
    driver = None
    ip = None

    try:
        ip = await resolve_hostname_to_ip(hostname, protocol)

        try:
            reader, writer = await asyncio.wait_for(asyncio.open_connection(ip, 80), timeout=5.0)
            writer.close()
            await writer.wait_closed()
        except (OSError, asyncio.TimeoutError):
            raise Exception("Cannot reach target IP on port 80 " + ip)

    except Exception as e:
        exitnagios(timeoutstatus, str(e))

    if ip is not None:
        try:
            driver = await generatedriver(proxy)

            wait = selenium.webdriver.support.ui.WebDriverWait(driver, 20)
        except Exception as e:
            exitnagios("CRITICAL", str(e))
    else:
        exitnagios("CRITICAL", "The hostname " + hostname + " was not resolved")

    if driver is not None:
        try:
            infomsg("browser OK")

            url = "http://" + username + ":" + password + "@" + ip + "/phyRates.html"
            driver.get(url)
            # await asyncio.sleep(5)
            await wait_page_loaded(driver)

            infomsg("asking for logging " + "http://" + ip + "/phyRates.html")
            wait.until(selenium.webdriver.support.expected_conditions.visibility_of_element_located((selenium.webdriver.common.by.By.ID, "pageContent")))
            wait.until(selenium.webdriver.support.expected_conditions.visibility_of_element_located((selenium.webdriver.common.by.By.ID, "table_data")))

            tableelem = driver.find_element(selenium.webdriver.common.by.By.ID, "table_data")
            tabletext = tableelem.text
            infomsg(tabletext)

            cells = []
            counter = 0
            while (counter < 15):
                cells = tableelem.find_elements(selenium.webdriver.common.by.By.TAG_NAME, "td")
                if len(cells) == 0:
                    counter = counter + 1
                    await asyncio.sleep(1)
                else:
                    break
            infomsg("found " + str(len(cells)) + " cells")

            values = []
            rows = tableelem.find_elements(selenium.webdriver.common.by.By.XPATH, ".//tr")
            if len(rows) > 0:
                rows.pop(0)
            for row in rows:
                infomsg("row " + row.text)
                cols = row.find_elements(selenium.webdriver.common.by.By.TAG_NAME, "td")
                if len(cols) > 0:
                    cols.pop(0)
                if len(cols) > 0:
                    cols.pop(0)
                for col in cols:
                    text = col.text
                    infomsg("cell " + text)
                    values.append(text)

            speed = 0
            infomsg("values " + str(values))
            if len(values) > 0:
                total = 0
                for item in values:
                    try:
                        parsed = float(item)
                    except:
                        parsed = 0
                    total = total + parsed
                infomsg("total " + str(total))
                average = total / len(values)
                speed = round(average)

            if (critical != "") and (speed < float(critical)):
                exitnagios("CRITICAL", "the speed is less than " + str(critical) + " - currently " + str(speed) + " | speed=" + str(speed))
            elif (warning != "") and (speed < float(warning)):
                exitnagios("WARNING", "the speed is less than " + str(warning) + " - currently " + str(speed) + " | speed=" + str(speed))
            else:
                exitnagios("OK", "The speed is " + str(speed) + " | speed=" + str(speed))

        except Exception as e:
            exitnagios("CRITICAL", str(e))
        finally:
            driver.quit()
    else:
        exitnagios("CRITICAL", "the driver was not initialized")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="server to check")
    parser.add_argument("-t", "--timeout", dest="timeout", default="30:CRITICAL", help="timeout value:STATUS")
    parser.add_argument("-w", "--warning", dest="warning", default="1000", help="minimum value for a warning")
    parser.add_argument("-c", "--critical", dest="critical", default="500", help="maximum value for a critical")
    parser.add_argument("-f", "--filecred", dest="filecred", default="", help="file containing the management credentials")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    if args.filecred == "":
        exitnagios("CRITICAL", "filecred is not specified")
    else:
        try:
            async with aiofiles.open(args.filecred, mode="rb") as f:
                filecontents = await f.read()
            filecontentslines = filecontents.decode("utf-8").splitlines()
            username = filecontentslines[0]
            password = filecontentslines[1]
        except Exception as e:
            exitnagios("CRITICAL", "could not read credentials file: " + str(e))

    if args.hostname == "":
        exitnagios("CRITICAL", "no hostname specified")

    parts = args.timeout.split(":")
    timeoutvalue = int(parts[0])
    if len(parts) > 1:
        timeoutstatus = parts[1]
    else:
        timeoutstatus = "CRITICAL"
    if timeoutstatus in ["OK", "WARNING", "CRITICAL", "UNKNOWN"]:
        proxy = ""
        await dogocoaxspeedcall(protocol, proxy, username, password, args.warning, args.critical, args.hostname, timeoutvalue, timeoutstatus)
    else:
        exitnagios("CRITICAL", "timeout status is not valid")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

