#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import asyncio
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def get_swap_info():
    total_kb = 0
    free_kb = 0
    has_swap = False

    try:
        async with aiofiles.open("/proc/meminfo", "r") as f:
            async for line in f:
                if line.startswith("SwapTotal:"):
                    total_kb = int(line.split()[1])
                    has_swap = True
                elif line.startswith("SwapFree:"):
                    free_kb = int(line.split()[1])
    except FileNotFoundError:
        exitnagios("CRITICAL", "Could not read /proc/meminfo")

    if total_kb == 0:
        return False, 0, 0

    # Convert kilobytes to megabytes
    total_mb = total_kb / 1024.0
    free_mb = free_kb / 1024.0
    used_mb = total_mb - free_mb

    return has_swap, total_mb, used_mb


async def dofreeswapscall(warning, critical, minimum):
    hasswap, total, used = await get_swap_info()

    infomsg("Swap Info -> Has Swap: " + str(hasswap) + ", Total: " + str(total) + "MB, Used: " + str(used) + "MB")

    if not hasswap or total == 0:
        exitnagios("CRITICAL", "no swap detected")
    else:
        usage = (used / total) * 100

        if minimum != "" and total < float(minimum):
            exitnagios("CRITICAL", "swap is too small")
        elif critical != "" and usage > float(critical):
            exitnagios("CRITICAL", "swap is used at " + str(round(usage, 2)) + "% | percent=" + str(usage))
        elif warning != "" and usage > float(warning):
            exitnagios("WARNING", "swap is used at " + str(round(usage, 2)) + "% | percent=" + str(usage))
        else:
            exitnagios("OK", "swap is used at " + str(round(usage, 2)) + "% | percent=" + str(usage))


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-w", "--warning", dest="warning", default="", help="warning level percentage")
    parser.add_argument("-c", "--critical", dest="critical", default="", help="critical level percentage")
    parser.add_argument("-m", "--minimum", dest="minimum", default="", help="minimum size MB")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await dofreeswapscall(args.warning, args.critical, args.minimum)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
