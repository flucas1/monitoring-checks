#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import shutil
import asyncio


async def check_prerequisites():
    """Checks if the required ntpdc binary is available in the system PATH."""
    if not shutil.which("ntpdc"):
        print("ntpdc - binary is missing. Please install it, or make sure it is in $PATH.")
        sys.exit(3)


async def check_stratum(hostname):
    """Executes ntpdc asynchronously, parses the output for stratum and peer, and returns the appropriate Nagios status code."""
    cmd = ["ntpdc", "-c", "sysinfo"]
    if hostname:
        cmd.append(hostname)

    try:
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            print("STRATUM UNKNOWN. Error executing ntpdc. Ensure the daemon is running and reachable.")
            sys.exit(3)

        output = stdout.decode("utf-8").strip()
    except Exception:
        print("STRATUM UNKNOWN. Error executing ntpdc. Ensure the daemon is running and reachable.")
        sys.exit(3)

    stratum = None
    peer = None

    for line in output.splitlines():
        if "stratum:" in line:
            parts = line.split()
            if len(parts) >= 2:
                try:
                    stratum = int(parts[1])
                except ValueError:
                    stratum = None
        elif "system peer:" in line:
            parts = line.split()
            if len(parts) >= 3:
                peer = parts[2]

    if stratum is None:
        print("STRATUM UNKNOWN. Could not determine stratum from ntpdc output.")
        sys.exit(3)

    if stratum < 3:
        print(f"STRATUM OK. Level: {stratum} (Excellent) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 4:
        print(f"STRATUM OK. Level: {stratum} (Good) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 5:
        print(f"STRATUM OK. Level: {stratum} (Normal) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 6:
        print(f"STRATUM WARNING. Level: {stratum} (Warning) System Peer: {peer} |stratum={stratum};")
        stateid = 1
    elif stratum < 7:
        print(f"STRATUM CRITICAL. Level: {stratum} (Critical) System Peer: {peer} |stratum={stratum};")
        stateid = 2
    elif stratum < 16:
        print(f"STRATUM UNKNOWN. Level: {stratum} (Unknown Stratum Level reached) System Peer: {peer} |stratum={stratum};")
        stateid = 3
    elif stratum == 16:
        print(f"STRATUM CRITICAL. Level: {stratum} (NTP Service is Dead!) System Peer: {peer} |stratum={stratum};")
        stateid = 2
    else:
        print(f"STRATUM UNKNOWN. Level: {stratum} (Out of bounds) System Peer: {peer} |stratum={stratum};")
        stateid = 3

    sys.exit(stateid)


async def main(forcedargs=None):
    target_host = sys.argv[1] if len(sys.argv) > 1 else ""
    await check_prerequisites()
    await check_stratum(target_host)


if __name__ == "__main__":
    asyncio.run(main())
