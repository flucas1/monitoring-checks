#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import shutil
import argparse
import asyncio


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def check_stratum(hostname, debug=False):
    cmd = ["ntpdc", "-c", "sysinfo"]
    if hostname:
        cmd.append(hostname)

    infomsg("Running command: " + " ".join(cmd))

    try:
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            exitnagios("UNKNOWN", "Error executing ntpdc. Ensure the daemon is running and reachable.")

        output = stdout.decode("utf-8").strip()
    except Exception as e:
        exitnagios("UNKNOWN", "Exception occurred: " + str(e))

    stratum = None
    peer = None

    for line in output.splitlines():
        if "stratum:" in line:
            parts = line.split()
            if len(parts) >= 2:
                try:
                    stratum = int(parts[1])
                except ValueError:
                    stratum = None
        elif "system peer:" in line:
            parts = line.split()
            if len(parts) >= 3:
                peer = parts[2]

    if stratum is None:
        exitnagios("UNKNOWN", "Could not determine stratum from ntpdc output.")

    if stratum < 3:
        exitnagios("OK", "Level: " + str(stratum) + " (Excellent) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum < 4:
        exitnagios("OK", "Level: " + str(stratum) + " (Good) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum < 5:
        exitnagios("OK", "Level: " + str(stratum) + " (Normal) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum < 6:
        exitnagios("WARNING", "Level: " + str(stratum) + " (Warning) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum < 7:
        exitnagios("CRITICAL", "Level: " + str(stratum) + " (Critical) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum < 16:
        exitnagios("UNKNOWN", "Level: " + str(stratum) + " (Unknown Stratum Level reached) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    elif stratum == 16:
        exitnagios("CRITICAL", "Level: " + str(stratum) + " (NTP Service is Dead!) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")
    else:
        exitnagios("UNKNOWN", "Level: " + str(stratum) + " (Out of bounds) System Peer: " + str(peer) + " |stratum=" + str(stratum) + ";")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check NTP stratum level")
    parser.add_argument("-H", "--hostname", nargs="?", default="", help="NTP server hostname (optional)")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)
    await check_stratum(args.hostname, args.debug)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
