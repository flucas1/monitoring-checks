#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import shutil
import subprocess


def check_prerequisites():
    """Checks if the required ntpdc binary is available in the system PATH."""
    # Python natively handles string parsing, so awk, grep, and sed are no longer required.
    if not shutil.which("ntpdc"):
        print("ntpdc - binary is missing. Please install it, or make sure it is in $PATH.")
        sys.exit(3)


def check_stratum(hostname):
    """Executes ntpdc, parses the output for stratum and peer, and returns the appropriate Nagios status code."""
    # Construct the command
    cmd = ["ntpdc", "-c", "sysinfo"]
    if hostname:
        cmd.append(hostname)

    try:
        # Execute the command and capture output
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        output = result.stdout
    except subprocess.CalledProcessError:
        print("STRATUM UNKNOWN. Error executing ntpdc. Ensure the daemon is running and reachable.")
        sys.exit(3)

    stratum = None
    peer = None

    # Parse the output to extract stratum and system peer
    for line in output.splitlines():
        if "stratum:" in line:
            parts = line.split()
            if len(parts) >= 2:
                stratum = int(parts[1])
        elif "system peer:" in line:
            parts = line.split()
            if len(parts) >= 3:
                peer = parts[2]

    if stratum is None:
        print("STRATUM UNKNOWN. Could not determine stratum from ntpdc output.")
        sys.exit(3)

    # Evaluate Stratum Levels and assign exit states
    if stratum < 3:
        print(f"STRATUM OK. Level: {stratum} (Excellent) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 4:
        print(f"STRATUM OK. Level: {stratum} (Good) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 5:
        print(f"STRATUM OK. Level: {stratum} (Normal) System Peer: {peer} |stratum={stratum};")
        stateid = 0
    elif stratum < 6:
        print(f"STRATUM WARNING. Level: {stratum} (Warning) System Peer: {peer} |stratum={stratum};")
        stateid = 1
    elif stratum < 7:
        print(f"STRATUM CRITICAL. Level: {stratum} (Critical) System Peer: {peer} |stratum={stratum};")
        stateid = 2
    elif stratum < 16:
        print(f"STRATUM UNKNOWN. Level: {stratum} (Unknown Stratum Level reached) System Peer: {peer} |stratum={stratum};")
        stateid = 3
    elif stratum == 16:
        print(f"STRATUM CRITICAL. Level: {stratum} (NTP Service is Dead!) System Peer: {peer} |stratum={stratum};")
        stateid = 2
    else:
        print(f"STRATUM UNKNOWN. Level: {stratum} (Out of bounds) System Peer: {peer} |stratum={stratum};")
        stateid = 3

    sys.exit(stateid)


if __name__ == "__main__":
    # Accept hostname as the first script argument, defaulting to an empty string if omitted
    target_host = sys.argv[1] if len(sys.argv) > 1 else ""
    check_prerequisites()
    check_stratum(target_host)
