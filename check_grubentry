#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import re
import asyncio
import aiofiles

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def read_grub_file(filepath):
    try:
        async with aiofiles.open(filepath, "rb") as handle:
            content = await handle.read()
            return content.decode("utf-8").strip().splitlines()
    except Exception as e:
        raise Exception("failed to read grub file: " + str(e))


async def dogrubentrycall(expectedpos):
    try:
        lines = await read_grub_file("/boot/grub/grub.cfg")
        allcandidates = []
        for line in lines:
            line = line.strip()
            if line.startswith("menuentry "):
                singlequotes = re.findall("'([^']*)'", line)
                if len(singlequotes) > 0:
                    allcandidates.append(singlequotes[0])
                doublequotes = re.findall("\"([^\"]*)\"", line)
                if len(doublequotes) > 0:
                    allcandidates.append(doublequotes[0])
        validcandidates = []
        for item in allcandidates:
            if item.startswith("Debian GNU/Linux"):
                validcandidates.append(item)
        infomsg(str(validcandidates))
        if expectedpos >= len(validcandidates):
            exitnagios("WARNING", "expected grub entry position " + str(expectedpos) + " is out of range, only " + str(len(validcandidates)) + " entries found")
        expectedstring = validcandidates[expectedpos]
        infomsg("expected -> " + expectedstring)

        cmdline = ["/usr/bin/uname", "--kernel-release"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        version = ""
        if exitcode == 0:
            version = output.strip()
        runningending = ", with Linux " + version
        infomsg("running -> " + runningending)

        if expectedstring.endswith(runningending):
            exitnagios("OK", "grub entry '" + str(expectedpos) + " - " + expectedstring + "' matches the running version '" + version + "'")
        else:
            exitnagios("WARNING", "running grub entry with version '" + version + "' but it was expected '" + expectedstring + "'")
    except Exception as e:
        exitnagios("CRITICAL", "internal issue - " + str(e))


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-e", "--expected", dest="expected", default="0", help="expected grub entry position")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    expected = int(args.expected)
    await dogrubentrycall(expected)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
