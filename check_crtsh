# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def ipv6_default_route_exists() -> bool:
    try:
        async with aiofiles.open("/proc/net/ipv6_route", "rb") as f:
            lines = await f.read()
            lines = lines.decode("utf-8").strip().splitlines()
            for line in lines:
                parts = line.split()
                # parts[0] = destination (32 hex chars), parts[1] = prefix length
                if parts[0] == "00000000000000000000000000000000" and parts[1] == "00" and parts[9] != "lo":
                    return True
        return False
    except FileNotFoundError:
        return False


async def ipv4_default_route_exists() -> bool:
    try:
        async with aiofiles.open("/proc/net/route", "rb") as f:
            lines = await f.read()
            lines = lines.decode("utf-8").strip().splitlines()
            lines = lines[1:]  # skip header
            for line in lines:
                parts = line.split()
                if parts[1] == "00000000" and parts[7] == "00000000":
                    return True
        return False
    except FileNotFoundError:
        return False


