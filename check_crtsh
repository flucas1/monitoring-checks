def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="domain to check")
    parser.add_argument("-v", "--valid", dest="valid", default="", help="valid CA ids")
    parser.add_argument("-i", "--ignore", dest="ignore", default="", help="ignore certificate ids")
    parser.add_argument("-t", "--timeout", dest="timeout", default="10:WARNING", help="timeout value:STATUS")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.hostname == "":
        exitnagios("CRITICAL", "hostname not defined")
    elif args.valid == "":
        exitnagios("CRITICAL", "valid CA ids not defined")

    parts = args.timeout.split(":")
    timeoutvalue = int(parts[0])
    if len(parts) > 1:
        timeoutstatus = parts[1]
    else:
        timeoutstatus = "WARNING"

    proxies = []

    start = datetime.datetime.now(datetime.timezone.utc)
    await asyncio.sleep(random.uniform(1, 5))
    if await ipv6_default_route_exists():
        infomsg("call ipv6")
        await docrtshcall("ipv6", None, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
        await doctlogscall("ipv6", None, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
    if await ipv4_default_route_exists():
        infomsg("call ipv4")
        await docrtshcall("ipv4", None, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
        await doctlogscall("ipv4", None, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
    for proxy in proxies:
        infomsg("call " + str(proxy))
        await docrtshcall(None, proxy, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
        await doctlogscall(None, proxy, args.hostname, args.valid, args.ignore, timeoutvalue, 5)
    elapsed = datetime.datetime.now(datetime.timezone.utc) - start
    duration = elapsed.total_seconds()

    exitnagios(timeoutstatus, "cannot get crt.sh data | found=0 duration=" + str(duration))


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

