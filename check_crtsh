async def load_json(mode, proxy, domain, retries, timeoutvalue, item_url):

    headers = {
        "Upgrade-Insecure-Requests": "1",
        "Dnt": "1",
        "Priority": "u=0,1",
        "Cache-Control": "max-age=0",
        "Accept-Language": "en-US",
        "Accept-Encoding": "gzip, deflate",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36",
        "Sec-Ch-Ua": "\"Not;A=Brand\";v=\"99\", \"Google Chrome\";v=\"142\", \"Chromium\";v=\"142\"",
        "Sec-Ch-Ua-Mobile": "?0",
        "Sec-Ch-Ua-Platform": "Windows",
        "Sec-Fetch-Dest": "document",
        "Sec-Fetch-Mode": "navigate",
        "Sec-Fetch-Site": "none",
        "Sec-Fetch-User": "?1"
    }

    connector_kwargs = {}
    if mode == "ipv6":
        connector_kwargs["family"] = socket.AF_INET6
    elif mode == "ipv4":
        connector_kwargs["family"] = socket.AF_INET

    request_proxy = None
    if proxy and (proxy.startswith("socks4://") or proxy.startswith("socks5://") or proxy.startswith("socks5h://")):
        connector = aiohttp_socks.ProxyConnector.from_url(proxy, **connector_kwargs)
    else:
        connector = aiohttp.TCPConnector(**connector_kwargs)
        request_proxy = proxy

    timeout = aiohttp.ClientTimeout(total=timeoutvalue)

    counter = 0
    object_json = None

    async with aiohttp.ClientSession(connector=connector, headers=headers, timeout=timeout) as session:
        while True:
            try:
                counter += 1
                infomsg("sending request")

                async with session.get(item_url, proxy=request_proxy) as response:
                    infomsg("request done")

                    if response.status == 429:
                        infomsg("got 'HTTP 429 (Too Many Requests)'")
                        object_json = None
                        break

                    response.raise_for_status()

                    decoded_data = await response.text()
                    infomsg("decoding done")

                    object_json = json.loads(decoded_data)
                    count_json = len(object_json)
                    infomsg("json done - items: " + str(count_json))

            except aiohttp.ClientResponseError as e:
                object_json = None
                message = str(e)
                infomsg("exception - " + message)
                if e.status == 429:
                    break
                else:
                    infomsg("server error " + str(e.status))
            except Exception as e:
                object_json = None
                message = str(e)
                infomsg("exception - " + message)

            if object_json is not None:
                break
            elif counter > retries:
                break
            else:
                await asyncio.sleep(5 + (counter * 2) + random.uniform(1, 5))

    return object_json


async def docrtshcall(mode, proxy, hostname, validcas, ignorecerts, timeoutvalue, retries):
    if mode:
        mode = mode.lower()
    if mode not in ("ipv6", "ipv4", None):
        exitnagios("CRITICAL", "invalid IP mode")

    hostnameparts = hostname.split(".")
    if "" in hostnameparts:
        hostnameparts.remove("")
    if len(hostnameparts) == 2:
        hostnameparts.insert(0, "*")
    hostname = ".".join(hostnameparts)
    issuers = validcas.split(";")
    ignored = ignorecerts.split(";")

    start = datetime.datetime.now(datetime.timezone.utc)
    item_url = "https://crt.sh/Identity=" + hostname + "&exclude=expired&output=json"
    infomsg(item_url)
    parsed = await load_json(mode, proxy, hostname, retries, timeoutvalue, item_url)
    elapsed = datetime.datetime.now(datetime.timezone.utc) - start
    duration = elapsed.total_seconds()
    if parsed is not None:
        valid = True
        problems = []
        totalfound = len(parsed)
        infomsg("found " + str(totalfound) + " entries")
        for item in parsed:
            issuerid = str(item["issuer_ca_id"])
            certificateid = str(item["id"])
            if (issuerid not in issuers) and (certificateid not in ignored):
                rawnotafter = str(item["not_after"])
                parsednotafter = dateutil.parser.parse(rawnotafter)
                infomsg(parsednotafter)
                if parsednotafter >= datetime.datetime.now(datetime.timezone.utc):
                    valid = False
                    problems.append(item)
                    infomsg(item)
        if totalfound == 0:
            exitnagios("WARNING", "no certificates in crt.sh | found=" + str(totalfound) + " duration=" + str(duration))
        elif valid:
            exitnagios("OK", "no issues found | found=" + str(totalfound) + " duration=" + str(duration))
        else:
            exitnagios("CRITICAL", "found problems --- " + str(problems) + " | found=" + str(totalfound) + " duration=" + str(duration))

    # do not fallback here, so several calls can be chained
    # exitnagios("WARNING","crt.sh does not answer properly")


