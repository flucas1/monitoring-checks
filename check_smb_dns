#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import asyncio
import sys


async def get_cmd_output(cmd):
    """Runs a shell command asynchronously and returns its standard output."""
    try:
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL
        )
        stdout, _ = await process.communicate()
        return stdout.decode().strip() if stdout else ""
    except (asyncio.SubprocessError, OSError):
        return ""


async def get_current_ip(ahosts_type, fqdn):
    """Emulates `getent ahosts<v4/v6> $(hostname -f) | awk '{print $1}' | uniq`"""
    output = await get_cmd_output(["getent", ahosts_type, fqdn])
    if not output:
        return ""

    # Emulate awk '{print $1}'
    ips = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped:
            parts = stripped.split()
            if parts:
                ips.append(parts[0])

    # Emulate `uniq` (removes adjacent duplicates)
    unique_ips = []
    for ip in ips:
        if not unique_ips or unique_ips[-1] != ip:
            unique_ips.append(ip)

    # The shell script evaluates this to a single string for comparison
    return "\n".join(unique_ips)


async def main(forcedargs=None):
    errors = ""
    fqdn = await get_cmd_output(["hostname", "-f"])

    if not fqdn:
        print("CRITICAL: Cannot determine hostname")
        sys.exit(2)

    # IPv4 Check
    list_ipv4_out = await get_cmd_output(["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "A"])
    list_ipv4 = list_ipv4_out.split() if list_ipv4_out else []
    current_ipv4 = await get_current_ip("ahostsv4", fqdn)

    ipv4_ok = False
    for test_ipv4 in list_ipv4:
        if test_ipv4 == current_ipv4:
            ipv4_ok = True
            break

    if not ipv4_ok:
        errors += " - cannot resolve A"

    # IPv6 Check
    list_ipv6_out = await get_cmd_output(["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "AAAA"])
    list_ipv6 = list_ipv6_out.split() if list_ipv6_out else []
    current_ipv6 = await get_current_ip("ahostsv6", fqdn)

    ipv6_ok = False
    for test_ipv6 in list_ipv6:
        if test_ipv6 == current_ipv6:
            ipv6_ok = True
            break

    if not ipv6_ok:
        errors += " - cannot resolve AAAA"

    # Status Reporting
    if errors:
        print(f"CRITICAL: the samba dns resolver has issues{errors}")
        sys.exit(2)
    else:
        print("OK: the samba dns resolver is behaving as expected")
        sys.exit(0)


if __name__ == "__main__":
    asyncio.run(main())
