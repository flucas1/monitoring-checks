#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import subprocess
import sys


def get_cmd_output(cmd):
    """Runs a shell command and returns its standard output."""
    try:
        return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError:
        return ""


def get_current_ip(ahosts_type, fqdn):
    """Emulates `getent ahosts<v4/v6> $(hostname -f) | awk '{print $1}' | uniq`"""
    output = get_cmd_output(["getent", ahosts_type, fqdn])
    if not output:
        return ""

    # Emulate awk '{print $1}'
    ips = [line.split()[0] for line in output.splitlines() if line.strip()]

    # Emulate `uniq` (removes adjacent duplicates)
    unique_ips = []
    for ip in ips:
        if not unique_ips or unique_ips[-1] != ip:
            unique_ips.append(ip)

    # The shell script evaluates this to a single string for comparison
    return "\n".join(unique_ips)


def main():
    errors = ""
    fqdn = get_cmd_output(["hostname", "-f"])

    if not fqdn:
        print("CRITICAL: Cannot determine hostname")
        sys.exit(2)

    # IPv4 Check
    list_ipv4_out = get_cmd_output(["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "A"])
    list_ipv4 = list_ipv4_out.split()  # Emulates the bash for-loop string splitting
    current_ipv4 = get_current_ip("ahostsv4", fqdn)

    ipv4_ok = False
    for test_ipv4 in list_ipv4:
        if test_ipv4 == current_ipv4:
            ipv4_ok = True
            break

    if not ipv4_ok:
        errors += " - cannot resolve A"

    # IPv6 Check
    list_ipv6_out = get_cmd_output(["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "AAAA"])
    list_ipv6 = list_ipv6_out.split()
    current_ipv6 = get_current_ip("ahostsv6", fqdn)

    ipv6_ok = False
    for test_ipv6 in list_ipv6:
        if test_ipv6 == current_ipv6:
            ipv6_ok = True
            break

    if not ipv6_ok:
        errors += " - cannot resolve AAAA"

    # Status Reporting
    if errors:
        print(f"CRITICAL: the samba dns resolver has issues{errors}")
        sys.exit(2)
    else:
        print("OK: the samba dns resolver is behaving as expected")
        sys.exit(0)


if __name__ == "__main__":
    main()
