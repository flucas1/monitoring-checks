#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import asyncio
import argparse
import sys


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def get_cmd_output(cmdline):
    try:
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        return stdout.decode().strip() if stdout else ""
    except (asyncio.SubprocessError, OSError):
        return ""


async def get_current_ip(ahosts_type, fqdn):
    """Emulates `getent ahosts<v4/v6> $(hostname -f) | awk '{print $1}' | uniq`"""
    cmdline = ["getent", ahosts_type, fqdn]
    output = await get_cmd_output(cmdline)
    if not output:
        return ""

    # Emulate awk '{print $1}'
    ips = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped:
            parts = stripped.split()
            if parts:
                ips.append(parts[0])

    # Emulate `uniq` (removes adjacent duplicates)
    unique_ips = []
    for ip in ips:
        if not unique_ips or unique_ips[-1] != ip:
            unique_ips.append(ip)

    # The shell script evaluates this to a single string for comparison
    return "\n".join(unique_ips)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check SMB DNS resolution")
    parser.add_argument("-4", "--ipv4", action="store_true", help="Check only IPv4")
    parser.add_argument("-6", "--ipv6", action="store_true", help="Check only IPv6")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    errors = ""
    cmdline = ["hostname", "-f"]
    fqdn = await get_cmd_output(cmdline)

    if not fqdn:
        exitnagios("CRITICAL", "Cannot determine hostname")

    # IPv4 Check
    if not args.ipv6:
        cmdline = ["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "A"]
        list_ipv4_out = await get_cmd_output(cmdline)
        list_ipv4 = list_ipv4_out.split() if list_ipv4_out else []
        current_ipv4 = await get_current_ip("ahostsv4", fqdn)

        ipv4_ok = False
        for test_ipv4 in list_ipv4:
            if test_ipv4 == current_ipv4:
                ipv4_ok = True
                break

        if not ipv4_ok:
            errors += " - cannot resolve A"

    # IPv6 Check
    if not args.ipv4:
        cmdline = ["dig", fqdn, "@127.0.0.1", "-p", "52", "+short", "AAAA"]
        list_ipv6_out = await get_cmd_output(cmdline)
        list_ipv6 = list_ipv6_out.split() if list_ipv6_out else []
        current_ipv6 = await get_current_ip("ahostsv6", fqdn)

        ipv6_ok = False
        for test_ipv6 in list_ipv6:
            if test_ipv6 == current_ipv6:
                ipv6_ok = True
                break

        if not ipv6_ok:
            errors += " - cannot resolve AAAA"

    # Status Reporting
    if errors:
        exitnagios("CRITICAL", "the samba dns resolver has issues" + errors)
    else:
        exitnagios("OK", "the samba dns resolver is behaving as expected")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
