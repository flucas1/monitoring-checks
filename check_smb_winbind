#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import argparse


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def get_state_string(state):
    """Maps the integer state to its corresponding string representation."""
    if state == STATE_OK:
        return "OK"
    elif state == STATE_WARNING:
        return "WARNING"
    elif state == STATE_CRITICAL:
        return "CRITICAL"
    else:
        return "UNKNOWN"


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check SMB winbind trust status")
    parser.add_argument('-d', '--debug', action='store_true', help="Enable debug output")
    parser.parse_args(forcedargs)
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Define the command
    cmd = "/usr/bin/wbinfo"

    try:
        # Create async subprocess
        process = await asyncio.create_subprocess_exec(
            cmd, "-t",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT
        )

        # Wait for process to complete and capture output
        stdout, _ = await process.communicate()
        ret = process.returncode
        output = stdout.decode().strip() if stdout else ""

    except FileNotFoundError:
        print("Cannot find wbinfo executable")
        sys.exit(STATE_UNKNOWN)

    # Replace newlines with semicolons and strip the trailing semicolon
    msg = output.replace('\n', ';').rstrip(';')

    # Evaluate the return code and exit with the appropriate state
    if ret != 0:
        state = STATE_CRITICAL
        state_string = get_state_string(state)
        print(state_string + ": wbinfo failed: " + msg)
        sys.exit(state)
    else:
        state = STATE_OK
        state_string = get_state_string(state)
        print(state_string + ": " + msg)
        sys.exit(state)

    # Fallback failure state (kept for structural parity with the original script)
    state = STATE_CRITICAL
    state_string = get_state_string(state)
    print(state_string + ": PLUGIN FAILED")
    sys.exit(state)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
