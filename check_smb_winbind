#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import argparse


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check SMB winbind trust status")
    parser.add_argument('-d', '--debug', action='store_true', help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Define the command
    cmdline = ["/usr/bin/wbinfo", "-t"]

    try:
        # Create async subprocess
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT
        )

        # Wait for process to complete and capture output
        stdout, _ = await process.communicate()
        ret = process.returncode
        output = stdout.decode().strip() if stdout else ""

    except FileNotFoundError:
        exitnagios("UNKNOWN", "Cannot find wbinfo executable")

    # Replace newlines with semicolons and strip the trailing semicolon
    msg = output.replace('\n', ';').rstrip(';')

    # Evaluate the return code and exit with the appropriate state
    if ret != 0:
        exitnagios("CRITICAL", "wbinfo failed: " + msg)
    else:
        exitnagios("OK", msg)

    exitnagios("UNKNOWN", "unexpected case")

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
