#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import os
import asyncio
import subprocess

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def doramspeedcall(expected):
    cmdline = ["/usr/sbin/dmidecode", "--type", "memory"]
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode

    token = "Configured Memory Speed:"
    if exitcode == 0:
        foundspeeds = []
        for line in output.splitlines():
            line = line.strip()
            if line.startswith(token):
                data = line[len(token):].strip()
                foundspeeds.append(data)
        finalvalue = " ; ".join(foundspeeds)
        if expected == "" or expected is None:
            exitnagios("OK", "the found speeds are '" + finalvalue + "'")
        elif finalvalue == expected:
            exitnagios("OK", "the found speeds are '" + finalvalue + "' as expected")
        else:
            exitnagios("CRITICAL", "the found speeds '" + finalvalue + "' are not as the expected '" + expected + "'")
    else:
        exitnagios("CRITICAL", "issue retrieving ram speed")

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-e", "--expected", dest="expected", default="", help="expected values")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)

    setcandebug(args.debug)

    parts = args.expected.split(";")
    clean = []
    for part in parts:
        clean.append(part.strip())
    expected = " ; ".join(clean)

    await doramspeedcall(expected)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
