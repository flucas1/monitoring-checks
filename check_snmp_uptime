#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import re
import asyncio
import datetime

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def dosnmpuptimecall(warningmin, criticalmin, warningmax, criticalmax, hostname, port, community, timeoutvalue, timeoutstatus):
    alternatives = {}
    alternatives["engine"] = ("2c", ".1.3.6.1.6.3.10.2.1.3.0", "INTEGER:\\W*(\\d+)\\W*seconds", 1)
    alternatives["sysUptime_2c"] = ("2c", ".1.3.6.1.2.1.1.3.0", "Timeticks:\\W*\\((\\d+)\\)\\W*", 0.01)
    alternatives["sysUptime_1"] = ("1", ".1.3.6.1.2.1.1.3.0", "Timeticks:\\W*\\((\\d+)\\)\\W*", 0.01)

    uptime_min = None
    method = None
    timed_out = False
    for key, value in alternatives.items():
        version, oid, search, factor = value
        returncode, stdout = await snmpget(hostname, port, version, community, oid, timeoutvalue)
        if returncode is None:
            timed_out = True
            continue
        if returncode == 0:
            match = re.search(search, stdout)
            if match:
                uptime_sec = float(int(match.group(1)) * factor)
                uptime_min = float(uptime_sec / 60)
                method = key
                break

    if method is None:
        if timed_out:
            exitnagios(timeoutstatus, "Unable to determine uptime (timeout)")
        else:
            exitnagios("CRITICAL", "Unable to determine uptime")

    fractionaldays = uptime_sec / (3600 * 24)
    if (criticalmin != "") and (uptime_min < float(criticalmin)):
        exitnagios("CRITICAL", "Uptime less than " + str(datetime.timedelta(minutes=float(criticalmin))) + " - currently " + str(datetime.timedelta(minutes=uptime_min)) + " (SNMP method: " + method + ") | uptime=" + str(fractionaldays))
    elif (warningmin != "") and (uptime_min < float(warningmin)):
        exitnagios("WARNING", "Uptime less than " + str(datetime.timedelta(minutes=float(warningmin))) + " - currently " + str(datetime.timedelta(minutes=uptime_min)) + " (SNMP method: " + method + ") | uptime=" + str(fractionaldays))
    elif (criticalmax != "") and (uptime_min > float(criticalmax)):
        exitnagios("CRITICAL", "Uptime more than " + str(datetime.timedelta(minutes=float(criticalmax))) + " - currently " + str(datetime.timedelta(minutes=uptime_min)) + " (SNMP method: " + method + ") | uptime=" + str(fractionaldays))
    elif (warningmax != "") and (uptime_min > float(warningmax)):
        exitnagios("WARNING", "Uptime more than " + str(datetime.timedelta(minutes=float(warningmax))) + " - currently " + str(datetime.timedelta(minutes=uptime_min)) + " (SNMP method: " + method + ") | uptime=" + str(fractionaldays))
    else:
        exitnagios("OK", "The uptime is " + str(datetime.timedelta(minutes=uptime_min)) + " - (SNMP method: " + method + ") | uptime=" + str(fractionaldays))


async def snmpget(hostname, port, version, community, oid, timeoutvalue):
    cmdline = ["/usr/bin/snmpget", "-v", version, "-c", community, "-t", str(timeoutvalue), hostname + ":" + str(port), oid]
    infomsg("[ '" + ("' '".join(cmdline)) + "' ]")

    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode
    if errors.startswith("Timeout: No Response from "):
        exitcode = None
        output = None

    return (exitcode, output)

# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="server to check")
    parser.add_argument("-p", "--port", dest="port", default=161, help="port to use, usually 161")
    parser.add_argument("-t", "--timeout", dest="timeout", default="30:CRITICAL", help="timeout value:STATUS")
    parser.add_argument("-m", "--community", dest="community", default="public", help="private/public")
    parser.add_argument("-w", "--warning-min", dest="warningmin", default="", help="minimum value for a warning (minutes)")
    parser.add_argument("-c", "--critical-min", dest="criticalmin", default="", help="minimum value for a critical (minutes)")
    parser.add_argument("-W", "--warning-max", dest="warningmax", default="", help="maximum value for a warning (minutes)")
    parser.add_argument("-C", "--critical-max", dest="criticalmax", default="", help="maximum value for a critical (minutes)")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.hostname == "":
        exitnagios("CRITICAL", "no hostname specified")

    parts = args.timeout.split(":")
    timeoutvalue = int(parts[0])
    if len(parts) > 1:
        timeoutstatus = parts[1]
    else:
        timeoutstatus = "CRITICAL"
    if timeoutstatus in ["OK", "WARNING", "CRITICAL", "UNKNOWN"]:
        await dosnmpuptimecall(args.warningmin, args.criticalmin, args.warningmax, args.criticalmax, args.hostname, int(args.port), args.community, timeoutvalue, timeoutstatus)
    else:
        exitnagios("CRITICAL", "timeout status is not valid")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
