#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import re
import math
import asyncio
import aiohttp
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


PLUGIN_OK = 0
PLUGIN_WARNING = 1
PLUGIN_CRITICAL = 2
PLUGIN_ERROR = 2
PLUGIN_UNKNOWN = 3


def find_xml_value(xml_str, value):
    """Mimics the sed XML value extraction."""
    match = re.search(rf"<{value}>(.*?)</{value}>", xml_str)
    return match.group(1).strip() if match else ""


def check_number(val):
    """Validates if the input can be treated as a number."""
    if not val:
        print("UNKNOWN: Could not parse output")
        sys.exit(PLUGIN_UNKNOWN)
    try:
        float(val)
    except ValueError:
        print("UNKNOWN: Could not parse output")
        sys.exit(PLUGIN_UNKNOWN)


def check_greater(value, warn, crit, msg, perfdata):
    """Threshold logic for values where higher is worse."""
    if warn == 0 or crit == 0:
        print("OK: " + msg + " | " + perfdata + "=" + str(value) + ";;;;")
        sys.exit(PLUGIN_OK)
    elif value > crit:
        print("CRITICAL: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_CRITICAL)
    elif value > warn:
        print("WARNING: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_WARNING)
    else:
        print("OK: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_OK)


def check_lower(value, warn, crit, msg, perfdata):
    """Threshold logic for values where lower is worse."""
    if warn == 0 or crit == 0:
        print("OK: " + msg + " | " + perfdata + "=" + str(value) + ";;;;")
        sys.exit(PLUGIN_OK)
    elif value < crit:
        print("CRITICAL: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_CRITICAL)
    elif value < warn:
        print("WARNING: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_WARNING)
    else:
        print("OK: " + msg + " | " + perfdata + "=" + str(value) + ";" + str(warn) + ";" + str(crit) + ";;")
        sys.exit(PLUGIN_OK)


def format_uptime(seconds):
    """Converts seconds into days, hours, minutes, seconds."""
    days = seconds // 86400
    hours = (seconds // 3600) - (days * 24)
    minutes = (seconds // 60) - (days * 1440) - (hours * 60)
    secs = seconds % 60
    return days, hours, minutes, secs


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="check_fritz Nagios Plugin")
    parser.add_argument("-H", "--host", default="fritz.box", help="IP-Adress or hostname from the Fritz!Box")
    parser.add_argument("-a", "--authfile", help="Authentication file")
    parser.add_argument("-p", "--port", default="49443", help="SSL-Port from the Fritz!Box")
    parser.add_argument("-u", "--username", default="dslf-config", help="Login Username for the Fritz!Box")
    parser.add_argument("-P", "--password", default="", help="Login Password for the Fritz!Box")
    parser.add_argument("-f", "--function", default="status", help="Function to check")
    parser.add_argument("-w", "--warning", type=float, default=0, help="Warning threshold")
    parser.add_argument("-c", "--critical", type=float, default=0, help="Critical threshold")
    parser.add_argument("-d", "--debug", action="store_true", help="prints debug information")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Argument overrides
    username = args.username
    password = args.password
    warn = args.warning
    crit = args.critical

    if args.authfile:
        try:
            async with aiofiles.open("/etc/nagios/scripts/" + args.authfile, "r") as f:
                content = await f.read()
                lines = content.splitlines()
                if len(lines) >= 2:
                    username = lines[0]
                    password = lines[1]
        except Exception as e:
            print("UNKNOWN: Could not read authfile - " + str(e))
            sys.exit(PLUGIN_UNKNOWN)

    # Function and Index extraction
    func_parts = args.function.split(":", 1)
    func_name = func_parts[0]
    index = func_parts[1] if len(func_parts) > 1 else "0"

    url = ""
    service = ""
    action = ""
    xml_var = ""

    # Routing logic based on requested function
    if func_name in ("status", "linkuptime"):
        url = "wanpppconn1"
        service = "WANPPPConnection"
        if index == "cable":
            url = "wanipconnection1"
            service = "WanIPConnection"
        elif index == "pppoe":
            url = "wanpppconn1"
            service = "WANPPPConnection"
        action = "GetInfo"

    elif func_name in ("downstreamrate", "upstreamrate", "downstream", "upstream"):
        url = "wancommonifconfig1"
        service = "WANCommonInterfaceConfig"
        action = "X_AVM-DE_GetOnlineMonitor"
        xml_var = "<NewSyncGroupIndex>0</NewSyncGroupIndex>"

    elif func_name == "update":
        url = "userif"
        service = "UserInterface"
        action = "GetInfo"

    elif func_name == "uptime":
        url = "deviceinfo"
        service = "DeviceInfo"
        action = "GetInfo"

    elif func_name in ("thermometer", "socketpower", "socketenergy", "socketswitch"):
        url = "x_homeauto"
        service = "X_AVM-DE_Homeauto"
        action = "GetGenericDeviceInfos"
        xml_var = "<NewIndex>" + index + "</NewIndex>"

    else:
        print("UNKNOWN: Unknown function")
        sys.exit(PLUGIN_UNKNOWN)

    # Formulate HTTP SOAP request
    target_url = "https://" + args.host + ":" + args.port + "/upnp/control/" + url
    headers = {
        "Content-Type": "text/xml; charset='utf-8'",
        "SOAPACTION": "urn:dslforum-org:service:" + service + ":1#" + action
    }
    soap_body = """<?xml version='1.0'?> 
    <s:Envelope xmlns:s='http://schemas.xmlsoap.org/soap/envelope/' s:encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'> 
        <s:Body> 
            <u:""" + action + """ xmlns:u='urn:dslforum-org:service:""" + service + """:1'> """ + xml_var + """ </u:""" + action + """> 
        </s:Body> 
    </s:Envelope>"""

    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                target_url,
                data=soap_body,
                headers=headers,
                auth=aiohttp.BasicAuth(username, password),
                ssl=False,
                timeout=aiohttp.ClientTimeout(total=10)
            ) as response:
                query_result = await response.text()
    except Exception as e:
        print("UNKNOWN: Connection error - " + str(e))
        sys.exit(PLUGIN_UNKNOWN)

    if args.debug:
        print(query_result)

    if response.status == 401 or "401 Unauthorized" in query_result:
        print("ERROR - Wrong Password")
        sys.exit(PLUGIN_ERROR)

    # Response parsing based on requested function
    if func_name == "status":
        status = find_xml_value(query_result, "NewConnectionStatus")
        if not status:
            print("UNKNOWN: Could not get a response | 'status'=" + str(PLUGIN_UNKNOWN) + ";;;;")
            sys.exit(PLUGIN_UNKNOWN)

        if status == "Connected":
            print("OK: " + status + " | 'status'=" + str(PLUGIN_OK) + ";;;;")
            sys.exit(PLUGIN_OK)
        elif status in ("Connecting", "Authenticating"):
            print("WARNING: " + status + " | 'status'=" + str(PLUGIN_WARNING) + ";;;;")
            sys.exit(PLUGIN_WARNING)
        else:
            print("ERROR - " + status + " | 'status'=" + str(PLUGIN_ERROR) + ";;;;")
            sys.exit(PLUGIN_ERROR)

    elif func_name == "linkuptime":
        linkuptime_str = find_xml_value(query_result, "NewUptime")
        check_number(linkuptime_str)
        linkuptime = int(linkuptime_str)
        d, h, m, s = format_uptime(linkuptime)
        print("OK: Link Uptime " + str(linkuptime) + " seconds (" + str(d) + "d " + str(h) + "h " + str(m) + "m " + str(s) + "s) | 'linkuptime'=" + str(linkuptime) + "s;;;;")
        sys.exit(PLUGIN_OK)

    elif func_name == "downstreamrate":
        list_ds_byte = find_xml_value(query_result, "Newds_current_bps")
        curr_ds_byte = list_ds_byte.split(",")[0] if list_ds_byte else ""
        check_number(curr_ds_byte)

        ds_rate_mbit = round((float(curr_ds_byte) * 8) / 1000000.0, 2)
        msg = "Current Downstream " + str(ds_rate_mbit) + " Mbit/s"
        check_greater(ds_rate_mbit, warn, crit, msg, "'current_downstream'")

    elif func_name == "upstreamrate":
        list_us_byte = find_xml_value(query_result, "Newus_current_bps")
        curr_us_byte = list_us_byte.split(",")[0] if list_us_byte else ""
        check_number(curr_us_byte)

        us_rate_mbit = round((float(curr_us_byte) * 8) / 1000000.0, 2)
        msg = "Current Upstream " + str(us_rate_mbit) + " Mbit/s"
        check_greater(us_rate_mbit, warn, crit, msg, "'current_upstream'")

    elif func_name == "downstream":
        ds_byte = find_xml_value(query_result, "Newmax_ds")
        check_number(ds_byte)

        downstream = math.floor((float(ds_byte) * 8) / 1000000.0)
        msg = "Downstream " + str(downstream) + " Mbit/s"
        check_lower(downstream, warn, crit, msg, "'downstream_rate'")

    elif func_name == "upstream":
        us_byte = find_xml_value(query_result, "Newmax_us")
        check_number(us_byte)

        upstream = math.floor((float(us_byte) * 8) / 1000000.0)
        msg = "Upstream " + str(upstream) + " Mbit/s"
        check_lower(upstream, warn, crit, msg, "'upstream_rate'")

    elif func_name == "update":
        update_str = find_xml_value(query_result, "NewUpgradeAvailable")
        if update_str == "0":
            print("OK: No Upgrade available | 'update_pending'=" + update_str + ";;;;")
            sys.exit(PLUGIN_OK)
        else:
            print("CRITICAL: Upgrade available | 'update_pending'=" + update_str + ";;;;")
            sys.exit(PLUGIN_CRITICAL)

    elif func_name == "uptime":
        uptime_str = find_xml_value(query_result, "NewUpTime")
        check_number(uptime_str)
        uptime = int(uptime_str)
        d, h, m, s = format_uptime(uptime)
        print("OK: Uptime " + str(uptime) + " seconds (" + str(d) + "d " + str(h) + "h " + str(m) + "m " + str(s) + "s) | 'uptime'=" + str(uptime) + "s;;;;")
        sys.exit(PLUGIN_OK)

    # Smart Home Features
    elif func_name in ("thermometer", "socketpower", "socketenergy", "socketswitch"):
        error_code = find_xml_value(query_result, "errorCode")
        if error_code == "820":
            print("UNKNOWN: Not able to fetch current " + func_name + " status | '" + func_name + "_current_state'=" + str(PLUGIN_UNKNOWN) + ";;;;")
            sys.exit(PLUGIN_UNKNOWN)
        if error_code == "713":
            print("UNKNOWN: Specified device index invalid")
            sys.exit(PLUGIN_UNKNOWN)

        device_firmware = find_xml_value(query_result, "NewFirmwareVersion")
        device_product = find_xml_value(query_result, "NewProductName")
        device_name = find_xml_value(query_result, "NewDeviceName")
        device_present = find_xml_value(query_result, "NewPresent")

        if func_name == "thermometer":
            temp_feature = find_xml_value(query_result, "NewTemperatureIsEnabled")
            temp_celsius = find_xml_value(query_result, "NewTemperatureCelsius")

            if device_present == "CONNECTED":
                if temp_feature != "ENABLED":
                    print("UNKNOWN: Temperature is not enabled on this device | 'thermometer_current_state'=" + str(PLUGIN_UNKNOWN) + ";;;;")
                    sys.exit(PLUGIN_UNKNOWN)

                current_temp = round(float(temp_celsius) / 10.0, 1)
                text = device_product + " " + device_firmware + " - " + device_name + " " + device_present + " " + str(current_temp) + " C"
                check_lower(current_temp, warn, crit, text, "'thermometer_current_state'=" + str(PLUGIN_OK) + ";;;; 'thermometer_current_temp'")
            elif device_present == "UNKNOWN":
                print("UNKNOWN: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present + " | 'thermometer_current_state'=" + str(PLUGIN_UNKNOWN) + ";;;;")
                sys.exit(PLUGIN_UNKNOWN)
            else:
                print("CRITICAL: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present + " | 'thermometer_current_state'=" + str(PLUGIN_CRITICAL) + ";;;;")
                sys.exit(PLUGIN_CRITICAL)

        else:  # socketpower, socketenergy, socketswitch
            multimeter_feature = find_xml_value(query_result, "NewMultimeterIsEnabled")

            if device_present == "CONNECTED":
                if multimeter_feature != "ENABLED":
                    print("UNKNOWN: Device with index " + index + " is not a socket")
                    sys.exit(PLUGIN_UNKNOWN)

                if func_name == "socketpower":
                    power_str = find_xml_value(query_result, "NewMultimeterPower")
                    current_power = round(float(power_str) / 100.0, 2)
                    text = device_product + " " + device_firmware + " - " + device_name + " " + device_present + " " + str(current_power) + " W"
                    check_greater(current_power, warn, crit, text, "'socket_current_power'")

                elif func_name == "socketenergy":
                    energy_str = find_xml_value(query_result, "NewMultimeterEnergy")
                    current_energy = round(float(energy_str) / 1000.0, 2)
                    text = device_product + " " + device_firmware + " - " + device_name + " " + device_present + " " + str(current_energy) + " kWh"
                    check_greater(current_energy, warn, crit, text, "'socket_total_consumption'")

                elif func_name == "socketswitch":
                    switch_state = find_xml_value(query_result, "NewSwitchState")
                    interpret_off_as_critical = (warn >= 1 or crit >= 1)
                    switch_state_int = 1 if switch_state == "ON" else 0

                    if switch_state == "OFF" and interpret_off_as_critical:
                        print("CRITICAL: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present + " Switch " + switch_state + " | 'socket_switch_state'=" + str(switch_state_int) + ";;;;")
                        sys.exit(PLUGIN_CRITICAL)
                    else:
                        print("OK: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present + " Switch " + switch_state + " | 'socket_switch_state'=" + str(switch_state_int) + ";;;;")
                        sys.exit(PLUGIN_OK)

            elif device_present == "UNKNOWN":
                print("UNKNOWN: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present)
                sys.exit(PLUGIN_UNKNOWN)
            else:
                print("CRITICAL: " + device_product + " " + device_firmware + " - " + device_name + " " + device_present)
                sys.exit(PLUGIN_CRITICAL)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

