import argparse
import sys
import os
import asyncio
import platform

#-------------------------------------------------------------------------------

_candebug = False
def candebug():
    global _candebug
    return _candebug
def setcandebug(value):
    global _candebug
    _candebug = value

def infomsg(msg):
    if candebug():
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

async def doospfroutescall(device):
    cmdline = ["/usr/bin/mmc", "extcsd", "read", device]
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip()
    errors = stderr.decode("utf-8").strip()
    exitcode = process.returncode

    if exitcode == 0:
        exitnagios("OK", "no issues detected with the sdcard")
    else:
        exitnagios("CRITICAL", "there are issues with the sdcard")

#-------------------------------------------------------------------------------

async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--device", dest="device", default="", help="block device to check")
    parser.add_argument("-®", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    
    setcandebug(args.debug)
    
    if args.device == "":
        exitnagios("CRITICAL", "no device specified")
    
    await doospfroutescall(args.device)

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

