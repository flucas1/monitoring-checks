#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import datetime
import asyncio
import aiohttp
import aiohttp_socks


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-i", "--ip", dest="ip", default="127.0.0.1")
    parser.add_argument("-p", "--port", dest="port", default="1080")
    parser.add_argument("-g", "--target", dest="target", default="https://www.google.com")
    parser.add_argument("-m", "--max-time", dest="max_time", default=10, type=int)
    parser.add_argument("-d", "--debug", dest="debug", action="store_true")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if not args.ip or not args.port or not args.target:
        exitnagios("UNKNOWN", "Missing required parameter(s).")

    connector = aiohttp_socks.SocksConnector.from_url("socks5://" + args.ip + ":" + args.port)
    timeout = aiohttp.ClientTimeout(total=args.max_time)

    ts = datetime.now(timezone.utc).timestamp()

    try:
        async with aiohttp.ClientSession(connector=connector, timeout=timeout) as session:
            async with session.get(args.target) as response:
                ret = 0 if response.status == 200 else 1
    except aiohttp.ClientConnectorError:
        ret = 1
    except aiohttp.ClientError:
        ret = 1
    except asyncio.TimeoutError:
        ret = 1
    except Exception:
        ret = 1

    tt = datetime.now(timezone.utc).timestamp() - ts
    mse = int(tt * 1000)

    if ret == 0:
        exitnagios("OK", "Latency " + str(mse) + "ms.")
    else:
        exitnagios("CRITICAL", "Proxy is down, returning " + str(ret) + " after " + str(mse) + "ms")


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
