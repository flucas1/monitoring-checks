#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import time
import subprocess


def main():
    # Setup argument parser to replicate getopt behavior
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument('-i', dest='ip', default='127.0.0.1')
    parser.add_argument('-p', dest='port', default='1080')
    parser.add_argument('--target', dest='target', default='https://www.google.com')
    parser.add_argument('--max-time', dest='max_time', default=10, type=int)
    parser.add_argument('-h', '--help', dest='help', action='store_true')

    try:
        args, unknown = parser.parse_known_args()
    except SystemExit:
        print("UNKNOWN - Failed parsing options.")
        sys.exit(3)

    if unknown:
        print("UNKNOWN - Failed parsing options.")
        sys.exit(3)

    if args.help:
        print("""check_socks - Monitor a socks5 proxy.
Usage:
    --help     = Print this message
    -i         = Proxy IP address (default 127.0.0.1)
    -p         = Proxy port (default 1080)
    --target   = Url to check socks proxy (default https://www.google.com)
    --max-time = Maximum time in seconds that you allow the whole operation to take (default 10)""")
        sys.exit(0)

    if not args.ip or not args.port or not args.target:
        print('UNKNOWN - Missing required parameter(s).')
        sys.exit(3)

    # Construct the curl command
    cmd = [
        "curl",
        "--max-time", str(args.max_time),
        "-sf",
        "--socks5-hostname", f"{args.ip}:{args.port}",
        args.target
    ]

    # Record start time in nanoseconds
    ts = time.time_ns()

    try:
        # Execute curl, suppressing stdout and stderr
        result = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        ret = result.returncode
    except FileNotFoundError:
        print("UNKNOWN - curl command not found on the system.")
        sys.exit(3)

    # Calculate latency in milliseconds
    tt = (time.time_ns() - ts) // 1_000_000

    if ret == 0:
        print(f"OK - Latency {tt}ms.")
        sys.exit(0)
    else:
        print(f"CRITICAL - Proxy is down, curl returns {ret} after {tt}ms")
        sys.exit(1)


if __name__ == '__main__':
    main()
