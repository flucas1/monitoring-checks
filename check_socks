#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import time
import asyncio
import aiohttp
import aiohttp_socks


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument('-i', dest='ip', default='127.0.0.1')
    parser.add_argument('-p', dest='port', default='1080')
    parser.add_argument('--target', dest='target', default='https://www.google.com')
    parser.add_argument('--max-time', dest='max_time', default=10, type=int)
    args = parser.parse_args()

    if not args.ip or not args.port or not args.target:
        print('UNKNOWN - Missing required parameter(s).')
        sys.exit(3)

    connector = aiohttp_socks.SocksConnector.from_url(f'socks5://{args.ip}:{args.port}')
    timeout = aiohttp.ClientTimeout(total=args.max_time)

    ts = time.time_ns()

    try:
        async with aiohttp.ClientSession(connector=connector, timeout=timeout) as session:
            async with session.get(args.target) as response:
                ret = 0 if response.status == 200 else 1
    except aiohttp.ClientConnectorError:
        ret = 1
    except aiohttp.ClientError:
        ret = 1
    except asyncio.TimeoutError:
        ret = 1
    except Exception:
        ret = 1

    tt = (time.time_ns() - ts) // 1_000_000

    if ret == 0:
        print(f"OK - Latency {tt}ms.")
        sys.exit(0)
    else:
        print(f"CRITICAL - Proxy is down, curl returns {ret} after {tt}ms")
        sys.exit(1)


if __name__ == '__main__':
    asyncio.run(main())
