#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import ipaddress
import pygeoip
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def get_fail2ban_client_path():
    return "/usr/bin/fail2ban-client"


async def run_cmdline(cmdline):
    try:
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        if exitcode != 0:
            infomsg("Command failed:")
            infomsg(output)
            infomsg(errors)
            return None
        else:
            return output
    except Exception as e:
        infosmg("exception - " + str(e))
    return None


async def check_fail2ban_status():
    cmdline = [get_fail2ban_client_path(), "ping"]
    infomsg("Running command: " + str(cmdline))
    output = await run_cmdline(cmdline)
    infomsg("Fail2Ban server response: " + str(output))
    if output != None:
        if "Server replied: pong" in output:
            return True
    return False


async def get_jail_list():
    cmdline = [get_fail2ban_client_path(), "status"]
    infomsg("Running command: " + str(cmdline))
    output = await run_cmdline(cmdline)
    if output != None:
        for line in output.splitlines():
            if "Jail list:" in line:
                jail_list = [jail.strip() for jail in line.split("Jail list:")[-1].strip().split(",")]
                infomsg("Jails list: " + ", ".join(jail_list))
                return jail_list
    return None



async def get_banned_ips(jail_name):
    cmdline = [get_fail2ban_client_path(), "status", jail_name]
    infomsg("Running command: " + str(cmdline))
    output = await run_cmdline(cmdline)
    if output != None:
        for line in output.splitlines():
            if "Banned IP list:" in line:
                banned_ips = [ip.strip() for ip in line.split("Banned IP list:")[-1].strip().split()]
                infomsg("Currently banned IPs for jail " + jail_name + ": " + " ".join(banned_ips))
                return banned_ips
    return None


def is_ipv6(ip):
    try:
        ip_obj = ipaddress.ip_address(ip)
        return isinstance(ip_obj, ipaddress.IPv6Address)
    except ValueError:
        return False


async def get_city_country(ip_address):
    if is_ipv6(ip_address):
        database = "/usr/share/GeoIP/GeoIPv6.dat"
    else:
        database = "/usr/share/GeoIP/GeoIP.dat"
    gi = pygeoip.GeoIP(database)
    if gi is not None:
        city = ""  # this database does not support 'region'
        country = gi.country_name_by_addr(ip_address)
    else:
        city = None
        country = None
    return country, city


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-j", "--jail", dest="jail", help="Specify a specific jail to check.")
    parser.add_argument("-w", "--warning", dest="warning", default="1", help="Warning threshold for banned IPs.")
    parser.add_argument("-c", "--critical", dest="critical", default="2", help="Critical threshold for banned IPs.")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    jail = args.jail
    warning = int(args.warning)
    critical = int(args.critical)

    valid_status = await check_fail2ban_status()
    if not valid_status:
        exitnagios("CRITICAL", "Fail2Ban server not responding. Check if it is running and accessible.")

    jails = None
    if jail:
        jails = [jail]
    else:
        jails = await get_jail_list()

    error_count = 0
    if jails == None:
        exitnagios("CRITICAL", "Unable to retrieve the jail list.")
    else:
        dict_banned = {}
        for jail_name in jails:
            banned_ips = await get_banned_ips(jail_name)
            if banned_ips != None:
                infomsg("Jail " + jail_name + " has " + str(len(banned_ips)) + " banned IP(s): " + ", ".join(banned_ips))
                for banned_ip in banned_ips:
                    if banned_ip not in dict_banned.keys():
                        country, city = await get_city_country(banned_ip)
                        dict_banned[banned_ip] = [city, country]
            else:
                error_count += 1


    if error_count == 0:
        countjails = len(jails)
        countbanned = len(dict_banned)
        state = "OK"
        if countbanned >= critical:
            state = "CRITICAL"
        elif countbanned >= warning:
            state = "WARNING"
        exitnagios(state, str(countjails) + " detected jails with " + str(countbanned) + " banned IPs: " + str(dict_banned) + " | banned=" + str(countbanned) + " jails=" + str(countjails))
    else:
        exitnagios("CRITICAL", "some calls failed | banned=-1 jails=-1")

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
