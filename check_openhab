iso8601_duration_re = \
    re.compile(r"""^P(?:(?:(\d+)Y)?
                        (?:(\d+)M)?
                        (?:(\d+)D)?
                        (?:T(?:(\d+)H)?
                            (?:(\d+)M)?
                            (?:(\d+)S)?)?
                        |
                        (\d+)W)$""", re.X)


def parse_iso8601(value, forward):
    period_match = iso8601_duration_re.search(value)
    if period_match:
        multiplier = 1 if forward else -1
        years, months, days, hours, minutes, seconds, weeks = [int(i) * multiplier if i else 0 for i in period_match.groups()]
        return datetime.datetime.now(pytz.utc) + dateutil.relativedelta.relativedelta(years=years, months=months, days=days, hours=hours, minutes=minutes, seconds=seconds, weeks=weeks)
    return dateutil.parser.parse(value, default=datetime.datetime(1, 1, 1))


def split_threshold(value, level, convert):
    if value in [None, "", ":"]:
        return (None, None)
    items = value.split(":")
    try:
        many = len(items)
        if many == 2:
            return (convert(items[0], False), convert(items[1], True))
        else:
            exitnagios("CRITICAL", "Malformed " + str(level) + " value: " + str(value))
    except:
        exitnagios("CRITICAL", "invalid value passed as " + str(level) + " parameter: " + str(value))


def check_limits(state, low, high, name, return_code):
    if low is not None and state < low:
        return (return_code, name + " state (" + str(state) + ") is less than " + str(low) + " | value=" + str(state))
    elif high is not None and state > high:
        return (return_code, name + " state (" + str(state) + ") is greater than " + str(high) + " | value=" + str(state))
    else:
        return (None, None)


def build_thresholds(args):
    thresholds = {}

    thresholds['numeric_limits'] = args.number_warn is not None or args.number_crit is not None or args.number_unkn is not None
    if thresholds['numeric_limits']:
        thresholds['number_warn_low'], thresholds['number_warn_high'] = split_threshold(args.number_warn, "number_warn", lambda i, f: float(i))
        thresholds['number_crit_low'], thresholds['number_crit_high'] = split_threshold(args.number_crit, "number_crit", lambda i, f: float(i))
        thresholds['number_unkn_low'], thresholds['number_unkn_high'] = split_threshold(args.number_unkn, "number_unkn", lambda i, f: float(i))
        infomsg("# numeric thresholds: " + str(thresholds['number_unkn_low']) + " <<< " + str(thresholds['number_crit_low']) + " << " + str(thresholds['number_warn_low']) + " < x > " + str(thresholds['number_warn_high']) + " >> " + str(thresholds['number_crit_high']) + " >>> " + str(thresholds['number_unkn_high']))

    thresholds['datetime_limits'] = args.datetime_warn is not None or args.datetime_crit is not None
    if thresholds['datetime_limits']:
        thresholds['datetime_warn_low'], thresholds['datetime_warn_high'] = split_threshold(args.datetime_warn, "datetime_warn", lambda i, f: parse_iso8601(i, f))
        thresholds['datetime_crit_low'], thresholds['datetime_crit_high'] = split_threshold(args.datetime_crit, "datetime_crit", lambda i, f: parse_iso8601(i, f))
        infomsg("# time thresholds: " + str(thresholds['datetime_crit_low']) + " << " + str(thresholds['datetime_warn_low']) + " < x > " + str(thresholds['datetime_warn_high']) + " >> " + str(thresholds['datetime_crit_high']))

    thresholds['string_limits'] = args.string_ok is not None or args.string_warn is not None or args.string_crit is not None
    if thresholds['string_limits']:
        if args.string_ok:
            try:
                thresholds['compiled_regex_ok'] = re.compile(args.string_ok)
            except:
                exitnagios("CRITICAL", "Unable to compile string OK regex: " + args.string_ok)
        else:
            thresholds['compiled_regex_ok'] = None

        if args.string_warn:
            try:
                thresholds['compiled_regex_warn'] = re.compile(args.string_warn)
            except:
                exitnagios("CRITICAL", "Unable to compile string WARNING regex: " + args.string_warn)
        else:
            thresholds['compiled_regex_warn'] = None

        if args.string_crit:
            try:
                thresholds['compiled_regex_crit'] = re.compile(args.string_crit)
            except:
                exitnagios("CRITICAL", " Unable to compile string CRITICAL regex: " + args.string_crit)
        else:
            thresholds['compiled_regex_crit'] = None

    return thresholds


def check_thresholds(thresholds, state, name):
    if thresholds.get('numeric_limits'):
        try:
            state_float = float(state.split()[0])
        except ValueError as e:
            return ("CRITICAL", "Numeric thresholds given for non-numeric state: " + str(state) + " | value=" + str(state))
        rc, message = check_limits(state_float, thresholds.get('number_unkn_low'), thresholds.get('number_unkn_high'), name, "UNKNOWN")
        if rc is not None:
            return (rc, message)
        rc, message = check_limits(state_float, thresholds.get('number_crit_low'), thresholds.get('number_crit_high'), name, "CRITICAL")
        if rc is not None:
            return (rc, message)
        rc, message = check_limits(state_float, thresholds.get('number_warn_low'), thresholds.get('number_warn_high'), name, "WARNING")
        if rc is not None:
            return (rc, message)
        return ("OK", name + " state within valid numeric range: " + str(state) + " | value=" + str(state))

    if thresholds.get('datetime_limits'):
        try:
            state_time = dateutil.parser.parse(state)
        except ValueError as e:
            return ("CRITICAL", "Time thresholds given for non-time state: " + str(state) + " | value=" + str(state))
        rc, message = check_limits(state_time, thresholds.get('datetime_crit_low'), thresholds.get('datetime_crit_high'), name, "CRITICAL")
        if rc is not None:
            return (rc, message)
        rc, message = check_limits(state_time, thresholds.get('datetime_warn_low'), thresholds.get('datetime_warn_high'), name, "WARNING")
        if rc is not None:
            return (rc, message)
        return ("OK", name + " state within valid datetime range: " + str(state))

    if thresholds.get('string_limits'):
        compiled_regex_crit = thresholds.get('compiled_regex_crit')
        compiled_regex_warn = thresholds.get('compiled_regex_warn')
        compiled_regex_ok = thresholds.get('compiled_regex_ok')

        if compiled_regex_crit and compiled_regex_crit.search(state):
            return ("CRITICAL", name + " string regex critical matched state: " + str(state) + " | value=" + str(state))
        elif compiled_regex_warn and compiled_regex_warn.search(state):
            return ("WARNING", name + " string regex warning matched state: " + str(state) + " | value=" + str(state))
        elif compiled_regex_ok and compiled_regex_ok.search(state):
            return ("OK", name + " string regex ok matched state: " + str(state) + " | value=" + str(state))
        else:
            return ("UNKNOWN", name + " any regex is matching " + str(state) + " | value=" + str(state))

    return ("OK", name + " state within fallback sittuation: " + str(state) + " | value=" + str(state))


async def check_item(object_json, thresholds, timeoutstatus):
    if object_json["state"] in ("Uninitialized", "Undefined", "UNDEF", "NULL"):
        return (timeoutstatus, object_json["name"] + " is uninitialized.")
    else:
        return check_thresholds(thresholds, object_json["state"], object_json["name"])


async def check_thing(object_json, args):
    status = object_json["statusInfo"]["status"]
    if status == "ONLINE":
        rc = "OK"
    elif status == "UNKONWN":
        rc = "UNKNOWN"
    else:
        rc = "CRITICAL"
    return (rc, object_json["UID"] + " is " + status + ".")


async def check_group(group_json, thresholds, args, timeoutstatus):
    final_rc = "OK"
    final_messages = []
    perfdata = ""
    for i in group_json["members"]:
        if i["type"] == "GroupItem":
            link = await fetch_object(i["link"], args, timeoutstatus)
            rc, messages, perfdata = await check_group(link, thresholds, args, timeoutstatus)
            final_messages += messages
            perfdata += perfdata
        else:
            rc, message = await check_item(i, thresholds, timeoutstatus)
            try:
                state_float = float(i["state"])
                perfdata += (i["name"] + "=" + i["state"] + " ")
            except:
                pass

            if rc != "OK":
                final_messages.append(message)
        if rc == "CRITICAL":
            final_rc = "CRITICAL"
        elif rc == "UNKNOWN" and final_rc in ["OK", "WARNING"]:
            final_rc = "UNKNOWN"
        elif rc == "WARNING" and final_rc in ["OK"]:
            final_rc = "WARNING"
    return (final_rc, final_messages, perfdata)


async def fetch_object(item_url, args, timeoutstatus):
    infomsg("# " + str(item_url))

    if args.exclude is True:
        ssl_context = ssl.create_default_context()
        ssl_context.check_hostname = False
        ssl_context.verify_mode = ssl.CERT_NONE
    else:
        ssl_context = None

    headers = {
        "Accept": "application/json"
    }

    if args.authorization is not None:
        auth_params = args.authorization.split(":")
        if len(auth_params) != 2:
            if not os.path.isfile(args.authorization):
                exitnagios("CRITICAL", "Authorization parameters not in username:password format, nor an existing file")
            else:
                filecontentslines = await readtextfile(args.authorization)
                auth_params = []
                auth_params.append(filecontentslines[0])
                auth_params.append(filecontentslines[1])

        auth_header = aiohttp.encode_basic_auth(auth_params[0], auth_params[1])
        headers['Authorization'] = auth_header

    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(item_url, headers=headers, ssl=ssl_context) as response:
                if response.status == 404:
                    exitnagios(timeoutstatus, "item " + str(item_url) + " does not exist.")
                elif response.status != 200:
                    exitnagios(timeoutstatus, "exception fetching item data - HTTP " + str(response.status))
                object_json = await response.json()
                infomsg("# " + str(json.dumps(object_json)))
                return object_json
    except Exception as e:
        exitnagios(timeoutstatus, "exception fetching item data - " + str(e))


async def readtextfile(file_path):
    async with aiofiles.open(file_path, mode="rb") as f:
        content = await f.read()
    return content.decode("utf-8").strip().splitlines()


