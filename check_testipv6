import os
import sys
import argparse
import asyncio
import datetime

import selenium
import selenium.webdriver
import selenium.webdriver.common.keys
import selenium.webdriver.chrome.options
import selenium.webdriver.common.action_chains
import selenium.webdriver.common.by
import selenium.webdriver.support.ui
import selenium.webdriver.support.expected_conditions

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-p", "--proxy", dest="proxy", default="", help="use a proxy")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args

# -------------------------------------------------------------------------------


async def generatedriver(proxy):
    chrome_options = selenium.webdriver.chrome.options.Options()
    # chrome_options.add_argument("--incognito")
    # chrome_options.add_argument("--enable-features=EphemeralGuestProfilesOnStartup")
    chrome_options.add_argument("--disk-cache-size=0")
    chrome_options.add_argument("--media-cache-size=0")
    chrome_options.add_argument("--headless")
    chrome_options.add_argument("--disable-gpu")
    chrome_options.add_argument("--no-zygote")
    chrome_options.add_argument("--renderer-process-limit=1")
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    chrome_options.add_argument("--in-process-gpu")
    chrome_options.add_argument("--use-gl=angle")
    chrome_options.add_argument("--use-angle=swiftshader-webgl")
    chrome_options.add_argument("--disable-popup-blocking")
    if proxy not in ["", None]:
        chrome_options.add_argument("--proxy-server=" + proxy)

    chrome_service = selenium.webdriver.ChromeService(executable_path="/usr/bin/chromedriver")

    driver = selenium.webdriver.Chrome(options=chrome_options, service=chrome_service)
    # driver.implicitly_Wait(10, TimeUnit.SECONDS)

    return driver


def check_page_loaded(driver):
    # self.log.info("Checking if {} page is loaded.".format(self.driver.current_url))
    page_state = driver.execute_script("return document.readyState;")
    return page_state == "complete"


async def wait_page_loaded(driver):
    timestamp = datetime.datetime.now(datetime.timezone.utc).timestamp()
    while True:
        if check_page_loaded(driver):
            break
        if datetime.datetime.now(datetime.timezone.utc).timestamp() - timestamp > 20:
            break
        await asyncio.sleep(1)

# -------------------------------------------------------------------------------


def extractvalue(driver, entryname):
    element = driver.find_element(selenium.webdriver.common.by.By.XPATH, "//td[text()=\"" + entryname + "\"]/following-sibling::td")
    value = element.text
    infomsg(value)
    return value


async def dotestipv6call(proxy):
    try:
        driver = await generatedriver(proxy)

        wait = selenium.webdriver.support.ui.WebDriverWait(driver, 10)
        action = selenium.webdriver.common.action_chains.ActionChains(driver)

        infomsg("browser OK")
        url = "https://test-ipv6.com/"
        driver.get(url)
        infomsg("asking for navigating " + url)

        await asyncio.sleep(5)
        await wait_page_loaded(driver)
        infomsg("page loaded")

        try:
            wait.until(selenium.webdriver.support.expected_conditions.text_to_be_present_in_element((selenium.webdriver.common.by.By.ID, "debugtable"), "Your readiness score"))
        except Exception as e:
            pass
        finally:
            infomsg("found element readiness score")

        try:
            resume = driver.find_element(selenium.webdriver.common.by.By.ID, "debugtable")
        except Exception as e:
            exitnagios("WARNING", "cannot find result element")
        if resume is None:
            exitnagios("WARNING", "no result from page")
        infomsg("test with results")

        rawresult = resume.text
        parts = rawresult.split()
        marks = parts[3]
        infomsg("raw marks is '" + marks + "'")
        grading = marks.split("/")
        try:
            currentmark = int(grading[0])
        except:
            currentmark = 0
        try:
            totalmarks = int(grading[1])
        except:
            totalmarks = 0

        if currentmark == 0:
            exitnagios("CRITICAL", "The result of the test is " + str(currentmark) + "/" + str(totalmarks) + " | result=" + str(currentmark) + " best=" + str(totalmarks))
        elif currentmark == totalmarks:
            exitnagios("OK", "The result of the test is " + str(currentmark) + "/" + str(totalmarks) + " | result=" + str(currentmark) + " best=" + str(totalmarks))
        else:
            exitnagios("WARNING", "The result of the test is " + str(currentmark) + "/" + str(totalmarks) + " | result=" + str(currentmark) + " best=" + str(totalmarks))
    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check - " + str(e))

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    await dotestipv6call(args.proxy)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

