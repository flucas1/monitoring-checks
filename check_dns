async def resolvewithretries(customresolver, zone, field, useTcp, retries=3):
    for i in range(retries):
        try:
            responses = customresolver.resolve(zone, field, tcp=useTcp, raise_on_no_answer=True)
            infomsg(f"responses for type {field} -> {responses}")
            return responses
        except dns.resolver.NXDOMAIN as e:
            infomsg(f"returning [] - {type(e).__name__} - {str(e)}")
            return []
        except dns.resolver.NoAnswer as e:
            infomsg(f"returning [] - {type(e).__name__} - {str(e)}")
            return []
        except Exception as e:
            infomsg(f"returning None - {type(e).__name__} - {str(e)}")
            await asyncio.sleep(i * 5)
    return None

def build_name(entry, zone):
    return entry.rstrip('.') + '.' + zone

def get_address(protocol, serverinfo):
    infomsg(f"get_address using {protocol} for {serverinfo}")

    parts = serverinfo.split("@")
    server = parts[0]
    port = int(parts[1]) if len(parts) > 1 else 53

    if server == ".":
        return f".@{port}"
    
    address = None
    try:
        if protocol == "-6":
            address = ipaddress.IPv6Address(server).compressed
        elif protocol == "-4":
            address = ipaddress.IPv4Address(server).compressed
        else:
            address = ipaddress.ip_address(server).compressed
    except Exception as e:
        infomsg(f"Exception in get_address: {str(e)}")

    if address is None:
        try:
            if protocol == "-6":
                address = socket.getaddrinfo(server, None, socket.AF_INET6)[0][4][0]
            elif protocol == "-4":
                address = socket.getaddrinfo(server, None, socket.AF_INET)[0][4][0]
            else:
                address = socket.getaddrinfo(server, None)[0][4][0]
        except Exception as e:
            infomsg(f"Exception in get_address: {str(e)}")
            return None

    result = f"{address}@{port}"
    infomsg(f"evaluated as {result}")
    return result

