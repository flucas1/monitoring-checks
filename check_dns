async def check_record(useTcp, protocol, server, timeoutvalue, timeoutstatus, authoritative, record, kind, expected, alternativeslogic, recmissingwarn, recmissingcrit, recmincountwarn, recmincountcrit):
    addressinfo = get_address(protocol, server)
    if addressinfo is None:
        return build_exitinfo("CRITICAL", f"error during get_address - {protocol} {server}")

    try:
        found = await get_records(useTcp, addressinfo, timeoutvalue, record, kind)
        if found is None:
            return build_exitinfo(timeoutstatus, "no response when trying to resolve records")
        elif found == "":
            if expected == ".":
                return build_exitinfo("OK", f"the query of record {record} to {addressinfo} did not return any value")
            return build_exitinfo("CRITICAL", "the server is not returning any value for the record")
        elif expected == "":
            return build_exitinfo("OK", f"the query of record {record} to {addressinfo} was successful with value {found} - no specific result was expected")
        else:
            listexpected = sorted(expected.split(","))
            listfound = sorted(found.split(","))
            if listexpected == listfound:
                return build_exitinfo("OK", f"the query of record {record} to {addressinfo} was successful with value {found} as expected | found={len(listfound)}")
            else:
                listunexpected = [test for test in listfound if test not in listexpected]
                msgunexpected = f"there were issues with the query of record {record} to {addressinfo} - Result {', '.join(listunexpected)} were not in expected {expected} | found={len(listfound)} unexpected={len(listunexpected)}"
                if listunexpected:
                    return build_exitinfo("CRITICAL", msgunexpected)

                listmissing = [test for test in listexpected if test not in listfound]
                msgmissing = f"the query of record {record} to {addressinfo} was successful with value {found} but is missing {', '.join(listmissing)} as in {expected} | found={len(listfound)} missing={len(listmissing)}"
                if alternativeslogic:
                    return build_exitinfo("OK", msgmissing)
                if len(listmissing) > recmissingcrit:
                    return build_exitinfo("CRITICAL", msgmissing)
                if len(listmissing) > recmissingwarn:
                    return build_exitinfo("WARNING", msgmissing)

                msgfound = f"the query of record {record} to {addressinfo} was successful with value {found} but is not reaching the minimum count of values | found={len(listfound)} unexpected=0 missing=0"
                if len(listfound) < recmincountcrit:
                    return build_exitinfo("CRITICAL", msgfound)
                if len(listfound) < recmincountwarn:
                    return build_exitinfo("WARNING", msgfound)

                return build_exitinfo("CRITICAL", "unexpected situation")
    except dns.exception.Timeout as e:
        return build_exitinfo(timeoutstatus, f"timeout reaching {addressinfo}")
    except dns.resolver.NoNameservers as e:
        if str(e).endswith("No route to host"):
            return build_exitinfo(timeoutstatus, f"error during check record - noroute - {str(e)}")
        return build_exitinfo("CRITICAL", f"error during check record - {type(e).__name__} - {str(e)}")
    except Exception as e:
        if expected == ".":
            return build_exitinfo("OK", f"the query of record {record} to {addressinfo} did not return any value")
        return build_exitinfo("CRITICAL", f"error during check record - {type(e).__name__} - {str(e)}")

