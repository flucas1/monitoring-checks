async def check_consistency(useTcp, protocol, server, timeoutvalue, timeoutstatus, authoritative, zone, mincountwarn, mincountcrit):
    addressinfo = get_address(protocol, server)
    if addressinfo is None:
        return build_exitinfo("CRITICAL", f"error during get_address - {protocol} {server}")

    try:
        mname = await get_mname(useTcp, addressinfo, timeoutvalue, zone)
        if not mname:
            return build_exitinfo(timeoutstatus, f"no response when trying to resolve mname for zone '{zone}' using server {addressinfo}")

        querydata = await get_query(useTcp, protocol, addressinfo, timeoutvalue, build_name(mname, zone))
        text_mname = await get_zone(useTcp, querydata, timeoutvalue, zone)
        if not text_mname:
            return build_exitinfo(timeoutstatus, f"no response when trying to transfer zone '{zone}' from mname")

        text_server = await get_zone(useTcp, addressinfo, timeoutvalue, zone)
        if not text_server:
            return build_exitinfo(timeoutstatus, f"no response when trying to transfer zone '{zone}' from server")

        if text_mname != text_server:
            infomsg(os.linesep.join(difflib.unified_diff(text_server.splitlines(), text_mname.splitlines())))
            return build_exitinfo("CRITICAL", f"zone '{zone}' in target server {server} and MNAME server {mname} are different.")

        ns = await get_ns(useTcp, addressinfo, timeoutvalue, zone)
        if not ns:
            return build_exitinfo(timeoutstatus, "no response when trying to resolve ns")

        validservers = []
        errorservers = []
        for test in ns:
            try:
                querydata = await get_query(useTcp, protocol, addressinfo, timeoutvalue, build_name(test, zone))
                text_test = await get_zone(useTcp, querydata, timeoutvalue, zone)
                if not text_test:
                    errorservers.append(test)
                elif text_test == text_server:
                    validservers.append(test)
                else:
                    infomsg(os.linesep.join(difflib.unified_diff(text_server.splitlines(), text_test.splitlines())))
                    return build_exitinfo("CRITICAL", f"zone '{zone}' in target server {server} and NS server {test} are different.")
            except Exception as e:
                infomsg(f"Exception in check_consistency: {str(e)}")
                errorservers.append(test)

        if len(validservers) < mincountcrit and mincountcrit >= 0 and errorservers:
            return build_exitinfo("CRITICAL", f"zone '{zone}' match, but too many servers are not responding - errors: {' '.join(errorservers)} - valid: {' '.join(validservers)} | valid={len(validservers)} errors={len(errorservers)}")
        if len(validservers) < mincountwarn and mincountwarn >= 0 and errorservers:
            return build_exitinfo("WARNING", f"zone '{zone}' match, but too many servers are not responding - errors: {' '.join(errorservers)} - valid: {' '.join(validservers)} | valid={len(validservers)} errors={len(errorservers)}")

        return build_exitinfo("OK", f"zone '{zone}' in target server matches the transfer from the MNAME and NS entries - errors {' '.join(errorservers)} - valid: {' '.join(validservers)} | valid={len(validservers)} errors={len(errorservers)}")
    except dns.exception.Timeout as e:
        return build_exitinfo(timeoutstatus, f"timeout reaching {addressinfo}")
    except dns.resolver.NoNameservers as e:
        if str(e).endswith("No route to host"):
            infomsg(f"Exception in check_consistency: {str(e)}")
            return build_exitinfo(timeoutstatus, f"error during check consistency - noroute - {str(e)}")
        infomsg(f"Exception in check_consistency: {str(e)}")
        return build_exitinfo("CRITICAL", f"error during check consistency - {type(e).__name__} - {str(e)}")
    except Exception as e:
        infomsg(f"Exception in check_consistency: {str(e)}")
        return build_exitinfo("CRITICAL", f"error during check consistency - {type(e).__name__} - {str(e)}")

