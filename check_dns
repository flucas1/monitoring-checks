    parts = addressinfo.split("@")
    address = parts[0]
    text = ""
    for i in range(3):
        try:
            xfr = dns.zone.from_xfr(
                dns.query.xfr(
                    address, zone, relativize=True, timeout=timeoutvalue, use_udp=(not useTcp)
                ),
                relativize=True
            )
            names = sorted(xfr.keys())
            text = os.linesep.join(
                node.to_text(item, origin=xfr.origin, relativize=True, sorted=True)
                for item in names
            )
        except Exception as e:
            infomsg(f"Exception in get_zone: {str(e)}")
            text = ""
        if text:
            break
        await asyncio.sleep(0.1)
    return text

async def get_mname(useTcp, addressinfo, timeoutvalue, zone):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, zone, "SOA", useTcp, retries=9)
    if responses is None:
        return ""
    return responses[0].mname.to_text()

async def get_serial(useTcp, addressinfo, timeoutvalue, zone):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, zone, "SOA", useTcp)
    if responses is None:
        return ""
    return responses[0].serial

async def get_retry(useTcp, addressinfo, timeoutvalue, zone):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, zone, "SOA", useTcp)
    if responses is None:
        return ""
    return responses[0].retry

async def get_ns(useTcp, addressinfo, timeoutvalue, zone):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, zone, "NS", useTcp)
    if responses is None:
        return ""
    return [response.target.to_text() for response in responses if response.target.to_text() not in responses]

async def get_records(useTcp, addressinfo, timeoutvalue, record, kind):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, record, kind, useTcp)
    if responses is None:
        return None
    return ",".join(
        "\"" + "".join(parttxt.decode() for parttxt in rdata.strings) + "\""
        if kind == "TXT" else rdata.to_text()
        for rdata in responses
    )

async def get_query(useTcp, protocol, addressinfo, timeoutvalue, entry):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    canonical_name = entry
    for _ in range(30):
        infomsg(canonical_name)
        answer = await resolvewithretries(customresolver, canonical_name, "CNAME", useTcp)
        infomsg(answer)
        if answer is None:
            return ""
        elif answer:
            canonical_name = answer[0].to_text()
        else:
            break

    alternatives = []
    for record_type in ("AAAA", "A") if protocol != "-4" else ("A",):
        responses = await resolvewithretries(customresolver, canonical_name, record_type, useTcp)
        if responses:
            alternatives.extend(responses)

    return alternatives[random.randrange(len(alternatives))].to_text() if alternatives else ""

async def get_resolver(addressinfo, timeoutvalue):
    parts = addressinfo.split("@")
    address = parts[0]
    port = int(parts[1]) if len(parts) > 1 else 53

    if address == ".":
        return dns.resolver.get_default_resolver()

    customresolver = dns.resolver.Resolver(configure=False)
    for _ in range(5):
        try:
            customresolver.read_resolv_conf(io.StringIO(f"nameserver {address}"))
            if customresolver.nameservers == [address]:
                break
        except Exception as e:
            infomsg(f"Exception in get_resolver: {str(e)}")
        await asyncio.sleep(1)
    else:
        return None

    customresolver.port = port
    customresolver.timeout = timeoutvalue
    infomsg(f"found resolver {customresolver.nameservers}")
    return customresolver

