async def resolvewithretries(customresolver, zone, field, useTcp, retries=3):
    responses = None
    # [] means that the record does not exists
    # None means error contacting the server
    for i in range(retries):
        try:
            responses = await customresolver.resolve(zone, field, tcp=useTcp, raise_on_no_answer=True)
        except dns.resolver.NXDOMAIN as e:
            # The DNS query name does not exist:
            infomsg("returning [] - " + type(e).__name__ + " - " + str(e))
            responses = []
        except dns.resolver.NoAnswer as e:
            # The DNS query name does not exist:
            infomsg("returning [] - " + type(e).__name__ + " - " + str(e))
            responses = []
        except Exception as e:
            infomsg("returning None - " + type(e).__name__ + " - " + str(e))
            responses = None
        infomsg("responses for type " + str(field) + " -> " + str(responses))
        if responses is None:
            await asyncio.sleep(i * 5)
        else:
            break
    infomsg(zone + " -> " + str(responses))
    return responses


def build_name(entry, zone):
    if entry.endswith("."):
        return entry[0:-1]
    else:
        return entry + "." + zone


async def get_address(protocol, serverinfo):
    infomsg("get_address using " + protocol + " for " + str(serverinfo))

    parts = serverinfo.split("@")
    server = parts[0]
    if len(parts) > 1:
        port = int(parts[1])
    else:
        port = 53

    if server == ".":
        result = "." + "@" + str(port)
    else:
        address = ""

        # 1. Check if the server string is already a valid IP address
        try:
            if protocol == "-6":
                address = ipaddress.IPv6Address(server).compressed
            elif protocol == "-4":
                address = ipaddress.IPv4Address(server).compressed
            else:
                address = ipaddress.ip_address(server).compressed

            return address + "@" + str(port)
        except Exception:
            pass

        # 2. Asynchronously resolve the hostname using dnspython
        try:
            # Using the default async resolver for standard system DNS queries
            sys_resolver = dns.asyncresolver.Resolver()
            if protocol == "-6":
                answers = await sys_resolver.resolve(server, "AAAA")
                address = answers[0].to_text()
            elif protocol == "-4":
                answers = await sys_resolver.resolve(server, "A")
                address = answers[0].to_text()
            else:
                # If no protocol is specified, try A first, then fallback to AAAA
                try:
                    answers = await sys_resolver.resolve(server, "A")
                    address = answers[0].to_text()
                except dns.resolver.NoAnswer:
                    answers = await sys_resolver.resolve(server, "AAAA")
                    address = answers[0].to_text()
        except Exception as e:
            infomsg("DNS resolution failed for " + server + ": " + str(e))
            return None

        result = address + "@" + str(port)

    infomsg("evaluated as " + result)
    return result


async def get_zone(useTcp, addressinfo, timeoutvalue, zone):
    parts = addressinfo.split("@")
    address = parts[0]
    # Map your boolean to the new enum
    # NEVER = TCP only (AXFR standard)
    # ONLY = UDP only
    # TRY_FIRST = UDP first, fallback to TCP if truncated
    mode = dns.query.UDPMode.NEVER if useTcp else dns.query.UDPMode.ONLY
    text = ""
    for i in range(3):
        text = ""
        try:
            zone_obj = dns.zone.Zone(origin=zone, relativize=True)
            await dns.asyncquery.inbound_xfr(where=address, txn_manager=zone_obj, timeout=timeoutvalue, udp_mode=mode)
            names = list(zone_obj.keys())
            names.sort()
            zone_lines = []
            for item in names:
                node = zone_obj[item]
                line = node.to_text(item, origin=zone_obj.origin, relativize=True, sorted=True)
                node_lines = line.splitlines()
                node_lines.sort()
                zone_lines.append(os.linesep.join(node_lines))
            text = os.linesep.join(zone_lines)
        except Exception as e:
            infomsg(str(e))
            text = ""
        if text == "":
            await asyncio.sleep(0.1)
        else:
            break
    return text


async def get_mname(useTcp, addressinfo, timeoutvalue, zone):
    customresolver = await get_resolver(addressinfo, timeoutvalue)
    responses = await resolvewithretries(customresolver, zone, "SOA", useTcp, retries=9)
    if responses is None or len(responses) == 0:
        return ""
    else:
        return (responses[0]).mname.to_text()


