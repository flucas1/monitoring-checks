#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import os
import sys
import socket
import argparse
import asyncio
import aiohttp
import bs4

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


original_getaddrinfo = socket.getaddrinfo


def forced_ipv6_gai_family(*args, **kwargs):
    global original_getaddrinfo
    responses = original_getaddrinfo(*args, **kwargs)
    return [response
            for response in responses
            if response[0] == socket.AF_INET6]


def forced_ipv4_gai_family(*args, **kwargs):
    global original_getaddrinfo
    responses = original_getaddrinfo(*args, **kwargs)
    return [response
            for response in responses
            if response[0] == socket.AF_INET]

# -------------------------------------------------------------------------------


async def dotorcall(protocol, response):
    try:
        url = "https://check.torproject.org/"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/113.0"
        }

        async with aiohttp.ClientSession() as session:
            async with session.get(url, headers=headers) as resp:
                if resp.status != 200:
                    exitnagios("CRITICAL", "unexpected HTTP status: " + str(resp.status))

                content = await resp.text()
                if content is None:
                    exitnagios("CRITICAL", "no result from page")

                soup = bs4.BeautifulSoup(content, "html.parser")

                element = soup.find("h1")
                if element is None:
                    exitnagios("CRITICAL", "could not find <h1> element")

                status = element.get("class")
                if status is None or len(status) == 0:
                    exitnagios("CRITICAL", "<h1> element has no class attribute")

                status_value = status[0]
                if status_value == response:
                    exitnagios("OK", "the result '" + status_value + "' is as expected")
                else:
                    exitnagios("CRITICAL", "the result '" + status_value + "' is not the expected value '" + response + "'")

    except aiohttp.ClientError as e:
        exitnagios("WARNING", "cannot connect - " + str(e))
    except Exception as e:
        exceptionmsg = str(e)
        exitnagios("CRITICAL", "unexpected error during the check - " + exceptionmsg)

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-4", "--ipv4", action="store_true", dest="ipv4", default=False, help="use ipv4 (exclusive with ipv6)")
    parser.add_argument("-6", "--ipv6", action="store_true", dest="ipv6", default=False, help="use ipv6 (exclusive with ipv4)")
    parser.add_argument("-0", "--ipv0", action="store_true", dest="ipv0", default=False, help="do not specify ip protocol version")
    # parser.add_argument("-p", "--proxy", dest="proxy", default="", help="use a proxy")
    parser.add_argument("-r", "--response", dest="response", default="open", help="response: open,closed")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)

    setcandebug(args.debug)

    protocol = None
    exclist = 0
    if args.ipv0 == True:
        protocol = ""
        exclist = exclist + 1
    if args.ipv4 == True:
        protocol = "-4"
        exclist = exclist + 1
        socket.getaddrinfo = forced_ipv4_gai_family
    if args.ipv6 == True:
        protocol = "-6"
        exclist = exclist + 1
        socket.getaddrinfo = forced_ipv6_gai_family
    if (exclist > 1):
        exitnagios("CRITICAL", "select ip protocol version 4 or 6, or 0 to relay on OS handling")
    elif (exclist < 1):
        exitnagios("CRITICAL", "no protocol selected")

    await dotorcall(protocol, args.response)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
