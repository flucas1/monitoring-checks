#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import asyncio

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def run_speedtest_command(cmdline):
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    if process.returncode != 0:
        raise RuntimeError("Speedtest command failed: " + stderr.decode().strip())
    return stdout.decode().strip()


def parse_speedtest_output(output):
    array = output.split()
    if len(array) != 9:
        raise ValueError("Cannot parse speedtest output")
    ping = float(array[1])
    pingUOM = array[2]
    download = float(array[4])
    downloadUOM = array[5]
    upload = float(array[7])
    uploadUOM = array[8]
    return ping, pingUOM, download, downloadUOM, upload, uploadUOM


def check_thresholds(download, upload, args):
    if download < args.critical_download:
        status = "CRITICAL"
    elif upload < args.critical_upload:
        status = "CRITICAL"
    elif download < args.warning_download:
        status = "WARNING"
    elif upload < args.warning_upload:
        status = "WARNING"
    else:
        status = "OK"

    return status


def build_output(ping, pingUOM, download, downloadUOM, upload, uploadUOM, args):
    nagout = "Ping = " + str(ping) + " " + pingUOM + " Download = " + str(download) + " " + downloadUOM + " Upload = " + str(upload) + " " + uploadUOM

    if args.perfdata:
        max_dl_calc = args.max_download * 1.05
        max_ul_calc = args.max_upload * 1.05
        perfout = " | download=" + str(download) + ";" + str(args.warning_download) + ";" + str(args.critical_download) + ";0;" + str(max_dl_calc) + " upload=" + str(upload) + ";" + str(args.warning_upload) + ";" + str(args.critical_upload) + ";0;" + str(max_ul_calc)
        nagout += perfout

    return nagout


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-w", "--warning-download", type=float, required=True, help="Download Warning Level - *Required*")
    parser.add_argument("-c", "--critical-download", type=float, required=True, help="Download Critical Level - *Required*")
    parser.add_argument("-W", "--warning-upload", type=float, required=True, help="Upload Warning Level - *Required*")
    parser.add_argument("-C", "--critical-upload", type=float, required=True, help="Upload Critical Level - *Required*")
    parser.add_argument("-l", "--location", choices=["i", "e"], required=True, help="Location of speedtest server ('i' or 'e')")
    parser.add_argument("-s", "--server", type=str, default="", help="Server integer or URL for the speedtest server to test against")
    parser.add_argument("-p", "--perfdata", action="store_true", help="Output Performance Data")
    parser.add_argument("-m", "--max-download", type=float, help="Download Maximum Level")
    parser.add_argument("-M", "--max-upload", type=float, help="Upload Maximum Level")
    parser.add_argument("-d", "--debug", dest="debug", action="store_true", help="Output debug info for testing")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.perfdata:
        if args.max_download is None or args.max_upload is None:
            exitnagios("UNKNOWN", "Download and Upload Maximum Levels are required if perfdata is requested.")

    if args.warning_download < args.critical_download:
        exitnagios("UNKNOWN", "$DLw is less than $DLc!")
    elif args.warning_upload < args.critical_upload:
        exitnagios("UNKNOWN", "$ULw is less than $ULc!")

    infomsg("Download Warning Level = " + str(args.warning_download))
    infomsg("Download Critical Level = " + str(args.critical_download))
    infomsg("Upload Warning Level = " + str(args.warning_upload))
    infomsg("Upload Critical Level = " + str(args.critical_upload))
    infomsg("Server Location = " + str(args.location))
    infomsg("Server URL or Integer = " + str(args.server))

    STB = "/usr/bin/speedtest"
    cmdline = [STB, "--simple"]

    if args.location == "e":
        infomsg("External Server defined")
        if args.server:
            cmdline = [STB, "--server=" + str(args.server), "--simple"]
    elif args.location == "i":
        infomsg("Internal Server defined")
        if args.server:
            cmdline = [STB, "--mini=" + str(args.server), "--simple"]
        else:
            exitnagios("UNKNOWN", "Error: URL required for Internal Mini Server")

    try:
        output = await run_speedtest_command(cmdline)
        infomsg(output)
    except Exception as e:
        exitnagios("UNKNOWN", "Speedtest command failed: " + str(e))

    try:
        ping, pingUOM, download, downloadUOM, upload, uploadUOM = parse_speedtest_output(output)
    except ValueError:
        exitnagios("CRITICAL", "Cannot parse speedtest output")

    infomsg("Ping = " + str(ping))
    infomsg("Download = " + str(download))
    infomsg("Upload = " + str(upload))

    status = check_thresholds(download, upload, args)

    nagout = build_output(ping, pingUOM, download, downloadUOM, upload, uploadUOM, args)

    exitnagios(status, nagout)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
