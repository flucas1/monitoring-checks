#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import argparse
import sys
import asyncio

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


# Set up the variable for the location of the speedtest binary
# Edit this path so that it points to speedtest on your system
STB = "/usr/bin/speedtest"


async def run_speedtest_command(cmd):
    process = await asyncio.create_subprocess_exec(
        *cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    if process.returncode != 0:
        raise RuntimeError("Speedtest command failed: " + stderr.decode().strip())
    return stdout.decode().strip()


def parse_speedtest_output(output):
    array = output.split()
    if len(array) != 9:
        raise ValueError("Cannot parse speedtest output")
    ping = float(array[1])
    pingUOM = array[2]
    download = float(array[4])
    downloadUOM = array[5]
    upload = float(array[7])
    uploadUOM = array[8]
    return ping, pingUOM, download, downloadUOM, upload, uploadUOM


def check_thresholds(download, upload, args):
    status = ""
    nagcode = 0

    if download < args.c:
        status = "CRITICAL"
        nagcode = 2
    elif upload < args.C:
        status = "CRITICAL"
        nagcode = 2
    elif download < args.w:
        status = "WARNING"
        nagcode = 1
    elif upload < args.W:
        status = "WARNING"
        nagcode = 1
    else:
        status = "OK"
        nagcode = 0

    return status, nagcode


def build_output(status, ping, pingUOM, download, downloadUOM, upload, uploadUOM, args):
    nagout = status + " - Ping = " + str(ping) + " " + pingUOM + " Download = " + str(download) + " " + downloadUOM + " Upload = " + str(upload) + " " + uploadUOM

    if args.p:
        max_dl_calc = args.m * 1.05
        max_ul_calc = args.M * 1.05
        perfout = "|'download'=" + str(download) + ";" + str(args.w) + ";" + str(args.c) + ";0;" + str(max_dl_calc) + " 'upload'=" + str(upload) + ";" + str(args.W) + ";" + str(args.C) + ";0;" + str(max_ul_calc)
        nagout += perfout

    return nagout


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Nagios speedtest-cli plugin")
    parser.add_argument('-w', type=float, required=True, help="Download Warning Level - *Required*")
    parser.add_argument('-c', type=float, required=True, help="Download Critical Level - *Required*")
    parser.add_argument('-W', type=float, required=True, help="Upload Warning Level - *Required*")
    parser.add_argument('-C', type=float, required=True, help="Upload Critical Level - *Required*")
    parser.add_argument('-l', choices=['i', 'e'], required=True, help="Location of speedtest server ('i' or 'e')")
    parser.add_argument('-s', type=str, default="", help="Server integer or URL for the speedtest server to test against")
    parser.add_argument('-p', action='store_true', help="Output Performance Data")
    parser.add_argument('-m', type=float, help="Download Maximum Level")
    parser.add_argument('-M', type=float, help="Upload Maximum Level")
    parser.add_argument("-d", "--debug", dest='debug', action='store_true', help="Output debug info for testing")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.p:
        if args.m is None or args.M is None:
            print("Usage error: Download and Upload Maximum Levels are required if perfdata is requested.")
            sys.exit(3)

    if args.w < args.c:
        print("$DLw is less than $DLc!")
        sys.exit(3)
    elif args.W < args.C:
        print("$ULw is less than $ULc!")
        sys.exit(3)

    infomsg("Download Warning Level = " + str(args.w))
    infomsg("Download Critical Level = " + str(args.c))
    infomsg("Upload Warning Level = " + str(args.W))
    infomsg("Upload Critical Level = " + str(args.C))
    infomsg("Server Location = " + str(args.l))
    infomsg("Server URL or Integer = " + str(args.s))

    cmd = [STB, "--simple"]

    if args.l == 'e':
        infomsg("External Server defined")
        if args.s:
            cmd = [STB, "--server=" + str(args.s), "--simple"]
    elif args.l == 'i':
        infomsg("Internal Server defined")
        if args.s:
            cmd = [STB, "--mini=" + str(args.s), "--simple"]
        else:
            print("Error: URL required for Internal Mini Server")
            sys.exit(3)

    try:
        output = await run_speedtest_command(cmd)
        infomsg(output)
    except Exception as e:
        if "Cannot parse" in str(e):
            print("ERROR: Cannot parse speedtest output")
            sys.exit(2)
        print("You have not defined the location of the speedtest binary in the script!")
        sys.exit(3)

    try:
        ping, pingUOM, download, downloadUOM, upload, uploadUOM = parse_speedtest_output(output)
    except ValueError:
        print("ERROR: Cannot parse speedtest output")
        sys.exit(2)

    infomsg("Ping = " + str(ping))
    infomsg("Download = " + str(download))
    infomsg("Upload = " + str(upload))

    status, nagcode = check_thresholds(download, upload, args)

    nagout = build_output(status, ping, pingUOM, download, downloadUOM, upload, uploadUOM, args)

    print(nagout)
    sys.exit(nagcode)


if __name__ == "__main__":
    asyncio.run(main())
