#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import subprocess
import argparse
import re
import shutil

# State Variables
STATE_OK = 0
STATE_WARN = 1
STATE_CRIT = 2
STATE_UNK = 3

# Universal SNMP OIDS
OIDS = {
    "hrDeviceDescr": "1.3.6.1.2.1.25.3.2.1.3",
    "hrDeviceIndex": "1.3.6.1.2.1.25.3.2.1.1",
    "hrDeviceStatus": "1.3.6.1.2.1.25.3.2.1.5",
    "hrPrinterStatus": "1.3.6.1.2.1.25.3.5.1.1.1",
    "prtAlertDescription": "1.3.6.1.2.1.43.18.1.1.8",
    "prtConsoleDisplayBufferText": "1.3.6.1.2.1.43.16.5.1.2.1",
    "prtGeneralSerialNumber": "1.3.6.1.2.1.43.5.1.1.17",
    "prtInputCurrentLevel": "1.3.6.1.2.1.43.8.2.1.10.1",
    "prtInputDimUnit": "1.3.6.1.2.1.43.8.2.1.3.1",
    "prtInputMaxCapacity": "1.3.6.1.2.1.43.8.2.1.9.1",
    "prtInputMediaDimFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.4.1",
    "prtInputMediaDimXFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.5.1",
    "prtInputName": "1.3.6.1.2.1.43.8.2.1.13.1",
    "prtMarkerColorantValue": "1.3.6.1.2.1.43.12.1.1.4.1",
    "prtMarkerLifeCount": "1.3.6.1.2.1.43.10.2.1.4.1.1",
    "prtMarkerSuppliesDescription": "1.3.6.1.2.1.43.11.1.1.6.1",
    "prtMarkerSuppliesLevel": "1.3.6.1.2.1.43.11.1.1.9.1",
    "prtMarkerSuppliesMaxCapacity": "1.3.6.1.2.1.43.11.1.1.8.1"
}


def walk_snmp(args, oid, raw=True):
    """Wrapper for snmpwalk command line tool"""
    output_options = "-Oavq" if raw else "-Oa"
    cmd = ["snmpwalk", "-v", args.snmpversion, output_options]

    if args.snmpversion == '3':
        cmd.extend(["-u", args.user, "-l", args.privlevel,
                    "-x", args.privprotocol, "-X", args.privpassword,
                    "-a", args.authprotocol, "-A", args.authpassword])
    else:
        cmd.extend(["-c", args.community])

    cmd.extend([args.host, oid])

    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        text = result.stdout.strip()
        if raw:
            # Remove leading whitespace and quotes like sed/tr in bash
            text = "\n".join([line.lstrip().replace('"', '') for line in text.splitlines()])
        return text
    except subprocess.CalledProcessError as e:
        print(f"snmpwalk command error.\n{e.stderr}")
        sys.exit(STATE_UNK)


def check_model(args):
    """Returns printer model and serial"""
    model = walk_snmp(args, f"{OIDS['hrDeviceDescr']}.1", True)
    serial = walk_snmp(args, OIDS['prtGeneralSerialNumber'], True)
    return STATE_OK, f"{model}, Serial # {serial}", ""


def check_messages(args):
    """Shows messages on the printer display"""
    messages = walk_snmp(args, OIDS['prtAlertDescription'], True)
    if not messages:
        return STATE_UNK, "UNKNOWN: Can't determine messages. Device does not support this OID.", ""
    else:
        return STATE_OK, messages.replace("\n", "!"), ""


def check_pagecount(args):
    """Returns formatted page count"""
    page_count = walk_snmp(args, OIDS['prtMarkerLifeCount'], True)
    perfdata = f"'Pages'={page_count}"
    try:
        formatted_count = f"{int(page_count):,}"  # Replaces bash sed formatter
    except ValueError:
        formatted_count = page_count
    return STATE_OK, f"Pagecount is {formatted_count}.", perfdata


def check_display(args, separator):
    """Report contents of printer display"""
    display = walk_snmp(args, OIDS['prtConsoleDisplayBufferText'], True)
    if display:
        return STATE_OK, display.replace("\n", separator), ""
    else:
        return STATE_UNK, "UNKNOWN - printer does not appear to support using this OID.", ""


def check_printer_status(args):
    """Check overall status of the printer"""
    prt_status = walk_snmp(args, OIDS['hrPrinterStatus'], True)

    if prt_status in ("1", "other", "other(1)"):
        return STATE_CRIT, f"CRITICAL: Printer status = {prt_status}.", ""
    elif prt_status in ("3", "idle", "idle(3)", "4", "printing", "printing(4)", "5", "warmup", "warmup(5)"):
        return STATE_OK, f"OK: Printer status = {prt_status}.", ""
    else:
        return STATE_WARN, f"WARNING: Printer status = {prt_status}.", ""


def _check_one_consumable(args, marker_id, separator, state_string, perfdata):
    """Determines capacity and status code for a single consumable"""
    consum_state = STATE_OK
    marker_name = walk_snmp(args, f"{OIDS['prtMarkerSuppliesDescription']}.{marker_id}", True)
    marker_name = marker_name.replace(".", "")

    marker_color = walk_snmp(args, f"{OIDS['prtMarkerColorantValue']}.{marker_id}", True)
    if marker_color and marker_color.lower() not in marker_name.lower():
        marker_name = f"{marker_color} {marker_name}"

    if not marker_name:
        return STATE_UNK, "UNKNOWN - OID not found! Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored.", ""

    current_cap = walk_snmp(args, f"{OIDS['prtMarkerSuppliesLevel']}.{marker_id}", True)
    max_cap = walk_snmp(args, f"{OIDS['prtMarkerSuppliesMaxCapacity']}.{marker_id}", True)

    try:
        current_cap = int(current_cap)
        max_cap = max(0, int(max_cap))
    except ValueError:
        return STATE_UNK, state_string, perfdata

    if current_cap == -3:  # Some supply remains
        state_string += f"{marker_name} is OK!{separator}"
    elif current_cap == -2:  # Unknown
        state_string = f"{marker_name} is at WARNING level!{separator}{state_string}"
        consum_state = max(consum_state, STATE_WARN)
    elif current_cap == 0:  # Empty
        state_string = f"{marker_name} is at CRITICAL level!{separator}{state_string}"
        consum_state = STATE_CRIT
    elif max_cap > 0:  # Measurable component
        pct = int((current_cap * 100) / max_cap)
        if pct > args.warning:
            state_string += f"{marker_name} is at {pct}% - OK!{separator}"
        elif args.critical < pct <= args.warning:
            state_string = f"{marker_name} is at {pct}% - WARNING!{separator}{state_string}"
            consum_state = max(consum_state, STATE_WARN)
        elif pct <= args.critical:
            state_string = f"{marker_name} is at {pct}% - CRITICAL!{separator}{state_string}"
            consum_state = STATE_CRIT

        perfdata += f" '{marker_name}'={pct};{args.warning};{args.critical}"

    return consum_state, state_string, perfdata


def check_consumables(args, param, separator):
    """Determines which consumables to check"""
    consums_state = STATE_OK
    state_string = ""
    perfdata = ""

    if param.upper() == "TEST":
        all_markers = walk_snmp(args, OIDS['prtMarkerSuppliesDescription'], True)
        return STATE_UNK, f"Consumables you may monitor:\n{all_markers}", ""

    elif param.upper() == "ALL":
        all_markers = walk_snmp(args, OIDS['prtMarkerSuppliesDescription'], True).splitlines()
        for i in range(1, len(all_markers) + 1):
            status, state_string, perfdata = _check_one_consumable(args, str(i), separator, state_string, perfdata)
            consums_state = max(consums_state, status)
    else:
        # Match specific string
        all_markers = walk_snmp(args, OIDS['prtMarkerSuppliesDescription'], False).splitlines()
        matched = [line for line in all_markers if re.search(param, line, re.IGNORECASE)]

        if not matched:
            return STATE_UNK, "UNKNOWN - OID not found! Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored.", ""

        for line in matched:
            # Extract marker ID like awk -F. '{print $8}' | awk -F= '{print $1}'
            match = re.search(r'\.(\d+)\s*=', line)
            if match:
                status, state_string, perfdata = _check_one_consumable(args, match.group(1), separator, state_string, perfdata)
                consums_state = max(consums_state, status)

    return consums_state, state_string, perfdata


def check_exact_consumable(args, param, separator):
    """Loops through all consumables and compares exact string"""
    all_markers = walk_snmp(args, OIDS['prtMarkerSuppliesDescription'], True).replace(".", "").splitlines()
    found_idx = -1

    for i, marker in enumerate(all_markers, start=1):
        if param == marker:
            found_idx = i
            break

    if found_idx != -1:
        return _check_one_consumable(args, str(found_idx), separator, "", "")
    else:
        return STATE_UNK, f"UNKNOWN - No match found for '{param}'! Use the CONSUM TEST option to determine which consumables may be monitored.", ""


def _get_tray_dimensions(args, tray_id):
    """Helper to calculate tray dimension strings"""
    feed = int(walk_snmp(args, f"{OIDS['prtInputMediaDimFeedDirDeclared']}.{tray_id}", True) or -1)
    xfeed = int(walk_snmp(args, f"{OIDS['prtInputMediaDimXFeedDirDeclared']}.{tray_id}", True) or -1)
    units = walk_snmp(args, f"{OIDS['prtInputDimUnit']}.{tray_id}", True)

    if feed < 0 and xfeed < 0:
        return "paper."

    if units == "3":  # ten thousandths of an inch to inches
        feed = round(feed / 10000.0, 1)
        xfeed = round(xfeed / 10000.0, 1)
    elif units == "4":  # micrometers to inches
        feed = round((feed * 0.0000393700787) + 0.5, 1)
        xfeed = round((xfeed * 0.0000393700787) + 0.5, 1)

    return f"{xfeed} x {feed} paper."


def _check_one_tray(args, tray_id, separator, state_string, perfdata):
    """Checks the tray #, returns status and capacity"""
    tray_state = STATE_OK
    tray_cap_str = walk_snmp(args, f"{OIDS['prtInputCurrentLevel']}.{tray_id}", True)

    if not tray_cap_str:
        state_string += f" UNKNOWN - Tray {tray_id} not found. Use the TRAY TEST option to determine which trays may be monitored."
        return STATE_UNK, state_string, perfdata

    tray_name = walk_snmp(args, f"{OIDS['prtInputName']}.{tray_id}", True)
    if not tray_name:
        tray_name = f"Tray {tray_id}"

    try:
        tray_cap = int(tray_cap_str)
    except ValueError:
        return STATE_UNK, state_string, perfdata

    if tray_cap == -3:
        state_string += f"{tray_name} is OK!{separator}"
    elif tray_cap == -2:
        state_string += f"{tray_name} status is UNKNOWN!{separator}"
        tray_state = STATE_UNK
    elif tray_cap == 0:
        dim_str = _get_tray_dimensions(args, tray_id)
        state_string += f"{tray_name} is at CRITICAL level - please refill with more {dim_str}{separator}"
        tray_state = STATE_CRIT
    else:
        tray_max = int(walk_snmp(args, f"{OIDS['prtInputMaxCapacity']}.{tray_id}", True) or 1)
        pct = int((tray_cap * 100) / tray_max)

        if pct > args.critical and pct > args.warning:
            state_string += f"{tray_name} is at {pct}% - OK!{separator}"
        elif pct <= args.warning:
            dim_str = _get_tray_dimensions(args, tray_id)
            if pct <= args.critical:
                state_string += f"{tray_name} is at {pct}% - CRITICAL! Please refill with more {dim_str}{separator}"
                tray_state = STATE_CRIT
            else:
                state_string += f"{tray_name} is at {pct}% - WARNING! Please refill with more {dim_str}{separator}"
                tray_state = max(tray_state, STATE_WARN)

        perfdata += f" '{tray_name}'={pct};{args.warning};{args.critical}"

    return tray_state, state_string, perfdata


def check_paper_trays(args, param, separator, arg_token):
    """Determines which trays to check"""
    trays_state = STATE_OK
    state_string = ""
    perfdata = ""

    all_trays_raw = walk_snmp(args, OIDS['prtInputName'], True).splitlines()

    # equivalent to awk -F" " '{print $2}'
    all_trays = []
    for t in all_trays_raw:
        parts = t.split(maxsplit=1)
        if len(parts) > 1:
            all_trays.append(parts[1])
        else:
            all_trays.append(t)

    if param.upper() == "TEST":
        return STATE_UNK, f"Trays you may monitor:\n" + "\n".join(all_trays), ""
    elif param.upper() == "ALL":
        for i in range(1, len(all_trays_raw) + 1):
            status, state_string, perfdata = _check_one_tray(args, str(i), separator, state_string, perfdata)
            trays_state = max(trays_state, status)
    else:
        for tray_id in param.split(arg_token):
            status, state_string, perfdata = _check_one_tray(args, tray_id.strip(), separator, state_string, perfdata)
            trays_state = max(trays_state, status)

    return trays_state, state_string, perfdata


def main():
    if not shutil.which("snmpwalk"):
        print(f"UNKNOWN: No usable 'snmpwalk' binary in PATH")
        sys.exit(STATE_UNK)

    parser = argparse.ArgumentParser(description="Nagios plugin to check the status of networked printers.")
    parser.add_argument("-H", "--host", default="localhost", help="Host name or IP address")
    parser.add_argument("-v", "--snmpversion", choices=["1", "2c", "3"], default="2c", help="SNMP version")
    parser.add_argument("-C", "--community", default="public", help="SNMP v2 community")
    parser.add_argument("-u", "--user", default="", help="SNMP v3 username")
    parser.add_argument("-l", "--privlevel", choices=["noAuthNoPriv", "authNoPriv", "authPriv"], default="noAuthNoPriv")
    parser.add_argument("-x", "--privprotocol", choices=["DES", "AES"], default="DES")
    parser.add_argument("-X", "--privpassword", default="")
    parser.add_argument("-a", "--authprotocol", choices=["MD5", "SHA"], default="MD5")
    parser.add_argument("-A", "--authpassword", default="")
    parser.add_argument("-t", "--timeout", default="10:UNKNOWN")
    parser.add_argument("-T", "--type", required=True, nargs="+", help="Check type and parameter")
    parser.add_argument("-w", "--warning", type=int, default=20, help="WARNING threshold percent")
    parser.add_argument("-c", "--critical", type=int, default=5, help="CRITICAL threshold percent")
    parser.add_argument("-S", "--separator", default=",", help="Separator string")

    args = parser.parse_args()

    check_type = args.type[0].upper()
    parameter = " ".join(args.type[1:]) if len(args.type) > 1 else ""

    separator = args.separator.replace("\\n", "\n") if args.separator else ","
    arg_token = ","

    state = STATE_UNK
    state_string = "UNKNOWN: No valid check type specified"
    perfdata = ""

    if check_type == "MODEL":
        state, state_string, perfdata = check_model(args)
    elif check_type == "MESSAGES":
        state, state_string, perfdata = check_messages(args)
    elif check_type in ("PAGES", "COUNT", "PAGECOUNT"):
        state, state_string, perfdata = check_pagecount(args)
    elif check_type == "DISPLAY":
        state, state_string, perfdata = check_display(args, separator)
    elif check_type == "STATUS":
        state, state_string, perfdata = check_printer_status(args)
    elif check_type == "CONSUM":
        state, state_string, perfdata = check_consumables(args, parameter, separator)
    elif check_type == "CONSUMX":
        state, state_string, perfdata = check_exact_consumable(args, parameter, separator)
    elif check_type in ("TRAY", "TRAYS"):
        state, state_string, perfdata = check_paper_trays(args, parameter, separator, arg_token)

    if not perfdata:
        print(state_string)
    else:
        print(f"{state_string}|{perfdata}")

    sys.exit(state)


if __name__ == "__main__":
    main()
