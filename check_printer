#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import subprocess
import argparse
import re
import shutil

# State Variables
STATE_OK = 0
STATE_WARN = 1
STATE_CRIT = 2
STATE_UNK = 3

# Universal SNMP OIDS
OIDS = {
    "hrDeviceDescr": "1.3.6.1.2.1.25.3.2.1.3",
    "hrDeviceIndex": "1.3.6.1.2.1.25.3.2.1.1",
    "hrDeviceStatus": "1.3.6.1.2.1.25.3.2.1.5",
    "hrPrinterStatus": "1.3.6.1.2.1.25.3.5.1.1.1",
    "prtAlertDescription": "1.3.6.1.2.1.43.18.1.1.8",
    "prtConsoleDisplayBufferText": "1.3.6.1.2.1.43.16.5.1.2.1",
    "prtGeneralSerialNumber": "1.3.6.1.2.1.43.5.1.1.17",
    "prtInputCurrentLevel": "1.3.6.1.2.1.43.8.2.1.10.1",
    "prtInputDimUnit": "1.3.6.1.2.1.43.8.2.1.3.1",
    "prtInputMaxCapacity": "1.3.6.1.2.1.43.8.2.1.9.1",
    "prtInputMediaDimFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.4.1",
    "prtInputMediaDimXFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.5.1",
    "prtInputName": "1.3.6.1.2.1.43.8.2.1.13.1",
    "prtMarkerColorantValue": "1.3.6.1.2.1.43.12.1.1.4.1",
    "prtMarkerLifeCount": "1.3.6.1.2.1.43.10.2.1.4.1.1",
    "prtMarkerSuppliesDescription": "1.3.6.1.2.1.43.11.1.1.6.1",
    "prtMarkerSuppliesLevel": "1.3.6.1.2.1.43.11.1.1.9.1",
    "prtMarkerSuppliesMaxCapacity": "1.3.6.1.2.1.43.11.1.1.8.1"
}


class SNMPPrinterCheck:
    def __init__(self, args):
        self.args = args
        self.state = STATE_OK
        self.state_string = ""
        self.perfdata = ""
        self.separator = args.separator.replace("\\n", "\n") if args.separator else ","
        self.arg_token = ","  #

    def walk_snmp(self, oid, raw=True):
        """Wrapper for snmpwalk command line tool"""
        output_options = "-Oavq" if raw else "-Oa"
        cmd = ["snmpwalk", "-v", self.args.snmpversion, output_options]

        if self.args.snmpversion == '3':
            cmd.extend(["-u", self.args.user, "-l", self.args.privlevel,
                        "-x", self.args.privprotocol, "-X", self.args.privpassword,
                        "-a", self.args.authprotocol, "-A", self.args.authpassword])
        else:
            cmd.extend(["-c", self.args.community])

        cmd.extend([self.args.host, oid])

        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
            text = result.stdout.strip()
            if raw:
                # Remove leading whitespace and quotes like sed/tr in bash
                text = "\n".join([line.lstrip().replace('"', '') for line in text.splitlines()])
            return text
        except subprocess.CalledProcessError as e:
            print(f"snmpwalk command error.\n{e.stderr}")
            sys.exit(STATE_UNK)

    def check_model(self):
        """Returns printer model and serial"""
        model = self.walk_snmp(f"{OIDS['hrDeviceDescr']}.1", True)
        serial = self.walk_snmp(OIDS['prtGeneralSerialNumber'], True)
        self.state_string = f"{model}, Serial # {serial}"
        return STATE_OK

    def check_messages(self):
        """Shows messages on the printer display"""
        messages = self.walk_snmp(OIDS['prtAlertDescription'], True)
        if not messages:
            self.state_string = "UNKNOWN: Can't determine messages. Device does not support this OID."
            return STATE_UNK
        else:
            self.state_string = messages.replace("\n", "!")
            return STATE_OK

    def check_pagecount(self):
        """Returns formatted page count"""
        page_count = self.walk_snmp(OIDS['prtMarkerLifeCount'], True)
        self.perfdata = f"'Pages'={page_count}"
        try:
            formatted_count = f"{int(page_count):,}"  # Replaces bash sed formatter
        except ValueError:
            formatted_count = page_count
        self.state_string = f"Pagecount is {formatted_count}."
        return STATE_OK

    def check_display(self):
        """Report contents of printer display"""
        display = self.walk_snmp(OIDS['prtConsoleDisplayBufferText'], True)
        if display:
            self.state_string = display.replace("\n", self.separator)
            return STATE_OK
        else:
            self.state_string = "UNKNOWN - printer does not appear to support using this OID."
            return STATE_UNK

    def check_printer_status(self):
        """Check overall status of the printer"""
        status_state = STATE_OK
        prt_status = self.walk_snmp(OIDS['hrPrinterStatus'], True)

        if prt_status in ("1", "other", "other(1)"):
            self.state_string = f"CRITICAL: Printer status = {prt_status}."
            status_state = STATE_CRIT
        elif prt_status in ("3", "idle", "idle(3)", "4", "printing", "printing(4)", "5", "warmup", "warmup(5)"):
            self.state_string = f"OK: Printer status = {prt_status}."
        else:
            self.state_string = f"WARNING: Printer status = {prt_status}."
            status_state = STATE_WARN
        return status_state

    def check_consumables(self, param):
        """Determines which consumables to check"""
        consums_state = STATE_OK

        if param.upper() == "TEST":
            all_markers = self.walk_snmp(OIDS['prtMarkerSuppliesDescription'], True)
            self.state_string = f"Consumables you may monitor:\n{all_markers}"
            return STATE_UNK

        elif param.upper() == "ALL":
            all_markers = self.walk_snmp(OIDS['prtMarkerSuppliesDescription'], True).splitlines()
            for i in range(1, len(all_markers) + 1):
                status = self._check_one_consumable(str(i))
                consums_state = max(consums_state, status)
        else:
            # Match specific string
            all_markers = self.walk_snmp(OIDS['prtMarkerSuppliesDescription'], False).splitlines()
            matched = [line for line in all_markers if re.search(param, line, re.IGNORECASE)]

            if not matched:
                self.state_string = "UNKNOWN - OID not found! Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored."
                self.perfdata = ""
                return STATE_UNK

            for line in matched:
                # Extract marker ID like awk -F. '{print $8}' | awk -F= '{print $1}'
                match = re.search(r'\.(\d+)\s*=', line)
                if match:
                    status = self._check_one_consumable(match.group(1))
                    consums_state = max(consums_state, status)

        return consums_state

    def _check_one_consumable(self, marker_id):
        """Determines capacity and status code for a single consumable"""
        consum_state = STATE_OK
        marker_name = self.walk_snmp(f"{OIDS['prtMarkerSuppliesDescription']}.{marker_id}", True)
        marker_name = marker_name.replace(".", "")

        marker_color = self.walk_snmp(f"{OIDS['prtMarkerColorantValue']}.{marker_id}", True)
        if marker_color and marker_color.lower() not in marker_name.lower():
            marker_name = f"{marker_color} {marker_name}"

        if not marker_name:
            self.state_string = "UNKNOWN - OID not found! Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored."
            self.perfdata = ""
            return STATE_UNK

        current_cap = self.walk_snmp(f"{OIDS['prtMarkerSuppliesLevel']}.{marker_id}", True)
        max_cap = self.walk_snmp(f"{OIDS['prtMarkerSuppliesMaxCapacity']}.{marker_id}", True)

        try:
            current_cap = int(current_cap)
            max_cap = max(0, int(max_cap))
        except ValueError:
            return STATE_UNK

        if current_cap == -3:  # Some supply remains
            self.state_string += f"{marker_name} is OK!{self.separator}"
        elif current_cap == -2:  # Unknown
            self.state_string = f"{marker_name} is at WARNING level!{self.separator}{self.state_string}"
            consum_state = max(consum_state, STATE_WARN)
        elif current_cap == 0:  # Empty
            self.state_string = f"{marker_name} is at CRITICAL level!{self.separator}{self.state_string}"
            consum_state = STATE_CRIT
        elif max_cap > 0:  # Measurable component
            pct = int((current_cap * 100) / max_cap)
            if pct > self.args.warning:
                self.state_string += f"{marker_name} is at {pct}% - OK!{self.separator}"
            elif self.args.critical < pct <= self.args.warning:
                self.state_string = f"{marker_name} is at {pct}% - WARNING!{self.separator}{self.state_string}"
                consum_state = max(consum_state, STATE_WARN)
            elif pct <= self.args.critical:
                self.state_string = f"{marker_name} is at {pct}% - CRITICAL!{self.separator}{self.state_string}"
                consum_state = STATE_CRIT

            self.perfdata += f" '{marker_name}'={pct};{self.args.warning};{self.args.critical}"

        return consum_state

    def check_exact_consumable(self, param):
        """Loops through all consumables and compares exact string"""
        all_markers = self.walk_snmp(OIDS['prtMarkerSuppliesDescription'], True).replace(".", "").splitlines()
        found_idx = -1

        for i, marker in enumerate(all_markers, start=1):
            if param == marker:
                found_idx = i
                break

        if found_idx != -1:
            return self._check_one_consumable(str(found_idx))
        else:
            self.state_string = f"UNKNOWN - No match found for '{param}'! Use the CONSUM TEST option to determine which consumables may be monitored."
            return STATE_UNK

    def check_paper_trays(self, param):
        """Determines which trays to check"""
        trays_state = STATE_OK
        all_trays_raw = self.walk_snmp(OIDS['prtInputName'], True).splitlines()

        # equivalent to awk -F" " '{print $2}'
        all_trays = []
        for t in all_trays_raw:
            parts = t.split(maxsplit=1)
            if len(parts) > 1:
                all_trays.append(parts[1])
            else:
                all_trays.append(t)

        if param.upper() == "TEST":
            self.state_string = f"Trays you may monitor:\n" + "\n".join(all_trays)
            return STATE_UNK
        elif param.upper() == "ALL":
            for i in range(1, len(all_trays_raw) + 1):
                status = self._check_one_tray(str(i))
                trays_state = max(trays_state, status)
        else:
            for tray_id in param.split(self.arg_token):
                status = self._check_one_tray(tray_id.strip())
                trays_state = max(trays_state, status)

        return trays_state

    def _check_one_tray(self, tray_id):
        """Checks the tray #, returns status and capacity"""
        tray_state = STATE_OK
        tray_cap_str = self.walk_snmp(f"{OIDS['prtInputCurrentLevel']}.{tray_id}", True)

        if not tray_cap_str:
            self.state_string += f" UNKNOWN - Tray {tray_id} not found. Use the TRAY TEST option to determine which trays may be monitored."
            return STATE_UNK

        tray_name = self.walk_snmp(f"{OIDS['prtInputName']}.{tray_id}", True)
        if not tray_name:
            tray_name = f"Tray {tray_id}"

        try:
            tray_cap = int(tray_cap_str)
        except ValueError:
            return STATE_UNK

        if tray_cap == -3:
            self.state_string += f"{tray_name} is OK!{self.separator}"
        elif tray_cap == -2:
            self.state_string += f"{tray_name} status is UNKNOWN!{self.separator}"
            tray_state = STATE_UNK
        elif tray_cap == 0:
            dim_str = self._get_tray_dimensions(tray_id)
            self.state_string += f"{tray_name} is at CRITICAL level - please refill with more {dim_str}{self.separator}"
            tray_state = STATE_CRIT
        else:
            tray_max = int(self.walk_snmp(f"{OIDS['prtInputMaxCapacity']}.{tray_id}", True) or 1)
            pct = int((tray_cap * 100) / tray_max)

            if pct > self.args.critical and pct > self.args.warning:
                self.state_string += f"{tray_name} is at {pct}% - OK!{self.separator}"
            elif pct <= self.args.warning:
                dim_str = self._get_tray_dimensions(tray_id)
                if pct <= self.args.critical:
                    self.state_string += f"{tray_name} is at {pct}% - CRITICAL! Please refill with more {dim_str}{self.separator}"
                    tray_state = STATE_CRIT
                else:
                    self.state_string += f"{tray_name} is at {pct}% - WARNING! Please refill with more {dim_str}{self.separator}"
                    tray_state = max(tray_state, STATE_WARN)

            self.perfdata += f" '{tray_name}'={pct};{self.args.warning};{self.args.critical}"

        return tray_state

    def _get_tray_dimensions(self, tray_id):
        """Helper to calculate tray dimension strings"""
        feed = int(self.walk_snmp(f"{OIDS['prtInputMediaDimFeedDirDeclared']}.{tray_id}", True) or -1)
        xfeed = int(self.walk_snmp(f"{OIDS['prtInputMediaDimXFeedDirDeclared']}.{tray_id}", True) or -1)
        units = self.walk_snmp(f"{OIDS['prtInputDimUnit']}.{tray_id}", True)

        if feed < 0 and xfeed < 0:
            return "paper."

        if units == "3":  # ten thousandths of an inch to inches
            feed = round(feed / 10000.0, 1)
            xfeed = round(xfeed / 10000.0, 1)
        elif units == "4":  # micrometers to inches
            feed = round((feed * 0.0000393700787) + 0.5, 1)
            xfeed = round((xfeed * 0.0000393700787) + 0.5, 1)

        return f"{xfeed} x {feed} paper."


def main():
    if not shutil.which("snmpwalk"):
        print(f"UNKNOWN: No usable 'snmpwalk' binary in PATH")
        sys.exit(STATE_UNK)

    parser = argparse.ArgumentParser(description="Nagios plugin to check the status of networked printers.")
    parser.add_argument("-H", "--host", default="localhost", help="Host name or IP address")
    parser.add_argument("-v", "--snmpversion", choices=["1", "2c", "3"], default="2c", help="SNMP version")
    parser.add_argument("-C", "--community", default="public", help="SNMP v2 community")
    parser.add_argument("-u", "--user", default="", help="SNMP v3 username")
    parser.add_argument("-l", "--privlevel", choices=["noAuthNoPriv", "authNoPriv", "authPriv"], default="noAuthNoPriv")
    parser.add_argument("-x", "--privprotocol", choices=["DES", "AES"], default="DES")
    parser.add_argument("-X", "--privpassword", default="")
    parser.add_argument("-a", "--authprotocol", choices=["MD5", "SHA"], default="MD5")
    parser.add_argument("-A", "--authpassword", default="")
    parser.add_argument("-t", "--timeout", default="10:UNKNOWN")
    parser.add_argument("-T", "--type", required=True, nargs="+", help="Check type and parameter")
    parser.add_argument("-w", "--warning", type=int, default=20, help="WARNING threshold percent")
    parser.add_argument("-c", "--critical", type=int, default=5, help="CRITICAL threshold percent")
    parser.add_argument("-S", "--separator", default=",", help="Separator string")

    args = parser.parse_args()

    check_type = args.type[0].upper()
    parameter = " ".join(args.type[1:]) if len(args.type) > 1 else ""

    checker = SNMPPrinterCheck(args)

    if check_type == "MODEL":
        checker.state = checker.check_model()
    elif check_type == "MESSAGES":
        checker.state = checker.check_messages()
    elif check_type in ("PAGES", "COUNT", "PAGECOUNT"):
        checker.state = checker.check_pagecount()
    elif check_type == "DISPLAY":
        checker.state = checker.check_display()
    elif check_type == "STATUS":
        checker.state = checker.check_printer_status()
    elif check_type == "CONSUM":
        checker.state = checker.check_consumables(parameter)
    elif check_type == "CONSUMX":
        checker.state = checker.check_exact_consumable(parameter)
    elif check_type in ("TRAY", "TRAYS"):
        checker.state = checker.check_paper_trays(parameter)
    else:
        checker.state_string = "UNKNOWN: No valid check type specified"
        checker.state = STATE_UNK

    if not checker.perfdata:
        print(checker.state_string)
    else:
        print(f"{checker.state_string}|{checker.perfdata}")

    sys.exit(checker.state)


if __name__ == "__main__":
    main()
