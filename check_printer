#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import re
import asyncio


# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


STATE_OK = 0
STATE_WARN = 1
STATE_CRIT = 2
STATE_UNK = 3

# Universal SNMP OIDS
OIDS = {
    "hrDeviceDescr": "1.3.6.1.2.1.25.3.2.1.3",
    "hrDeviceIndex": "1.3.6.1.2.1.25.3.2.1.1",
    "hrDeviceStatus": "1.3.6.1.2.1.25.3.2.1.5",
    "hrPrinterStatus": "1.3.6.1.2.1.25.3.5.1.1.1",
    "prtAlertDescription": "1.3.6.1.2.1.43.18.1.1.8",
    "prtConsoleDisplayBufferText": "1.3.6.1.2.1.43.16.5.1.2.1",
    "prtGeneralSerialNumber": "1.3.6.1.2.1.43.5.1.1.17",
    "prtInputCurrentLevel": "1.3.6.1.2.1.43.8.2.1.10.1",
    "prtInputDimUnit": "1.3.6.1.2.1.43.8.2.1.3.1",
    "prtInputMaxCapacity": "1.3.6.1.2.1.43.8.2.1.9.1",
    "prtInputMediaDimFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.4.1",
    "prtInputMediaDimXFeedDirDeclared": "1.3.6.1.2.1.43.8.2.1.5.1",
    "prtInputName": "1.3.6.1.2.1.43.8.2.1.13.1",
    "prtMarkerColorantValue": "1.3.6.1.2.1.43.12.1.1.4.1",
    "prtMarkerLifeCount": "1.3.6.1.2.1.43.10.2.1.4.1.1",
    "prtMarkerSuppliesDescription": "1.3.6.1.2.1.43.11.1.1.6.1",
    "prtMarkerSuppliesLevel": "1.3.6.1.2.1.43.11.1.1.9.1",
    "prtMarkerSuppliesMaxCapacity": "1.3.6.1.2.1.43.11.1.1.8.1",
    "brInfoMaintenance": "1.3.6.1.4.1.2435.2.3.9.4.2.1.5.5.8.0"
}


async def walk_snmp(args, oid, raw=True):
    output_options = "-Oavq" if raw else "-Oa"
    cmdline = ["/usr/bin/snmpwalk", "-v", args.snmpversion, output_options]
    if args.snmpversion == "3":
        cmdline.extend(["-u", args.user, "-l", args.privlevel, "-x", args.privprotocol, "-X", args.privpassword, "-a", args.authprotocol, "-A", args.authpassword])
    else:
        cmdline.extend(["-c", args.community])
    cmdline.extend([args.host, oid])

    try:
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            exitnagios("UNKNOWN", "snmpwalk command error.\n" + stderr.decode().strip())

        text = stdout.decode().strip()
        if raw:
            # Remove leading whitespace and quotes like sed/tr in bash
            text = "\n".join([line.lstrip().replace('"', "") for line in text.splitlines()])
        return text
    except Exception as e:
        exitnagios("UNKNOWN", "snmpwalk command error.\n" + str(e))


async def check_model(args):
    """Returns printer model and serial"""
    model = await walk_snmp(args, OIDS["hrDeviceDescr"] + ".1", True)
    serial = await walk_snmp(args, OIDS["prtGeneralSerialNumber"], True)
    return STATE_OK, model + ", Serial # " + serial, ""


async def check_messages(args):
    """Shows messages on the printer display"""
    messages = await walk_snmp(args, OIDS["prtAlertDescription"], True)
    if not messages:
        return STATE_UNK, "Can't determine messages. Device does not support this OID.", ""
    else:
        return STATE_OK, messages.replace("\n", " - "), ""


async def check_pagecount(args):
    """Returns formatted page count"""
    page_count = await walk_snmp(args, OIDS["prtMarkerLifeCount"], True)
    perfdata = "'Pages'=" + page_count
    try:
        formatted_count = str(int(page_count))
    except ValueError:
        formatted_count = page_count
    return STATE_OK, "Pagecount is " + formatted_count + ".", perfdata


async def check_display(args):
    """Report contents of printer display"""
    display = await walk_snmp(args, OIDS["prtConsoleDisplayBufferText"], True)
    if display:
        return STATE_OK, display.replace("\n", " - "), ""
    else:
        return STATE_UNK, "printer does not appear to support using this OID.", ""


async def check_printer_status(args):
    """Check overall status of the printer"""
    prt_status = await walk_snmp(args, OIDS["hrPrinterStatus"], True)

    if prt_status in ("1", "other", "other(1)"):
        return STATE_CRIT, "Printer status = " + prt_status + ".", ""
    elif prt_status in ("3", "idle", "idle(3)", "4", "printing", "printing(4)", "5", "warmup", "warmup(5)"):
        return STATE_OK, "Printer status = " + prt_status + ".", ""
    else:
        return STATE_WARN, "Printer status = " + prt_status + ".", ""


async def _check_one_consumable(args, marker_id, state_string, perfdata):
    """Determines capacity and status code for a single consumable"""
    consum_state = STATE_OK
    marker_name = await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"] + "." + marker_id, True)

    marker_color = await walk_snmp(args, OIDS["prtMarkerColorantValue"] + "." + marker_id, True)
    if marker_color and marker_color.lower() not in marker_name.lower() and marker_color != "No Such Instance currently exists at this OID":
        marker_name = marker_color + " " + marker_name

    if not marker_name:
        return STATE_UNK, "OID not found. Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored.", ""

    current_cap = await walk_snmp(args, OIDS["prtMarkerSuppliesLevel"] + "." + marker_id, True)
    max_cap = await walk_snmp(args, OIDS["prtMarkerSuppliesMaxCapacity"] + "." + marker_id, True)

    try:
        current_cap = int(current_cap)
        max_cap = max(0, int(max_cap))
    except ValueError:
        return STATE_UNK, state_string, perfdata

    if current_cap == -3:  # Some supply remains
        # Fallback to Brother's proprietary SNMP OID to extract precise percentages
        brother_hex = await walk_snmp(args, OIDS.get("brInfoMaintenance", "1.3.6.1.4.1.2435.2.3.9.4.2.1.5.5.8.0"), True)
        pct = None

        if brother_hex and "No Such Object" not in brother_hex:
            # Brother Hex identifiers: 81=Black, 82=Cyan, 83=Magenta, 84=Yellow
            color_map = {"black": "81", "cyan": "82", "magenta": "83", "yellow": "84"}
            color_id = next((cid for c, cid in color_map.items() if c in marker_name.lower()), None)

            if color_id:
                clean_hex = brother_hex.replace("\n", " ").replace("Hex-STRING:", "")
                match = re.search(color_id + r"\s+01\s+04\s+00\s+00\s+[0-9A-Fa-f]{2}\s+([0-9A-Fa-f]{2})", clean_hex)
                if match:
                    pct = int(match.group(1), 16)  # Convert the final hex byte to a decimal integer

        if pct is not None:
            if pct > args.warning:
                state_string += "OK: " + marker_name + " is at " + str(pct) + "% - "
            elif args.critical < pct <= args.warning:
                state_string = "WARNING: " + marker_name + " is at " + str(pct) + "% - " + state_string
                consum_state = max(consum_state, STATE_WARN)
            elif pct <= args.critical:
                state_string = "CRITICAL: " + marker_name + " is at " + str(pct) + "% - " + state_string
                consum_state = STATE_CRIT

            perfdata += " '" + marker_name + "'=" + str(pct) + ";" + str(args.warning) + ";" + str(args.critical)
        else:
            state_string += "OK: " + marker_name + " valid - "

    elif current_cap == -2:  # Unknown
        state_string = "WARNING: " + marker_name + " is at level - " + state_string
        consum_state = max(consum_state, STATE_WARN)
    elif current_cap == 0:  # Empty
        state_string = "CRITICAL: " + marker_name + " is at level - " + state_string
        consum_state = STATE_CRIT
    elif max_cap > 0:  # Measurable component
        pct = int((current_cap * 100) / max_cap)

        # Invert the percentage for Drum Units since they often report "used capacity" instead of "remaining"
        if "drum" in marker_name.lower():
            pct = 100 - pct

        if pct > args.warning:
            state_string += "OK: " + marker_name + " is at " + str(pct) + "% - "
        elif args.critical < pct <= args.warning:
            state_string = "WARNING: " + marker_name + " is at " + str(pct) + "% - " + state_string
            consum_state = max(consum_state, STATE_WARN)
        elif pct <= args.critical:
            state_string = "CRITICAL: " + marker_name + " is at " + str(pct) + "% - " + state_string
            consum_state = STATE_CRIT

        perfdata += " '" + marker_name + "'=" + str(pct) + ";" + str(args.warning) + ";" + str(args.critical)

    return consum_state, state_string, perfdata


async def check_consumables(args, param):
    """Determines which consumables to check"""
    consums_state = STATE_OK
    state_string = ""
    perfdata = ""

    if param.upper() == "TEST":
        all_markers = await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"], True)
        return STATE_UNK, "Consumables you may monitor:\n" + all_markers, ""
    elif param.upper() == "ALL":
        all_markers = (await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"], True)).splitlines()
        tasks = []
        for i in range(1, len(all_markers) + 1):
            tasks.append(_check_one_consumable(args, str(i), state_string, perfdata))

        results = await asyncio.gather(*tasks, return_exceptions=True)
        for status, s_string, p_data in results:
            state_string += s_string
            perfdata += p_data
            consums_state = max(consums_state, status)
    else:
        # Match specific string
        all_markers = (await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"], False)).splitlines()
        matched = [line for line in all_markers if re.search(param, line, re.IGNORECASE)]

        if not matched:
            return STATE_UNK, "OID not found - Your printer may not support checking this consumable. Use the CONSUM TEST option to determine which consumables may be monitored.", ""

        tasks = []
        for line in matched:
            match = re.search(r"\.(\d+)\s*=", line)
            if match:
                tasks.append(_check_one_consumable(args, match.group(1), state_string, perfdata))

        results = await asyncio.gather(*tasks, return_exceptions=True)
        for status, s_string, p_data in results:
            state_string += s_string
            perfdata += p_data
            consums_state = max(consums_state, status)

    return consums_state, state_string, perfdata


async def check_exact_consumable(args, param):
    """Loops through all consumables and compares exact string"""
    all_markers = (await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"], True)).replace(".", "").splitlines()
    found_idx = -1

    for i, marker in enumerate(all_markers, start=1):
        if param == marker:
            found_idx = i
            break

    if found_idx != -1:
        return await _check_one_consumable(args, str(found_idx), "", "")
    else:
        return STATE_UNK, "No match found for '" + param + "' - Use the CONSUM TEST option to determine which consumables may be monitored.", ""


async def check_toner_levels(args):
    """Dedicated check specifically for Toner Cartridges (ignores drums and waste boxes)"""
    toner_state = STATE_OK
    state_string = ""
    perfdata = ""

    # Fetch all supply descriptions
    temp_markers = await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"], False)
    all_markers = temp_markers.splitlines()

    # Filter for toners, specifically excluding "waste" to avoid the Waste Toner Box
    matched = []
    for line in all_markers:
        if re.search(r"toner", line, re.IGNORECASE) and not re.search(r"waste", line, re.IGNORECASE):
            matched.append(line)

    if not matched:
        return STATE_UNK, "No toner cartridges found on this device.", ""

    tasks = []
    for line in matched:
        # Extract marker ID
        match = re.search(r"\.(\d+)\s*=", line)
        if not match:
            continue

        marker_id = match.group(1)

        # Build the accurate marker name and color
        marker_name = await walk_snmp(args, OIDS["prtMarkerSuppliesDescription"] + "." + marker_id, True)
        marker_color = await walk_snmp(args, OIDS["prtMarkerColorantValue"] + "." + marker_id, True)

        if marker_color and marker_color.lower() not in marker_name.lower() and "No Such" not in marker_color:
            marker_name = marker_color + " " + marker_name

        # Fetch capacities
        current_cap_str = await walk_snmp(args, OIDS["prtMarkerSuppliesLevel"] + "." + marker_id, True)
        max_cap_str = await walk_snmp(args, OIDS["prtMarkerSuppliesMaxCapacity"] + "." + marker_id, True)

        try:
            current_cap = int(current_cap_str)
            max_cap = max(0, int(max_cap_str))
        except ValueError:
            continue

        pct = None

        # Apply specific states and calculations
        if current_cap == -3:
            # Fallback to Brother's proprietary SNMP OID for exact percentages
            brother_hex = await walk_snmp(args, OIDS.get("brInfoMaintenance", "1.3.6.1.4.1.2435.2.3.9.4.2.1.5.5.8.0"), True)
            if brother_hex and "No Such Object" not in brother_hex:
                color_map = {"black": "81", "cyan": "82", "magenta": "83", "yellow": "84"}
                color_id = next((cid for c, cid in color_map.items() if c in marker_name.lower()), None)

                if color_id:
                    clean_hex = brother_hex.replace("\n", " ").replace("Hex-STRING:", "")
                    hex_match = re.search(color_id + r"\s+01\s+04\s+00\s+00\s+[0-9A-Fa-f]{2}\s+([0-9A-Fa-f]{2})", clean_hex)
                    if hex_match:
                        pct = int(hex_match.group(1), 16)

        elif current_cap == -2:
            state_string += "WARNING: " + marker_name + " is UNKNOWN - "
            toner_state = max(toner_state, STATE_WARN)
            continue

        elif current_cap == 0:
            pct = 0

        elif max_cap > 0:
            # Standard calculation for standard OID responses
            pct = int((current_cap * 100) / max_cap)

        # Apply Nagios thresholds and build the output string
        if pct is not None:
            if pct > args.warning:
                state_string += "OK: " + marker_name + " is at " + str(pct) + "% - "
            elif args.critical < pct <= args.warning:
                state_string = "WARNING: " + marker_name + " is at " + str(pct) + "% - " + state_string
                toner_state = max(toner_state, STATE_WARN)
            elif pct <= args.critical:
                state_string = "CRITICAL: " + marker_name + " is at " + str(pct) + "% - " + state_string
                toner_state = STATE_CRIT

            perfdata += " '" + marker_name + "'=" + str(pct) + ";" + str(args.warning) + ";" + str(args.critical)
        else:
            # Fallback if it's -3 but the Brother hex extraction failed
            if current_cap == -3:
                state_string += "OK: " + marker_name + " valid - "

    return toner_state, state_string, perfdata


async def _get_tray_dimensions(args, tray_id):
    """Helper to calculate tray dimension strings"""
    feed = int(await walk_snmp(args, OIDS["prtInputMediaDimFeedDirDeclared"] + "." + tray_id, True) or -1)
    xfeed = int(await walk_snmp(args, OIDS["prtInputMediaDimXFeedDirDeclared"] + "." + tray_id, True) or -1)
    units = await walk_snmp(args, OIDS["prtInputDimUnit"] + "." + tray_id, True)

    if feed < 0 and xfeed < 0:
        return "paper."

    if units == "3":  # ten thousandths of an inch to inches
        feed = round(feed / 10000.0, 1)
        xfeed = round(xfeed / 10000.0, 1)
    elif units == "4":  # micrometers to inches
        feed = round((feed * 0.0000393700787) + 0.5, 1)
        xfeed = round((xfeed * 0.0000393700787) + 0.5, 1)

    return str(xfeed) + " x " + str(feed) + " paper."


async def _check_one_tray(args, tray_id, state_string, perfdata):
    """Checks the tray #, returns status and capacity"""
    tray_state = STATE_OK
    tray_cap_str = await walk_snmp(args, OIDS["prtInputCurrentLevel"] + "." + tray_id, True)

    if not tray_cap_str:
        state_string += " UNKNOWN - Tray " + tray_id + " not found. Use the TRAY TEST option to determine which trays may be monitored."
        return STATE_UNK, state_string, perfdata

    tray_name = await walk_snmp(args, OIDS["prtInputName"] + "." + tray_id, True)
    if not tray_name:
        tray_name = "Tray " + tray_id

    try:
        tray_cap = int(tray_cap_str)
    except ValueError:
        return STATE_UNK, state_string, perfdata

    if tray_cap == -3:
        state_string += tray_name + " is OK - "
    elif tray_cap == -2:
        state_string += tray_name + " status is UNKNOWN - "
        tray_state = STATE_UNK
    elif tray_cap == 0:
        dim_str = await _get_tray_dimensions(args, tray_id)
        state_string += tray_name + " is at CRITICAL level - please refill with more " + dim_str + " - "
        tray_state = STATE_CRIT
    else:
        tray_max = int(await walk_snmp(args, OIDS["prtInputMaxCapacity"] + "." + tray_id, True) or 1)
        pct = int((tray_cap * 100) / tray_max)

        if pct > args.critical and pct > args.warning:
            state_string += tray_name + " is at " + str(pct) + "% - OK - "
        elif pct <= args.warning:
            dim_str = await _get_tray_dimensions(args, tray_id)
            if pct <= args.critical:
                state_string += tray_name + " is at " + str(pct) + "% - CRITICAL - Please refill with more " + dim_str + " - "
                tray_state = STATE_CRIT
            else:
                state_string += tray_name + " is at " + str(pct) + "% - WARNING - Please refill with more " + dim_str + " - "
                tray_state = max(tray_state, STATE_WARN)

        perfdata += " '" + tray_name + "'=" + str(pct) + ";" + str(args.warning) + ";" + str(args.critical)

    return tray_state, state_string, perfdata


async def check_paper_trays(args, param, arg_token):
    """Determines which trays to check"""
    trays_state = STATE_OK
    state_string = ""
    perfdata = ""

    temp_trays = await walk_snmp(args, OIDS["prtInputName"], True)
    all_trays_raw = temp_trays.splitlines()

    all_trays = []
    for t in all_trays_raw:
        parts = t.split(maxsplit=1)
        if len(parts) > 1:
            all_trays.append(parts[1])
        else:
            all_trays.append(t)

    if param.upper() == "TEST":
        return STATE_UNK, "Trays you may monitor:\n" + "\n".join(all_trays), ""
    elif param.upper() == "ALL":
        tasks = []
        for i in range(1, len(all_trays_raw) + 1):
            tasks.append(_check_one_tray(args, str(i), state_string, perfdata))

        results = await asyncio.gather(*tasks, return_exceptions=True)
        for status, s_string, p_data in results:
            state_string += s_string
            perfdata += p_data
            trays_state = max(trays_state, status)
    else:
        tasks = []
        for tray_id in param.split(arg_token):
            tasks.append(_check_one_tray(args, tray_id.strip(), state_string, perfdata))

        results = await asyncio.gather(*tasks, return_exceptions=True)
        for status, s_string, p_data in results:
            state_string += s_string
            perfdata += p_data
            trays_state = max(trays_state, status)

    return trays_state, state_string, perfdata


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Nagios plugin to check the status of networked printers.")
    parser.add_argument("-H", "--host", default="localhost", help="Host name or IP address")
    parser.add_argument("-v", "--snmpversion", choices=["1", "2c", "3"], default="2c", help="SNMP version")
    parser.add_argument("-C", "--community", default="public", help="SNMP v2 community")
    parser.add_argument("-u", "--user", default="", help="SNMP v3 username")
    parser.add_argument("-l", "--privlevel", choices=["noAuthNoPriv", "authNoPriv", "authPriv"], default="noAuthNoPriv")
    parser.add_argument("-x", "--privprotocol", choices=["DES", "AES"], default="DES")
    parser.add_argument("-X", "--privpassword", default="")
    parser.add_argument("-a", "--authprotocol", choices=["MD5", "SHA"], default="MD5")
    parser.add_argument("-A", "--authpassword", default="")
    parser.add_argument("-t", "--timeout", default="10:UNKNOWN")
    parser.add_argument("-T", "--type", required=True, help="Check type")
    parser.add_argument("-P", "--parameter", required=False, help="Check type parameter")
    parser.add_argument("-w", "--warning", type=int, default=20, help="WARNING threshold percent")
    parser.add_argument("-c", "--critical", type=int, default=5, help="CRITICAL threshold percent")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug mode")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    check_type = args.type.upper()
    parameter = args.parameter.upper() if args.parameter else ""

    arg_token = ","

    state = STATE_UNK
    state_string = "No valid check type specified"
    perfdata = ""

    if check_type == "MODEL":
        state, state_string, perfdata = await check_model(args)
    elif check_type == "MESSAGES":
        state, state_string, perfdata = await check_messages(args)
    elif check_type in ("PAGES", "COUNT", "PAGECOUNT"):
        state, state_string, perfdata = await check_pagecount(args)
    elif check_type == "DISPLAY":
        state, state_string, perfdata = await check_display(args)
    elif check_type == "STATUS":
        state, state_string, perfdata = await check_printer_status(args)
    elif check_type == "CONSUM":
        state, state_string, perfdata = await check_consumables(args, parameter)
    elif check_type == "CONSUMX":
        state, state_string, perfdata = await check_exact_consumable(args, parameter)
    elif check_type == "TONER":
        state, state_string, perfdata = await check_toner_levels(args)
    elif check_type in ("TRAY", "TRAYS"):
        state, state_string, perfdata = await check_paper_trays(args, parameter, arg_token)

    # Map integer state to status string for exitnagios
    status_map = {STATE_OK: "OK", STATE_WARN: "WARNING", STATE_CRIT: "CRITICAL", STATE_UNK: "UNKNOWN"}
    status_str = status_map.get(state, "UNKNOWN")

    if perfdata:
        exitnagios(status_str, state_string + " | " + perfdata)
    else:
        exitnagios(status_str, state_string)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

