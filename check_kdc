#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import os
import argparse
import tempfile
import asyncio
import aiofiles

# -------------------------------------------------------------------------------


_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


async def cleanup(cc_path, conf_path):
    """Destroy credentials and remove temporary configuration."""
    if cc_path and os.path.exists(cc_path):
        try:
            cmdline = ["kdestroy", "-c", cc_path]
            process = await asyncio.create_subprocess_exec(
                *cmdline,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            stdout, stderr = await process.communicate()
        except OSError:
            pass

    if conf_path and os.path.exists(conf_path):
        try:
            os.remove(conf_path)
        except OSError:
            pass


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", required=True, help="Name of KDC to check")
    parser.add_argument("-P", "--port", default="88", help="Port on which KDC runs (default 88)")
    parser.add_argument("-p", "--principal", required=True, help="Principal name to authenticate as (including realm)")
    parser.add_argument("-k", "--keytab", required=True, help="Keytab file containing principal key")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    # Validate principal format
    if "@" not in args.principal:
        exitnagios("UNKNOWN", "Principal must include realm (e.g., user@REALM)")

    # Extract realm (equivalent to: sed -e s/.*@//)
    realm = args.principal.split("@", 1)[-1]
    kdc_address = args.hostname + ":" + args.port

    # Generate Kerberos config content
    krb5_conf_content = (
        "[libdefaults]\n"
        "default_realm = " + realm + "\n"
        "[realms]\n"
        + realm + " = { \n"
        "kdc = " + kdc_address + "\n"
        "}\n"
        "[appdefaults]\n"
        "krb4_get_tickets = false\n"
    )

    # Securely create temp files for config and credential cache
    conf_fd, conf_path = tempfile.mkstemp(prefix="nagios_krb5_conf_")
    cc_fd, cc_path = tempfile.mkstemp(prefix="nagios_krb5_cc_")

    # We only need the paths, close the file descriptors opened by mkstemp
    os.close(conf_fd)
    os.close(cc_fd)

    async with aiofiles.open(conf_path, "wb") as f:
        content = krb5_conf_content.encode("utf-8")
        await f.write(content)

    try:
        # Prepare environment with our temporary config
        env = os.environ.copy()
        env["KRB5_CONFIG"] = conf_path

        # Construct and run the kinit command
        cmdline = ["/usr/bin/kinit", "-c", cc_path, "-k", "-t", args.keytab, args.principal]

        process = await asyncio.create_subprocess_exec(
            *cmdline,
            env=env,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT
        )

        stdout, _ = await process.communicate()

        # Check success
        if process.returncode == 0:
            exitnagios("OK", "")
        else:
            # Grab the first line of stdout (equivalent to head -n 1)
            error_msg = ""
            if stdout:
                decoded = stdout.decode().strip()
                error_msg = decoded.replace("\n", " ")
            exitnagios("CRITICAL", "Getting Kerberos ticket: " + error_msg)

    except FileNotFoundError:
        exitnagios("CRITICAL", "/usr/bin/kinit not found")
    except Exception as e:
        exitnagios("CRITICAL", str(e))
    finally:
        # Cleanup mechanism via finally (equivalent to bash trap)
        await cleanup(cc_path, conf_path)


# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
