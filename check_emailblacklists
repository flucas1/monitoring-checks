async def generatedriver(proxy):
    browserargs = []
    # browserargs.append("--incognito")
    # browserargs.append("--enable-features=EphemeralGuestProfilesOnStartup")
    browserargs.append("--disk-cache-size=0")
    browserargs.append("--media-cache-size=0")
    browserargs.append("--headless")
    browserargs.append("--disable-gpu")
    browserargs.append("--no-zygote")
    browserargs.append("--renderer-process-limit=1")
    browserargs.append("--no-sandbox")
    browserargs.append("--disable-dev-shm-usage")
    browserargs.append("--in-process-gpu")
    browserargs.append("--use-gl=angle")
    browserargs.append("--use-angle=swiftshader-webgl")
    browserargs.append("--disable-popup-blocking")
    if proxy not in ["", None]:
        browserargs.append("--proxy-server=" + proxy)
    # ua = fake_useragent.UserAgent()
    # browserargs.append("user-agent=" + ua.random)
    browserargs.append("--user-agent=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.7204.298 Safari/537.36\"")
    browserconfig = nodriver.Config(browser_args=browserargs)

    driver = await nodriver.start(browserconfig)
    # driver.implicitly_Wait(10, TimeUnit.SECONDS)

    await nodriver.cdp.network.enable()
    # nodriver.cdp.network.setExtraHTTPHeaders("Network.setExtraHTTPHeaders",{"headers": {"Accept-Language": "en-US,en;q=0.9","Sec-Fetch-Site": "none","Sec-Fetch-Mode": "navigate","Sec-Fetch-User": "?1","Sec-Fetch-Dest": "document"}})

    return driver


async def get_html_source(page):
    js = """
    (() => {
        return document.documentElement.outerHTML;
    })();
    """
    response, session = await page.send(nodriver.cdp.runtime.evaluate(expression=js, return_by_value=True))
    html = response.value
    return html


async def get_page_title(page):
    js = """
    (() => {
        return document.title;
    })();
    """
    response, session = await page.send(nodriver.cdp.runtime.evaluate(expression=js, return_by_value=True))
    title = response.value
    return title


async def check_page_loaded(page):
    js = """
    (() => {
        return document.readyState;
    })();
    """
    response, session = await page.send(nodriver.cdp.runtime.evaluate(expression=js, return_by_value=True))
    page_state_value = response.value
    infomsg("page state is '" + str(page_state_value) + "'")
    result = (page_state_value == "complete")
    return result


async def wait_page_loaded(page):
    timestamp = time.monotonic()
    while True:
        loaded = await check_page_loaded(page)
        if loaded == True:
            break
        if time.monotonic() - timestamp > 20:
            break
        await asyncio.sleep(1)


