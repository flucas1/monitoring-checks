async def tryfindbyid(page, idname):
    result = []
    try:
        result = await page.select_all("#" + idname)
    except Exception:
        pass
    return result


async def tryfindbytagname(page, tagname):
    result = []
    try:
        result = await page.select_all(tagname)
    except Exception:
        pass
    return result


