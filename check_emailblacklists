async def resolverecord(protocol, hostname):
    result = []
    try:
        record = None
        if protocol in ["-4", "4"]:
            record = "A"
        if protocol in ["-6", "6"]:
            record = "AAAA"
        if record is not None:
            resolver = dns.asyncresolver.Resolver()
            answers = await resolver.resolve(hostname, record)
            for rdata in answers:
                result.append(rdata.to_text())
    except Exception as e:
        infomsg("exception " + str(e))
    return result


async def dodnscheckercall(protocol, hostname, ignorelist, tolerance, proxy):
    driver = None
    try:
        ips = await resolverecord(protocol, hostname)
        if len(ips) == 0:
            exitnagios("CRITICAL", "cannot resolve " + hostname + " with protocol " + protocol)
        if len(ips) > 1:
            exitnagios("CRITICAL", "too many ips resolved for " + hostname + " - " + str(ips))
        targetip = ips[0]
        infomsg("The IP to test is " + targetip)

        driver = await generatedriver(proxy)

        infomsg("browser OK")

        # driver.get("https://www.whatismybrowser.com/detect/what-is-my-user-agent/")
        # detected_user_agent = driver.find_element(By.ID, "detected_value").text
        # infomsg("Detected User Agent: " + detected_user_agent)

        targeturl = "https://dnschecker.org/ip-blacklist-checker.php"
        infomsg("asking for navigating " + targeturl)
        page = await driver.get(targeturl)
        # page = page.main_tab

        infomsg("manual delay")
        await asyncio.sleep(2)

        await wait_page_loaded(page)
        infomsg("page loaded")

        # currenturl = driver.current_url
        # driver.get("the current page is "+currenturl)

        # sourceraw = await page.send(nodriver.cdp.dom.get_outer_html())
        sourceraw = await get_html_source(page)
        if (sourceraw == None) or (sourceraw.strip() == ""):
            infomsg("The page source is empty")
        else:
            infomsg("The page source has contents")
            pagetitle = await get_page_title(page)
            infomsg("The page title is '" + str(pagetitle) + "'")
            if (pagetitle in ["New tab", "", None]) or ("Access denied" in pagetitle) or ("Cloudflare" in pagetitle):
                infomsg("Aborting...")
                infomsg(sourceraw)
                exitnagios("CRITICAL", "could not get effective page, maybe antibot protection")
            else:
                infomsg("page OK")
                infomsg(sourceraw)

        infomsg("waiting for mTools")
        await page.wait_for("#mTools", timeout=20)

        infomsg("waiting for ipbc_submit")
        await page.wait_for("#ipbc_submit", timeout=20)

        infomsg("finding textbox element")
        elements = await tryfindbyid(page, "ipbc_host")
        if len(elements) == 0:
            exitnagios("CRITICAL", "cannot find textbox")
        else:
            infomsg("sending ip")
            await elements[0].send_keys(targetip)
            await elements[0].send_keys(nodriver.Keys.RETURN)

        infomsg("manual delay")
        await asyncio.sleep(10)

        infomsg("waiting for result")
        await page.wait_for("#blacklist_count", timeout=20)

        infomsg("extracting listed")
        blocks = await tryfindbyid(page, "ipbc_results_dnsbl")
        if len(blocks) == 0:
            exitnagios("CRITICAL", "cannot find results table")
        lists = await tryfindbytagname(blocks[0], "tr")
        infomsg("row candidates: " + str(len(lists)))
        issues = []
        for item in lists:
            providers = await tryfindbytagname(item, "th")
            if len(providers) == 1:
                provider = providers[0].text
            else:
                provider = ""
            statuses = await tryfindbytagname(item, "td")
            if len(statuses) == 2:
                listed = statuses[0].text.split()[0]
            else:
                listed = ""
            if provider != "" and listed != "":
                infomsg("status " + provider + " " + listed)
                if listed.lower() == "yes":
                    if provider in ignorelist:
                        infomsg("ignoring " + provider)
                    else:
                        infomsg("adding " + provider)
                        issues.append(provider)

        if len(issues) > tolerance:
            exitnagios("CRITICAL", "The IP " + targetip + " is listed in spam databases " + str(issues) + " | count=" + str(len(issues)))
        elif len(issues) > 0:
            exitnagios("WARNING", "The IP " + targetip + " is listed in spam databases " + str(issues) + " | count=" + str(len(issues)))
        else:
            exitnagios("OK", "No issues found for the IP " + targetip + " | count=" + str(len(issues)))

    except Exception as e:
        if driver is not None:
            infomsg(driver.page_source)
        exitnagios("CRITICAL", "unexpected error during the check " + str(e))


