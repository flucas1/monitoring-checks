#!/usr/bin/env python
# -------------------------------------------------------------------------------

import asyncio
import argparse
import sys

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug() is True:
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check Raspberry Pi voltage and throttling status")
    parser.add_argument("-d", "--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    infomsg("Starting voltage/throttling check")

    try:
        cmdline = ["/usr/bin/vcgencmd", "get_throttled"]
        process = await asyncio.create_subprocess_exec(
            *cmdline,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        output = stdout.decode("utf-8").strip() if stdout else ""
        errors = stderr.decode("utf-8").strip() if stderr else ""
        exitcode = process.returncode
        infomsg("vcgencmd output: " + output)
        infomsg("vcgencmd errors: " + errors)

        if exitcode != 0:
            exitnagios("UNKNOWN", "vcgencmd command failed with exit code " + str(exitcode))

        if "=" not in output:
            exitnagios("UNKNOWN", "Unexpected vcgencmd output format")

        value = output.split("=")[1]
        status = int(value, 16)
        infomsg("Throttling status: " + hex(status))

    except (IndexError, ValueError) as e:
        exitnagios("UNKNOWN", "Error retrieving or parsing vcgencmd status: " + str(e))

    if (status & 0x1) != 0:
        exitnagios("CRITICAL", "currently undervolted")
    elif (status & 0x10000) != 0:
        exitnagios("WARNING", "has undervolted")
    else:
        exitnagios("OK", "no issues")

# -------------------------------------------------------------------------------


if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
