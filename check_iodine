#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import asyncio
import argparse
import aiohttp
import bs4

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


async def doportexternalcall(domain):
    url = "https://code.kryo.se/iodine/check-it/"
    retries = 3
    counter = 0
    valid = False

    async with aiohttp.ClientSession() as session:
        while counter < retries:
            counter = counter + 1
            welldone = False
            try:
                infomsg("initializing request")
                async with session.get(url) as response:
                    infomsg("page opened")
                    if response.status != 200:
                        infomsg("unexpected status: " + str(response.status))
                        continue

                    # Parse form to extract any hidden fields (e.g., CSRF tokens)
                    content = await response.text()
                    soup = bs4.BeautifulSoup(content, "html.parser")
                    form = soup.find("form")
                    if form is None:
                        infomsg("form not found")
                        continue

                    # Build form data
                    form_data = aiohttp.FormData()
                    form_data.add_field("domain", domain)

                    # Collect all input fields from the form
                    for input_tag in form.find_all("input"):
                        name = input_tag.get("name")
                        if name is None:
                            continue
                        value = input_tag.get("value", "")
                        form_data.add_field(name, value)

                    infomsg("going to submit!")
                    async with session.post(url, data=form_data) as submit_response:
                        infomsg("submitted")
                        submit_content = await submit_response.text()
                        infomsg("the result is of length " + str(len(submit_content)))

                        soup = bs4.BeautifulSoup(submit_content, "html.parser")
                        wdbold = soup.find_all("b")
                        for item in wdbold:
                            if item.text == "Well done":
                                welldone = True
                                break

                if welldone:
                    valid = True
                    break
                else:
                    infomsg("retrying in 10 seconds...")
                    await asyncio.sleep(10)
            except Exception as e:
                infomsg("exception: " + str(e))
                await asyncio.sleep(10)

    if valid:
        exitnagios("OK", "the tunnel is well done")
    else:
        exitnagios("WARNING", "the tunnel is not valid")


# -------------------------------------------------------------------------------


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="server to check")
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def main(forcedargs=None):
    args = parse_args(forcedargs)
    setcandebug(args.debug)

    if args.hostname == "":
        exitnagios("CRITICAL", "hostname not defined")

    await doportexternalcall(args.hostname)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
