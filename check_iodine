#!/usr/bin/env python3
#-------------------------------------------------------------------------------

import os
import sys
import asyncio
import time
import aiohttp
import argparse
from bs4 import BeautifulSoup

#-------------------------------------------------------------------------------

_candebug = False
def candebug():
    global _candebug
    return _candebug

def setcandebug(value):
    global _candebug
    _candebug = value

def infomsg(msg):
    if candebug() == True:
        print(msg, flush=True)

def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode

def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

#-------------------------------------------------------------------------------

async def doportexternalcall(domain):
    try:
        valid = False
        url = "https://code.kryo.se/iodine/check-it/"
        retries = 3
        counter = 0
        async with aiohttp.ClientSession() as session:
            while True:
                counter = counter + 1
                welldone = False
                try:
                    infomsg("initializing request")
                    headers = {
                        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/113.0"
                    }
                    async with session.get(url, headers=headers) as response:
                        infomsg("page opened")
                        if response.status != 200:
                            raise Exception("HTTP status " + str(response.status))
                        page_content = await response.text()
                        infomsg("the result is of length " + str(len(page_content)))

                        soup = BeautifulSoup(page_content, "html.parser")
                        div = soup.find("div", id="blaffa")
                        wdbold = soup.find_all("b")
                        welldone = False
                        for item in wdbold:
                            if item.text == "Well done":
                                welldone = True
                except Exception as e:
                    print(str(e), flush=True)

                if welldone == True:
                    valid = True
                    break
                elif counter >= retries:
                    break
                else:
                    await asyncio.sleep(10)

        if valid == True:
            exitnagios("OK", "the tunnel is well done")
        else:
            exitnagios("WARNING", "the tunnel is not valid")
    except Exception as e:
        exitnagios("CRITICAL", "unexpected error during the check " + str(e))

#-------------------------------------------------------------------------------

async def main(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-H", "--hostname", dest="hostname", default="", help="server to check")
    parser.add_argument("-®", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)

    setcandebug(args.debug)

    if args.hostname == "":
        exitnagios("CRITICAL", "hostname not defined")

    await doportexternalcall(args.hostname)

#-------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

