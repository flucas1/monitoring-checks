#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse

# -------------------------------------------------------------------------------

# 0 is host UP;           reacheable yes
# 1 is host UP;           reacheable yes
# 2 is host DOWN;         reacheable no
# 3 is host UNREACHEABLE; reacheable no


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("exit_code", nargs="?", type=int, default=0)
    parser.add_argument("message", nargs="?", default="")
    return parser.parse_args(forcedargs)


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    print(args.message)

    sys.exit(args.exit_code)

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    import asyncio
    asyncio.run(main())

# -------------------------------------------------------------------------------
