#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import sys
import argparse
import asyncio
import re

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)


# Standard Nagios/Icinga Exit-Codes
STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser(description="Check system uptime and return standard plugin exit codes.")
    parser.add_argument('-c', type=int, dest='min_critical', help='Minimum critical uptime (minutes)')
    parser.add_argument('-w', type=int, dest='min_warning', help='Minimum warning uptime (minutes)')
    parser.add_argument('-C', type=int, dest='max_critical', help='Maximum critical uptime (minutes)')
    parser.add_argument('-W', type=int, dest='max_warning', help='Maximum warning uptime (minutes)')
    parser.add_argument('-v', action='store_true', dest='verbose', help='Verbose output')

    if forcedargs is not None:
        args = parser.parse_args(forcedargs)
    else:
        args = parser.parse_args()

    return args


async def get_uptime():
    try:
        process = await asyncio.create_subprocess_exec(
            "uptime",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await process.communicate()
        if process.returncode != 0:
            raise Exception("uptime command failed")
        return stdout.decode().replace(",", "")
    except Exception as e:
        raise Exception("Could not retrieve uptime - " + str(e))


def parse_uptime(uptime_report):
    days = 0
    hours = 0
    minutes = 0

    uptime_lower = uptime_report.lower()
    words = uptime_report.split()

    try:
        if "day" in uptime_lower:
            if "min" in uptime_lower:
                days = int(words[2])
                minutes = int(words[4])
            else:
                days = int(words[2])
                time_parts = words[4].split(":")
                hours = int(time_parts[0])
                if len(time_parts) > 1:
                    minutes = int(time_parts[1])
        elif re.search(r"hour|hr\(s\)", uptime_lower):
            hours = int(words[2])
        else:
            if ":" in words[2]:
                time_parts = words[2].split(":")
                hours = int(time_parts[0])
                if len(time_parts) > 1:
                    minutes = int(time_parts[1])
            else:
                minutes = int(words[2])
    except (IndexError, ValueError):
        pass

    uptime_minutes = (days * 1440) + (hours * 60) + minutes
    raw_days = uptime_minutes / 1440.0
    uptime_days = str(format(raw_days, ".4f"))

    msg_parts = []
    if days:
        msg_parts.append(str(days) + " Days")
    if hours:
        msg_parts.append(str(hours) + " Hours")
    msg_parts.append(str(minutes) + " Minutes")
    uptime_msg = ", ".join(msg_parts)

    return uptime_minutes, uptime_days, uptime_msg


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    try:
        uptime_report = await get_uptime()
    except Exception as e:
        print("Error: " + str(e))
        sys.exit(STATE_UNKNOWN)

    uptime_minutes, uptime_days, uptime_msg = parse_uptime(uptime_report)

    min_w = str(args.min_warning) if args.min_warning is not None else ""
    max_w = str(args.max_warning) if args.max_warning is not None else ""
    min_c = str(args.min_critical) if args.min_critical is not None else ""
    max_c = str(args.max_critical) if args.max_critical is not None else ""

    perfdata = "|Uptime=" + uptime_days + ";" + min_w + ":" + max_w + ";" + min_c + ":" + max_c + ";0;"

    if args.min_critical is not None and uptime_minutes < args.min_critical:
        print("CRITICAL: minimum - system booted " + uptime_msg + " ago" + perfdata)
        sys.exit(STATE_CRITICAL)

    elif args.min_warning is not None and uptime_minutes < args.min_warning:
        print("WARNING: minimum - system booted " + uptime_msg + " ago" + perfdata)
        sys.exit(STATE_WARNING)

    elif args.max_critical is not None and uptime_minutes > args.max_critical:
        print("CRITICAL: maximum - system has not booted for " + uptime_msg + perfdata)
        sys.exit(STATE_CRITICAL)

    elif args.max_warning is not None and uptime_minutes > args.max_warning:
        print("WARNING: maximum - system has not booted for " + uptime_msg + perfdata)
        sys.exit(STATE_WARNING)

    else:
        print("OK: uptime is " + uptime_msg + perfdata)
        sys.exit(STATE_OK)


if __name__ == "__main__":
    asyncio.run(main())
