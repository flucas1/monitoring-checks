#!/usr/bin/env python3
# -------------------------------------------------------------------------------

import os
import sys
import argparse
import pathlib
import asyncio

# -------------------------------------------------------------------------------

_candebug = False


def candebug():
    global _candebug
    return _candebug


def setcandebug(value):
    global _candebug
    _candebug = value


def infomsg(msg):
    if candebug():
        print(msg, flush=True)


def mapstatustoexitcode(status):
    if status == "OK":
        exitcode = 0
    elif status == "WARNING":
        exitcode = 1
    elif status == "CRITICAL":
        exitcode = 2
    elif status == "UNKNOWN":
        exitcode = 3
    else:
        exitcode = 4
    return exitcode


def exitnagios(status, message):
    exitcode = mapstatustoexitcode(status)
    print(status + ": " + message, flush=True)
    sys.exit(exitcode)

# -------------------------------------------------------------------------------


def speedfromversion(version):
    if version in ["1.00", "1.10"]:
        return 12
    elif version in ["2.00", "2.01"]:
        return 480
    elif version in ["3.00"]:
        return 5000
    elif version in ["3.10"]:
        return 10000
    elif version in ["3.20"]:
        return 20000
    else:
        return 0


def parse_args(forcedargs=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--debug", action="store_true", dest="debug", default=False, help="be more verbose")
    args = parser.parse_args(forcedargs)
    return args


async def getmaxspeed(device):
    deviceroute = os.path.basename(device).replace("-", ":")
    cmdline = ["/usr/bin/lsusb", "-v", "-s", deviceroute]
    process = await asyncio.create_subprocess_exec(
        *cmdline,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8").strip() if stdout else ""
    errors = stderr.decode("utf-8").strip() if stderr else ""
    exitcode = process.returncode

    maxspeed = 0
    if exitcode == 0:
        for line in output.splitlines():
            line = line.strip()
            if line.startswith("Device can operate at SuperSpeed "):
                parts = line.split()
                candidate = parts[5]
                candidate = candidate.replace("(", "").replace(")", "").replace("Gbps", "") + "000"
                candidate = int(candidate)
                if candidate > maxspeed:
                    maxspeed = candidate
    elif exitcode == 1:
        if output == "" and errors == "":
            maxspeed = -1

    return maxspeed


async def printinfo(device):
    status = False
    try:
        version = pathlib.Path(os.path.join(device, "version")).read_text().strip()
        parts = version.split(".")
        major = int(parts[0])
        infomsg("USB major version for " + device + " is " + str(major))
        if major >= 3:
            maxspeed = await getmaxspeed(device)
            actualspeed = pathlib.Path(os.path.join(device, "speed")).read_text().strip()
            actualspeed = int(actualspeed)
            reference = speedfromversion(version)
            infomsg("\tusb version: " + version)
            infomsg("\tmax speed: " + str(maxspeed))
            infomsg("\tactual speed: " + str(actualspeed))
            infomsg("\treference speed: " + str(reference))
            if maxspeed <= actualspeed:
                status = True
            elif maxspeed == -1:
                status = True
        else:
            status = True
    except Exception as e:
        infomsg("exception - " + str(e))
    infomsg("\tstatus: " + str(status))
    return status


def listdevices():
    result = []
    basepath = "/sys/bus/usb/devices"
    listcontents = os.listdir(basepath)
    for item in listcontents:
        fullpath = os.path.join(basepath, item)
        if os.path.isdir(fullpath):
            parts = item.split("-")
            if (len(parts) == 2) and (":" not in item):
                result.append(fullpath)
    return result


async def is_usb_speedmax():
    issues = []

    realdevices = listdevices()
    for device in realdevices:
        status = await printinfo(device)
        if status == False:
            issues.append(device)

    if len(issues) == 0:
        exitnagios("OK", "no issues found | issues=0")
    else:
        exitnagios("WARNING", "some issues found - " + str(issues) + " | issues=" + str(len(issues)))

# -------------------------------------------------------------------------------


async def main(forcedargs=None):
    args = parse_args(forcedargs)

    setcandebug(args.debug)

    await is_usb_speedmax()

# -------------------------------------------------------------------------------

if __name__ == "__main__":
    asyncio.run(main())

# -------------------------------------------------------------------------------
